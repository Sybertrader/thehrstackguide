{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:slug*-for-tech-startups",
      "destination": "/:slug*/",
      "permanent": true
    },
    {
      "source": "/:slug*-for-tech-startups/",
      "destination": "/:slug*/",
      "permanent": true
    },
    {
      "source": "/oyster-vs-:rest*",
      "destination": "/oyster-hr-vs-:rest*/",
      "permanent": true
    },
    {
      "source": "/oyster-vs-:rest*/",
      "destination": "/oyster-hr-vs-:rest*/",
      "permanent": true
    },
    {
      "source": "/:pair*-vs-oyster-for-:mod*",
      "destination": "/:pair*-vs-oyster-hr-for-:mod*/",
      "permanent": true
    },
    {
      "source": "/:pair*-vs-oyster-for-:mod*/",
      "destination": "/:pair*-vs-oyster-hr-for-:mod*/",
      "permanent": true
    },
    {
      "source": "/:pair*-vs-oyster",
      "destination": "/:pair*-vs-oyster-hr/",
      "permanent": true
    },
    {
      "source": "/:pair*-vs-oyster/",
      "destination": "/:pair*-vs-oyster-hr/",
      "permanent": true
    },
    {
      "source": "/papaya-vs-:rest*",
      "destination": "/papaya-global-vs-:rest*/",
      "permanent": true
    },
    {
      "source": "/papaya-vs-:rest*/",
      "destination": "/papaya-global-vs-:rest*/",
      "permanent": true
    },
    {
      "source": "/:pair*-vs-papaya-for-:mod*",
      "destination": "/:pair*-vs-papaya-global-for-:mod*/",
      "permanent": true
    },
    {
      "source": "/:pair*-vs-papaya-for-:mod*/",
      "destination": "/:pair*-vs-papaya-global-for-:mod*/",
      "permanent": true
    },
    {
      "source": "/:pair*-vs-papaya",
      "destination": "/:pair*-vs-papaya-global/",
      "permanent": true
    },
    {
      "source": "/:pair*-vs-papaya/",
      "destination": "/:pair*-vs-papaya-global/",
      "permanent": true
    },
    {
      "source": "/go/oyster",
      "destination": "/go/oyster-hr/",
      "permanent": true
    },
    {
      "source": "/go/oyster/",
      "destination": "/go/oyster-hr/",
      "permanent": true
    },
    {
      "source": "/go/papaya",
      "destination": "/go/papaya-global/",
      "permanent": true
    },
    {
      "source": "/go/papaya/",
      "destination": "/go/papaya-global/",
      "permanent": true
    },
    {
      "source": "/reflektive-vs-:rest*",
      "destination": "/peoplefluent-vs-:rest*/",
      "permanent": true
    },
    {
      "source": "/reflektive-vs-:rest*/",
      "destination": "/peoplefluent-vs-:rest*/",
      "permanent": true
    },
    {
      "source": "/:pair*-vs-reflektive-for-:mod*",
      "destination": "/:pair*-vs-peoplefluent-for-:mod*/",
      "permanent": true
    },
    {
      "source": "/:pair*-vs-reflektive-for-:mod*/",
      "destination": "/:pair*-vs-peoplefluent-for-:mod*/",
      "permanent": true
    },
    {
      "source": "/:pair*-vs-reflektive",
      "destination": "/:pair*-vs-peoplefluent/",
      "permanent": true
    },
    {
      "source": "/:pair*-vs-reflektive/",
      "destination": "/:pair*-vs-peoplefluent/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/go",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/go/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/go/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/go/:path*/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
