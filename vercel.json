{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:slug*-for-tech-startups",
      "destination": "/:slug*/",
      "permanent": true
    },
    {
      "source": "/:slug*-for-tech-startups/",
      "destination": "/:slug*/",
      "permanent": true
    }
  ]
}
