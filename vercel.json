{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:slug*-for-tech-startups",
      "destination": "/:slug*/",
      "permanent": true
    },
    {
      "source": "/:slug*-for-tech-startups/",
      "destination": "/:slug*/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/go/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
