---
import Layout from '../../layouts/Layout.astro';
import ConciergeLeadBox from '../../components/ConciergeLeadBox.astro';
import CategoryComparisonBrowser from '../../components/CategoryComparisonBrowser.astro';
import VendorButton from '../../components/VendorButton.astro';
import ManualLeadModal from '../../components/ManualLeadModal.astro';
import { loadComparisons } from '../../lib/comparisons';
import { isManualLeadBrand, manualLeadModalId, resolveVendorOutboundHref } from '../../lib/outbound';
import { getToolsByCategory } from '../../lib/tools';

const currentMonthYear = new Date().toLocaleDateString('en-US', {
  month: 'long',
  year: 'numeric',
}); // Produces "September 2026"

const CATEGORY = 'ats';

const allComparisons = loadComparisons();
const toolProfiles = getToolsByCategory(CATEGORY);
const toolIds = new Set(toolProfiles.map((tool) => tool.id));

// Comparisons "belong" to this sub-vertical when both tools in the pairing
// are tagged with this category in src/data/tools.json, so this hub stays in
// sync automatically as tools.json gains a category tag rather than needing
// a hardcoded id list here.
const categoryComparisons = allComparisons.filter(
  (comparison) => toolIds.has(comparison.tool_a_id) && toolIds.has(comparison.tool_b_id)
);

// Look up display name, logo, and the high-signal "best fit" badge from the
// comparisons data source itself (those richer fields aren't duplicated in
// tools.json). Reading the badge from here rather than a map maintained on this
// page means a vendor's sub-niche tag is authored once, in
// generate_comparisons.py, and reads identically on the roster below and on
// every comparison page it appears in.
const nameById = new Map<string, string>();
const logoById = new Map<string, string>();
const badgeById = new Map<string, string>();
for (const comparison of allComparisons) {
  nameById.set(comparison.tool_a_id, comparison.tool_a_name);
  nameById.set(comparison.tool_b_id, comparison.tool_b_name);
  logoById.set(comparison.tool_a_id, comparison.tool_a_logo_url);
  logoById.set(comparison.tool_b_id, comparison.tool_b_logo_url);
  badgeById.set(comparison.tool_a_id, comparison.tool_a_badge);
  badgeById.set(comparison.tool_b_id, comparison.tool_b_badge);
}

const toolRoster = toolProfiles
  .map((profile) => ({
    ...profile,
    name: nameById.get(profile.id) ?? profile.id,
    logo: logoById.get(profile.id) ?? null,
    bestFor: badgeById.get(profile.id) ?? null,
  }))
  .sort((a, b) => parseFloat(b.rating ?? '0') - parseFloat(a.rating ?? '0'));

const buyerGuide = [
  {
    title: 'Structured Scorecards vs. Freeform Notes',
    description:
      'Platforms like Greenhouse and Ashby enforce structured, weighted scorecards across every interviewer, reducing bias and creating an auditable hiring record you can defend later. Freeform-notes-only tools are faster to set up but make it much harder to compare candidates objectively once you\u2019re hiring at volume.',
  },
  {
    title: 'Candidate Sourcing CRM Integration',
    description:
      'If outbound sourcing is a core part of your hiring motion, prioritize a platform with a built-in candidate CRM (Lever, Ashby) that lets you nurture silver-medalist candidates and re-engage past applicants, rather than tracking sourcing efforts in a separate spreadsheet or tool.',
  },
  {
    title: 'Headcount vs. Seat-Based Pricing',
    description:
      'Some ATS platforms price by total employee headcount (a BambooHR-style model), while others price by active job openings or hiring-manager seats. Seat-based pricing can penalize you for looping in more interviewers; headcount-based pricing can get expensive fast as you scale, so model both against your actual hiring plan before committing.',
  },
];

function logoBadgeColor(name: string): string {
  const colors = ['bg-indigo-600', 'bg-violet-600', 'bg-sky-600', 'bg-emerald-600', 'bg-rose-600', 'bg-amber-600', 'bg-cyan-600', 'bg-fuchsia-600'];
  let hash = 0;
  for (let i = 0; i < name.length; i += 1) {
    hash = name.charCodeAt(i) + ((hash << 5) - hash);
  }
  return colors[Math.abs(hash) % colors.length];
}

function parseReviewCount(value?: string): number | null {
  if (!value) return null;
  const parsed = parseInt(value.replace(/[^0-9]/g, ''), 10);
  return Number.isNaN(parsed) ? null : parsed;
}

const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const siteRootUrl = new URL('/', Astro.site ?? Astro.url.origin).href;

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Applicant Tracking System (ATS) Comparisons',
  description:
    'Independent, data-driven comparisons of the leading Applicant Tracking Systems on structured hiring, sourcing, compliance, and real pricing.',
  url: pageUrl,
  isPartOf: {
    '@type': 'WebSite',
    name: 'The HR Stack Guide',
    url: siteRootUrl,
  },
  about: {
    '@type': 'Thing',
    name: 'Applicant Tracking System (ATS) Software',
  },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: toolRoster.length,
    itemListElement: toolRoster.map((tool, index) => {
      const reviewCount = parseReviewCount(tool.review_count);
      return {
        '@type': 'ListItem',
        position: index + 1,
        item: {
          '@type': 'SoftwareApplication',
          name: tool.name,
          applicationCategory: 'BusinessApplication',
          operatingSystem: 'Web-based',
          description: tool.positioning,
          offers: {
            '@type': 'Offer',
            price: '0',
            priceCurrency: 'USD',
            description: 'Contact for custom enterprise pricing / Free demo',
          },
          aggregateRating: {
            '@type': 'AggregateRating',
            ratingValue: tool.rating || '4.7',
            reviewCount: String(reviewCount ?? '100'),
          },
        },
      };
    }),
  },
};
---

<Layout
  title={`Best ATS Software Comparisons (${currentMonthYear}) | The HR Stack Guide`}
  description={`Independent ${currentMonthYear} applicant tracking system (ATS) comparisons. Compare Ashby, Greenhouse, Lever, Workable, and more on features, pricing, and workflows.`}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />

  <main class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <!-- Hero -->
    <header class="mb-12">
      <nav aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-2 text-sm text-slate-500">
          <li><a href="/" class="transition hover:text-indigo-600">Home</a></li>
          <li aria-hidden="true" class="text-slate-300">&gt;</li>
          <li class="font-medium text-indigo-600" aria-current="page">Applicant Tracking Systems (ATS)</li>
        </ol>
      </nav>

      <span class="mt-4 inline-flex items-center rounded-full border border-emerald-200 bg-emerald-50 px-3.5 py-1.5 text-sm font-semibold text-emerald-700">
        {toolRoster.length} Platforms Evaluated · {categoryComparisons.length} Comparisons
      </span>

      <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
        Applicant Tracking Systems (ATS) Comparisons
      </h1>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed text-slate-600">
        Independent, data-driven comparisons of the platforms modern talent teams use to source, screen, and hire candidates, from structured enterprise scorecards to SMB-friendly drag-and-drop pipelines. Every rating, price, and feature claim below is sourced from our {currentMonthYear} evaluation.
      </p>
    </header>

    <!-- Tool Roster -->
    <section class="mb-16" aria-label="ATS tool roster">
      <h2 class="mb-6 text-2xl font-bold text-slate-900">The {currentMonthYear} Platform Roster</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {toolRoster.map((tool) => (
          <article class="flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:shadow-md">
            {tool.bestFor && (
              <span class="mb-3 inline-flex w-fit items-center gap-1.5 rounded-full bg-amber-50 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide text-amber-700">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-3 w-3" aria-hidden="true">
                  <path d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.454 1.405 1.02L10 15.591l4.069 2.485c.713.434 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401Z" />
                </svg>
                {tool.bestFor}
              </span>
            )}
            <div class="flex items-center gap-3">
              <div class="relative inline-flex h-10 w-10 shrink-0">
                {tool.logo && (
                  <img
                    src={tool.logo}
                    alt={`${tool.name} logo`}
                    class="h-10 w-10 rounded-lg bg-slate-100 object-contain aspect-square"
                    width="40"
              height="40"
              decoding="async"
              loading="lazy"
                    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                  />
                )}
                <div
                  class:list={[
                    tool.logo ? 'hidden' : 'flex',
                    'h-10 w-10 items-center justify-center rounded-lg text-sm font-bold uppercase text-white',
                    logoBadgeColor(tool.name),
                  ]}
                  aria-hidden="true"
                >
                  {tool.name.charAt(0)}
                </div>
              </div>
              <div>
                <h3 class="text-lg font-bold text-slate-900">{tool.name}</h3>
                {tool.rating && (
                  <p class="text-sm font-medium text-slate-500">
                    ⭐️ {tool.rating}/5{tool.review_count && ` (${tool.review_count}+)`}
                  </p>
                )}
              </div>
            </div>
            <p class="mt-4 flex-1 text-sm leading-relaxed text-slate-600">{tool.positioning}</p>
            <VendorButton
              href={isManualLeadBrand(tool.id) ? undefined : resolveVendorOutboundHref(tool.id)}
              modalId={isManualLeadBrand(tool.id) ? manualLeadModalId(tool.name) : undefined}
              vendorName={tool.name}
              location="hub_roster"
              class="mt-5 inline-flex w-full items-center justify-center rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 hover:shadow-md"
            >
              Try {tool.name}
            </VendorButton>
          </article>
        ))}
      </div>
    </section>

    <!-- Category Buyer's Guide -->
    <section class="mb-16" aria-label="How to evaluate Applicant Tracking System platforms">
      <h2 class="mb-2 text-2xl font-bold text-slate-900">How to Evaluate Applicant Tracking System (ATS) Platforms in {currentMonthYear}</h2>
      <p class="mb-8 max-w-3xl text-base leading-relaxed text-slate-600">
        Every ATS claims to "streamline hiring." Here's what actually separates them once you get past the demo and into daily use by your recruiters and hiring managers.
      </p>
      <div class="grid gap-6 sm:grid-cols-3">
        {buyerGuide.map((item, index) => (
          <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-emerald-50 text-sm font-bold text-emerald-600">
              {index + 1}
            </span>
            <h3 class="mt-4 text-lg font-bold text-slate-900">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{item.description}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- Comparison Directory -->
    <section id="browse-comparisons" class="scroll-mt-24" aria-label="Comparison directory">
      <h2 class="mb-2 text-2xl font-bold text-slate-900">Browse All Comparisons</h2>
      <CategoryComparisonBrowser comparisons={categoryComparisons} theme="emerald" idPrefix="ats" />
    </section>

    <ConciergeLeadBox categoryName="Applicant Tracking Systems (ATS)" theme="teal" ctaHref="/recommendation/?category=ats" />

    {toolRoster
      .filter((tool) => isManualLeadBrand(tool.id))
      .map((tool) => (
        <ManualLeadModal
          brandName={tool.name}
          vendorId={tool.id}
          modalId={manualLeadModalId(tool.name)}
          partnerLandingUrl={tool.partner_landing_url ?? ''}
        />
      ))}
  </main>
</Layout>
