---
import Layout from '../layouts/Layout.astro';
import { loadComparisons } from '../lib/comparisons';

const comparisons = loadComparisons();
const bySlug = new Map(comparisons.map((c) => [c.slug, c]));

const categoryBadges = ['Global EOR', 'US & Global Payroll', 'Contractor Compliance', 'PEO Services'];

// "Gusto vs BambooHR" and "ADP vs Rippling" were requested but neither BambooHR nor ADP
// exist in our dataset, so they're swapped for two other real, high-intent pairs.
const featuredSlugs = [
  'deel-vs-rippling-for-tech-startups',
  'rippling-vs-gusto-for-scaleups',
  'remote-vs-oyster-for-agencies',
  'deel-vs-remote-for-us-latam',
  'gusto-vs-multiplier-for-web3-crypto',
  'deel-vs-oyster-for-tech-startups',
];

const featuredComparisons = featuredSlugs
  .map((slug) => bySlug.get(slug))
  .filter((comparison): comparison is NonNullable<typeof comparison> => Boolean(comparison));

const categoryBreakdown = [
  {
    title: 'Global Payroll & EOR',
    description: 'Managing remote teams, tax compliance, and local legal entities.',
  },
  {
    title: 'US Payroll & Benefits',
    description: 'Small business payroll, health insurance, and 401(k) management.',
  },
  {
    title: 'Contractor Management',
    description: 'Cross-border invoicing, automated payouts, and W-8/W-9 compliance.',
  },
];
---

<Layout
  title="The HR Stack Guide — Global HR Tool Comparisons"
  description="Independent, data-driven comparisons of the leading global payroll, EOR, and HR platforms."
>
  <main class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
    <!-- Hero Section -->
    <section class="mx-auto max-w-3xl text-center">
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
        Compare HR, Global Payroll &amp; EOR Software
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-slate-600">
        Unbiased side-by-side comparisons covering payroll, Employer of Record (EOR) platforms, contractor compliance, and HR tech for modern businesses.
      </p>

      <div class="mt-6 flex flex-wrap items-center justify-center gap-2">
        {categoryBadges.map((badge) => (
          <span class="inline-flex items-center rounded-full border border-indigo-200 bg-indigo-50 px-3.5 py-1.5 text-sm font-semibold text-indigo-700">
            {badge}
          </span>
        ))}
      </div>
    </section>

    <!-- Featured Comparisons Grid -->
    {featuredComparisons.length > 0 && (
      <section class="mt-16" aria-label="Featured comparisons">
        <h2 class="mb-6 text-center text-2xl font-bold text-slate-900 sm:text-left">
          Featured Comparisons
        </h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {featuredComparisons.map((comparison) => (
            <a
              href={`/${comparison.slug}`}
              class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-indigo-300 hover:shadow-md"
            >
              <span class="inline-flex w-fit items-center rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-slate-600">
                {comparison.niche_name}
              </span>
              <h3 class="mt-3 text-lg font-semibold text-slate-900 transition group-hover:text-indigo-600">
                {comparison.tool_a_name} vs {comparison.tool_b_name}
              </h3>
              <span class="mt-4 inline-flex items-center text-sm font-semibold text-indigo-600">
                View comparison
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="ml-1 h-4 w-4" aria-hidden="true">
                  <path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 0 1 .75-.75h8.5a.75.75 0 0 1 .75.75v5.75a.75.75 0 0 1-1.5 0V7.06l-7.47 7.47a.75.75 0 0 1-1.06-1.06L11.94 6H5.5a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd" />
                </svg>
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Category Breakdown -->
    <section class="mt-16" aria-label="What we cover">
      <h2 class="mb-6 text-center text-2xl font-bold text-slate-900 sm:text-left">
        What We Cover
      </h2>
      <div class="grid gap-6 sm:grid-cols-3">
        {categoryBreakdown.map((category) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
            <h3 class="text-lg font-semibold text-slate-900">{category.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">
              {category.description}
            </p>
          </div>
        ))}
      </div>
    </section>
  </main>
</Layout>
