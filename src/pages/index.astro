---
import Layout from '../layouts/Layout.astro';
import PainPointSearch from '../components/PainPointSearch.jsx';
import VendorLogo from '../components/VendorLogo.astro';
import { loadComparisons } from '../lib/comparisons';
import { comparisonHubSlug } from '../lib/comparison-routes';
import { getToolsByCategory, loadToolProfiles } from '../lib/tools';
import { ORGANIZATION_SAME_AS } from '../lib/organization';

const currentMonthYear = new Date().toLocaleDateString('en-US', {
  month: 'long',
  year: 'numeric',
}); // Produces "September 2026"
const currentYear = String(new Date().getFullYear());

const comparisons = loadComparisons();
const bySlug = new Map(comparisons.map((c) => [c.slug, c]));

function categoryStats(category: string): { tools: number; comparisons: number } {
  const ids = new Set(getToolsByCategory(category).map((tool) => tool.id));
  const hubs = new Set(
    comparisons
      .filter((row) => ids.has(row.tool_a_id) && ids.has(row.tool_b_id))
      .map((row) => comparisonHubSlug(row.tool_a_id, row.tool_b_id))
  );
  return {
    tools: ids.size,
    comparisons: hubs.size,
  };
}

const payrollStats = categoryStats('payroll-eor');
const atsStats = categoryStats('ats');
const pmStats = categoryStats('performance-management');

const categoryCards = [
  {
    title: 'Global Payroll & EOR',
    href: '/global-payroll-eor/',
    description: 'Deel, Rippling, Remote, Oyster HR, Gusto, Payoneer, and more, compared on compliance, global reach, and real pricing.',
    badge: `${payrollStats.tools} tools · ${payrollStats.comparisons} comparisons`,
    accent: 'from-indigo-500 to-violet-600',
    titleHover: 'transition-colors duration-200 text-gray-900 group-hover:text-indigo-600',
  },
  {
    title: 'Applicant Tracking Systems (ATS)',
    href: '/applicant-tracking-systems/',
    description: 'Ashby, Lever, Workable, JazzHR, and more, compared on structured hiring, sourcing, and pricing.',
    badge: `${atsStats.tools} tools · ${atsStats.comparisons} comparisons`,
    accent: 'from-emerald-500 to-teal-600',
    titleHover: 'transition-colors duration-200 text-gray-900 group-hover:text-teal-600',
  },
  {
    title: 'Performance Management',
    href: '/performance-management/',
    description: 'Lattice, PerformYard, and Culture Amp, compared on OKRs, reviews, engagement, and pricing.',
    badge: `${pmStats.tools} tools · ${pmStats.comparisons} comparisons`,
    accent: 'from-sky-500 to-cyan-600',
    titleHover: 'transition-colors duration-200 text-gray-900 group-hover:text-blue-500',
  },
];

// A curated mix of high-intent comparisons spanning all sub-verticals.
const featuredSlugs = [
  'deel-vs-remote',
  'ashby-vs-lever',
  'performyard-vs-lattice',
  'rippling-vs-gusto',
  'papaya-global-vs-multiplier',
  'breezy-hr-vs-bamboohr',
];

const featuredComparisons = featuredSlugs
  .map((slug) => {
    const comparison =
      bySlug.get(slug) ??
      comparisons.find((item) => comparisonHubSlug(item.tool_a_id, item.tool_b_id) === slug);
    return comparison ? { comparison, href: `/${slug}/` } : null;
  })
  .filter((entry): entry is NonNullable<typeof entry> => Boolean(entry));

function logoBadgeColor(name: string): string {
  const colors = [
    'bg-indigo-600',
    'bg-violet-600',
    'bg-sky-600',
    'bg-emerald-600',
    'bg-rose-600',
    'bg-amber-600',
    'bg-cyan-600',
    'bg-fuchsia-600',
  ];
  let hash = 0;
  for (let i = 0; i < name.length; i += 1) {
    hash = name.charCodeAt(i) + ((hash << 5) - hash);
  }
  return colors[Math.abs(hash) % colors.length];
}

const eeatPillars = [
  {
    icon: 'M2.5 10a7.5 7.5 0 1 1 15 0 7.5 7.5 0 0 1-15 0Zm8.03-4.03a.75.75 0 0 0-1.06 0l-3.5 3.5a.75.75 0 0 0 1.06 1.06L9.25 8.31v5.44a.75.75 0 0 0 1.5 0V8.31l2.22 2.22a.75.75 0 0 0 1.06-1.06l-3.5-3.5Z',
    title: 'Transparent Pricing & Hidden Fees',
    description:
      'We break down published plans, hidden currency conversion fees, and contract terms so you see the real total cost before signing.',
  },
  {
    icon: 'M10 1.75a.75.75 0 0 1 .3.063l6.25 2.708a.75.75 0 0 1 .45.688v3.958c0 4.706-3.087 8.13-6.634 9.463a.75.75 0 0 1-.532 0C6.287 17.296 3.2 13.872 3.2 9.167V5.209a.75.75 0 0 1 .45-.688L9.9 1.813a.75.75 0 0 1 .3-.063Z',
    title: 'Global Compliance Checks',
    description:
      'We verify local entity coverage, automated tax withholding, data privacy, and multi-country labor law support.',
  },
  {
    icon: 'M3.25 3A2.25 2.25 0 0 0 1 5.25v9.5A2.25 2.25 0 0 0 3.25 17h13.5A2.25 2.25 0 0 0 19 14.75v-9.5A2.25 2.25 0 0 0 16.75 3H3.25Zm.943 8.752a.75.75 0 0 1 .055-1.06L6.128 9l-1.88-1.693a.75.75 0 1 1 1.004-1.114l2.5 2.25a.75.75 0 0 1 0 1.114l-2.5 2.25a.75.75 0 0 1-1.06-.055ZM9.75 10.25a.75.75 0 0 0 0 1.5h2.5a.75.75 0 0 0 0-1.5h-2.5Z',
    title: 'Native Integrations & Tech Fit',
    description:
      'We check the API, HRIS sync, and whether data has to be re-keyed. If it lives in a CSV, it is not integrated.',
  },
  {
    icon: 'M3 3.75A.75.75 0 0 1 3.75 3h.5a.75.75 0 0 1 .75.75v12.5h11a.75.75 0 0 1 0 1.5H4.25A1.75 1.75 0 0 1 2.5 16V3.75c0-.414.336-.75.5-.75Zm4.25 10a.75.75 0 0 1 .75-.75h1a.75.75 0 0 1 .75.75v3a.75.75 0 0 1-.75.75h-1a.75.75 0 0 1-.75-.75v-3Zm4-4a.75.75 0 0 1 .75-.75h1a.75.75 0 0 1 .75.75v7a.75.75 0 0 1-.75.75h-1a.75.75 0 0 1-.75-.75v-7Zm4-3a.75.75 0 0 1 .75-.75h1a.75.75 0 0 1 .75.75v10a.75.75 0 0 1-.75.75h-1a.75.75 0 0 1-.75-.75v-10Z',
    title: 'Fit by Company Size',
    description:
      "We evaluate tools based on team size and growth stage, so early startups don't overpay for enterprise software.",
  },
];

const proofStats = [
  { value: '50+', label: 'Head-to-Head Comparisons' },
  { value: '19', label: 'Vetted HR Platforms' },
  { value: '100%', label: 'Independent Methodology' },
  { value: currentYear, label: 'Verified Pricing' },
];

const comparisonToolkit = [
  {
    title: 'Interactive Cost Calculator',
    body: 'Model total platform fees based on your exact EOR and contractor headcount.',
    border: 'border-t-indigo-600 hover:border-t-indigo-600',
    iconWrap: 'bg-indigo-50 text-indigo-600',
    icon: 'calculator',
  },
  {
    title: 'Persona-Based Verdicts',
    body: 'Filter verdicts specifically for Startups, Scaleups, Agencies, or LATAM teams.',
    border: 'border-t-violet-600 hover:border-t-violet-600',
    iconWrap: 'bg-violet-50 text-violet-600',
    icon: 'target',
  },
  {
    title: 'Hidden Fee Audits',
    body: 'Expose unlisted FX markups, deposit liabilities, and minimum seat terms.',
    border: 'border-t-amber-500 hover:border-t-amber-500',
    iconWrap: 'bg-amber-50 text-amber-600',
    icon: 'shield',
  },
  {
    title: '1-Click Demo Scripts',
    body: 'Copy CFO-vetted negotiation questions directly to your clipboard for sales calls.',
    border: 'border-t-emerald-600 hover:border-t-emerald-600',
    iconWrap: 'bg-emerald-50 text-emerald-600',
    icon: 'clipboard',
  },
];

// Lightweight search index for the hero search bar: every tool's display
// name + the sub-vertical hub it belongs to, plus every comparison's tool
// names + slug. Kept intentionally small (ids/names/slugs only) since it's
// embedded directly in the page and parsed client-side with no dependencies.
const toolProfiles = loadToolProfiles();
const nameById = new Map<string, string>();
for (const comparison of comparisons) {
  nameById.set(comparison.tool_a_id, comparison.tool_a_name);
  nameById.set(comparison.tool_b_id, comparison.tool_b_name);
}
const hubHrefByCategory: Record<string, string> = {
  'payroll-eor': '/global-payroll-eor/',
  ats: '/applicant-tracking-systems/',
  'performance-management': '/performance-management/',
};

const searchTools = Object.entries(toolProfiles).map(([id, profile]) => ({
  name: nameById.get(id) ?? id,
  href: (profile.category && hubHrefByCategory[profile.category]) || '/',
}));

const searchComparisons = (() => {
  const seen = new Set<string>();
  const unique: Array<{ slug: string; a: string; b: string }> = [];
  for (const comparison of comparisons) {
    const hubSlug = comparisonHubSlug(comparison.tool_a_id, comparison.tool_b_id);
    if (seen.has(hubSlug)) continue;
    seen.add(hubSlug);
    unique.push({
      slug: hubSlug,
      a: comparison.tool_a_name,
      b: comparison.tool_b_name,
    });
  }
  return unique;
})();

const searchData = JSON.stringify({ tools: searchTools, comparisons: searchComparisons });

const pageTitle = 'The HR Stack Guide | Interactive HR Software & EOR Cost Comparisons (2026)';
const pageHeading = 'Data-Driven HR Software Comparisons & Buyer Guides';
const pageDescription =
  'Compare B2B HR software, global EOR pricing, and payroll platform fees side-by-side. Use our interactive headcount cost calculator to model total vendor fees without demo call surprises.';

const homepageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://www.thehrstackguide.com/#website',
      url: 'https://www.thehrstackguide.com/',
      name: 'The HR Stack Guide',
      description: 'Programmatic HR Software Comparisons and Stack Guides',
    },
    {
      '@type': 'Organization',
      '@id': 'https://www.thehrstackguide.com/#organization',
      name: 'The HR Stack Guide',
      url: 'https://www.thehrstackguide.com/',
      logo: 'https://www.thehrstackguide.com/favicon.svg',
      sameAs: [...ORGANIZATION_SAME_AS],
    },
  ],
};
---

<Layout
  title={pageTitle}
  heading={pageHeading}
  description={pageDescription}
  includeOrganizationSchema={false}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(homepageSchema)} />

  <main class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
    <!-- Hero Section -->
    <section class="mx-auto max-w-3xl text-center">
      <span class="inline-flex items-center rounded-full border border-indigo-200 bg-indigo-50 px-3.5 py-1.5 text-sm font-semibold text-indigo-700">
        {currentMonthYear} Edition
      </span>
      <h1 class="mt-5 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
        {pageHeading}
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-slate-600">
        Independent breakdowns of real pricing, hidden implementation costs, and platform capabilities across Global Payroll, EOR, ATS, and Performance Management software.
      </p>
      <!-- Hero Search -->
      <div class="mx-auto mt-8 max-w-xl">
        <form id="hero-search-form" class="relative" role="search" aria-label="Search HR software and comparisons">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-400"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.452 4.391l3.328 3.329a.75.75 0 1 1-1.06 1.06l-3.329-3.328A7 7 0 0 1 2 9Z"
              clip-rule="evenodd"
            />
          </svg>
          <input
            id="hero-search-input"
            type="text"
            name="q"
            autocomplete="off"
            placeholder="Search software (e.g. Deel, Ashby) or comparison..."
            class="w-full rounded-2xl border border-slate-200 bg-white py-4 pl-12 pr-24 text-base text-slate-900 shadow-lg shadow-slate-200/60 outline-none transition placeholder:text-slate-400 focus:border-indigo-400 focus:ring-4 focus:ring-indigo-100"
          />
          <button
            type="submit"
            aria-label="Search"
            class="absolute right-2 top-1/2 -translate-y-1/2 inline-flex items-center justify-center rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700"
          >
            Search
          </button>
          <div
            id="hero-search-results"
            class="absolute inset-x-0 top-full z-20 mt-2 hidden max-h-80 overflow-y-auto rounded-2xl border border-slate-200 bg-white p-2 text-left shadow-xl"
            role="listbox"
          >
          </div>
        </form>
      </div>
    </section>

    <!-- Stats Proof Bar -->
    <section class="mt-10" aria-label="Site coverage statistics">
      <div class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-slate-200 bg-slate-200 sm:grid-cols-4">
        {proofStats.map((stat) => (
          <div class="bg-slate-50 px-4 py-5 text-center sm:px-6 sm:py-6">
            <p class="text-xl font-bold tracking-tight text-slate-900 sm:text-2xl">{stat.value}</p>
            <p class="mt-1 text-xs font-medium leading-snug text-slate-600 sm:text-sm">{stat.label}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Category Grid -->
    <section class="mt-16" aria-label="Browse by category">
      <h2 class="mb-6 text-center text-2xl font-bold text-slate-900 sm:text-left">
        Browse by Category
      </h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {categoryCards.map((category) => (
          <a
            href={category.href}
            class="group relative flex cursor-pointer flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white p-8 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg"
          >
            <div class:list={['absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r', category.accent]} aria-hidden="true"></div>
            <span class="inline-flex w-fit items-center rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-slate-600">
              {category.badge}
            </span>
            <h3 class:list={['mt-4 text-2xl font-bold', category.titleHover]}>
              {category.title}
            </h3>
            <p class="mt-3 text-base leading-relaxed text-slate-600">
              {category.description}
            </p>
            <span class="mt-6 inline-flex items-center text-sm font-semibold text-indigo-600">
              View all comparisons
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="ml-1 h-4 w-4" aria-hidden="true">
                <path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 0 1 .75-.75h8.5a.75.75 0 0 1 .75.75v5.75a.75.75 0 0 1-1.5 0V7.06l-7.47 7.47a.75.75 0 0 1-1.06-1.06L11.94 6H5.5a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- What You Get Inside Every Comparison -->
    <section class="mt-16" aria-label="What you get inside every comparison">
      <div class="text-center sm:text-left">
        <h2 class="text-2xl font-bold text-slate-900">What You Get Inside Every Comparison</h2>
        <p class="mt-2 text-base text-slate-500">
          Every 1-to-1 guide comes loaded with interactive financial tooling and procurement frameworks.
        </p>
      </div>
      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {comparisonToolkit.map((item) => (
          <article
            class:list={[
              'relative overflow-hidden rounded-2xl border border-t-2 border-gray-100 bg-white p-6 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:border-gray-300 hover:shadow-lg',
              item.border,
            ]}
          >
            <div class:list={['mb-4 flex h-12 w-12 items-center justify-center rounded-xl', item.iconWrap]}>
              {item.icon === 'calculator' && (
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                </svg>
              )}
              {item.icon === 'target' && (
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18a6 6 0 100-12 6 6 0 000 12z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14a2 2 0 100-4 2 2 0 000 4z" />
                </svg>
              )}
              {item.icon === 'shield' && (
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                </svg>
              )}
              {item.icon === 'clipboard' && (
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
                </svg>
              )}
            </div>
            <h3 class="mt-4 mb-2 text-lg font-bold text-gray-900">{item.title}</h3>
            <p class="text-sm leading-relaxed text-gray-600">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="my-12">
      <div class="mb-6 text-left">
        <h2 class="text-xl font-bold text-gray-900 sm:text-2xl">Why Buyers Use The HR Stack Guide</h2>
        <p class="text-sm text-gray-600 mt-1">Built to eliminate sales call surprises and hidden software fees.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="p-6 bg-white rounded-2xl border border-gray-200/80 shadow-xs flex flex-col justify-between">
          <div>
            <div class="text-blue-600 font-semibold mb-2 text-sm flex items-center gap-1.5">
              <span>⚡</span> Skip Demo Traps
            </div>
            <p class="text-xs text-gray-600 leading-relaxed">
              Model total platform fees and EOR costs instantly without sitting through a mandatory sales call.
            </p>
          </div>
        </div>

        <div class="p-6 bg-white rounded-2xl border border-gray-200/80 shadow-xs flex flex-col justify-between">
          <div>
            <div class="text-amber-600 font-semibold mb-2 text-sm flex items-center gap-1.5">
              <span>🔍</span> Expose Hidden Fees
            </div>
            <p class="text-xs text-gray-600 leading-relaxed">
              Uncover unlisted FX conversion markups, deposit requirements, and seat minimums before signing.
            </p>
          </div>
        </div>

        <div class="p-6 bg-white rounded-2xl border border-gray-200/80 shadow-xs flex flex-col justify-between">
          <div>
            <div class="text-emerald-600 font-semibold mb-2 text-sm flex items-center gap-1.5">
              <span>🛡️</span> 100% Unbiased
            </div>
            <p class="text-xs text-gray-600 leading-relaxed">
              Zero paid vendor placements. Rankings and matrices are calculated using independent operational data.
            </p>
          </div>
        </div>

        <div class="p-6 bg-white rounded-2xl border border-gray-200/80 shadow-xs flex flex-col justify-between">
          <div>
            <div class="text-purple-600 font-semibold mb-2 text-sm flex items-center gap-1.5">
              <span>🎯</span> Stage-Matched
            </div>
            <p class="text-xs text-gray-600 leading-relaxed">
              Get filtered verdicts based on your exact team size from 2 contractors to 250+ enterprise employees.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Calculator Hub Promo -->
    <section class="mt-16" aria-label="Standalone EOR cost calculator">
      <div class="relative overflow-hidden rounded-2xl border border-indigo-200 bg-indigo-50/70 p-6 shadow-sm sm:p-8">
        <div class="absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r from-indigo-500 to-violet-600" aria-hidden="true"></div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
          Try the Standalone Global EOR Cost Calculator
        </h2>
        <p class="mt-3 max-w-2xl text-base leading-relaxed text-slate-600">
          Compare pricing across Deel, Remote, Multiplier, Papaya, Gusto, and Payoneer in one dynamic view.
        </p>
        <a
          href="/tools/eor-cost-calculator/"
          class="mt-6 inline-flex items-center justify-center rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
        >
          Launch Calculator Tool →
        </a>
      </div>
    </section>

    <!-- Our Evaluation Methodology (E-E-A-T trust pillars) -->
    <section class="mt-16" aria-label="Our evaluation methodology">
      <div class="text-center sm:text-left">
        <h2 class="text-2xl font-bold text-slate-900">How We Build Independent HR Tech Guides</h2>
        <p class="mt-2 text-base text-slate-500">
          Our independent criteria for auditing pricing, global compliance, tech stack integrations, and stage alignment.
        </p>
        <div class="mt-4 mb-8 flex items-center gap-3 rounded-xl border border-blue-100 bg-blue-50/80 p-4 text-sm text-blue-950">
          <svg class="h-5 w-5 shrink-0 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span>
            <strong>Human-Verified Data:</strong> All platform fee baselines, FX markups, and module pricing are manually audited and fact-checked against official vendor documentation by our software operations team (Updated October 2026).
          </span>
        </div>
      </div>
      <div class="mt-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {eeatPillars.map((pillar) => (
          <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-6 w-6" aria-hidden="true">
                <path fill-rule="evenodd" d={pillar.icon} clip-rule="evenodd" />
              </svg>
            </div>
            <h3 class="mt-5 text-lg font-bold text-slate-900">{pillar.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{pillar.description}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- Popular Comparisons -->
    {featuredComparisons.length > 0 && (
      <section class="mt-16" aria-label="Popular comparisons">
        <h2 class="mb-6 text-center text-2xl font-bold text-slate-900 sm:text-left">
          Popular Comparisons
        </h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {featuredComparisons.map(({ comparison, href }) => (
            <a
              href={href}
              class="group flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-indigo-300 hover:shadow-md"
            >
              <div class="flex items-center gap-2.5">
                <VendorLogo
                  src={comparison.tool_a_logo_url}
                  alt={`${comparison.tool_a_name} logo`}
                  name={comparison.tool_a_name}
                  badgeColor={logoBadgeColor(comparison.tool_a_name)}
                  size={36}
                />
                <span class="text-xs font-semibold uppercase tracking-wide text-slate-400">vs</span>
                <VendorLogo
                  src={comparison.tool_b_logo_url}
                  alt={`${comparison.tool_b_name} logo`}
                  name={comparison.tool_b_name}
                  badgeColor={logoBadgeColor(comparison.tool_b_name)}
                  size={36}
                />
              </div>
              <h3 class="mt-4 text-lg font-semibold text-slate-900 transition group-hover:text-indigo-600">
                {comparison.tool_a_name} vs {comparison.tool_b_name}
              </h3>
              <span class="mt-4 inline-flex items-center text-sm font-semibold text-indigo-600">
                View comparison
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="ml-1 h-4 w-4" aria-hidden="true">
                  <path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 0 1 .75-.75h8.5a.75.75 0 0 1 .75.75v5.75a.75.75 0 0 1-1.5 0V7.06l-7.47 7.47a.75.75 0 0 1-1.06-1.06L11.94 6H5.5a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd" />
                </svg>
              </span>
              <div class="mt-auto flex flex-wrap gap-1.5 pt-4">
                <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2 py-0.5 text-[11px] font-medium text-slate-500">
                  ⚡ Live Calculator
                </span>
                <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2 py-0.5 text-[11px] font-medium text-slate-500">
                  🎁 Free Scorecard
                </span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </main>

  <script type="application/json" id="hero-search-data" set:html={searchData} />

  <script>
    function escapeHtml(value: string): string {
      const entities: Record<string, string> = {
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;',
      };
      return value.replace(/[&<>"']/g, (char) => entities[char] ?? char);
    }

    interface SearchTool {
      name: string;
      href: string;
    }
    interface SearchComparison {
      slug: string;
      a: string;
      b: string;
    }
    interface SearchData {
      tools: SearchTool[];
      comparisons: SearchComparison[];
    }

    function initHeroSearch() {
      const dataEl = document.getElementById('hero-search-data');
      const input = document.getElementById('hero-search-input') as HTMLInputElement | null;
      const results = document.getElementById('hero-search-results');
      const form = document.getElementById('hero-search-form') as HTMLFormElement | null;
      if (!dataEl?.textContent || !input || !results || !form) return;

      let data: SearchData;
      try {
        data = JSON.parse(dataEl.textContent) as SearchData;
      } catch {
        return;
      }

      function findMatches(query: string) {
        const q = query.trim().toLowerCase();
        if (!q) return { tools: [] as SearchTool[], comparisons: [] as SearchComparison[], exactTool: null as SearchTool | null };

        const exactTool = data.tools.find((tool) => tool.name.toLowerCase() === q) ?? null;
        const tools = data.tools.filter((tool) => tool.name.toLowerCase().includes(q)).slice(0, 4);
        const comparisons = data.comparisons
          .filter((c) => c.a.toLowerCase().includes(q) || c.b.toLowerCase().includes(q))
          .slice(0, 5);

        return { tools, comparisons, exactTool };
      }

      function render(query: string) {
        if (!results) return;
        const { tools, comparisons } = findMatches(query);

        if (!tools.length && !comparisons.length) {
          results.classList.add('hidden');
          results.innerHTML = '';
          return;
        }

        let html = '';
        if (tools.length) {
          html += '<p class="px-3 pt-2 pb-1 text-xs font-semibold uppercase tracking-wide text-slate-400">Software</p>';
          html += tools
            .map(
              (tool) =>
                `<a href="${tool.href}" class="flex items-center justify-between rounded-lg px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-indigo-50 hover:text-indigo-700"><span>${escapeHtml(tool.name)}</span><span class="text-xs text-slate-400">View category</span></a>`
            )
            .join('');
        }
        if (comparisons.length) {
          html += '<p class="px-3 pt-3 pb-1 text-xs font-semibold uppercase tracking-wide text-slate-400">Comparisons</p>';
          html += comparisons
            .map(
              (c) =>
                `<a href="/${c.slug}/" class="flex items-center justify-between rounded-lg px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-indigo-50 hover:text-indigo-700"><span>${escapeHtml(c.a)} vs ${escapeHtml(c.b)}</span></a>`
            )
            .join('');
        }

        results.innerHTML = html;
        results.classList.remove('hidden');
      }

      let debounceTimer = 0;
      input.addEventListener('input', () => {
        window.clearTimeout(debounceTimer);
        debounceTimer = window.setTimeout(() => render(input.value), 120);
      });
      input.addEventListener('focus', () => {
        if (input.value) render(input.value);
      });
      document.addEventListener('click', (event) => {
        if (!form.contains(event.target as Node)) {
          results?.classList.add('hidden');
        }
      });

      // Supports the WebSite/SearchAction structured data: when a visitor
      // arrives via a Google Sitelinks Searchbox (e.g. "/?q=deel"), prefill
      // and run the search immediately instead of landing on an empty box.
      const initialQuery = new URLSearchParams(window.location.search).get('q');
      if (initialQuery) {
        input.value = initialQuery;
        render(initialQuery);
      }

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const query = input.value.trim();
        if (!query) return;

        const { tools, comparisons, exactTool } = findMatches(query);
        if (exactTool) {
          window.location.href = exactTool.href;
        } else if (comparisons.length) {
          window.location.href = `/${comparisons[0].slug}/`;
        } else if (tools.length) {
          window.location.href = tools[0].href;
        }
      });
    }

    if (typeof window !== 'undefined' && typeof document !== 'undefined') {
      initHeroSearch();
    }
  </script>
</Layout>
