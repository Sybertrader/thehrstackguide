---
import Layout from '../../layouts/Layout.astro';
import { loadComparisons } from '../../lib/comparisons';
import type { Comparison } from '../../lib/comparisons';
import { getToolsByCategory } from '../../lib/tools';

const CATEGORY = 'payroll-eor';

const allComparisons = loadComparisons();
const toolProfiles = getToolsByCategory(CATEGORY);
const toolIds = new Set(toolProfiles.map((tool) => tool.id));

// Comparisons "belong" to this sub-vertical when both tools in the pairing
// are tagged with this category in src/data/tools.json, so this hub stays in
// sync automatically as tools.json gains a category tag rather than needing
// a hardcoded id list here.
const categoryComparisons = allComparisons.filter(
  (comparison) => toolIds.has(comparison.tool_a_id) && toolIds.has(comparison.tool_b_id)
);

// Look up display name + logo from the comparisons data source itself (the
// richer tool_a_name/tool_a_logo_url fields aren't duplicated in tools.json),
// so the tool roster below can show a name and logo for every tool profile.
const nameById = new Map<string, string>();
const logoById = new Map<string, string>();
for (const comparison of allComparisons) {
  nameById.set(comparison.tool_a_id, comparison.tool_a_name);
  nameById.set(comparison.tool_b_id, comparison.tool_b_name);
  logoById.set(comparison.tool_a_id, comparison.tool_a_logo_url);
  logoById.set(comparison.tool_b_id, comparison.tool_b_logo_url);
}

const toolRoster = toolProfiles
  .map((profile) => ({
    ...profile,
    name: nameById.get(profile.id) ?? profile.id,
    logo: logoById.get(profile.id) ?? null,
  }))
  .sort((a, b) => parseFloat(b.rating ?? '0') - parseFloat(a.rating ?? '0'));

interface NicheGroup {
  nicheId: string;
  nicheName: string;
  comparisons: Comparison[];
}

const nicheGroups: NicheGroup[] = [];
const nicheGroupById = new Map<string, NicheGroup>();
for (const comparison of categoryComparisons) {
  let group = nicheGroupById.get(comparison.niche_id);
  if (!group) {
    group = { nicheId: comparison.niche_id, nicheName: comparison.niche_name, comparisons: [] };
    nicheGroupById.set(comparison.niche_id, group);
    nicheGroups.push(group);
  }
  group.comparisons.push(comparison);
}

function logoBadgeColor(name: string): string {
  const colors = ['bg-indigo-600', 'bg-violet-600', 'bg-sky-600', 'bg-emerald-600', 'bg-rose-600', 'bg-amber-600', 'bg-cyan-600', 'bg-fuchsia-600'];
  let hash = 0;
  for (let i = 0; i < name.length; i += 1) {
    hash = name.charCodeAt(i) + ((hash << 5) - hash);
  }
  return colors[Math.abs(hash) % colors.length];
}
---

<Layout
  title="Global Payroll & EOR Software Comparisons (2026) — The HR Stack Guide"
  description="Compare the leading Global Payroll and Employer of Record (EOR) platforms, including Deel, Rippling, Remote, Oyster, and Gusto, on compliance, global reach, and real pricing."
>
  <main class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <!-- Hero -->
    <header class="mb-12">
      <nav aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-2 text-sm text-slate-500">
          <li><a href="/" class="transition hover:text-indigo-600">Home</a></li>
          <li aria-hidden="true" class="text-slate-300">&gt;</li>
          <li class="font-medium text-indigo-600" aria-current="page">Global Payroll &amp; EOR</li>
        </ol>
      </nav>

      <span class="mt-4 inline-flex items-center rounded-full border border-indigo-200 bg-indigo-50 px-3.5 py-1.5 text-sm font-semibold text-indigo-700">
        {toolRoster.length} Platforms Evaluated · {categoryComparisons.length} Comparisons
      </span>

      <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
        Global Payroll &amp; EOR Software Comparisons
      </h1>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed text-slate-600">
        Independent, data-driven comparisons of the platforms modern companies use to hire, pay, and stay compliant with employees and contractors across 150+ countries. Every rating, price, and compliance claim below is sourced from our 2026 evaluation.
      </p>
    </header>

    <!-- Tool Roster -->
    <section class="mb-16" aria-label="Global Payroll & EOR tool roster">
      <h2 class="mb-6 text-2xl font-bold text-slate-900">The 2026 Platform Roster</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {toolRoster.map((tool) => (
          <article class="flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:shadow-md">
            <div class="flex items-center gap-3">
              <div class="relative inline-flex h-10 w-10 shrink-0">
                {tool.logo && (
                  <img
                    src={tool.logo}
                    alt={`${tool.name} logo`}
                    class="h-10 w-10 rounded-lg border border-slate-200 bg-slate-100 object-contain p-1"
                    loading="lazy"
                    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                  />
                )}
                <div
                  class:list={[
                    tool.logo ? 'hidden' : 'flex',
                    'h-10 w-10 items-center justify-center rounded-lg text-sm font-bold uppercase text-white',
                    logoBadgeColor(tool.name),
                  ]}
                  aria-hidden="true"
                >
                  {tool.name.charAt(0)}
                </div>
              </div>
              <div>
                <h3 class="text-lg font-bold text-slate-900">{tool.name}</h3>
                {tool.rating && (
                  <p class="text-sm font-medium text-slate-500">
                    ⭐️ {tool.rating}/5{tool.review_count && ` (${tool.review_count}+)`}
                  </p>
                )}
              </div>
            </div>
            <p class="mt-4 text-sm leading-relaxed text-slate-600">{tool.positioning}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- Comparison Directory -->
    <section aria-label="Comparison directory">
      <h2 class="mb-2 text-2xl font-bold text-slate-900">Browse All Comparisons</h2>
      <p class="mb-8 max-w-3xl text-sm text-slate-500">
        {categoryComparisons.length} head-to-head comparisons across {nicheGroups.length} audience-specific use cases, organized below by team type.
      </p>

      <div class="space-y-10">
        {nicheGroups.map((group) => (
          <div>
            <h3 class="mb-4 text-lg font-bold text-slate-900">{group.nicheName}</h3>
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {group.comparisons.map((comparison) => (
                <a
                  href={`/${comparison.slug}`}
                  class="group flex items-center justify-between gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3.5 text-sm shadow-sm transition hover:-translate-y-0.5 hover:border-indigo-300 hover:shadow-md"
                >
                  <span class="font-semibold text-slate-800 transition group-hover:text-indigo-600">
                    {comparison.tool_a_name} vs {comparison.tool_b_name}
                  </span>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 shrink-0 text-slate-400 transition group-hover:text-indigo-600" aria-hidden="true">
                    <path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 0 1 .75-.75h8.5a.75.75 0 0 1 .75.75v5.75a.75.75 0 0 1-1.5 0V7.06l-7.47 7.47a.75.75 0 0 1-1.06-1.06L11.94 6H5.5a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd" />
                  </svg>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>
</Layout>
