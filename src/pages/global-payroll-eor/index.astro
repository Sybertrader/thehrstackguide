---
import Layout from '../../layouts/Layout.astro';
import ConciergeLeadBox from '../../components/ConciergeLeadBox.astro';
import { loadComparisons } from '../../lib/comparisons';
import type { Comparison } from '../../lib/comparisons';
import { getToolsByCategory } from '../../lib/tools';

const currentMonthYear = new Date().toLocaleDateString('en-US', {
  month: 'long',
  year: 'numeric',
}); // Produces "September 2026"

const CATEGORY = 'payroll-eor';

const allComparisons = loadComparisons();
const toolProfiles = getToolsByCategory(CATEGORY);
const toolIds = new Set(toolProfiles.map((tool) => tool.id));

// Comparisons "belong" to this sub-vertical when both tools in the pairing
// are tagged with this category in src/data/tools.json, so this hub stays in
// sync automatically as tools.json gains a category tag rather than needing
// a hardcoded id list here.
const categoryComparisons = allComparisons.filter(
  (comparison) => toolIds.has(comparison.tool_a_id) && toolIds.has(comparison.tool_b_id)
);

// Look up display name, logo, and the high-signal "best fit" badge from the
// comparisons data source itself (those richer fields aren't duplicated in
// tools.json). Reading the badge from here rather than a map maintained on this
// page means a vendor's sub-niche tag is authored once, in
// generate_comparisons.py, and reads identically on the roster below and on
// every comparison page it appears in.
const nameById = new Map<string, string>();
const logoById = new Map<string, string>();
const badgeById = new Map<string, string>();
for (const comparison of allComparisons) {
  nameById.set(comparison.tool_a_id, comparison.tool_a_name);
  nameById.set(comparison.tool_b_id, comparison.tool_b_name);
  logoById.set(comparison.tool_a_id, comparison.tool_a_logo_url);
  logoById.set(comparison.tool_b_id, comparison.tool_b_logo_url);
  badgeById.set(comparison.tool_a_id, comparison.tool_a_badge);
  badgeById.set(comparison.tool_b_id, comparison.tool_b_badge);
}

const toolRoster = toolProfiles
  .map((profile) => ({
    ...profile,
    name: nameById.get(profile.id) ?? profile.id,
    logo: logoById.get(profile.id) ?? null,
    bestFor: badgeById.get(profile.id) ?? null,
  }))
  .sort((a, b) => parseFloat(b.rating ?? '0') - parseFloat(a.rating ?? '0'));

interface NicheGroup {
  nicheId: string;
  nicheName: string;
  comparisons: Comparison[];
}

const nicheGroups: NicheGroup[] = [];
const nicheGroupById = new Map<string, NicheGroup>();
for (const comparison of categoryComparisons) {
  let group = nicheGroupById.get(comparison.niche_id);
  if (!group) {
    group = { nicheId: comparison.niche_id, nicheName: comparison.niche_name, comparisons: [] };
    nicheGroupById.set(comparison.niche_id, group);
    nicheGroups.push(group);
  }
  group.comparisons.push(comparison);
}

// Tab order + short labels are curated for readability (e.g. "US & LATAM"
// instead of the longer on-page niche name), but the tab list itself is
// still derived from the real niche groups above, so a tab silently drops
// out (rather than pointing at an empty result set) if that niche's
// comparisons ever disappear from comparisons.csv.
const tabLabelOverrides: Record<string, string> = {
  'tech-startups': 'Startups',
  scaleups: 'Scaleups',
  agencies: 'Agencies',
  'us-latam': 'US & LATAM',
  'web3-crypto': 'Web3 & Crypto',
};
const tabOrder = ['tech-startups', 'scaleups', 'agencies', 'us-latam', 'web3-crypto'];

interface TabDef {
  id: string;
  label: string;
}

const tabs: TabDef[] = tabOrder
  .map((id) => nicheGroupById.get(id))
  .filter((group): group is NicheGroup => Boolean(group))
  .map((group) => ({ id: group.nicheId, label: tabLabelOverrides[group.nicheId] ?? group.nicheName }));

// No "All Use Cases" tab: only one niche's comparisons are ever visible at
// once (server-rendered this way too, not just after JS runs), so neither
// users nor crawlers see every comparison as a single wall of text.
const defaultTabId = tabs[0]?.id ?? null;

// Every niche holds the same number of pairings (one per tool combination),
// so the first group's size is the "comparisons per use case" count shown in
// the directory intro — derived rather than hardcoded so it stays correct as
// vendors are added to this category.
const comparisonsPerNiche = nicheGroups[0]?.comparisons.length ?? 0;

const buyerGuide = [
  {
    title: 'Direct Infrastructure vs. Partner Agencies',
    description:
      'Some providers (Deel, Remote) own their legal entities in every market; others lease coverage through a network of local partner agencies to reach more countries faster. Owned infrastructure typically means faster onboarding and more direct compliance liability, while partner networks can unlock niche markets an owned-entity provider hasn\u2019t built out yet. Ask any vendor for a country-by-country breakdown of owned vs. partnered entities before you sign.',
  },
  {
    title: 'Total Cost & Hidden FX Spreads',
    description:
      'The advertised per-employee fee is rarely the full story. Foreign exchange spreads (commonly 1\u20131.5% on every payout), mandatory security deposits, and benefit administration add-ons can add 15\u201330% to your effective cost. Always request an all-in quote for your specific headcount and countries, not just the homepage sticker price.',
  },
  {
    title: 'Statutory Compliance Guarantees',
    description:
      'Misclassification and non-compliant terminations carry real legal and financial risk. Look for explicit guarantees, such as misclassification insurance and indemnification clauses, rather than vague "we handle compliance" language on a pricing page, and confirm how the vendor keeps contracts current with changing local labor law.',
  },
];

function logoBadgeColor(name: string): string {
  const colors = ['bg-indigo-600', 'bg-violet-600', 'bg-sky-600', 'bg-emerald-600', 'bg-rose-600', 'bg-amber-600', 'bg-cyan-600', 'bg-fuchsia-600'];
  let hash = 0;
  for (let i = 0; i < name.length; i += 1) {
    hash = name.charCodeAt(i) + ((hash << 5) - hash);
  }
  return colors[Math.abs(hash) % colors.length];
}

function formatReviewCount(count: string): string {
  const trimmed = count.trim();
  return trimmed.endsWith('+') ? trimmed : `${trimmed}+`;
}

function parseReviewCount(value?: string): number | null {
  if (!value) return null;
  const parsed = parseInt(value.replace(/[^0-9]/g, ''), 10);
  return Number.isNaN(parsed) ? null : parsed;
}

const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const siteRootUrl = new URL('/', Astro.site ?? Astro.url.origin).href;

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Global Payroll & EOR Software Comparisons',
  description:
    'Independent, data-driven comparisons of the leading Global Payroll and Employer of Record (EOR) platforms on compliance, global reach, and real pricing.',
  url: pageUrl,
  isPartOf: {
    '@type': 'WebSite',
    name: 'The HR Stack Guide',
    url: siteRootUrl,
  },
  about: {
    '@type': 'Thing',
    name: 'Global Payroll & Employer of Record (EOR) Software',
  },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: toolRoster.length,
    itemListElement: toolRoster.map((tool, index) => {
      const reviewCount = parseReviewCount(tool.review_count);
      return {
        '@type': 'ListItem',
        position: index + 1,
        item: {
          '@type': 'SoftwareApplication',
          name: tool.name,
          applicationCategory: 'BusinessApplication',
          operatingSystem: 'Web-based',
          description: tool.positioning,
          offers: {
            '@type': 'Offer',
            price: '0',
            priceCurrency: 'USD',
            description: 'Contact for custom enterprise pricing / Free demo',
          },
          aggregateRating: {
            '@type': 'AggregateRating',
            ratingValue: tool.rating || '4.7',
            reviewCount: String(reviewCount ?? '100'),
          },
        },
      };
    }),
  },
};
---

<Layout
  title={`Best Global Payroll & EOR Tools (${currentMonthYear}) | The HR Stack Guide`}
  description={`Independent ${currentMonthYear} global payroll and EOR software comparisons. Compare Deel, Rippling, Remote, Gusto, and more on real pricing, fees, and compliance.`}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />

  <main class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <!-- Hero -->
    <header class="mb-12">
      <nav aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-2 text-sm text-slate-500">
          <li><a href="/" class="transition hover:text-indigo-600">Home</a></li>
          <li aria-hidden="true" class="text-slate-300">&gt;</li>
          <li class="font-medium text-indigo-600" aria-current="page">Global Payroll &amp; EOR</li>
        </ol>
      </nav>

      <span class="mt-4 inline-flex items-center rounded-full border border-indigo-200 bg-indigo-50 px-3.5 py-1.5 text-sm font-semibold text-indigo-700">
        {toolRoster.length} Platforms Evaluated · {categoryComparisons.length} Comparisons
      </span>

      <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
        Global Payroll &amp; EOR Software Comparisons
      </h1>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed text-slate-600">
        Independent, data-driven comparisons of the platforms modern companies use to hire, pay, and stay compliant with employees and contractors across 150+ countries. Every rating, price, and compliance claim below is sourced from our {currentMonthYear} evaluation.
      </p>
    </header>

    <!-- Tool Roster -->
    <section class="mb-16" aria-label="Global Payroll & EOR tool roster">
      <h2 class="mb-6 text-2xl font-bold text-slate-900">The {currentMonthYear} Platform Roster</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {toolRoster.map((tool) => (
          <article class="flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:shadow-md">
            {tool.bestFor && (
              <span class="mb-3 inline-flex max-w-full items-center gap-1.5 rounded-full bg-amber-50 px-2.5 py-1 text-left text-[11px] font-semibold uppercase leading-snug tracking-wide text-amber-700">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-3 w-3" aria-hidden="true">
                  <path d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.454 1.405 1.02L10 15.591l4.069 2.485c.713.434 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401Z" />
                </svg>
                {tool.bestFor}
              </span>
            )}
            <div class="flex items-center gap-3">
              <div class="relative inline-flex h-10 w-10 shrink-0">
                {tool.logo && (
                  <img
                    src={tool.logo}
                    alt={`${tool.name} logo`}
                    class="h-10 w-10 rounded-lg bg-slate-100 object-contain aspect-square"
                    width="40"
              height="40"
              decoding="async"
              loading="lazy"
                    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                  />
                )}
                <div
                  class:list={[
                    tool.logo ? 'hidden' : 'flex',
                    'h-10 w-10 items-center justify-center rounded-lg text-sm font-bold uppercase text-white',
                    logoBadgeColor(tool.name),
                  ]}
                  aria-hidden="true"
                >
                  {tool.name.charAt(0)}
                </div>
              </div>
              <div>
                <h3 class="text-lg font-bold text-slate-900">{tool.name}</h3>
                {tool.rating && (
                  <p class="text-sm font-medium text-slate-500">
                    ⭐️ {tool.rating}/5{tool.review_count && ` (${formatReviewCount(tool.review_count)})`}
                  </p>
                )}
              </div>
            </div>
            <p class="mt-4 text-sm leading-relaxed text-slate-600">{tool.positioning}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- Category Buyer's Guide -->
    <section class="mb-16" aria-label="How to evaluate Global Payroll & EOR platforms">
      <h2 class="mb-2 text-2xl font-bold text-slate-900">How to Evaluate Global Payroll &amp; EOR Platforms in {currentMonthYear}</h2>
      <p class="mb-8 max-w-3xl text-base leading-relaxed text-slate-600">
        Every EOR and global payroll vendor claims "full compliance" and "transparent pricing." Here's what actually separates them once you get past the marketing page.
      </p>
      <div class="grid gap-6 sm:grid-cols-3">
        {buyerGuide.map((item, index) => (
          <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-50 text-sm font-bold text-indigo-600">
              {index + 1}
            </span>
            <h3 class="mt-4 text-lg font-bold text-slate-900">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{item.description}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- Comparison Directory -->
    <section aria-label="Comparison directory">
      <h2 class="mb-2 text-2xl font-bold text-slate-900">Browse All Comparisons</h2>
      <p class="mb-6 max-w-3xl text-sm text-slate-500">
        {categoryComparisons.length} head-to-head comparisons across {nicheGroups.length} audience-specific use cases. Filter by team type to jump straight to the {comparisonsPerNiche} comparisons built for your situation.
      </p>

      <div class="mb-8 flex flex-wrap gap-2" role="tablist" aria-label="Filter comparisons by use case">
        {tabs.map((tab, index) => (
          <button
            type="button"
            role="tab"
            id={`eor-tab-${tab.id}`}
            data-niche-tab={tab.id}
            aria-selected={index === 0 ? 'true' : 'false'}
            class:list={[
              'inline-flex items-center rounded-full border px-4 py-2 text-sm font-semibold transition',
              index === 0
                ? 'border-indigo-600 bg-indigo-600 text-white shadow-sm'
                : 'border-slate-200 bg-white text-slate-600 hover:border-indigo-300 hover:text-indigo-700',
            ]}
          >
            {tab.label}
          </button>
        ))}
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" id="eor-comparison-grid">
        {categoryComparisons.map((comparison) => (
          <a
            href={`/${comparison.slug}`}
            data-niche={comparison.niche_id}
            class:list={[
              'comparison-card group flex flex-col gap-2 rounded-xl border border-slate-200 bg-white px-4 py-3.5 text-sm shadow-sm transition duration-150 hover:-translate-y-0.5 hover:border-indigo-300 hover:shadow-md',
              comparison.niche_id === defaultTabId ? '' : 'hidden opacity-0',
            ]}
          >
            <span class="inline-flex w-fit items-center rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-slate-500">
              {comparison.niche_name}
            </span>
            <span class="flex items-center justify-between gap-3">
              <span class="font-semibold text-slate-800 transition group-hover:text-indigo-600">
                {comparison.tool_a_name} vs {comparison.tool_b_name}
              </span>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 shrink-0 text-slate-400 transition group-hover:text-indigo-600" aria-hidden="true">
                <path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 0 1 .75-.75h8.5a.75.75 0 0 1 .75.75v5.75a.75.75 0 0 1-1.5 0V7.06l-7.47 7.47a.75.75 0 0 1-1.06-1.06L11.94 6H5.5a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd" />
              </svg>
            </span>
          </a>
        ))}
      </div>

      <p id="eor-comparison-empty-state" class="hidden mt-10 text-center text-sm text-slate-500">
        No comparisons found for this use case yet.
      </p>
    </section>

    <ConciergeLeadBox categoryName="Global Payroll & EOR" theme="indigo" ctaHref="/recommendation/?category=payroll" />
  </main>

  <script>
    function initNicheFilter() {
      const ACTIVE_CLASSES = ['border-indigo-600', 'bg-indigo-600', 'text-white', 'shadow-sm'];
      const INACTIVE_CLASSES = ['border-slate-200', 'bg-white', 'text-slate-600', 'hover:border-indigo-300', 'hover:text-indigo-700'];

      const tabButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-niche-tab]'));
      const cards = Array.from(document.querySelectorAll<HTMLAnchorElement>('.comparison-card'));
      const emptyState = document.getElementById('eor-comparison-empty-state');
      if (!tabButtons.length || !cards.length) return;

      function showCard(card: HTMLElement) {
        // Avoid forced reflow (offsetWidth) — class toggles alone are enough for INP.
        card.classList.remove('hidden', 'opacity-0');
      }

      function hideCard(card: HTMLElement) {
        card.classList.add('hidden', 'opacity-0');
      }

      function applyFilter(nicheId: string) {
        let visibleCount = 0;
        for (const card of cards) {
          const matches = card.dataset.niche === nicheId;
          if (matches) {
            visibleCount += 1;
            showCard(card);
          } else {
            hideCard(card);
          }
        }
        emptyState?.classList.toggle('hidden', visibleCount > 0);
      }

      for (const button of tabButtons) {
        button.addEventListener('click', () => {
          const nicheId = button.dataset.nicheTab;
          if (!nicheId) return;

          for (const btn of tabButtons) {
            const isActive = btn === button;
            btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
            btn.classList.remove(...ACTIVE_CLASSES, ...INACTIVE_CLASSES);
            btn.classList.add(...(isActive ? ACTIVE_CLASSES : INACTIVE_CLASSES));
          }

          // Defer DOM filter work to the next frame so the tab paint stays responsive (INP).
          requestAnimationFrame(() => applyFilter(nicheId));
        });
      }
    }

    if (typeof window !== 'undefined' && typeof document !== 'undefined') {
      initNicheFilter();
    }
  </script>
</Layout>
