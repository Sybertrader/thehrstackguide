---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Thank you — The HR Stack Guide"
  description="Your request was received. A specialist will follow up with pricing and onboarding details."
  robots="noindex, nofollow"
>
  <main class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
    <p class="text-sm font-semibold uppercase tracking-wide text-indigo-700">Request received</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
      Thank you
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-slate-600">
      We received your inquiry and will follow up with pricing and onboarding details. You can close this tab
      or keep comparing platforms in the meantime.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex items-center justify-center rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700"
    >
      Back to comparisons
    </a>
  </main>
</Layout>
