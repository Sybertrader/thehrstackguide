---
import Layout from '../layouts/Layout.astro';

const lastUpdated = 'September 2026';
const pageTitle = 'Privacy Policy — The HR Stack Guide';
const pageHeading = 'Privacy Policy';
const pageDescription =
  'This Privacy Policy explains how Stack Guide Media handles information when you visit The HR Stack Guide. By using the Site, you agree to the minimal collection and use of information described in this policy.';
---

<Layout
  title={pageTitle}
  heading={pageHeading}
  description={pageDescription}
>
  <main class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <header class="mb-10">
      <nav aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 text-sm text-slate-500">
          <li><a href="/" class="transition hover:text-indigo-600">Home</a></li>
          <li aria-hidden="true" class="text-slate-300">&gt;</li>
          <li class="font-medium text-indigo-600" aria-current="page">Privacy Policy</li>
        </ol>
      </nav>
      <h1 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        {pageHeading}
      </h1>
      <p class="mt-3 text-sm font-medium text-slate-500">Last updated: {lastUpdated}</p>
    </header>

    <article class="space-y-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
      <section>
        <p class="text-base leading-relaxed text-slate-700">
          This Privacy Policy explains how Stack Guide Media ("we," "us," or "our") handles information when
          you visit The HR Stack Guide (the "Site"). By using the Site, you agree to the minimal collection
          and use of information described in this policy.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-slate-900">Information We Collect</h2>
        <p class="mt-2 text-base leading-relaxed text-slate-700">
          You do not need to create an account, log in, or submit personal information to browse the Site. We
          collect limited technical data automatically:
        </p>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-base leading-relaxed text-slate-700">
          <li>
            <strong>Privacy-Friendly Analytics:</strong> We use Vercel Web Analytics to track aggregate site
            performance (such as page views and outbound link clicks). This system is designed to operate
            without persistent tracking cookies or cross-site profiling.
          </li>
          <li>
            <strong>Server Logs:</strong> Standard web server logs (including IP addresses, browser types, and
            referring pages) are processed by our hosting provider strictly for performance monitoring,
            security diagnostics, and DDoS protection.
          </li>
        </ul>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-slate-900">How We Use Information</h2>
        <p class="mt-2 text-base leading-relaxed text-slate-700">
          We use aggregate usage data to diagnose technical issues, optimize site navigation, and measure
          outbound traffic to vendor websites (including outbound affiliate links described in our
          <a href="/affiliate-disclosure/" class="font-medium text-indigo-600 hover:underline">Affiliate Disclosure</a>).
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-slate-900">Third-Party Links &amp; Vendor Sites</h2>
        <p class="mt-2 text-base leading-relaxed text-slate-700">
          The Site contains links to third-party software vendors, some of which are affiliate links. We do not
          control and are not responsible for the privacy policies or practices of external vendor websites. We
          encourage you to read the privacy notice of any vendor platform you visit.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-slate-900">Cookies</h2>
        <p class="mt-2 text-base leading-relaxed text-slate-700">
          The Site relies on minimal functional cookies necessary for fundamental web performance. We do not
          run invasive cross-site ad-targeting pixels or third-party tracking cookies.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-slate-900">Your Data Rights</h2>
        <p class="mt-2 text-base leading-relaxed text-slate-700">
          Under applicable privacy laws (including GDPR and CCPA), you have the right to request access to,
          correction of, or deletion of any personal data we hold. Because we do not store user accounts or
          personal profiles, our data footprint is minimal. Contact us at
          <a href="mailto:dave@thehrstackguide.com" class="font-medium text-indigo-600 hover:underline">dave@thehrstackguide.com</a>
          for any privacy-related requests.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-slate-900">Children's Privacy</h2>
        <p class="mt-2 text-base leading-relaxed text-slate-700">
          The Site is intended exclusively for a professional business audience and is not directed at children
          under 16.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-slate-900">Changes &amp; Contact Information</h2>
        <p class="mt-2 text-base leading-relaxed text-slate-700">
          We may update this policy periodically to reflect operational or legal updates. Questions regarding
          this policy can be directed to
          <a href="mailto:dave@thehrstackguide.com" class="font-medium text-indigo-600 hover:underline">dave@thehrstackguide.com</a>.
        </p>
      </section>
    </article>
  </main>
</Layout>
