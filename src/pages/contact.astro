---
import Layout from '../layouts/Layout.astro';

const lastUpdated = 'September 2026';
const contactEmail = 'dave@thehrstackguide.com';
const pageTitle = 'Contact — The HR Stack Guide';
const pageHeading = 'Contact Us';
const pageDescription =
  'Get in touch with Stack Guide Media, the publisher of The HR Stack Guide. Reach us about pricing corrections, vendor data accuracy, editorial questions, or partnership enquiries.';

const enquiries = [
  {
    title: 'Corrections & Data Accuracy',
    body: 'Found a price, feature, or country-coverage claim that is out of date? Tell us which comparison page and which specific claim, and we will verify it against primary vendor documentation and update or retract it.',
  },
  {
    title: 'Vendors & Product Teams',
    body: 'If you represent a platform we cover, you are welcome to submit updated pricing, product documentation, or a correction. Note that we do not accept payment for inclusion, ratings, or placement.',
  },
  {
    title: 'Editorial & Methodology Questions',
    body: 'Questions about how we score vendors, how the 4-pillar framework works, or how we handle affiliate relationships are always welcome, and we answer them on the record.',
  },
  {
    title: 'Press & Partnerships',
    body: 'For citation requests, data licensing, or syndication enquiries, include your outlet or organisation and your deadline so we can prioritise accordingly.',
  },
];

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: pageTitle,
  description: pageDescription,
  url: new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href,
  mainEntity: {
    '@type': 'Organization',
    name: 'Stack Guide Media',
    url: new URL('/', Astro.site ?? Astro.url.origin).href,
    email: contactEmail,
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'Editorial',
      email: contactEmail,
      availableLanguage: 'English',
    },
  },
};
---

<Layout title={pageTitle} heading={pageHeading} description={pageDescription}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(contactSchema)} />

  <main class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <header class="mb-10">
      <nav aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 text-sm text-slate-500">
          <li><a href="/" class="transition hover:text-indigo-600">Home</a></li>
          <li aria-hidden="true" class="text-slate-300">&gt;</li>
          <li class="font-medium text-indigo-600" aria-current="page">Contact</li>
        </ol>
      </nav>
      <h1 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        {pageHeading}
      </h1>
      <p class="mt-3 text-sm font-medium text-slate-500">Last updated: {lastUpdated}</p>
    </header>

    <article class="space-y-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
      <section>
        <p class="text-base leading-relaxed text-slate-700">
          The HR Stack Guide is published by Stack Guide Media. Every enquiry reaches a real person, and
          we read all of them. Email is the fastest and only channel we monitor.
        </p>
        <a
          href={`mailto:${contactEmail}`}
          class="mt-5 inline-flex items-center justify-center rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
        >
          Email {contactEmail}
        </a>
        <p class="mt-3 text-sm text-slate-500">
          We aim to reply within two business days. Corrections to published pricing or compliance claims
          are prioritised ahead of everything else.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-slate-900">What to Get in Touch About</h2>
        <div class="mt-4 grid gap-5 sm:grid-cols-2">
          {enquiries.map((item) => (
            <div>
              <h3 class="text-base font-semibold text-slate-900">{item.title}</h3>
              <p class="mt-1.5 text-base leading-relaxed text-slate-700">{item.body}</p>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-slate-900">What We Cannot Help With</h2>
        <p class="mt-2 text-base leading-relaxed text-slate-700">
          We are an independent comparison guide, not a reseller, implementation partner, or support desk
          for any platform we cover. We cannot access your account, resolve a billing dispute, or provide
          technical support for a vendor's product. For those, contact the vendor directly. We also do not
          provide legal, tax, or employment-compliance advice.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-slate-900">Looking for a Recommendation Instead?</h2>
        <p class="mt-2 text-base leading-relaxed text-slate-700">
          If you want help narrowing down a shortlist, our
          <a href="/recommendation/" class="font-medium text-indigo-600 hover:underline">recommendation tool</a>
          takes four questions and returns a tailored head-to-head comparison instantly, with no email
          required.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-slate-900">Related Policies</h2>
        <p class="mt-2 text-base leading-relaxed text-slate-700">
          For details on how we operate, see our
          <a href="/methodology/" class="font-medium text-indigo-600 hover:underline">Methodology</a>,
          <a href="/affiliate-disclosure/" class="font-medium text-indigo-600 hover:underline">Affiliate Disclosure</a>,
          <a href="/privacy-policy/" class="font-medium text-indigo-600 hover:underline">Privacy Policy</a>, and
          <a href="/terms/" class="font-medium text-indigo-600 hover:underline">Terms of Service</a>.
        </p>
      </section>
    </article>
  </main>
</Layout>
