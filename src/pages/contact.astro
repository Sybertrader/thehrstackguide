---
import Layout from '../layouts/Layout.astro';

const category = Astro.url.searchParams.get('category');
const target = category ? `/recommendation/?category=${encodeURIComponent(category)}` : '/recommendation/';
---

<Layout
  title="Get an HR Tech Recommendation (2026) | The HR Stack Guide"
  description="Answer three quick questions about your category, headcount, and budget to get an instant unbiased HR tech stack recommendation."
  noindex
>
  <Fragment slot="head">
    <meta http-equiv="refresh" content={`0;url=${target}`} />
  </Fragment>
  <main class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900">Get our recommendation</h1>
    <p class="mt-4 text-lg text-slate-600">
      Redirecting you to the recommendation tool…
    </p>
    <a
      href={target}
      class="mt-6 inline-flex items-center justify-center rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700"
    >
      Continue to Get Our Recommendation ↗
    </a>
  </main>
</Layout>
