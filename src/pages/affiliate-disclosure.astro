---
import Layout from '../layouts/Layout.astro';

const lastUpdated = 'September 2026';
const pageTitle = 'Affiliate Disclosure — The HR Stack Guide';
const pageHeading = 'Affiliate Disclosure';
const pageDescription =
  'The HR Stack Guide is published by Stack Guide Media. In accordance with the Federal Trade Commission\'s (FTC) 16 CFR Part 255 guidelines on endorsements and testimonials, we are fully transparent about how this site generates revenue and maintains editorial independence.';
---

<Layout
  title={pageTitle}
  heading={pageHeading}
  description={pageDescription}
>
  <main class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <header class="mb-10">
      <nav aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 text-sm text-slate-500">
          <li><a href="/" class="transition hover:text-indigo-600">Home</a></li>
          <li aria-hidden="true" class="text-slate-300">&gt;</li>
          <li class="font-medium text-indigo-600" aria-current="page">Affiliate Disclosure</li>
        </ol>
      </nav>
      <h1 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        {pageHeading}
      </h1>
      <p class="mt-3 text-sm font-medium text-slate-500">Last updated: {lastUpdated}</p>
    </header>

    <article class="space-y-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
      <section>
        <p class="text-base leading-relaxed text-slate-700">
          The HR Stack Guide is published by Stack Guide Media. In accordance with the Federal Trade
          Commission's (FTC) 16 CFR Part 255 guidelines on endorsements and testimonials, we are fully
          transparent about how this site generates revenue and maintains editorial independence.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-slate-900">How We Earn Revenue</h2>
        <p class="mt-2 text-base leading-relaxed text-slate-700">
          Some links on The HR Stack Guide, including "Try [Vendor]" buttons, pricing links, and comparison
          callouts, are affiliate links. If you click one of these links and subsequently sign up for or
          purchase a vendor's product, we may earn a referral commission. This occurs at no extra cost to
          you; vendor pricing remains identical whether you use our link or navigate directly to the vendor's
          site.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-slate-900">Editorial Independence &amp; Anti-Pay-for-Play</h2>
        <p class="mt-2 text-base leading-relaxed text-slate-700">
          Affiliate participation never determines whether a vendor is included in a comparison, nor does it
          influence ratings, scoring, or "Winner" badge placement across our Global Payroll &amp; EOR, ATS,
          or Performance Management guides. Rankings are determined solely by our standardized 4-pillar
          evaluation framework based on publicly verified product capabilities, official pricing, and primary
          vendor documentation.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-slate-900">Search Engine Compliance &amp; Link Standards</h2>
        <p class="mt-2 text-base leading-relaxed text-slate-700">
          Outbound affiliate links on this site utilize standard
          <code class="rounded bg-slate-100 px-1.5 py-0.5 text-sm">rel="noopener sponsored nofollow"</code>
          attributes in full compliance with search engine webmaster guidelines. Additionally, The HR Stack
          Guide maintains a strict policy against trademark bidding: we do not run paid search campaigns
          targeting vendor brand names or registered trademarks.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-slate-900">Contact Information</h2>
        <p class="mt-2 text-base leading-relaxed text-slate-700">
          If you have questions about our commercial relationships or editorial standards, please contact
          <a href="mailto:dave@thehrstackguide.com" class="font-medium text-indigo-600 hover:underline">dave@thehrstackguide.com</a>.
          You can also review our
          <a href="/privacy-policy/" class="font-medium text-indigo-600 hover:underline">Privacy Policy</a>,
          <a href="/terms/" class="font-medium text-indigo-600 hover:underline">Terms of Service</a>, and
          <a href="/methodology/" class="font-medium text-indigo-600 hover:underline">Methodology</a>
          for further details.
        </p>
      </section>
    </article>
  </main>
</Layout>
