/**
 * 1-on-1 B2B HR comparison catch-all.
 *
 * Scoped to `brand-a-vs-brand-b` and `brand-a-vs-brand-b-for-modifier` slugs
 * via getStaticPaths + `isComparisonRouteSlug`. Static utility routes
 * (`recommendation.astro`, `about.astro`, `contact.astro`, `thank-you.astro`,
 * category hubs) and `go/[slug].astro` take file-based precedence; Vercel
 * `api/leads.js` remains the lead-capture endpoint under `/api/leads`.
 */
import Layout from '../layouts/Layout.astro';
import { loadComparisons, getComparisonsLastUpdated, getComparisonsFirstPublished } from '../lib/comparisons';
import type { Comparison, FeatureMatrixEntry } from '../lib/comparisons';
import { isComparisonRouteSlug, comparisonHubSlug, isLegacyTechStartupsSlug } from '../lib/comparison-routes';
import { getToolProfile } from '../lib/tools';
import type { EnterpriseAnalysis } from '../lib/tools';
import { isManualLeadBrand, manualLeadModalId, resolveVendorOutboundHref } from '../lib/outbound';
import ManualLeadModal from '../components/ManualLeadModal.astro';
import PreferredSourceButton from '../components/PreferredSourceButton.astro';
import DataVerificationBadge from '../components/DataVerificationBadge.astro';
import DemoQuestions from '../components/DemoQuestions.astro';
import AtAGlance from '../components/AtAGlance.astro';
import PricingNuance from '../components/PricingNuance.astro';
import VerdictCallout from '../components/VerdictCallout.astro';
import TailoredEvaluationsSection from '../components/TailoredEvaluationsSection.astro';
import PersonaEvaluation from '../components/PersonaEvaluation.astro';
import PersonaEvaluationMatrix from '../components/PersonaEvaluationMatrix.astro';
import WorkflowBottlenecks from '../components/WorkflowBottlenecks.astro';
import ComparisonFaq from '../components/ComparisonFaq.astro';
import VendorButton from '../components/VendorButton.astro';
import { resolveChildHeroSubtitle, resolveHubHeroSubtitle } from '../data/scenarios';
import {
  buildPersonaEvaluation,
  buildPersonaFaqItems,
  buildWorkflowBottlenecks,
  comparisonFamily,
  modifierTitleSuffix,
  personaRowsForComparison,
  pickHubComparison,
  startupAliasForPair,
  variantsForPair,
  type ComparisonVariantLink,
} from '../lib/persona-evaluation';

/**
 * The four vendors whose CTAs open the lead capture modal (see
 * src/components/ManualLeadModal.astro) instead of linking out. `isManualLeadBrand`
 * in src/lib/outbound.ts must stay in sync with EMAIL_SEND_VENDORS in that
 * component. Applying the rule here keeps every CTA on a comparison page
 * (cards, feature table, decision checklist, final verdict) consistent.
 */

interface ComparisonPageProps {
  comparison: Comparison;
  related: Comparison[];
  lastUpdatedIso: string;
  firstPublishedIso: string;
  isHub: boolean;
  hubSlug: string;
  variants: ComparisonVariantLink[];
}

export function getStaticPaths() {
  const comparisons = loadComparisons();

  // Derived once from the real git history of comparisons.csv (not the current
  // wall-clock time) so freshness signals reflect genuine data updates. See
  // src/lib/comparisons.ts for why this avoids "date spam" freshness signals.
  const lastUpdatedIso = getComparisonsLastUpdated().toISOString();
  const firstPublishedIso = getComparisonsFirstPublished().toISOString();

  function relatedScore(candidate: Comparison, current: Comparison): number {
    let score = 0;
    if (candidate.tool_a_id === current.tool_a_id || candidate.tool_a_id === current.tool_b_id) score += 1;
    if (candidate.tool_b_id === current.tool_a_id || candidate.tool_b_id === current.tool_b_id) score += 1;
    return score;
  }

  const pairGroups = new Map<string, Comparison[]>();
  for (const row of comparisons) {
    const key = comparisonHubSlug(row.tool_a_id, row.tool_b_id);
    const list = pairGroups.get(key) ?? [];
    list.push(row);
    pairGroups.set(key, list);
  }

  function relatedChildren(current: Comparison): Comparison[] {
    return comparisons
      .filter((candidate) => candidate.niche_id === current.niche_id && candidate.slug !== current.slug)
      .sort((a, b) => relatedScore(b, current) - relatedScore(a, current))
      .slice(0, 3);
  }

  function relatedHubs(current: Comparison): Comparison[] {
    const currentKey = comparisonHubSlug(current.tool_a_id, current.tool_b_id);
    const seen = new Set<string>([currentKey]);
    const scored: { row: Comparison; score: number }[] = [];
    for (const [key, rows] of pairGroups) {
      if (seen.has(key)) continue;
      const representative = pickHubComparison(rows);
      const score = relatedScore(representative, current);
      if (score === 0) continue;
      seen.add(key);
      scored.push({ row: representative, score });
    }
    return scored.sort((a, b) => b.score - a.score).slice(0, 3).map((entry) => entry.row);
  }

  // Static files (recommendation, about, contact, category hubs) and
  // `src/pages/go/[slug].astro` / Vercel `api/*` already outrank this
  // rest-parameter route. Still skip any CSV slug that is not a 1-on-1
  // `brand-vs-brand` comparison so the catch-all cannot steal those paths.
  // Legacy `-for-tech-startups` CSV slugs 301 to the master hub via vercel.json.
  // Active startup children are the `for-startups` alias paths below.
  const childPaths = comparisons
    .filter((comparison) => isComparisonRouteSlug(comparison.slug))
    .filter((comparison) => !isLegacyTechStartupsSlug(comparison.slug))
    .map((comparison) => {
      const hubSlug = comparisonHubSlug(comparison.tool_a_id, comparison.tool_b_id);
      const variants = variantsForPair(pairGroups.get(hubSlug) ?? [comparison]);
      return {
        params: { slug: comparison.slug },
        props: {
          comparison,
          related: relatedChildren(comparison),
          lastUpdatedIso,
          firstPublishedIso,
          isHub: false,
          hubSlug,
          variants,
        } satisfies ComparisonPageProps,
      };
    });

  const hubPaths = [...pairGroups.entries()]
    .filter(([hubSlug]) => isComparisonRouteSlug(hubSlug))
    .map(([hubSlug, rows]) => {
      const comparison = pickHubComparison(rows);
      return {
        params: { slug: hubSlug },
        props: {
          comparison,
          related: relatedHubs(comparison),
          lastUpdatedIso,
          firstPublishedIso,
          isHub: true,
          hubSlug,
          variants: variantsForPair(rows),
        } satisfies ComparisonPageProps,
      };
    });

  const startupAliasPaths = [...pairGroups.values()].flatMap((rows) => {
    const alias = startupAliasForPair(rows);
    if (!alias || !isComparisonRouteSlug(alias.slug)) return [];
    const hubSlug = comparisonHubSlug(alias.tool_a_id, alias.tool_b_id);
    return [
      {
        params: { slug: alias.slug },
        props: {
          comparison: alias,
          related: relatedChildren(alias),
          lastUpdatedIso,
          firstPublishedIso,
          isHub: false,
          hubSlug,
          variants: variantsForPair(rows),
        } satisfies ComparisonPageProps,
      },
    ];
  });

  return [...childPaths, ...hubPaths, ...startupAliasPaths];
}

const { comparison, related, lastUpdatedIso, firstPublishedIso, isHub, hubSlug, variants } =
  Astro.props as ComparisonPageProps;
const isChildRoute = !isHub;
const hubFamily = comparisonFamily(comparison.tool_a_id, comparison.tool_b_id);

const currentQuarter = `Q${Math.ceil((new Date().getMonth() + 1) / 3)} ${new Date().getFullYear()}`;

function parsePipeList(value: string): string[] {
  if (!value?.trim()) return [];
  return value.split('|').map((item) => item.trim()).filter(Boolean);
}

function parseFeatureMatrix(json: string): Record<string, FeatureMatrixEntry> {
  if (!json?.trim()) return {};
  try {
    return JSON.parse(json) as Record<string, FeatureMatrixEntry>;
  } catch {
    return {};
  }
}

function cleanCopy(text: string): string {
  return text
    .replace(/\bFiat \$/g, 'Flat $')
    .replace(/\.\s*,/g, ',')
    .replace(/\s{2,}/g, ' ')
    .trim();
}

function logoBadgeColor(name: string): string {
  const colors = [
    'bg-indigo-600',
    'bg-violet-600',
    'bg-sky-600',
    'bg-emerald-600',
    'bg-rose-600',
    'bg-amber-600',
    'bg-cyan-600',
    'bg-fuchsia-600',
  ];
  let hash = 0;
  for (let i = 0; i < name.length; i += 1) {
    hash = name.charCodeAt(i) + ((hash << 5) - hash);
  }
  return colors[Math.abs(hash) % colors.length];
}

interface FaqItem {
  question: string;
  answer: string;
}

interface ToolNarrative {
  rating: string;
  reviewCountLabel: string | null;
  reviewCountNumeric: number | null;
  ratingSource: string | null;
  positioning: string;
  chooseIf: string[];
}

/**
 * Resolves the SEO narrative engine content for one side of a comparison.
 * Prefers editorial data from `src/data/tools.json` (keyed by tool id); tools
 * that don't have a profile yet fall back to content derived from their own
 * existing comparisons.csv fields, so the page never hardcodes another
 * tool's specific facts and never renders blank/undefined copy.
 */
function resolveToolNarrative(
  toolId: string,
  toolName: string,
  nicheAudiencePhrase: string,
  features: string[],
  pros: string[],
  csvRating: string
): ToolNarrative {
  const profile = getToolProfile(toolId);

  const reviewCountNumeric = profile?.review_count
    ? parseInt(profile.review_count.replace(/,/g, ''), 10)
    : null;

  const positioning =
    profile?.positioning ??
    cleanCopy(
      `${toolName} is built for ${nicheAudiencePhrase.toLowerCase()} that want ${
        features[0] ? features[0].toLowerCase() : 'a modern, all-in-one HR platform'
      }.`
    );

  const chooseIf =
    profile?.choose_if && profile.choose_if.length > 0
      ? profile.choose_if
      : pros.slice(0, 4).map((pro) => `You want ${pro.toLowerCase()}`);

  return {
    rating: profile?.rating ?? csvRating,
    reviewCountLabel: profile?.review_count ?? null,
    reviewCountNumeric: reviewCountNumeric && !Number.isNaN(reviewCountNumeric) ? reviewCountNumeric : null,
    ratingSource: profile?.rating_source ?? null,
    positioning,
    chooseIf,
  };
}

/**
 * Google's Rich Results validator requires `offers.price` to be a bare
 * numeric string ("400", "0"), rejecting currency symbols, thousands
 * separators, or unit suffixes like "$400/mo" or "$6,000/yr". This strips
 * everything except digits and the decimal point, falling back to "0" if no
 * numeric value can be extracted from the source pricing string.
 */
function toSchemaPrice(price: string): string {
  const numeric = price.replace(/[^0-9.]/g, '');
  return numeric || '0';
}

function buildSchemaGraph(
  comparison: Comparison,
  pageUrl: string,
  siteRootUrl: string,
  faqItems: FaqItem[],
  toolARating: string,
  toolBRating: string,
  toolAReviewCount: number | null,
  toolBReviewCount: number | null,
  datePublished: string,
  dateModified: string,
  pageTitle: string,
  schemaOptions: {
    isHub: boolean;
    hubUrl: string;
    modifierLabel?: string;
    softwareDescriptionA?: string;
    softwareDescriptionB?: string;
  }
) {
  const pageId = `${pageUrl}#webpage`;
  const faqId = `${pageUrl}#faq`;
  const breadcrumbId = `${pageUrl}#breadcrumb`;
  const toolAId = `${pageUrl}#${comparison.tool_a_id}`;
  const toolBId = `${pageUrl}#${comparison.tool_b_id}`;
  const pairName = `${comparison.tool_a_name} vs ${comparison.tool_b_name}`;

  const breadcrumbItems = schemaOptions.isHub
    ? [
        { '@type': 'ListItem', position: 1, name: 'Home', item: siteRootUrl },
        { '@type': 'ListItem', position: 2, name: 'Comparisons', item: siteRootUrl },
        { '@type': 'ListItem', position: 3, name: pairName, item: pageUrl },
      ]
    : [
        { '@type': 'ListItem', position: 1, name: 'Home', item: siteRootUrl },
        { '@type': 'ListItem', position: 2, name: 'Comparisons', item: siteRootUrl },
        { '@type': 'ListItem', position: 3, name: pairName, item: schemaOptions.hubUrl },
        {
          '@type': 'ListItem',
          position: 4,
          name: schemaOptions.modifierLabel ?? comparison.niche_name,
          item: pageUrl,
        },
      ];

  const softwareAudience = schemaOptions.modifierLabel
    ? { '@type': 'Audience', audienceType: schemaOptions.modifierLabel }
    : undefined;

  return {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'BreadcrumbList',
        '@id': breadcrumbId,
        itemListElement: breadcrumbItems,
      },
      {
        '@type': 'ItemPage',
        '@id': pageId,
        url: pageUrl,
        name: pageTitle,
        description: comparison.meta_description,
        datePublished,
        dateModified,
        mainEntity: {
          '@type': 'ItemList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, item: { '@id': toolAId } },
            { '@type': 'ListItem', position: 2, item: { '@id': toolBId } },
          ],
        },
      },
      {
        '@type': 'SoftwareApplication',
        '@id': toolAId,
        name: comparison.tool_a_name,
        applicationCategory: 'BusinessApplication',
        operatingSystem: 'Web-based',
        ...(schemaOptions.softwareDescriptionA ? { description: schemaOptions.softwareDescriptionA } : {}),
        ...(softwareAudience ? { audience: softwareAudience } : {}),
        offers: {
          '@type': 'Offer',
          price: toSchemaPrice(comparison.tool_a_starting_price),
          priceCurrency: 'USD',
        },
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: toolARating || '4.7',
          reviewCount: String(toolAReviewCount ?? '100'),
        },
        review: {
          '@type': 'Review',
          author: {
            '@type': 'Organization',
            name: 'The HR Stack Guide',
            url: 'https://www.thehrstackguide.com',
          },
          reviewRating: {
            '@type': 'Rating',
            ratingValue: toolARating,
            bestRating: '5',
            worstRating: '1',
          },
        },
      },
      {
        '@type': 'SoftwareApplication',
        '@id': toolBId,
        name: comparison.tool_b_name,
        applicationCategory: 'BusinessApplication',
        operatingSystem: 'Web-based',
        ...(schemaOptions.softwareDescriptionB ? { description: schemaOptions.softwareDescriptionB } : {}),
        ...(softwareAudience ? { audience: softwareAudience } : {}),
        offers: {
          '@type': 'Offer',
          price: toSchemaPrice(comparison.tool_b_starting_price),
          priceCurrency: 'USD',
        },
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: toolBRating || '4.7',
          reviewCount: String(toolBReviewCount ?? '100'),
        },
        review: {
          '@type': 'Review',
          author: {
            '@type': 'Organization',
            name: 'The HR Stack Guide',
            url: 'https://www.thehrstackguide.com',
          },
          reviewRating: {
            '@type': 'Rating',
            ratingValue: toolBRating,
            bestRating: '5',
            worstRating: '1',
          },
        },
      },
      {
        '@type': 'FAQPage',
        '@id': faqId,
        mainEntity: faqItems.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: item.answer,
          },
        })),
      },
    ],
  };
}

const toolAFeatures = parsePipeList(comparison.tool_a_key_features);
const toolAPros = parsePipeList(comparison.tool_a_pros);
const toolACons = parsePipeList(comparison.tool_a_cons);
const toolBFeatures = parsePipeList(comparison.tool_b_key_features);
const toolBPros = parsePipeList(comparison.tool_b_pros);
const toolBCons = parsePipeList(comparison.tool_b_cons);
const featureMatrix = parseFeatureMatrix(comparison.feature_matrix_json);
const featureMatrixRows = Object.entries(featureMatrix);

const toolANarrative = resolveToolNarrative(
  comparison.tool_a_id,
  comparison.tool_a_name,
  comparison.niche_audience_phrase,
  toolAFeatures,
  toolAPros,
  comparison.tool_a_rating
);
const toolBNarrative = resolveToolNarrative(
  comparison.tool_b_id,
  comparison.tool_b_name,
  comparison.niche_audience_phrase,
  toolBFeatures,
  toolBPros,
  comparison.tool_b_rating
);

/**
 * Enterprise-tier analysis blocks rendered inside a collapsed <details>
 * accordion so human buyers skip the legal fine print while LLM crawlers
 * still read the full DOM.
 *
 * These four topics only have a meaningful answer for Employer of Record and
 * Global Payroll vendors, so `enterprise_analysis` is populated exclusively on
 * `payroll-eor` profiles in tools.json. ATS and performance management
 * comparisons resolve to zero columns and the whole block is skipped, which is
 * why the gating lives in the data rather than in a niche allowlist here.
 */
const ENTERPRISE_SECTION_META = [
  {
    key: 'ip_assignment',
    title: 'Intellectual Property & Work Product Assignment',
    intro:
      'How work product created abroad actually transfers to your company, and whether the assignment runs through a directly owned local entity or an intermediary sub-licensing chain.',
  },
  {
    key: 'tax_withholding',
    title: 'Localized Tax Withholding & Statutory Payroll',
    intro:
      'Employer tax contributions, social security deductions, and income tax withholding handled on your behalf, including mandatory 13th and 14th month salary in markets such as Brazil, Italy, and the Philippines.',
  },
  {
    key: 'statutory_benefits',
    title: 'Statutory Benefits & Local Labor Law Compliance',
    intro:
      'Statutory health insurance, pension contributions, and mandatory paid time off across tier-1 markets, plus severance, notice period enforcement, and who carries unlawful termination liability.',
  },
  {
    key: 'fee_structure',
    title: 'Fine-Print EOR Fee Structures & Hidden Costs',
    intro:
      'What reaches the invoice beyond the headline per-employee-per-month rate: FX conversion spread, security deposit requirements, offboarding fees, and per-country add-ons.',
  },
] as const;

interface EnterpriseColumn {
  name: string;
  summary: string;
  bullets: string[];
}

interface EnterpriseSection {
  title: string;
  intro: string;
  columns: EnterpriseColumn[];
}

const toolAProfile = getToolProfile(comparison.tool_a_id);
const toolBProfile = getToolProfile(comparison.tool_b_id);

const enterpriseSections: EnterpriseSection[] = ENTERPRISE_SECTION_META.map((meta) => {
  const columns = [
    { name: comparison.tool_a_name, entry: toolAProfile?.enterprise_analysis?.[meta.key] },
    { name: comparison.tool_b_name, entry: toolBProfile?.enterprise_analysis?.[meta.key] },
  ]
    .filter((column): column is { name: string; entry: EnterpriseAnalysis } => Boolean(column.entry))
    .map(({ name, entry }) => ({ name, summary: entry.summary, bullets: entry.bullets }));

  return { title: meta.title, intro: meta.intro, columns };
}).filter((section) => section.columns.length > 0);

const richSnippetSchema = [
  {
    tool: comparison.tool_a_name,
    narrative: toolANarrative,
  },
  {
    tool: comparison.tool_b_name,
    narrative: toolBNarrative,
  },
]
  .filter((entry) => entry.narrative.reviewCountNumeric !== null)
  .map((entry) => ({
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: entry.tool,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web-based',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
      description: 'Contact for custom enterprise pricing / Free demo',
    },
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: entry.narrative.rating,
      reviewCount: entry.narrative.reviewCountNumeric,
    },
  }));

/**
 * Hub routes (`/deel-vs-remote/`) keep a modifier-free title so child pages
 * (`/deel-vs-remote-for-us-latam/`) are the only URLs that compete for
 * audience-specific queries.
 */
const modifierLabel = modifierTitleSuffix(comparison.niche_id, comparison.niche_name);
const pairName = `${comparison.tool_a_name} vs ${comparison.tool_b_name}`;
const pageTitle = isHub
  ? `${pairName}: Detailed Comparison`
  : `${pairName} for ${modifierLabel}`;
const pageHeading = isHub
  ? `${pairName}: Detailed Comparison`
  : `${pairName} for ${modifierLabel}`;
const pageDescription = isHub
  ? `Independent comparison of ${comparison.tool_a_name} and ${comparison.tool_b_name} for technology buyers, startups, and scaleups. Feature matrix, pricing nuance, and specialized use-case evaluations.`
  : `Independent comparison of ${comparison.tool_a_name} and ${comparison.tool_b_name} for ${modifierLabel}. Tailored capability breakdown, workflow evaluation, and pricing nuance.`;
const heroSubtitle = isHub
  ? resolveHubHeroSubtitle(hubFamily, comparison.tool_a_name, comparison.tool_b_name)
  : resolveChildHeroSubtitle(
      hubFamily,
      comparison.niche_id,
      comparison.niche_name,
      comparison.target_audience
    );
const personaRows = isHub ? [] : personaRowsForComparison(comparison);
const personaEvaluation =
  isChildRoute && personaRows.length > 0 ? buildPersonaEvaluation(comparison, personaRows) : null;
const workflowBottlenecks = isChildRoute ? buildWorkflowBottlenecks(comparison) : [];


const winnerName =
  comparison.winner_id === comparison.tool_a_id
    ? comparison.tool_a_name
    : comparison.winner_id === comparison.tool_b_id
      ? comparison.tool_b_name
      : comparison.winner_id;

const toolAIsWinner = comparison.winner_id === comparison.tool_a_id;
const toolBIsWinner = comparison.winner_id === comparison.tool_b_id;
const toolAAffiliateHref = resolveVendorOutboundHref(comparison.tool_a_id, comparison.tool_a_affiliate_url);
const toolBAffiliateHref = resolveVendorOutboundHref(comparison.tool_b_id, comparison.tool_b_affiliate_url);
const toolAIsManualLead = isManualLeadBrand(comparison.tool_a_id);
const toolBIsManualLead = isManualLeadBrand(comparison.tool_b_id);
const toolAModalId = manualLeadModalId(comparison.tool_a_name);
const toolBModalId = manualLeadModalId(comparison.tool_b_name);
const toolABadgeColor = logoBadgeColor(comparison.tool_a_name);
const toolBBadgeColor = logoBadgeColor(comparison.tool_b_name);

// Ratings always reflect the real, consistent scores from the CSV source data.
const toolADisplayRating = comparison.tool_a_rating;
const toolBDisplayRating = comparison.tool_b_rating;

// For comparisons against a global partner platform (Deel, Remote, Oyster, Gusto),
// the verdict is framed around a specific use case (Global EOR, International
// Contractor Management, SMB Usability) rather than a blanket "better overall"
// claim. Other comparisons fall back to the generic overall-winner framing.
const isUseCaseVerdict = comparison.winner_category && comparison.winner_category !== 'Overall Fit';
const winnerBullets = parsePipeList(comparison.winner_bullets ?? '');
const winnerBadgeText = isUseCaseVerdict ? `Winner: ${comparison.winner_category}` : 'Winner';

function extractMonthlyPrice(price: string): number | null {
  const match = price.match(/\$([\d.]+)/);
  return match ? parseFloat(match[1]) : null;
}

function contractorPaymentAnswer(current: Comparison, matrix: Record<string, FeatureMatrixEntry>): string {
  const relevantKeys = ['Contractor Auto-Pay', 'Native Legal Entities', 'Zero FX Rate Markup', 'Global Tax Filings'];
  const key = relevantKeys.find((candidate) => matrix[candidate]);

  if (!key) {
    return cleanCopy(
      `Both ${current.tool_a_name} and ${current.tool_b_name} support paying international contractors, though coverage and payout speed can vary by country, so confirm details with each vendor for your specific markets.`
    );
  }

  const entry = matrix[key];
  if (entry.a && entry.b) {
    return cleanCopy(
      `Yes, both ${current.tool_a_name} and ${current.tool_b_name} support ${key.toLowerCase()} for paying international contractors.`
    );
  }
  if (entry.a || entry.b) {
    const supporter = entry.a ? current.tool_a_name : current.tool_b_name;
    const other = entry.a ? current.tool_b_name : current.tool_a_name;
    return cleanCopy(
      `${supporter} offers ${key.toLowerCase()}, giving it the edge over ${other} for paying international contractors.`
    );
  }
  return cleanCopy(
    `Neither ${current.tool_a_name} nor ${current.tool_b_name} lists ${key.toLowerCase()} in this comparison, so confirm contractor payout coverage with each vendor directly.`
  );
}

const priceA = extractMonthlyPrice(comparison.tool_a_starting_price);
const priceB = extractMonthlyPrice(comparison.tool_b_starting_price);
const priceDiffSentence =
  priceA !== null && priceB !== null
    ? ` That's a difference of $${Math.abs(priceA - priceB).toFixed(2).replace(/\.00$/, '')} at the entry tier.`
    : '';

// The pricing fine print (add-ons, FX spreads, per-module gating) is the most
// citable detail on the page, so it is folded into the pricing FAQ answer as
// well as the on-page callout: `faqItems` feeds the FAQPage JSON-LD, which is
// where answer engines read pricing claims from. Each nuance is prefixed with
// its vendor name because the strings themselves lead with a price rather than
// a brand, and attribution has to survive being read out of context.
const pricingNuanceAttributions = [
  comparison.tool_a_pricing_nuance
    ? `${comparison.tool_a_name}: ${comparison.tool_a_pricing_nuance}`
    : '',
  comparison.tool_b_pricing_nuance
    ? `${comparison.tool_b_name}: ${comparison.tool_b_pricing_nuance}`
    : '',
].filter(Boolean);

const pricingNuanceClause = pricingNuanceAttributions.length
  ? ` Beyond the headline rates, here is the fine print. ${pricingNuanceAttributions.join(' ')}`
  : '';

const faqIntro = isHub
  ? `${winnerName} is the better overall fit for technology buyers, startups, and scaleups. `
  : isUseCaseVerdict
    ? `${comparison.winner_label}. `
    : `${winnerName} is the better fit for ${comparison.niche_audience_phrase}. `;

const pricingFaqAnswer = cleanCopy(
  `${comparison.tool_a_name} starts at ${comparison.tool_a_starting_price}; ${comparison.tool_a_pricing_model}. ${comparison.tool_b_name} starts at ${comparison.tool_b_starting_price}; ${comparison.tool_b_pricing_model}.${priceDiffSentence}${pricingNuanceClause}`
);

const hubFaq3 =
  hubFamily === 'ats'
    ? {
        question: 'Do these ATS platforms integrate with job boards and HRIS tools?',
        answer:
          'Yes, both platforms support multi-board job posting syndication and two-way worker record syncing with major HRIS platforms like BambooHR, Rippling, and Gusto.',
      }
    : hubFamily === 'pm'
      ? {
          question: 'Do these performance tools integrate with core HRIS systems?',
          answer:
            'Yes, both platforms sync employee organization charts directly with core HRIS platforms to automate review cycle participant rosters.',
        }
      : {
          question: `Does ${comparison.tool_a_name} or ${comparison.tool_b_name} handle international contractor payments?`,
          answer: contractorPaymentAnswer(comparison, featureMatrix),
        };

const hubFaqItems: FaqItem[] = [
  {
    question: `Is ${comparison.tool_a_name} or ${comparison.tool_b_name} better for technology buyers, startups, and scaleups?`,
    answer: cleanCopy(`${faqIntro}${comparison.winner_reason}`),
  },
  {
    question: `What is the starting price difference between ${comparison.tool_a_name} and ${comparison.tool_b_name}?`,
    answer: pricingFaqAnswer,
  },
  hubFaq3,
];

const faqItems: FaqItem[] = isHub
  ? hubFaqItems
  : buildPersonaFaqItems(comparison, personaRows, modifierLabel, pricingFaqAnswer);

const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const siteRootUrl = new URL('/', Astro.site ?? Astro.url.origin).href;
const hubUrl = new URL(`/${hubSlug}/`, Astro.site ?? Astro.url.origin).href;
const schemaGraph = buildSchemaGraph(
  comparison,
  pageUrl,
  siteRootUrl,
  faqItems,
  toolADisplayRating,
  toolBDisplayRating,
  toolANarrative.reviewCountNumeric,
  toolBNarrative.reviewCountNumeric,
  firstPublishedIso,
  lastUpdatedIso,
  pageTitle,
  {
    isHub,
    hubUrl,
    modifierLabel: isHub ? undefined : modifierLabel,
    softwareDescriptionA: isHub
      ? undefined
      : `${comparison.tool_a_name} evaluated for ${modifierLabel}. ${personaRows[0]?.a.spec ?? comparison.tool_a_pricing_model}`,
    softwareDescriptionB: isHub
      ? undefined
      : `${comparison.tool_b_name} evaluated for ${modifierLabel}. ${personaRows[0]?.b.spec ?? comparison.tool_b_pricing_model}`,
  }
);

const relatedHref = (item: Comparison) =>
  isHub ? `/${comparisonHubSlug(item.tool_a_id, item.tool_b_id)}/` : `/${item.slug}/`;

---

<Layout title={pageTitle} description={pageDescription}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
  {richSnippetSchema.length > 0 && (
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(richSnippetSchema)} />
  )}
  <meta slot="head" property="og:updated_time" content={lastUpdatedIso} />
  <meta slot="head" name="revised" content={lastUpdatedIso} />

  <main class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
      <!--
        Manual lead-capture modals for brands awaiting affiliate approval
        (Plane, Rippling, Lever, JazzHR). Mounted once per tool (not wrapped
        in display:none — that permanently hid the backdrop) so every CTA
        below can open the same instance via data-modal-target={toolXModalId}.
        modalId is passed explicitly so it always matches the button attribute.
      -->
      {toolAIsManualLead && (
        <ManualLeadModal
          brandName={comparison.tool_a_name}
          vendorId={comparison.tool_a_id}
          modalId={toolAModalId}
          partnerLandingUrl={getToolProfile(comparison.tool_a_id)?.partner_landing_url ?? ''}
        />
      )}
      {toolBIsManualLead && (
        <ManualLeadModal
          brandName={comparison.tool_b_name}
          vendorId={comparison.tool_b_id}
          modalId={toolBModalId}
          partnerLandingUrl={getToolProfile(comparison.tool_b_id)?.partner_landing_url ?? ''}
        />
      )}

      <!-- Hero Section -->
      <header class="mb-2">
        <nav aria-label="Breadcrumb">
          <ol class="flex flex-wrap items-center gap-2 text-sm text-slate-500">
            <li>
              <a href="/" class="transition hover:text-indigo-600">Home</a>
            </li>
            <li aria-hidden="true" class="text-slate-300">&gt;</li>
            <li>
              <a href="/" class="transition hover:text-indigo-600">Comparisons</a>
            </li>
            <li aria-hidden="true" class="text-slate-300">&gt;</li>
            {isHub ? (
              <li class="font-medium text-indigo-600" aria-current="page">
                {comparison.tool_a_name} vs {comparison.tool_b_name}
              </li>
            ) : (
              <>
                <li>
                  <a href={`/${hubSlug}/`} class="transition hover:text-indigo-600">
                    {comparison.tool_a_name} vs {comparison.tool_b_name}
                  </a>
                </li>
                <li aria-hidden="true" class="text-slate-300">&gt;</li>
                <li class="font-medium text-indigo-600" aria-current="page">
                  {modifierLabel}
                </li>
              </>
            )}
          </ol>
        </nav>

        <div class="mt-4 flex items-center gap-3">
          <div class="relative inline-flex h-10 w-10 shrink-0">
            <img
              src={comparison.tool_a_logo_url}
              alt={`${comparison.tool_a_name} logo`}
              class="w-10 h-10 rounded-lg object-contain bg-slate-100 aspect-square"
              width="40"
              height="40"
              decoding="async"
              loading="lazy"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            />
            <div
              class:list={[
                'hidden h-10 w-10 items-center justify-center rounded-lg text-sm font-bold uppercase text-white',
                toolABadgeColor,
              ]}
              aria-hidden="true"
            >
              {comparison.tool_a_name.charAt(0)}
            </div>
          </div>
          <span class="text-sm font-semibold uppercase tracking-wide text-slate-400">vs</span>
          <div class="relative inline-flex h-10 w-10 shrink-0">
            <img
              src={comparison.tool_b_logo_url}
              alt={`${comparison.tool_b_name} logo`}
              class="w-10 h-10 rounded-lg object-contain bg-slate-100 aspect-square"
              width="40"
              height="40"
              decoding="async"
              loading="lazy"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            />
            <div
              class:list={[
                'hidden h-10 w-10 items-center justify-center rounded-lg text-sm font-bold uppercase text-white',
                toolBBadgeColor,
              ]}
              aria-hidden="true"
            >
              {comparison.tool_b_name.charAt(0)}
            </div>
          </div>
        </div>

        <h1 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl">
          {pageHeading}
        </h1>

        <p class="mt-4 max-w-3xl text-lg leading-relaxed text-slate-600">
          {heroSubtitle}
        </p>

        <!--
          FTC/ASA disclosure: kept in the hero so it stays above the fold,
          immediately adjacent to the comparison that the affiliate links cover.
        -->
        <p class="text-xs text-slate-500 mt-2 mb-4">
          <span class="font-medium text-slate-500">Disclosure:</span> The HR Stack Guide is an independent comparison guide. We may earn a commission if you sign up through our links at no extra cost to you.
          <a href="/affiliate-disclosure/" class="text-slate-500 underline underline-offset-2 hover:text-indigo-600">Read full disclosure</a>.
        </p>
      </header>

      <DataVerificationBadge quarter={currentQuarter} />

      {isChildRoute && (
        <aside class="mb-10 mt-8 rounded-2xl border border-indigo-200 bg-indigo-50/70 px-5 py-4 sm:px-6 sm:py-5" aria-label={`${modifierLabel} evaluation context`}>
          <p class="text-sm leading-relaxed text-slate-800">
            <span class="font-semibold text-indigo-900">Viewing {modifierLabel} Evaluation.</span>
            {' '}
            For the baseline feature-by-feature comparison, see the main
            {' '}
            <a href={`/${hubSlug}/`} class="font-semibold text-indigo-700 underline underline-offset-2 hover:text-indigo-900">
              {pairName} comparison guide
            </a>.
          </p>
        </aside>
      )}

      <AtAGlance
        comparison={comparison}
        toolAFeatures={toolAFeatures}
        toolBFeatures={toolBFeatures}
        toolANarrative={toolANarrative}
        toolBNarrative={toolBNarrative}
        toolAIsWinner={toolAIsWinner}
        toolBIsWinner={toolBIsWinner}
        winnerBadgeText={winnerBadgeText}
        toolABadgeColor={toolABadgeColor}
        toolBBadgeColor={toolBBadgeColor}
        toolAIsManualLead={toolAIsManualLead}
        toolBIsManualLead={toolBIsManualLead}
        toolAModalId={toolAModalId}
        toolBModalId={toolBModalId}
        toolAAffiliateHref={toolAAffiliateHref}
        toolBAffiliateHref={toolBAffiliateHref}
      />

      {isHub && (
        <PricingNuance
          toolAName={comparison.tool_a_name}
          toolBName={comparison.tool_b_name}
          toolANuance={comparison.tool_a_pricing_nuance ? cleanCopy(comparison.tool_a_pricing_nuance) : ''}
          toolBNuance={comparison.tool_b_pricing_nuance ? cleanCopy(comparison.tool_b_pricing_nuance) : ''}
        />
      )}

      {isHub && comparison.hr_stack_take && (
        <VerdictCallout take={cleanCopy(comparison.hr_stack_take)} />
      )}

      {isHub && variants.length > 0 && (
        <TailoredEvaluationsSection variants={variants} family={hubFamily} />
      )}

      {isHub && (
      <>
      <!-- Feature Matrix Table -->
      {featureMatrixRows.length > 0 && (
        <section class="mb-12" aria-label="Feature comparison matrix">
          <h3 class="mb-6 text-xl font-bold text-slate-900">Feature Comparison</h3>
          <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <div class="overflow-x-auto">
              <table class="w-full min-w-[480px] text-left text-sm">
                <thead>
                  <tr class="border-b border-slate-200 bg-slate-50">
                    <th scope="col" class="px-6 py-4 align-bottom font-semibold text-slate-700">Feature</th>
                    <th scope="col" class="px-6 py-4 align-bottom font-semibold text-slate-700">
                      {comparison.tool_a_badge && (
                        <span class="mb-1.5 inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700">
                          {comparison.tool_a_badge}
                        </span>
                      )}
                      <span class="block">{comparison.tool_a_name}</span>
                    </th>
                    <th scope="col" class="px-6 py-4 align-bottom font-semibold text-slate-700">
                      {comparison.tool_b_badge && (
                        <span class="mb-1.5 inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700">
                          {comparison.tool_b_badge}
                        </span>
                      )}
                      <span class="block">{comparison.tool_b_name}</span>
                    </th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  {featureMatrixRows.map(([feature, value]) => (
                    <tr class="transition hover:bg-slate-50/80">
                      <td class="px-6 py-4 font-medium text-slate-900">{feature}</td>
                      <td class="px-6 py-4">
                        {value.a ? (
                          <span class="inline-flex items-center rounded-full bg-emerald-50 p-0.5 text-emerald-600" aria-label="Yes">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5" aria-hidden="true">
                              <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                            </svg>
                          </span>
                        ) : (
                          <span class="inline-flex items-center rounded-full bg-red-50 p-0.5 text-red-500" aria-label="No">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5" aria-hidden="true">
                              <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" />
                            </svg>
                          </span>
                        )}
                      </td>
                      <td class="px-6 py-4">
                        {value.b ? (
                          <span class="inline-flex items-center rounded-full bg-emerald-50 p-0.5 text-emerald-600" aria-label="Yes">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5" aria-hidden="true">
                              <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                            </svg>
                          </span>
                        ) : (
                          <span class="inline-flex items-center rounded-full bg-red-50 p-0.5 text-red-500" aria-label="No">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5" aria-hidden="true">
                              <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" />
                            </svg>
                          </span>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
                <tfoot>
                  <tr class="border-t border-slate-200 bg-slate-50">
                    <td class="px-6 py-4 text-sm font-medium text-slate-500">Ready to get started?</td>
                    <td class="px-6 py-4">
                      <VendorButton
                        href={toolAAffiliateHref}
                        modalId={toolAIsManualLead ? toolAModalId : undefined}
                        vendorName={comparison.tool_a_name}
                        location="feature_table"
                        class="inline-flex items-center rounded-lg bg-indigo-600 px-3.5 py-2 text-xs font-semibold text-white shadow-sm transition hover:bg-indigo-700"
                      >
                        Try {comparison.tool_a_name}{toolAIsManualLead ? '' : ' ↗'}
                      </VendorButton>
                    </td>
                    <td class="px-6 py-4">
                      <VendorButton
                        href={toolBAffiliateHref}
                        modalId={toolBIsManualLead ? toolBModalId : undefined}
                        vendorName={comparison.tool_b_name}
                        location="feature_table"
                        class="inline-flex items-center rounded-lg bg-indigo-600 px-3.5 py-2 text-xs font-semibold text-white shadow-sm transition hover:bg-indigo-700"
                      >
                        Try {comparison.tool_b_name}{toolBIsManualLead ? '' : ' ↗'}
                      </VendorButton>
                    </td>
                  </tr>
                </tfoot>
              </table>
            </div>
          </div>
        </section>
      )}
      </>
      )}

      {isChildRoute && personaEvaluation && (
        <PersonaEvaluation evaluation={personaEvaluation} />
      )}

      {isChildRoute && personaRows.length > 0 && (
        <PersonaEvaluationMatrix
          toolAName={comparison.tool_a_name}
          toolBName={comparison.tool_b_name}
          modifierLabel={modifierLabel}
          rows={personaRows}
        />
      )}

      {isChildRoute && (
        <WorkflowBottlenecks modifierLabel={modifierLabel} items={workflowBottlenecks} />
      )}

      {isChildRoute && (
        <ComparisonFaq
          heading={`Frequently Asked Questions for ${modifierLabel}`}
          ariaLabel={`Frequently asked questions for ${modifierLabel}`}
          items={faqItems}
        />
      )}

      {isHub && (
      <aside class="mb-12" aria-label="Add as a Google preferred source">
        <p class="text-sm font-medium text-slate-700">Enjoying benchmarks from The HR Stack Guide?</p>
        <PreferredSourceButton theme="light" align="left" />
      </aside>
      )}

      {isHub && (
      <>
      <!-- Pros & Cons Section -->
      <section class="mb-12" aria-label="Pros and cons comparison">
        <h3 class="mb-6 text-xl font-bold text-slate-900">Pros &amp; Cons</h3>
        <div class="grid gap-6 lg:grid-cols-2">
          <!-- Tool A Pros/Cons -->
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
            <h4 class="text-lg font-semibold text-slate-900">{comparison.tool_a_name}</h4>
            <div class="mt-6 grid gap-6 sm:grid-cols-2">
              <div>
                <h5 class="mb-3 text-sm font-semibold uppercase tracking-wide text-emerald-700">Pros</h5>
                <ul class="space-y-3">
                  {toolAPros.map((pro) => (
                    <li class="flex items-start gap-2.5 text-sm text-slate-700">
                      <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-3 w-3" aria-hidden="true">
                          <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                        </svg>
                      </span>
                      {pro}
                    </li>
                  ))}
                </ul>
              </div>
              <div>
                <h5 class="mb-3 text-sm font-semibold uppercase tracking-wide text-red-600">Cons</h5>
                <ul class="space-y-3">
                  {toolACons.map((con) => (
                    <li class="flex items-start gap-2.5 text-sm text-slate-700">
                      <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-600">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-3 w-3" aria-hidden="true">
                          <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" />
                        </svg>
                      </span>
                      {con}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>

          <!-- Tool B Pros/Cons -->
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
            <h4 class="text-lg font-semibold text-slate-900">{comparison.tool_b_name}</h4>
            <div class="mt-6 grid gap-6 sm:grid-cols-2">
              <div>
                <h5 class="mb-3 text-sm font-semibold uppercase tracking-wide text-emerald-700">Pros</h5>
                <ul class="space-y-3">
                  {toolBPros.map((pro) => (
                    <li class="flex items-start gap-2.5 text-sm text-slate-700">
                      <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-3 w-3" aria-hidden="true">
                          <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                        </svg>
                      </span>
                      {pro}
                    </li>
                  ))}
                </ul>
              </div>
              <div>
                <h5 class="mb-3 text-sm font-semibold uppercase tracking-wide text-red-600">Cons</h5>
                <ul class="space-y-3">
                  {toolBCons.map((con) => (
                    <li class="flex items-start gap-2.5 text-sm text-slate-700">
                      <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-600">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-3 w-3" aria-hidden="true">
                          <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" />
                        </svg>
                      </span>
                      {con}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- SECTION 4: Decision Checklist -->
      <section class="mb-12" aria-label="Buyer decision checklist">
        <h2 class="mb-6 text-2xl font-bold text-slate-900">The Decision Checklist</h2>
        <div class="grid gap-6 lg:grid-cols-2">
          <div class="rounded-2xl border border-indigo-100 bg-indigo-50/60 p-6 sm:p-8">
            <h3 class="text-lg font-bold text-indigo-900">Choose {comparison.tool_a_name} If...</h3>
            <ul class="mt-4 space-y-3">
              {toolANarrative.chooseIf.map((reason) => (
                <li class="flex items-start gap-2.5 text-sm leading-relaxed text-slate-700">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 h-5 w-5 shrink-0 text-indigo-600" aria-hidden="true">
                    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                  </svg>
                  <span><span class="font-semibold text-slate-900">{reason}</span></span>
                </li>
              ))}
            </ul>
            <VendorButton
              href={toolAAffiliateHref}
              modalId={toolAIsManualLead ? toolAModalId : undefined}
              vendorName={comparison.tool_a_name}
              location="decision_checklist"
              class="mt-6 inline-flex items-center justify-center rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 hover:shadow-md"
            >
              Try {comparison.tool_a_name}
            </VendorButton>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6 sm:p-8">
            <h3 class="text-lg font-bold text-slate-900">Choose {comparison.tool_b_name} If...</h3>
            <ul class="mt-4 space-y-3">
              {toolBNarrative.chooseIf.map((reason) => (
                <li class="flex items-start gap-2.5 text-sm leading-relaxed text-slate-700">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 h-5 w-5 shrink-0 text-slate-500" aria-hidden="true">
                    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                  </svg>
                  <span><span class="font-semibold text-slate-900">{reason}</span></span>
                </li>
              ))}
            </ul>
            <VendorButton
              href={toolBAffiliateHref}
              modalId={toolBIsManualLead ? toolBModalId : undefined}
              vendorName={comparison.tool_b_name}
              location="decision_checklist"
              class="mt-6 inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-indigo-300 hover:text-indigo-700 hover:shadow-md"
            >
              Try {comparison.tool_b_name}
            </VendorButton>
          </div>
        </div>
      </section>

      <DemoQuestions toolA={comparison.tool_a_name} toolB={comparison.tool_b_name} family={hubFamily} />
      </>
      )}

      <!-- SECTION 5: Final Verdict & Primary CTAs -->
      {isHub && (
      <section class="mb-12" aria-label="Final verdict">
        <h2 class="mb-6 text-2xl font-bold text-slate-900">
          {isHub ? 'Final Verdict' : `Final Verdict for ${modifierLabel}`}
        </h2>

        <!-- Winner Banner -->
        <div class="mb-6 overflow-hidden rounded-2xl border border-emerald-200 bg-gradient-to-r from-emerald-50 via-white to-slate-50 shadow-sm">
          <div class="flex flex-col gap-4 p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8">
            <div class="flex items-start gap-4">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-emerald-600 text-white shadow-md">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6" aria-hidden="true">
                  <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" clip-rule="evenodd" />
                </svg>
              </div>
              <div>
                <div class="flex flex-wrap items-center gap-2">
                  <span class="inline-flex items-center rounded-full bg-emerald-600 px-2.5 py-0.5 text-xs font-semibold text-white">
                    {isUseCaseVerdict ? `Best for ${comparison.winner_category}` : 'Recommended Choice'}
                  </span>
                </div>
                <h3 class="mt-2 text-xl font-bold text-slate-900 sm:text-2xl">
                  {isUseCaseVerdict ? comparison.winner_label : `${winnerName} is the winner`}
                </h3>
                {winnerBullets.length > 0 && (
                  <ul class="mt-3 max-w-2xl space-y-1.5">
                    {winnerBullets.map((bullet) => (
                      <li class="flex items-start gap-2 text-sm text-slate-600">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 h-4 w-4 shrink-0 text-emerald-600" aria-hidden="true">
                          <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                        </svg>
                        {bullet}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          </div>
        </div>

        <!-- Final Primary CTAs -->
        <div class="mt-6 flex flex-col items-start gap-4 rounded-2xl border border-indigo-100 bg-indigo-50/60 p-6 sm:flex-row sm:items-center sm:justify-end sm:p-8">
          <div class="flex flex-wrap gap-3">
            <VendorButton
              href={toolAAffiliateHref}
              modalId={toolAIsManualLead ? toolAModalId : undefined}
              vendorName={comparison.tool_a_name}
              location="final_verdict"
              class="inline-flex items-center justify-center rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 hover:shadow-md"
            >
              Try {comparison.tool_a_name}
            </VendorButton>
            <VendorButton
              href={toolBAffiliateHref}
              modalId={toolBIsManualLead ? toolBModalId : undefined}
              vendorName={comparison.tool_b_name}
              location="final_verdict"
              class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-indigo-300 hover:text-indigo-700 hover:shadow-md"
            >
              Try {comparison.tool_b_name}
            </VendorButton>
          </div>
        </div>
      </section>
      )}

      {isChildRoute && (
        <section class="mb-12" aria-label={`${modifierLabel} next steps`}>
          <div class="flex flex-col items-start gap-4 rounded-2xl border border-indigo-100 bg-indigo-50/60 p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8">
            <p class="text-sm font-medium text-slate-800">
              Ready to act on this {modifierLabel} evaluation of {pairName}?
            </p>
            <div class="flex flex-wrap gap-3">
              <VendorButton
                href={toolAAffiliateHref}
                modalId={toolAIsManualLead ? toolAModalId : undefined}
                vendorName={comparison.tool_a_name}
                location="persona_next_step"
                class="inline-flex items-center justify-center rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 hover:shadow-md"
              >
                Try {comparison.tool_a_name}
              </VendorButton>
              <VendorButton
                href={toolBAffiliateHref}
                modalId={toolBIsManualLead ? toolBModalId : undefined}
                vendorName={comparison.tool_b_name}
                location="persona_next_step"
                class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-indigo-300 hover:text-indigo-700 hover:shadow-md"
              >
                Try {comparison.tool_b_name}
              </VendorButton>
            </div>
          </div>
        </section>
      )}

      {isHub && (
        <ComparisonFaq
          heading="Frequently Asked Questions"
          ariaLabel="Frequently asked questions"
          items={faqItems}
        />
      )}

      {isHub && enterpriseSections.length > 0 && (
        <details class="legal-deep-dive group mb-12">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-2xl border border-slate-200 bg-slate-50 px-6 py-5 text-base font-bold text-slate-900 shadow-sm transition hover:border-indigo-300 hover:bg-indigo-50 hover:text-indigo-900 group-open:border-indigo-200 group-open:bg-indigo-50/80 [&::-webkit-details-marker]:hidden">
            <span>Deep-Dive Legal, IP &amp; Tax Analysis</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              class="h-5 w-5 shrink-0 text-indigo-600 transition group-open:rotate-180"
              aria-hidden="true"
            >
              <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.168l3.71-3.938a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" />
            </svg>
          </summary>
          <div class="legal-deep-dive-body mt-4 space-y-6 text-sm leading-relaxed text-slate-700">
            <p class="max-w-3xl text-sm text-slate-500">
              The four questions that decide an EOR contract once legal and procurement get involved: who owns the work product, who files the payroll taxes, who carries the termination liability, and what the invoice actually looks like.
            </p>
            {enterpriseSections.map((section) => (
              <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
                <h3 class="text-lg font-bold text-slate-900">{section.title}</h3>
                <p class="mt-2 max-w-3xl text-sm leading-relaxed text-slate-500">{section.intro}</p>
                <div class:list={['mt-5 grid gap-6', section.columns.length > 1 && 'sm:grid-cols-2']}>
                  {section.columns.map((column) => (
                    <div class="rounded-xl bg-slate-50 p-5">
                      <h4 class="text-sm font-semibold uppercase tracking-wide text-indigo-700">{column.name}</h4>
                      <p class="mt-2 text-sm leading-relaxed text-slate-700">{column.summary}</p>
                      <ul class="mt-4 space-y-2.5">
                        {column.bullets.map((bullet) => (
                          <li class="flex items-start gap-2.5 text-sm leading-relaxed text-slate-700">
                            <span aria-hidden="true" class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-indigo-400"></span>
                            <span>{bullet}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </article>
            ))}
          </div>
        </details>
      )}

      <!-- Related Comparisons -->
      {related.length > 0 && (
        <section class="mt-16" aria-label="Related comparisons">
          <h2 class="mb-6 text-2xl font-bold text-slate-900">
            {isHub ? 'Related Comparisons' : `Related Comparisons for ${modifierLabel}`}
          </h2>
          <div class="grid gap-6 sm:grid-cols-3">
            {related.map((item) => (
              <a
                href={relatedHref(item)}
                class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-indigo-200 hover:shadow-md"
              >
                <span class="text-xs font-semibold uppercase tracking-wide text-indigo-600">
                  {isHub ? 'Detailed comparison' : modifierTitleSuffix(item.niche_id, item.niche_name)}
                </span>
                <h3 class="mt-2 text-lg font-semibold text-slate-900 transition group-hover:text-indigo-600">
                  {item.tool_a_name} vs {item.tool_b_name}
                </h3>
                <span class="mt-4 inline-flex items-center text-sm font-semibold text-indigo-600">
                  View comparison
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="ml-1 h-4 w-4" aria-hidden="true">
                    <path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 0 1 .75-.75h8.5a.75.75 0 0 1 .75.75v5.75a.75.75 0 0 1-1.5 0V7.06l-7.47 7.47a.75.75 0 0 1-1.06-1.06L11.94 6H5.5a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd" />
                  </svg>
                </span>
              </a>
            ))}
          </div>
        </section>
      )}
    </main>

    <script>
      // Client-only: Astro scripts never execute during SSR, and `track()`
      // itself no-ops outside the browser, so this is safe on the server.
      import { track } from '@vercel/analytics';

      if (typeof window !== 'undefined' && typeof document !== 'undefined') {
        document.querySelectorAll('.js-affiliate-cta[data-track-vendor]').forEach((link) => {
          link.addEventListener('click', () => {
            const vendor = link.getAttribute('data-track-vendor');
            const location = link.getAttribute('data-track-location') ?? 'unknown';
            const url = link.getAttribute('href');

            if (!vendor || !url) return;

            track('Outbound Click', { vendor, location, url });
          });
        });
      }
    </script>
</Layout>
