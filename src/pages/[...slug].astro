---
/**
 * 1-on-1 B2B HR comparison catch-all.
 *
 * Scoped to master `brand-a-vs-brand-b` slugs via getStaticPaths +
 * `isComparisonHubSlug`. Segment URLs (`-for-startups`, etc.) are not built;
 * they 308 to the hub. Do not nest these under category prefixes. Static
 * utility routes and `go/[slug].astro` take file-based precedence.
 */
import Layout from '../layouts/Layout.astro';
import { loadComparisons, getComparisonsLastUpdated, getComparisonsFirstPublished } from '../lib/comparisons';
import type { Comparison, FeatureMatrixEntry } from '../lib/comparisons';
import { isComparisonHubSlug, comparisonHubSlug, categoryHubNav } from '../lib/comparison-routes';
import { comparisonVendorsAreLive, getToolProfile } from '../lib/tools';
import { isManualLeadBrand, manualLeadModalId, resolveVendorOutboundHref, vendorCtaLabel } from '../lib/outbound';
import StickyMobileCta from '../components/StickyMobileCta.astro';
import PersonaEvaluation from '../components/PersonaEvaluation.astro';
import PersonaEvaluationMatrix from '../components/PersonaEvaluationMatrix.astro';
import WorkflowBottlenecks from '../components/WorkflowBottlenecks.astro';
import { vendorLogoPreloadHref } from '../lib/vendor-logo';
import { comparisonSeo } from '../lib/seo';
import { verifiedSoftwareOffer, visibleAggregateRating } from '../lib/schema-offer';
import { pickRelatedHubs } from '../lib/related-comparisons';
import RelatedComparisons from '../components/RelatedComparisons.astro';
import HeroVariantA from '../components/heroes/HeroVariantA.astro';
import ComparisonMainBody from '../components/sections/ComparisonMainBody.astro';
import { buildVendorContrast } from '../lib/vendor-contrast';
import { buildMatchupVerdict } from '../lib/matchup-verdict';
import { resolveChildHeroSubtitle, resolveHubHeroSubtitle } from '../data/scenarios';
import type { CategoryHubFamily } from '../lib/comparison-routes';
import {
  buildMasterSegmentPanels,
  buildPersonaEvaluation,
  buildWorkflowBottlenecks,
  comparisonFamily,
  modifierTitleSuffix,
  personaRowsForComparison,
  pickHubComparison,
} from '../lib/persona-evaluation';

/**
 * Vendors whose CTAs open the lead capture modal (mounted once in
 * src/layouts/Layout.astro) instead of linking out.
 * `isManualLeadBrand` in src/lib/outbound.ts is the allowlist.
 * EMAIL_SEND_VENDORS in the modal covers Lever, JazzHR, Culture Amp,
 * PerformYard, and the nine non-affiliate brands (Web3Forms). The nine
 * then also POST /api/leads and redirect to data-vendor-url.
 * Zapier is PerformYard-only.
 */

interface ComparisonPageProps {
  comparison: Comparison;
  related: Comparison[];
  lastUpdatedIso: string;
  firstPublishedIso: string;
  isHub: boolean;
  hubSlug: string;
  pairRows: Comparison[];
}

export function getStaticPaths() {
  const comparisons = loadComparisons();

  // Derived once from the real git history of comparisons.csv (not the current
  // wall-clock time) so freshness signals reflect genuine data updates. See
  // src/lib/comparisons.ts for why this avoids "date spam" freshness signals.
  const lastUpdatedIso = getComparisonsLastUpdated().toISOString();
  const firstPublishedIso = getComparisonsFirstPublished().toISOString();

  // tools.json is the vendor allowlist. CSV rows (and any leftover alias
  // paths) whose tool ids are not keys in that catalog never become HTML.
  const liveComparisons = comparisons.filter((row) =>
    comparisonVendorsAreLive(row.tool_a_id, row.tool_b_id)
  );

  const pairGroups = new Map<string, Comparison[]>();
  for (const row of liveComparisons) {
    const key = comparisonHubSlug(row.tool_a_id, row.tool_b_id);
    const list = pairGroups.get(key) ?? [];
    list.push(row);
    pairGroups.set(key, list);
  }

  const hubRepresentatives = [...pairGroups.values()].map((rows) => pickHubComparison(rows));

  function relatedHubs(current: Comparison): Comparison[] {
    return pickRelatedHubs(current, hubRepresentatives);
  }

  const hubPaths = [...pairGroups.entries()]
    .filter(([hubSlug]) => isComparisonHubSlug(hubSlug))
    .filter(([, rows]) => {
      const comparison = pickHubComparison(rows);
      return comparisonVendorsAreLive(comparison.tool_a_id, comparison.tool_b_id);
    })
    .map(([hubSlug, rows]) => {
      const comparison = pickHubComparison(rows);
      return {
        params: { slug: hubSlug },
        props: {
          comparison,
          related: relatedHubs(comparison),
          lastUpdatedIso,
          firstPublishedIso,
          isHub: true,
          hubSlug,
          pairRows: rows,
        } satisfies ComparisonPageProps,
      };
    });

  return hubPaths;
}

const { comparison, related, lastUpdatedIso, firstPublishedIso, isHub, hubSlug, pairRows } =
  Astro.props as ComparisonPageProps;
const isChildRoute = !isHub;
const hubFamily = comparisonFamily(comparison.tool_a_id, comparison.tool_b_id);

function parsePipeList(value: string): string[] {
  if (!value?.trim()) return [];
  return value.split('|').map((item) => cleanCopy(item.trim())).filter(Boolean);
}

function parseFeatureMatrix(json: string): Record<string, FeatureMatrixEntry> {
  if (!json?.trim()) return {};
  try {
    return JSON.parse(json) as Record<string, FeatureMatrixEntry>;
  } catch {
    return {};
  }
}

function cleanCopy(text: string): string {
  return text
    .replace(/\bFiat \$/g, 'Flat $')
    .replace(/\.\s*,/g, ',')
    .replace(/\u2014/g, '. ')
    .replace(/(\d)\u2013(\d)/g, '$1 to $2')
    .replace(/\u2013/g, ', ')
    .replace(/\.\s+([a-z])/g, (_, letter: string) => `. ${letter.toUpperCase()}`)
    .replace(/\s{2,}/g, ' ')
    .replace(/\.\s+\./g, '.')
    .trim();
}

comparison.tool_a_badge = cleanCopy(comparison.tool_a_badge ?? '');
comparison.tool_b_badge = cleanCopy(comparison.tool_b_badge ?? '');
comparison.tool_a_pricing_model = cleanCopy(comparison.tool_a_pricing_model ?? '');
comparison.tool_b_pricing_model = cleanCopy(comparison.tool_b_pricing_model ?? '');

function firstSentence(text: string): string {
  const trimmed = text.trim();
  if (!trimmed) return '';
  const match = trimmed.match(/^[^.!?]+[.!?]/);
  return (match?.[0] ?? trimmed).slice(0, 240).trim();
}

function escapeRegExp(value: string): string {
  return value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

/** Drop a leading "{A} vs {B}:" so the card label is the only pair mention. */
function stripPairPrefix(text: string, vendorA: string, vendorB: string): string {
  const a = escapeRegExp(vendorA.trim());
  const b = escapeRegExp(vendorB.trim());
  if (!a || !b) return text.trim();
  return text
    .replace(new RegExp(`^${a}\\s+vs\\s+${b}:?\\s*`, 'i'), '')
    .replace(new RegExp(`^${b}\\s+vs\\s+${a}:?\\s*`, 'i'), '')
    .trim();
}

function logoBadgeColor(name: string): string {
  const colors = [
    'bg-indigo-600',
    'bg-violet-600',
    'bg-sky-600',
    'bg-emerald-600',
    'bg-rose-600',
    'bg-amber-600',
    'bg-cyan-600',
    'bg-fuchsia-600',
  ];
  let hash = 0;
  for (let i = 0; i < name.length; i += 1) {
    hash = name.charCodeAt(i) + ((hash << 5) - hash);
  }
  return colors[Math.abs(hash) % colors.length];
}

interface ToolNarrative {
  rating: string;
  reviewCountLabel: string | null;
  reviewCountNumeric: number | null;
  ratingSource: string | null;
  positioning: string;
  chooseIf: string[];
  skipIf: string[];
}

function stripSkipPrefix(text: string, vendorName: string): string {
  const escaped = vendorName.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  let out = text.trim();
  out = out
    .replace(new RegExp(`^Don['’]t buy\\s+${escaped}\\s+if\\s+`, 'i'), '')
    .replace(/^Don['’]t buy\s+.+?\s+if\s+/i, '')
    .replace(new RegExp(`^Skip\\s+${escaped}\\s+if\\s+`, 'i'), '')
    .trim();
  if (!out) return text.trim();
  return out.charAt(0).toUpperCase() + out.slice(1);
}

/**
 * Resolves the SEO narrative engine content for one side of a comparison.
 * Prefers editorial data from `src/data/tools.json` (keyed by tool id); tools
 * that don't have a profile yet fall back to content derived from their own
 * existing comparisons.csv fields, so the page never hardcodes another
 * tool's specific facts and never renders blank/undefined copy.
 */
function resolveToolNarrative(
  toolId: string,
  toolName: string,
  nicheAudiencePhrase: string,
  features: string[],
  pros: string[],
  csvRating: string
): ToolNarrative {
  const profile = getToolProfile(toolId);

  const reviewCountNumeric = profile?.review_count
    ? parseInt(profile.review_count.replace(/,/g, ''), 10)
    : null;

  const positioning = cleanCopy(
    profile?.positioning ??
      `${toolName} is built for ${nicheAudiencePhrase.toLowerCase()} that want ${
        features[0] ? features[0].toLowerCase() : 'payroll, hiring, or reviews in one place'
      }.`
  );

  const chooseIf =
    profile?.choose_if && profile.choose_if.length > 0
      ? profile.choose_if.map((item) => cleanCopy(item))
      : pros.slice(0, 4).map((pro) => `You want ${pro.toLowerCase()}`);
  const skipIf = profile?.skip_if ? [cleanCopy(stripSkipPrefix(profile.skip_if, toolName))] : [];

  return {
    rating: profile?.rating ?? csvRating,
    reviewCountLabel: profile?.review_count ?? null,
    reviewCountNumeric: reviewCountNumeric && !Number.isNaN(reviewCountNumeric) ? reviewCountNumeric : null,
    ratingSource: profile?.rating_source ?? null,
    positioning,
    chooseIf,
    skipIf,
  };
}

function softwareCategory(family: CategoryHubFamily | null): string {
  if (family === 'pm') return 'Performance Management Software';
  if (family === 'ats') return 'Applicant Tracking Software';
  return 'Global Payroll & EOR';
}

function softwareNode(args: {
  id: string;
  name: string;
  vendorId: string;
  startingPrice: string;
  family: CategoryHubFamily | null;
  rating: string;
  reviewCount: number | null;
}) {
  const offer = verifiedSoftwareOffer(args.vendorId, args.startingPrice);
  const aggregateRating = visibleAggregateRating(args.rating, args.reviewCount);
  return {
    '@type': 'SoftwareApplication',
    '@id': args.id,
    name: args.name,
    applicationCategory: softwareCategory(args.family),
    operatingSystem: 'Web-based, SaaS',
    ...(offer ? { offers: offer } : {}),
    ...(aggregateRating ? { aggregateRating } : {}),
  };
}

function buildSchemaGraph(
  comparison: Comparison,
  pageUrl: string,
  siteRootUrl: string,
  toolARating: string,
  toolBRating: string,
  toolAReviewCount: number | null,
  toolBReviewCount: number | null,
  datePublished: string,
  dateModified: string,
  pageTitle: string,
  pageDescription: string,
  family: CategoryHubFamily | null,
  schemaOptions: {
    isHub: boolean;
    hubUrl: string;
    categoryName: string;
    categoryUrl: string;
    modifierLabel?: string;
  }
) {
  const pageId = `${pageUrl}#webpage`;
  const breadcrumbId = `${pageUrl}#breadcrumb`;
  const toolAId = `${pageUrl}#${comparison.tool_a_id}`;
  const toolBId = `${pageUrl}#${comparison.tool_b_id}`;
  const pairName = `${comparison.tool_a_name} vs ${comparison.tool_b_name}`;
  const aboutUrl = new URL('/about/', siteRootUrl).href;

  const breadcrumbItems = schemaOptions.isHub
    ? [
        { '@type': 'ListItem', position: 1, name: 'Home', item: siteRootUrl },
        { '@type': 'ListItem', position: 2, name: schemaOptions.categoryName, item: schemaOptions.categoryUrl },
        { '@type': 'ListItem', position: 3, name: pairName, item: pageUrl },
      ]
    : [
        { '@type': 'ListItem', position: 1, name: 'Home', item: siteRootUrl },
        { '@type': 'ListItem', position: 2, name: schemaOptions.categoryName, item: schemaOptions.categoryUrl },
        { '@type': 'ListItem', position: 3, name: pairName, item: schemaOptions.hubUrl },
        {
          '@type': 'ListItem',
          position: 4,
          name: schemaOptions.modifierLabel ?? comparison.niche_name,
          item: pageUrl,
        },
      ];

  return {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'BreadcrumbList',
        '@id': breadcrumbId,
        itemListElement: breadcrumbItems,
      },
      {
        '@type': 'ItemPage',
        '@id': pageId,
        url: pageUrl,
        name: pageTitle,
        description: pageDescription,
        datePublished,
        dateModified,
        author: {
          '@type': 'Person',
          name: 'Dave Storey',
          jobTitle: 'Founder',
          url: aboutUrl,
          sameAs: ['https://www.linkedin.com/in/dave-storey-0053b111/'],
        },
        mainEntity: {
          '@type': 'ItemList',
          name: `Software Comparison: ${pairName}`,
          itemListElement: [
            { '@type': 'ListItem', position: 1, item: { '@id': toolAId } },
            { '@type': 'ListItem', position: 2, item: { '@id': toolBId } },
          ],
        },
      },
      softwareNode({
        id: toolAId,
        name: comparison.tool_a_name,
        vendorId: comparison.tool_a_id,
        startingPrice: comparison.tool_a_starting_price,
        family,
        rating: toolARating,
        reviewCount: toolAReviewCount,
      }),
      softwareNode({
        id: toolBId,
        name: comparison.tool_b_name,
        vendorId: comparison.tool_b_id,
        startingPrice: comparison.tool_b_starting_price,
        family,
        rating: toolBRating,
        reviewCount: toolBReviewCount,
      }),
    ],
  };
}

const toolAFeatures = parsePipeList(comparison.tool_a_key_features);
const toolAPros = parsePipeList(comparison.tool_a_pros);
const toolACons = parsePipeList(comparison.tool_a_cons);
const toolBFeatures = parsePipeList(comparison.tool_b_key_features);
const toolBPros = parsePipeList(comparison.tool_b_pros);
const toolBCons = parsePipeList(comparison.tool_b_cons);
const featureMatrix = parseFeatureMatrix(comparison.feature_matrix_json);
const featureMatrixRows = Object.entries(featureMatrix);

const toolANarrative = resolveToolNarrative(
  comparison.tool_a_id,
  comparison.tool_a_name,
  comparison.niche_audience_phrase,
  toolAFeatures,
  toolAPros,
  comparison.tool_a_rating
);
const toolBNarrative = resolveToolNarrative(
  comparison.tool_b_id,
  comparison.tool_b_name,
  comparison.niche_audience_phrase,
  toolBFeatures,
  toolBPros,
  comparison.tool_b_rating
);

const toolAProfile = getToolProfile(comparison.tool_a_id);
const toolBProfile = getToolProfile(comparison.tool_b_id);
const toolAIntegrations = toolAProfile?.integrations ?? [];
const toolBIntegrations = toolBProfile?.integrations ?? [];
const hasNativeIntegrations = toolAIntegrations.length > 0 || toolBIntegrations.length > 0;
const showFeatureTable = isHub && (featureMatrixRows.length > 0 || hasNativeIntegrations);
const segmentPanels = isHub ? buildMasterSegmentPanels(pairRows ?? []) : [];
const vendorAContrast = buildVendorContrast({
  badge: comparison.tool_a_badge,
  features: toolAFeatures,
  pros: toolAPros,
  cons: toolACons,
});
const vendorBContrast = buildVendorContrast({
  badge: comparison.tool_b_badge,
  features: toolBFeatures,
  pros: toolBPros,
  cons: toolBCons,
});
const mainSectionOrder = [
  'glance',
  'verdict',
  'features',
  'pricing',
  'pros',
  'calculator',
  'tabs',
  'preferred',
  'demo',
];
const differingFeature = featureMatrixRows.find(([, value]) => value.a !== value.b)?.[0];
const matchupVerdict = isHub
  ? buildMatchupVerdict({
      aId: comparison.tool_a_id,
      bId: comparison.tool_b_id,
      aName: comparison.tool_a_name,
      bName: comparison.tool_b_name,
      aCsvPrice: comparison.tool_a_starting_price,
      bCsvPrice: comparison.tool_b_starting_price,
      aProfile: toolAProfile,
      bProfile: toolBProfile,
      differingFeature,
    })
  : null;
const toolAContrastNuance = comparison.tool_a_pricing_nuance
  ? stripPairPrefix(
      firstSentence(cleanCopy(comparison.tool_a_pricing_nuance)),
      comparison.tool_a_name,
      comparison.tool_b_name,
    )
  : '';
const toolBContrastNuance = comparison.tool_b_pricing_nuance
  ? stripPairPrefix(
      firstSentence(cleanCopy(comparison.tool_b_pricing_nuance)),
      comparison.tool_a_name,
      comparison.tool_b_name,
    )
  : '';

/**
 * Title comes from comparisonSeo. Master-hub H1 is
 * `{A} vs {B}: {category} Comparison` with the category labels in
 * `HUB_HEADING_CATEGORY`. Persona child H1s stay question-form.
 */
const modifierLabel = modifierTitleSuffix(comparison.niche_id, comparison.niche_name);
const pairName = `${comparison.tool_a_name} vs ${comparison.tool_b_name}`;
const { title: pageTitle, heading: pageHeading } = comparisonSeo(
  { id: comparison.tool_a_id, name: comparison.tool_a_name },
  { id: comparison.tool_b_id, name: comparison.tool_b_name },
  hubFamily,
  isChildRoute ? modifierLabel : undefined,
  isChildRoute ? comparison.niche_id : undefined
);
const hubDescription = resolveHubHeroSubtitle({
  family: hubFamily,
  toolAId: comparison.tool_a_id,
  toolBId: comparison.tool_b_id,
  toolAName: comparison.tool_a_name,
  toolBName: comparison.tool_b_name,
  winnerId: comparison.winner_id,
});
const pageDescription = hubDescription;
const heroSubtitle = isHub
  ? hubDescription
  : resolveChildHeroSubtitle(
      hubFamily,
      comparison.niche_id,
      comparison.niche_name,
      comparison.target_audience
    );
const personaRows = isHub ? [] : personaRowsForComparison(comparison);
const personaEvaluation =
  isChildRoute && personaRows.length > 0 ? buildPersonaEvaluation(comparison, personaRows) : null;
const workflowBottlenecks = isChildRoute ? buildWorkflowBottlenecks(comparison) : [];

const toolAIsWinner = comparison.winner_id === comparison.tool_a_id;
const toolBIsWinner = comparison.winner_id === comparison.tool_b_id;
const toolAAffiliateHref = resolveVendorOutboundHref(comparison.tool_a_id, comparison.tool_a_affiliate_url);
const toolBAffiliateHref = resolveVendorOutboundHref(comparison.tool_b_id, comparison.tool_b_affiliate_url);
const toolAIsManualLead = isManualLeadBrand(comparison.tool_a_id);
const toolBIsManualLead = isManualLeadBrand(comparison.tool_b_id);
const toolAModalId = manualLeadModalId(comparison.tool_a_name);
const toolBModalId = manualLeadModalId(comparison.tool_b_name);
const toolABadgeColor = logoBadgeColor(comparison.tool_a_name);
const toolBBadgeColor = logoBadgeColor(comparison.tool_b_name);
const stickyWinnerIsB = toolBIsWinner;
const stickyWinner = stickyWinnerIsB
  ? {
      id: comparison.tool_b_id,
      name: comparison.tool_b_name,
      href: toolBAffiliateHref,
      modalId: toolBIsManualLead ? toolBModalId : '',
      logoUrl: comparison.tool_b_logo_url,
      badgeColor: toolBBadgeColor,
      ctaLabel: vendorCtaLabel(comparison.tool_b_id, comparison.tool_b_name, comparison.tool_b_free_trial),
    }
  : {
      id: comparison.tool_a_id,
      name: comparison.tool_a_name,
      href: toolAAffiliateHref,
      modalId: toolAIsManualLead ? toolAModalId : '',
      logoUrl: comparison.tool_a_logo_url,
      badgeColor: toolABadgeColor,
      ctaLabel: vendorCtaLabel(comparison.tool_a_id, comparison.tool_a_name, comparison.tool_a_free_trial),
    };
// For comparisons against a global partner platform (Deel, Remote, Oyster HR, Gusto),
// the verdict is framed around a specific use case (Global EOR, International
// Contractor Management, SMB Usability) rather than a blanket "better overall"
// claim. Other comparisons fall back to the generic overall-winner framing.
const isUseCaseVerdict = comparison.winner_category && comparison.winner_category !== 'Overall Fit';
const winnerBadgeText = isUseCaseVerdict ? `Winner: ${comparison.winner_category}` : 'Winner';

const slugParam = Astro.params.slug;
const pagePath = `/${(Array.isArray(slugParam) ? slugParam.filter(Boolean) : String(slugParam ?? '').split('/').filter(Boolean)).join('/')}/`;
const pageUrl = new URL(pagePath, Astro.site ?? Astro.url.origin).href;
const siteRootUrl = new URL('/', Astro.site ?? Astro.url.origin).href;
const hubUrl = new URL(`/${hubSlug}/`, Astro.site ?? Astro.url.origin).href;
const categoryHub = categoryHubNav(hubFamily);
const categoryUrl = new URL(categoryHub.href, Astro.site ?? Astro.url.origin).href;
const schemaGraph = buildSchemaGraph(
  comparison,
  pageUrl,
  siteRootUrl,
  toolANarrative.rating,
  toolBNarrative.rating,
  toolANarrative.reviewCountNumeric,
  toolBNarrative.reviewCountNumeric,
  firstPublishedIso,
  lastUpdatedIso,
  pageTitle,
  pageDescription,
  hubFamily,
  {
    isHub,
    hubUrl,
    categoryName: categoryHub.label,
    categoryUrl,
    modifierLabel: isHub ? undefined : modifierLabel,
  }
);

const relatedLinks = related.map((item) => ({
  href: `/${comparisonHubSlug(item.tool_a_id, item.tool_b_id)}/`,
  tool_a_name: item.tool_a_name,
  tool_b_name: item.tool_b_name,
  tool_a_logo_url: item.tool_a_logo_url,
  tool_b_logo_url: item.tool_b_logo_url,
}));

const heroLogoPreloads = (
  await Promise.all([
    vendorLogoPreloadHref(comparison.tool_a_logo_url),
    vendorLogoPreloadHref(comparison.tool_b_logo_url),
  ])
).filter((href): href is string => Boolean(href));

---

<Layout
  title={pageTitle}
  heading={pageHeading}
  description={pageDescription}
  lcpImages={heroLogoPreloads}
  includeOrganizationSchema={false}
  emitLayoutSchema={false}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
  <meta slot="head" property="og:updated_time" content={lastUpdatedIso} />
  <meta slot="head" name="revised" content={lastUpdatedIso} />

  <main id="main-content" class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
      <HeroVariantA
        toolAName={comparison.tool_a_name}
        toolBName={comparison.tool_b_name}
        toolALogo={comparison.tool_a_logo_url}
        toolBLogo={comparison.tool_b_logo_url}
        toolABadgeColor={toolABadgeColor}
        toolBBadgeColor={toolBBadgeColor}
        pageHeading={pageHeading}
        heroSubtitle={heroSubtitle}
        categoryHref={categoryHub.href}
        categoryLabel={categoryHub.label}
        isHub={isHub}
        hubSlug={hubSlug}
        modifierLabel={modifierLabel}
        reviewedAt={lastUpdatedIso}
      />

      {isChildRoute && (
        <aside class="mb-10 mt-8 rounded-2xl border border-indigo-200 bg-indigo-50/70 px-5 py-4 sm:px-6 sm:py-5" aria-label={`${modifierLabel} evaluation context`}>
          <p class="text-sm leading-relaxed text-slate-800">
            <span class="font-semibold text-indigo-900">Viewing {modifierLabel} Evaluation.</span>
            {' '}
            For the baseline feature-by-feature comparison, see the main
            {' '}
            <a href={`/${hubSlug}/`} class="font-semibold text-indigo-700 underline underline-offset-2 hover:text-indigo-900">
              {pairName} comparison guide
            </a>.
          </p>
        </aside>
      )}

      <ComparisonMainBody
        comparison={comparison}
        mainSectionOrder={mainSectionOrder}
        isHub={isHub}
        hubFamily={hubFamily}
        toolAFeatures={toolAFeatures}
        toolBFeatures={toolBFeatures}
        toolANarrative={toolANarrative}
        toolBNarrative={toolBNarrative}
        toolAIsWinner={toolAIsWinner}
        toolBIsWinner={toolBIsWinner}
        winnerBadgeText={winnerBadgeText}
        toolABadgeColor={toolABadgeColor}
        toolBBadgeColor={toolBBadgeColor}
        toolAIsManualLead={toolAIsManualLead}
        toolBIsManualLead={toolBIsManualLead}
        toolAModalId={toolAModalId}
        toolBModalId={toolBModalId}
        toolAAffiliateHref={toolAAffiliateHref}
        toolBAffiliateHref={toolBAffiliateHref}
        vendorAContrast={vendorAContrast}
        vendorBContrast={vendorBContrast}
        toolAContrastNuance={toolAContrastNuance}
        toolBContrastNuance={toolBContrastNuance}
        showFeatureTable={showFeatureTable}
        featureMatrixRows={featureMatrixRows}
        toolAIntegrations={toolAIntegrations}
        toolBIntegrations={toolBIntegrations}
        segmentPanels={segmentPanels}
        matchupVerdict={matchupVerdict}
      />

      {isChildRoute && personaEvaluation && (
        <PersonaEvaluation evaluation={personaEvaluation} />
      )}

      {isChildRoute && personaRows.length > 0 && (
        <PersonaEvaluationMatrix
          toolAName={comparison.tool_a_name}
          toolBName={comparison.tool_b_name}
          modifierLabel={modifierLabel}
          rows={personaRows}
        />
      )}

      {isChildRoute && (
        <WorkflowBottlenecks modifierLabel={modifierLabel} items={workflowBottlenecks} />
      )}

      <RelatedComparisons
        links={relatedLinks}
        categoryHref={categoryHub.href}
        categoryLabel={categoryHub.label}
        currentPair={`${comparison.tool_a_name} vs ${comparison.tool_b_name}`}
      />

      <div class="h-20 md:hidden" aria-hidden="true"></div>
    </main>

    <StickyMobileCta
      vendorId={stickyWinner.id}
      vendorName={stickyWinner.name}
      href={stickyWinner.href}
      ctaLabel={stickyWinner.ctaLabel}
      logoUrl={stickyWinner.logoUrl}
      badgeColor={stickyWinner.badgeColor}
      modalId={stickyWinner.modalId}
    />

    <script>
      import { initOutboundAnalytics } from '../scripts/outbound-analytics';

      initOutboundAnalytics();
    </script>
</Layout>
