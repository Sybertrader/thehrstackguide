---
import Layout from '../layouts/Layout.astro';
import { loadComparisons, getComparisonsLastUpdated, getComparisonsFirstPublished, getRelatedComparisons } from '../lib/comparisons';
import type { Comparison, FeatureMatrixEntry, RelatedComparisonCard } from '../lib/comparisons';
import { getToolProfile } from '../lib/tools';
import type { EnterpriseAnalysis } from '../lib/tools';
import { affiliateLinks } from '../config/affiliates';
import { outboundRel } from '../lib/links';
import ManualLeadModal from '../components/ManualLeadModal.astro';
import PreferredSourceButton from '../components/PreferredSourceButton.astro';
import RelatedComparisons from '../components/RelatedComparisons.astro';

/**
 * Routes outbound CTAs through our own `/go/{slug}` redirect for any tool
 * with a registered affiliate link (see src/config/affiliates.ts), so the
 * tracked partner URL lives in one place and can be swapped without editing
 * comparison content. Tools without a registered affiliate link fall back to
 * their plain vendor URL from comparisons.csv.
 */
function resolveOutboundHref(toolId: string, fallbackUrl: string): string {
  return affiliateLinks[toolId] ? `/go/${toolId}` : fallbackUrl;
}

/**
 * The four vendors whose CTAs open the lead capture modal (see
 * src/components/ManualLeadModal.astro) instead of linking out. Must stay in
 * sync with EMAIL_SEND_VENDORS in that component. Applying the rule here keeps
 * every CTA on a comparison page (hero, cards, feature table, decision
 * checklist, final verdict) consistent without duplicating five near-identical
 * `<VendorCTA>` calls per tool across the template. Every other brand — including
 * ones with no affiliate link yet — links straight to its vendor URL.
 */
const MANUAL_LEAD_BRANDS = ['lever', 'jazzhr', 'culture-amp', 'performyard'];
function isManualLeadBrand(toolId: string): boolean {
  return MANUAL_LEAD_BRANDS.includes(toolId.toLowerCase().trim());
}
function manualLeadModalId(brandName: string): string {
  return `lead-modal-${brandName.toLowerCase().replace(/\s+/g, '-')}`;
}

export function getStaticPaths() {
  const comparisons = loadComparisons();

  // Derived once from the real git history of comparisons.csv (not the current
  // wall-clock time) so freshness signals reflect genuine data updates. See
  // src/lib/comparisons.ts for why this avoids "date spam" freshness signals.
  const lastUpdatedIso = getComparisonsLastUpdated().toISOString();
  const firstPublishedIso = getComparisonsFirstPublished().toISOString();

  return comparisons.map((comparison) => {
    const relatedComparisons = getRelatedComparisons(comparisons, comparison);

    return {
      params: { slug: comparison.slug },
      props: { comparison, relatedComparisons, lastUpdatedIso, firstPublishedIso },
    };
  });
}

const { comparison, relatedComparisons, lastUpdatedIso, firstPublishedIso } = Astro.props as {
  comparison: Comparison;
  relatedComparisons: RelatedComparisonCard[];
  lastUpdatedIso: string;
  firstPublishedIso: string;
};

const lastUpdatedLabel = new Date(lastUpdatedIso).toLocaleDateString('en-US', {
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

const currentMonthYear = new Date().toLocaleDateString('en-US', {
  month: 'long',
  year: 'numeric',
}); // Produces "September 2026"

function parsePipeList(value: string): string[] {
  if (!value?.trim()) return [];
  return value.split('|').map((item) => item.trim()).filter(Boolean);
}

function parseFeatureMatrix(json: string): Record<string, FeatureMatrixEntry> {
  if (!json?.trim()) return {};
  try {
    return JSON.parse(json) as Record<string, FeatureMatrixEntry>;
  } catch {
    return {};
  }
}

function parseBool(value: string): boolean {
  return value?.toLowerCase() === 'true';
}

function cleanCopy(text: string): string {
  return text
    .replace(/\.\s*,/g, ',')
    .replace(/\s{2,}/g, ' ')
    .trim();
}

function logoBadgeColor(name: string): string {
  const colors = [
    'bg-indigo-600',
    'bg-violet-600',
    'bg-sky-600',
    'bg-emerald-600',
    'bg-rose-600',
    'bg-amber-600',
    'bg-cyan-600',
    'bg-fuchsia-600',
  ];
  let hash = 0;
  for (let i = 0; i < name.length; i += 1) {
    hash = name.charCodeAt(i) + ((hash << 5) - hash);
  }
  return colors[Math.abs(hash) % colors.length];
}

interface FaqItem {
  question: string;
  answer: string;
}

interface ToolNarrative {
  rating: string;
  reviewCountLabel: string | null;
  reviewCountNumeric: number | null;
  ratingSource: string | null;
  positioning: string;
  textCompliance: string;
  textGlobalReach: string;
  textPricingTruth: string;
  chooseIf: string[];
}

/**
 * Resolves the SEO narrative engine content for one side of a comparison.
 * Prefers editorial data from `src/data/tools.json` (keyed by tool id); tools
 * that don't have a profile yet fall back to content derived from their own
 * existing comparisons.csv fields, so the page never hardcodes another
 * tool's specific facts and never renders blank/undefined copy.
 */
function resolveToolNarrative(
  toolId: string,
  toolName: string,
  nicheAudiencePhrase: string,
  features: string[],
  pros: string[],
  csvRating: string
): ToolNarrative {
  const profile = getToolProfile(toolId);

  const reviewCountNumeric = profile?.review_count
    ? parseInt(profile.review_count.replace(/,/g, ''), 10)
    : null;

  const positioning =
    profile?.positioning ??
    cleanCopy(
      `${toolName} is built for ${nicheAudiencePhrase.toLowerCase()} that want ${
        features[0] ? features[0].toLowerCase() : 'a modern, all-in-one HR platform'
      }.`
    );

  const chooseIf =
    profile?.choose_if && profile.choose_if.length > 0
      ? profile.choose_if
      : pros.slice(0, 4).map((pro) => `You want ${pro.toLowerCase()}`);

  const comingSoon = (topic: string) =>
    `A detailed ${topic} breakdown for ${toolName} is being finalized. In the meantime, confirm the specifics directly on the vendor's site before making a decision.`;

  return {
    rating: profile?.rating ?? csvRating,
    reviewCountLabel: profile?.review_count ?? null,
    reviewCountNumeric: reviewCountNumeric && !Number.isNaN(reviewCountNumeric) ? reviewCountNumeric : null,
    ratingSource: profile?.rating_source ?? null,
    positioning,
    textCompliance: profile?.text_compliance ?? comingSoon('tax, legal, and misclassification compliance'),
    textGlobalReach: profile?.text_global_reach ?? comingSoon('global reach and workforce infrastructure'),
    textPricingTruth: profile?.text_pricing_truth ?? comingSoon('pricing and hidden-fee'),
    chooseIf,
  };
}

/**
 * Google's Rich Results validator requires `offers.price` to be a bare
 * numeric string ("400", "0"), rejecting currency symbols, thousands
 * separators, or unit suffixes like "$400/mo" or "$6,000/yr". This strips
 * everything except digits and the decimal point, falling back to "0" if no
 * numeric value can be extracted from the source pricing string.
 */
function toSchemaPrice(price: string): string {
  const numeric = price.replace(/[^0-9.]/g, '');
  return numeric || '0';
}

function buildSchemaGraph(
  comparison: Comparison,
  pageUrl: string,
  siteRootUrl: string,
  faqItems: FaqItem[],
  toolARating: string,
  toolBRating: string,
  toolAReviewCount: number | null,
  toolBReviewCount: number | null,
  datePublished: string,
  dateModified: string,
  pageTitle: string
) {
  const pageId = `${pageUrl}#webpage`;
  const faqId = `${pageUrl}#faq`;
  const breadcrumbId = `${pageUrl}#breadcrumb`;
  const toolAId = `${pageUrl}#${comparison.tool_a_id}`;
  const toolBId = `${pageUrl}#${comparison.tool_b_id}`;

  return {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'BreadcrumbList',
        '@id': breadcrumbId,
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: siteRootUrl },
          { '@type': 'ListItem', position: 2, name: 'Comparisons', item: siteRootUrl },
          {
            '@type': 'ListItem',
            position: 3,
            name: `${comparison.tool_a_name} vs ${comparison.tool_b_name}`,
            item: pageUrl,
          },
        ],
      },
      {
        '@type': 'ItemPage',
        '@id': pageId,
        url: pageUrl,
        name: pageTitle,
        description: comparison.meta_description,
        datePublished,
        dateModified,
        mainEntity: {
          '@type': 'ItemList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, item: { '@id': toolAId } },
            { '@type': 'ListItem', position: 2, item: { '@id': toolBId } },
          ],
        },
      },
      {
        '@type': 'SoftwareApplication',
        '@id': toolAId,
        name: comparison.tool_a_name,
        applicationCategory: 'BusinessApplication',
        operatingSystem: 'Web-based',
        offers: {
          '@type': 'Offer',
          price: toSchemaPrice(comparison.tool_a_starting_price),
          priceCurrency: 'USD',
        },
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: toolARating || '4.7',
          reviewCount: String(toolAReviewCount ?? '100'),
        },
        review: {
          '@type': 'Review',
          author: {
            '@type': 'Organization',
            name: 'The HR Stack Guide',
            url: 'https://www.thehrstackguide.com',
          },
          reviewRating: {
            '@type': 'Rating',
            ratingValue: toolARating,
            bestRating: '5',
            worstRating: '1',
          },
        },
      },
      {
        '@type': 'SoftwareApplication',
        '@id': toolBId,
        name: comparison.tool_b_name,
        applicationCategory: 'BusinessApplication',
        operatingSystem: 'Web-based',
        offers: {
          '@type': 'Offer',
          price: toSchemaPrice(comparison.tool_b_starting_price),
          priceCurrency: 'USD',
        },
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: toolBRating || '4.7',
          reviewCount: String(toolBReviewCount ?? '100'),
        },
        review: {
          '@type': 'Review',
          author: {
            '@type': 'Organization',
            name: 'The HR Stack Guide',
            url: 'https://www.thehrstackguide.com',
          },
          reviewRating: {
            '@type': 'Rating',
            ratingValue: toolBRating,
            bestRating: '5',
            worstRating: '1',
          },
        },
      },
      {
        '@type': 'FAQPage',
        '@id': faqId,
        mainEntity: faqItems.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: item.answer,
          },
        })),
      },
    ],
  };
}

const toolAFeatures = parsePipeList(comparison.tool_a_key_features);
const toolAPros = parsePipeList(comparison.tool_a_pros);
const toolACons = parsePipeList(comparison.tool_a_cons);
const toolBFeatures = parsePipeList(comparison.tool_b_key_features);
const toolBPros = parsePipeList(comparison.tool_b_pros);
const toolBCons = parsePipeList(comparison.tool_b_cons);
const featureMatrix = parseFeatureMatrix(comparison.feature_matrix_json);
const featureMatrixRows = Object.entries(featureMatrix);

const toolANarrative = resolveToolNarrative(
  comparison.tool_a_id,
  comparison.tool_a_name,
  comparison.niche_audience_phrase,
  toolAFeatures,
  toolAPros,
  comparison.tool_a_rating
);
const toolBNarrative = resolveToolNarrative(
  comparison.tool_b_id,
  comparison.tool_b_name,
  comparison.niche_audience_phrase,
  toolBFeatures,
  toolBPros,
  comparison.tool_b_rating
);

/**
 * Enterprise-tier analysis blocks rendered beneath the feature deep dive.
 *
 * These four topics only have a meaningful answer for Employer of Record and
 * Global Payroll vendors, so `enterprise_analysis` is populated exclusively on
 * `payroll-eor` profiles in tools.json. ATS and performance management
 * comparisons resolve to zero columns and the whole block is skipped, which is
 * why the gating lives in the data rather than in a niche allowlist here.
 */
const ENTERPRISE_SECTION_META = [
  {
    key: 'ip_assignment',
    title: 'Intellectual Property & Work Product Assignment',
    intro:
      'How work product created abroad actually transfers to your company, and whether the assignment runs through a directly owned local entity or an intermediary sub-licensing chain.',
  },
  {
    key: 'tax_withholding',
    title: 'Localized Tax Withholding & Statutory Payroll',
    intro:
      'Employer tax contributions, social security deductions, and income tax withholding handled on your behalf, including mandatory 13th and 14th month salary in markets such as Brazil, Italy, and the Philippines.',
  },
  {
    key: 'statutory_benefits',
    title: 'Statutory Benefits & Local Labor Law Compliance',
    intro:
      'Statutory health insurance, pension contributions, and mandatory paid time off across tier-1 markets, plus severance, notice period enforcement, and who carries unlawful termination liability.',
  },
  {
    key: 'fee_structure',
    title: 'Fine-Print EOR Fee Structures & Hidden Costs',
    intro:
      'What reaches the invoice beyond the headline per-employee-per-month rate: FX conversion spread, security deposit requirements, offboarding fees, and per-country add-ons.',
  },
] as const;

interface EnterpriseColumn {
  name: string;
  summary: string;
  bullets: string[];
}

interface EnterpriseSection {
  title: string;
  intro: string;
  columns: EnterpriseColumn[];
}

const toolAProfile = getToolProfile(comparison.tool_a_id);
const toolBProfile = getToolProfile(comparison.tool_b_id);

const enterpriseSections: EnterpriseSection[] = ENTERPRISE_SECTION_META.map((meta) => {
  const columns = [
    { name: comparison.tool_a_name, entry: toolAProfile?.enterprise_analysis?.[meta.key] },
    { name: comparison.tool_b_name, entry: toolBProfile?.enterprise_analysis?.[meta.key] },
  ]
    .filter((column): column is { name: string; entry: EnterpriseAnalysis } => Boolean(column.entry))
    .map(({ name, entry }) => ({ name, summary: entry.summary, bullets: entry.bullets }));

  return { title: meta.title, intro: meta.intro, columns };
}).filter((section) => section.columns.length > 0);

const richSnippetSchema = [
  {
    tool: comparison.tool_a_name,
    narrative: toolANarrative,
  },
  {
    tool: comparison.tool_b_name,
    narrative: toolBNarrative,
  },
]
  .filter((entry) => entry.narrative.reviewCountNumeric !== null)
  .map((entry) => ({
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: entry.tool,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web-based',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
      description: 'Contact for custom enterprise pricing / Free demo',
    },
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: entry.narrative.rating,
      reviewCount: entry.narrative.reviewCountNumeric,
    },
  }));

/**
 * Every tool pairing is published once per audience segment, so the segment has
 * to appear in the H1 or all variants of a pairing share one heading and compete
 * with each other. This uses `niche_name` rather than `niche_id` because it is
 * the per-row label `meta_title` already uses, including sub-niche splits like
 * "Mid-Market Scaleups" vs "Scaleups", so the heading and the title tag always
 * name the same audience.
 */
const pageTitle = `${comparison.tool_a_name} vs ${comparison.tool_b_name} for ${comparison.niche_name} (${currentMonthYear} Comparison)`;
const pageHeading = `${comparison.tool_a_name} vs ${comparison.tool_b_name} for ${comparison.niche_name}: Detailed Comparison for ${currentMonthYear}`;

const winnerName =
  comparison.winner_id === comparison.tool_a_id
    ? comparison.tool_a_name
    : comparison.winner_id === comparison.tool_b_id
      ? comparison.tool_b_name
      : comparison.winner_id;

const toolAIsWinner = comparison.winner_id === comparison.tool_a_id;
const toolBIsWinner = comparison.winner_id === comparison.tool_b_id;
const toolAAffiliateHref = resolveOutboundHref(comparison.tool_a_id, comparison.tool_a_affiliate_url);
const toolBAffiliateHref = resolveOutboundHref(comparison.tool_b_id, comparison.tool_b_affiliate_url);
// Derived from the resolved href rather than hardcoded per CTA, so the five
// duplicated link blocks per tool can never drift apart. See src/lib/links.ts.
const toolARel = outboundRel(toolAAffiliateHref);
const toolBRel = outboundRel(toolBAffiliateHref);
const toolAIsManualLead = isManualLeadBrand(comparison.tool_a_id);
const toolBIsManualLead = isManualLeadBrand(comparison.tool_b_id);
const toolAModalId = manualLeadModalId(comparison.tool_a_name);
const toolBModalId = manualLeadModalId(comparison.tool_b_name);
const toolABadgeColor = logoBadgeColor(comparison.tool_a_name);
const toolBBadgeColor = logoBadgeColor(comparison.tool_b_name);

// Ratings always reflect the real, consistent scores from the CSV source data.
const toolADisplayRating = comparison.tool_a_rating;
const toolBDisplayRating = comparison.tool_b_rating;

// For comparisons against a global partner platform (Deel, Remote, Oyster, Gusto),
// the verdict is framed around a specific use case (Global EOR, International
// Contractor Management, SMB Usability) rather than a blanket "better overall"
// claim. Other comparisons fall back to the generic overall-winner framing.
const isUseCaseVerdict = comparison.winner_category && comparison.winner_category !== 'Overall Fit';
const winnerBullets = parsePipeList(comparison.winner_bullets ?? '');
const winnerBadgeText = isUseCaseVerdict ? `Winner: ${comparison.winner_category}` : 'Winner';

function extractMonthlyPrice(price: string): number | null {
  const match = price.match(/\$([\d.]+)/);
  return match ? parseFloat(match[1]) : null;
}

function contractorPaymentAnswer(current: Comparison, matrix: Record<string, FeatureMatrixEntry>): string {
  const relevantKeys = ['Contractor Auto-Pay', 'Native Legal Entities', 'Zero FX Rate Markup', 'Global Tax Filings'];
  const key = relevantKeys.find((candidate) => matrix[candidate]);

  if (!key) {
    return cleanCopy(
      `Both ${current.tool_a_name} and ${current.tool_b_name} support paying international contractors, though coverage and payout speed can vary by country, so confirm details with each vendor for your specific markets.`
    );
  }

  const entry = matrix[key];
  if (entry.a && entry.b) {
    return cleanCopy(
      `Yes, both ${current.tool_a_name} and ${current.tool_b_name} support ${key.toLowerCase()} for paying international contractors.`
    );
  }
  if (entry.a || entry.b) {
    const supporter = entry.a ? current.tool_a_name : current.tool_b_name;
    const other = entry.a ? current.tool_b_name : current.tool_a_name;
    return cleanCopy(
      `${supporter} offers ${key.toLowerCase()}, giving it the edge over ${other} for paying international contractors.`
    );
  }
  return cleanCopy(
    `Neither ${current.tool_a_name} nor ${current.tool_b_name} lists ${key.toLowerCase()} in this comparison, so confirm contractor payout coverage with each vendor directly.`
  );
}

const priceA = extractMonthlyPrice(comparison.tool_a_starting_price);
const priceB = extractMonthlyPrice(comparison.tool_b_starting_price);
const priceDiffSentence =
  priceA !== null && priceB !== null
    ? ` That's a difference of $${Math.abs(priceA - priceB).toFixed(2).replace(/\.00$/, '')} at the entry tier.`
    : '';

// The pricing fine print (add-ons, FX spreads, per-module gating) is the most
// citable detail on the page, so it is folded into the pricing FAQ answer as
// well as the on-page callout: `faqItems` feeds the FAQPage JSON-LD, which is
// where answer engines read pricing claims from. Each nuance is prefixed with
// its vendor name because the strings themselves lead with a price rather than
// a brand, and attribution has to survive being read out of context.
const pricingNuanceAttributions = [
  comparison.tool_a_pricing_nuance
    ? `${comparison.tool_a_name}: ${comparison.tool_a_pricing_nuance}`
    : '',
  comparison.tool_b_pricing_nuance
    ? `${comparison.tool_b_name}: ${comparison.tool_b_pricing_nuance}`
    : '',
].filter(Boolean);

const pricingNuanceClause = pricingNuanceAttributions.length
  ? ` Beyond the headline rates, here is the fine print. ${pricingNuanceAttributions.join(' ')}`
  : '';

const faqIntro = isUseCaseVerdict
  ? `${comparison.winner_label}. `
  : `${winnerName} is the better fit for ${comparison.niche_audience_phrase}. `;

const faqItems: FaqItem[] = [
  {
    question: `Is ${comparison.tool_a_name} or ${comparison.tool_b_name} better for ${comparison.niche_name}?`,
    answer: cleanCopy(`${faqIntro}${comparison.winner_reason}`),
  },
  {
    question: `What is the starting price difference between ${comparison.tool_a_name} and ${comparison.tool_b_name}?`,
    answer: cleanCopy(
      `${comparison.tool_a_name} starts at ${comparison.tool_a_starting_price}; ${comparison.tool_a_pricing_model}. ${comparison.tool_b_name} starts at ${comparison.tool_b_starting_price}; ${comparison.tool_b_pricing_model}.${priceDiffSentence}${pricingNuanceClause}`
    ),
  },
  {
    question: `Does ${comparison.tool_a_name} or ${comparison.tool_b_name} handle international contractor payments?`,
    answer: contractorPaymentAnswer(comparison, featureMatrix),
  },
];

const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const siteRootUrl = new URL('/', Astro.site ?? Astro.url.origin).href;
const schemaGraph = buildSchemaGraph(
  comparison,
  pageUrl,
  siteRootUrl,
  faqItems,
  toolADisplayRating,
  toolBDisplayRating,
  toolANarrative.reviewCountNumeric,
  toolBNarrative.reviewCountNumeric,
  firstPublishedIso,
  lastUpdatedIso,
  pageTitle
);

const winnerPros = toolAIsWinner ? toolAPros : toolBPros;
const winnerCons = toolAIsWinner ? toolACons : toolBCons;
const winnerFeatures = toolAIsWinner ? toolAFeatures : toolBFeatures;
const winnerPrice = toolAIsWinner ? comparison.tool_a_starting_price : comparison.tool_b_starting_price;
const winnerPricingModel = toolAIsWinner ? comparison.tool_a_pricing_model : comparison.tool_b_pricing_model;
const runnerUpName = toolAIsWinner ? comparison.tool_b_name : comparison.tool_a_name;
const runnerUpPros = toolAIsWinner ? toolBPros : toolAPros;
const runnerUpCons = toolAIsWinner ? toolBCons : toolACons;
const runnerUpFeatures = toolAIsWinner ? toolBFeatures : toolAFeatures;
const runnerUpPrice = toolAIsWinner ? comparison.tool_b_starting_price : comparison.tool_a_starting_price;
const runnerUpPricingModel = toolAIsWinner ? comparison.tool_b_pricing_model : comparison.tool_a_pricing_model;

const contractorAutoPayEntry = featureMatrix['Contractor Auto-Pay'];
const winnerHasContractorAutoPay = contractorAutoPayEntry
  ? toolAIsWinner
    ? contractorAutoPayEntry.a
    : contractorAutoPayEntry.b
  : null;
const contractorAutomationPhrase =
  winnerHasContractorAutoPay === true
    ? 'automated contractor pay runs keep cross-border payouts on schedule without manual spreadsheet reconciliation'
    : 'structured payout workflows keep contractor payments organized even as the team scales into new markets';

function capitalizeAcronyms(text: string): string {
  return text.replace(/\beor\b/gi, 'EOR').replace(/\bus\b/gi, 'US');
}

const winnerEdgeParagraph = capitalizeAcronyms(
  cleanCopy(
    `${winnerName} earns the top spot for ${comparison.niche_audience_phrase} because its platform is built around the operational realities this segment faces day to day. Teams lean on ${
      winnerFeatures[0] ? winnerFeatures[0].toLowerCase() : 'its core feature set'
    }${winnerFeatures[1] ? ` and ${winnerFeatures[1].toLowerCase()}` : ''} to keep onboarding, compliance, and payroll cycles moving without manual busywork, while ${contractorAutomationPhrase}. Pricing reinforces the edge too: starting at ${winnerPrice} (${winnerPricingModel}), ${winnerName} keeps the cost of scaling predictable as headcount grows across new markets. Combined with ${
      winnerPros[0] ? winnerPros[0].toLowerCase() : 'strong operational fundamentals'
    }${winnerPros[1] ? ` and ${winnerPros[1].toLowerCase()}` : ''}, it is the more complete fit for ${comparison.niche_audience_phrase.toLowerCase()} that need speed, compliance, and automation working together rather than bolted on after the fact.`
  )
);

const runnerUpFitParagraph = capitalizeAcronyms(
  cleanCopy(
    `${runnerUpName} is not without merit, particularly for ${comparison.niche_audience_phrase.toLowerCase()} that value ${
      runnerUpPros[0] ? runnerUpPros[0].toLowerCase() : 'a simpler, more familiar workflow'
    }${runnerUpPros[1] ? ` and ${runnerUpPros[1].toLowerCase()}` : ''}. It performs well on ${
      runnerUpFeatures[0] ? runnerUpFeatures[0].toLowerCase() : 'its core feature set'
    }, and its pricing, starting at ${runnerUpPrice} (${runnerUpPricingModel}), can look attractive at first glance. That said, ${runnerUpName} shows its limits here: ${
      runnerUpCons[0] ? runnerUpCons[0].toLowerCase() : 'it lacks some of the deeper automation this niche eventually needs'
    }, and it trails ${winnerName} on the international contractor workflows that matter most for ${comparison.niche_audience_phrase.toLowerCase()} operating across borders. It remains a reasonable option if your priorities shift, but it is the secondary choice in this comparison, not the primary recommendation.`
  )
);

const decisionFrameworkParagraph = capitalizeAcronyms(
  cleanCopy(
    `Choosing between ${comparison.tool_a_name} and ${comparison.tool_b_name} ultimately comes down to three variables: team size, global expansion plans, and budget. Smaller ${comparison.niche_audience_phrase.toLowerCase()} with a handful of hires and no near-term plans to hire across borders can reasonably choose either platform, with cost likely deciding it. Teams that are actively expanding into new countries, adding contractors in multiple currencies, or scaling headcount quickly should prioritize ${winnerName} for its stronger automation and compliance coverage at ${winnerPrice}. If your roadmap stays narrower, mostly domestic payroll with occasional contractor hires, ${runnerUpName} at ${runnerUpPrice} remains a budget-friendly, lower-complexity alternative worth shortlisting alongside ${winnerName} before you commit.`
  )
);
---

<Layout title={pageTitle} description={comparison.meta_description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
  {richSnippetSchema.length > 0 && (
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(richSnippetSchema)} />
  )}
  <meta slot="head" property="og:updated_time" content={lastUpdatedIso} />
  <meta slot="head" name="revised" content={lastUpdatedIso} />

  <main class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
      <!--
        Manual lead-capture modals for brands awaiting affiliate approval
        (Plane, Rippling, Lever, JazzHR). Mounted once per tool (not wrapped
        in display:none — that permanently hid the backdrop) so every CTA
        below can open the same instance via data-modal-target={toolXModalId}.
        modalId is passed explicitly so it always matches the button attribute.
      -->
      {toolAIsManualLead && (
        <ManualLeadModal
          brandName={comparison.tool_a_name}
          vendorId={comparison.tool_a_id}
          modalId={toolAModalId}
          partnerLandingUrl={getToolProfile(comparison.tool_a_id)?.partner_landing_url ?? ''}
        />
      )}
      {toolBIsManualLead && (
        <ManualLeadModal
          brandName={comparison.tool_b_name}
          vendorId={comparison.tool_b_id}
          modalId={toolBModalId}
          partnerLandingUrl={getToolProfile(comparison.tool_b_id)?.partner_landing_url ?? ''}
        />
      )}

      <!-- Hero Section -->
      <header class="mb-10">
        <nav aria-label="Breadcrumb">
          <ol class="flex flex-wrap items-center gap-2 text-sm text-slate-500">
            <li>
              <a href="/" class="transition hover:text-indigo-600">Home</a>
            </li>
            <li aria-hidden="true" class="text-slate-300">&gt;</li>
            <li>
              <a href="/" class="transition hover:text-indigo-600">Comparisons</a>
            </li>
            <li aria-hidden="true" class="text-slate-300">&gt;</li>
            <li class="font-medium text-indigo-600" aria-current="page">
              {comparison.tool_a_name} vs {comparison.tool_b_name}
            </li>
          </ol>
        </nav>

        <div class="mt-4 flex flex-wrap items-center gap-3">
          <span class="inline-flex items-center rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-emerald-700">
            {currentMonthYear} Verified
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-semibold text-slate-500" title="Reflects when the underlying comparison data was last revised">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5 text-slate-400" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm.75-13a.75.75 0 0 0-1.5 0v5c0 .199.079.39.22.53l3.5 3.5a.75.75 0 1 0 1.06-1.06l-3.28-3.28V5Z" clip-rule="evenodd" />
            </svg>
            Updated: {lastUpdatedLabel}
          </span>
        </div>

        <div class="mt-4 flex items-center gap-3">
          <div class="relative inline-flex h-10 w-10 shrink-0">
            <img
              src={comparison.tool_a_logo_url}
              alt={`${comparison.tool_a_name} logo`}
              class="w-10 h-10 rounded-lg object-contain bg-slate-100 aspect-square"
              width="40"
              height="40"
              decoding="async"
              loading="lazy"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            />
            <div
              class:list={[
                'hidden h-10 w-10 items-center justify-center rounded-lg text-sm font-bold uppercase text-white',
                toolABadgeColor,
              ]}
              aria-hidden="true"
            >
              {comparison.tool_a_name.charAt(0)}
            </div>
          </div>
          <span class="text-sm font-semibold uppercase tracking-wide text-slate-400">vs</span>
          <div class="relative inline-flex h-10 w-10 shrink-0">
            <img
              src={comparison.tool_b_logo_url}
              alt={`${comparison.tool_b_name} logo`}
              class="w-10 h-10 rounded-lg object-contain bg-slate-100 aspect-square"
              width="40"
              height="40"
              decoding="async"
              loading="lazy"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            />
            <div
              class:list={[
                'hidden h-10 w-10 items-center justify-center rounded-lg text-sm font-bold uppercase text-white',
                toolBBadgeColor,
              ]}
              aria-hidden="true"
            >
              {comparison.tool_b_name.charAt(0)}
            </div>
          </div>
        </div>

        <h1 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl">
          {pageHeading}
        </h1>

        <p class="mt-4 max-w-3xl text-lg leading-relaxed text-slate-600">
          {cleanCopy(comparison.target_audience)}
        </p>

        <p class="mt-3 text-sm font-medium text-slate-500">
          Reviewed by B2B Software Operations Analysts • Updated {lastUpdatedLabel} • Independent Evaluation
        </p>

        <div class="mt-6 flex flex-wrap gap-3">
          {toolAIsManualLead ? (
            <button
              type="button"
              data-modal-target={toolAModalId}
              class="open-modal-btn inline-flex items-center justify-center rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
            >
              Request Intro &amp; Pricing for {comparison.tool_a_name}
            </button>
          ) : (
            <a
              href={toolAAffiliateHref}
              class="js-affiliate-cta inline-flex items-center justify-center rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
              target="_blank"
              rel={toolARel}
              data-track-vendor={comparison.tool_a_name}
              data-track-location="hero"
            >
              Try {comparison.tool_a_name}
            </a>
          )}
          {toolBIsManualLead ? (
            <button
              type="button"
              data-modal-target={toolBModalId}
              class="open-modal-btn inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-indigo-300 hover:text-indigo-700 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
            >
              Request Intro &amp; Pricing for {comparison.tool_b_name}
            </button>
          ) : (
            <a
              href={toolBAffiliateHref}
              class="js-affiliate-cta inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-indigo-300 hover:text-indigo-700 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
              target="_blank"
              rel={toolBRel}
              data-track-vendor={comparison.tool_b_name}
              data-track-location="hero"
            >
              Try {comparison.tool_b_name}
            </a>
          )}
        </div>

        <!--
          FTC/ASA disclosure: kept directly beneath the hero CTAs so it stays
          above the fold, immediately adjacent to the affiliate links it covers.
        -->
        <p class="text-xs text-slate-500 mt-2 mb-4">
          <span class="font-medium text-slate-500">Disclosure:</span> The HR Stack Guide is an independent evaluation hub. We may earn a commission if you sign up through our links at no extra cost to you.
          <a href="/affiliate-disclosure" class="text-slate-500 underline underline-offset-2 hover:text-indigo-600">Read full disclosure</a>.
        </p>
      </header>

      <!-- The HR Stack Take: executive takeaway above the comparison tables -->
      {comparison.hr_stack_take && (
        <blockquote class="my-6 rounded-r-lg border-l-4 border-indigo-600 bg-slate-50 p-4 font-medium text-slate-800">
          <p class="text-xs font-bold uppercase tracking-wide text-indigo-700">The HR Stack Take</p>
          <p class="mt-2 text-base leading-relaxed">{cleanCopy(comparison.hr_stack_take)}</p>
        </blockquote>
      )}

      <!-- SECTION 2: At-a-Glance Comparison Matrix -->
      <h2 class="mb-6 text-2xl font-bold text-slate-900">
        At a Glance: {comparison.tool_a_name} vs {comparison.tool_b_name}
      </h2>

      <!-- Side-by-Side Cards -->
      <section class="mb-12 grid gap-6 lg:grid-cols-2" aria-label="Tool comparison cards">
        <!-- Tool A -->
        <article
          class:list={[
            'relative flex flex-col rounded-2xl border bg-white p-6 shadow-sm transition hover:shadow-md sm:p-8',
            toolAIsWinner ? 'border-emerald-300 ring-2 ring-emerald-100' : 'border-slate-200',
          ]}
        >
          {toolAIsWinner && (
            <span class="absolute -top-3 left-6 inline-flex items-center rounded-full bg-emerald-600 px-3 py-1 text-xs font-semibold text-white shadow">
              {winnerBadgeText}
            </span>
          )}

          <div class="flex items-center gap-4">
            <div class="relative inline-flex h-10 w-10 shrink-0">
              <img
                src={comparison.tool_a_logo_url}
                alt={`${comparison.tool_a_name} logo`}
                class="w-10 h-10 rounded-lg object-contain bg-slate-100 aspect-square"
                width="40"
              height="40"
              decoding="async"
              loading="lazy"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
              />
              <div
                class:list={[
                  'hidden h-10 w-10 items-center justify-center rounded-lg text-sm font-bold uppercase text-white',
                  toolABadgeColor,
                ]}
                aria-hidden="true"
              >
                {comparison.tool_a_name.charAt(0)}
              </div>
            </div>
            <div>
              {comparison.tool_a_badge && (
                <span class="mb-1.5 inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700">
                  {comparison.tool_a_badge}
                </span>
              )}
              <h2 class="text-2xl font-bold text-slate-900">{comparison.tool_a_name}</h2>
              <p class="mt-1 text-sm font-medium text-slate-500">
                ⭐️ {toolANarrative.rating}/5{toolANarrative.reviewCountLabel && ` (${toolANarrative.reviewCountLabel}+ reviews)`}
              </p>
              {toolANarrative.ratingSource && (
                <p class="mt-1 text-xs text-slate-400">Based on {toolANarrative.ratingSource} user reviews</p>
              )}
            </div>
          </div>

          <div class="mt-6 space-y-3 border-t border-slate-100 pt-6">
            <div class="flex items-baseline justify-between gap-4">
              <span class="text-sm text-slate-500">Starting price</span>
              <span class="text-2xl font-bold text-indigo-600">{comparison.tool_a_starting_price}</span>
            </div>
            <div class="flex items-start justify-between gap-4">
              <span class="text-sm text-slate-500">Pricing model</span>
              <span class="max-w-[60%] text-right text-sm font-medium text-slate-700">{comparison.tool_a_pricing_model}</span>
            </div>
            <div class="flex items-center justify-between gap-4">
              <span class="text-sm text-slate-500">Free trial</span>
              <span
                class:list={[
                  'inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold',
                  parseBool(comparison.tool_a_free_trial)
                    ? 'bg-emerald-50 text-emerald-700'
                    : 'bg-slate-100 text-slate-600',
                ]}
              >
                {parseBool(comparison.tool_a_free_trial) ? 'Available' : 'Not available'}
              </span>
            </div>
          </div>

          {toolAFeatures.length > 0 && (
            <ul class="mt-6 space-y-2 border-t border-slate-100 pt-6">
              {toolAFeatures.map((feature) => (
                <li class="flex items-start gap-2 text-sm text-slate-600">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 h-4 w-4 shrink-0 text-indigo-500" aria-hidden="true">
                    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>
          )}

          {toolAIsManualLead ? (
            <button
              type="button"
              data-modal-target={toolAModalId}
              class="open-modal-btn mt-8 inline-flex w-full items-center justify-center rounded-xl bg-indigo-600 px-6 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
            >
              Request Intro &amp; Pricing
            </button>
          ) : (
            <a
              href={toolAAffiliateHref}
              class="js-affiliate-cta mt-8 inline-flex w-full items-center justify-center rounded-xl bg-indigo-600 px-6 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
              target="_blank"
              rel={toolARel}
              data-track-vendor={comparison.tool_a_name}
              data-track-location="comparison_card"
            >
              Try {comparison.tool_a_name}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="ml-2 h-4 w-4" aria-hidden="true">
                <path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 0 1 .75-.75h8.5a.75.75 0 0 1 .75.75v5.75a.75.75 0 0 1-1.5 0V7.06l-7.47 7.47a.75.75 0 0 1-1.06-1.06L11.94 6H5.5a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd" />
              </svg>
            </a>
          )}
        </article>

        <!-- Tool B -->
        <article
          class:list={[
            'relative flex flex-col rounded-2xl border bg-white p-6 shadow-sm transition hover:shadow-md sm:p-8',
            toolBIsWinner ? 'border-emerald-300 ring-2 ring-emerald-100' : 'border-slate-200',
          ]}
        >
          {toolBIsWinner && (
            <span class="absolute -top-3 left-6 inline-flex items-center rounded-full bg-emerald-600 px-3 py-1 text-xs font-semibold text-white shadow">
              {winnerBadgeText}
            </span>
          )}

          <div class="flex items-center gap-4">
            <div class="relative inline-flex h-10 w-10 shrink-0">
              <img
                src={comparison.tool_b_logo_url}
                alt={`${comparison.tool_b_name} logo`}
                class="w-10 h-10 rounded-lg object-contain bg-slate-100 aspect-square"
                width="40"
              height="40"
              decoding="async"
              loading="lazy"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
              />
              <div
                class:list={[
                  'hidden h-10 w-10 items-center justify-center rounded-lg text-sm font-bold uppercase text-white',
                  toolBBadgeColor,
                ]}
                aria-hidden="true"
              >
                {comparison.tool_b_name.charAt(0)}
              </div>
            </div>
            <div>
              {comparison.tool_b_badge && (
                <span class="mb-1.5 inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700">
                  {comparison.tool_b_badge}
                </span>
              )}
              <h2 class="text-2xl font-bold text-slate-900">{comparison.tool_b_name}</h2>
              <p class="mt-1 text-sm font-medium text-slate-500">
                ⭐️ {toolBNarrative.rating}/5{toolBNarrative.reviewCountLabel && ` (${toolBNarrative.reviewCountLabel}+ reviews)`}
              </p>
              {toolBNarrative.ratingSource && (
                <p class="mt-1 text-xs text-slate-400">Based on {toolBNarrative.ratingSource} user reviews</p>
              )}
            </div>
          </div>

          <div class="mt-6 space-y-3 border-t border-slate-100 pt-6">
            <div class="flex items-baseline justify-between gap-4">
              <span class="text-sm text-slate-500">Starting price</span>
              <span class="text-2xl font-bold text-indigo-600">{comparison.tool_b_starting_price}</span>
            </div>
            <div class="flex items-start justify-between gap-4">
              <span class="text-sm text-slate-500">Pricing model</span>
              <span class="max-w-[60%] text-right text-sm font-medium text-slate-700">{comparison.tool_b_pricing_model}</span>
            </div>
            <div class="flex items-center justify-between gap-4">
              <span class="text-sm text-slate-500">Free trial</span>
              <span
                class:list={[
                  'inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold',
                  parseBool(comparison.tool_b_free_trial)
                    ? 'bg-emerald-50 text-emerald-700'
                    : 'bg-slate-100 text-slate-600',
                ]}
              >
                {parseBool(comparison.tool_b_free_trial) ? 'Available' : 'Not available'}
              </span>
            </div>
          </div>

          {toolBFeatures.length > 0 && (
            <ul class="mt-6 space-y-2 border-t border-slate-100 pt-6">
              {toolBFeatures.map((feature) => (
                <li class="flex items-start gap-2 text-sm text-slate-600">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 h-4 w-4 shrink-0 text-indigo-500" aria-hidden="true">
                    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>
          )}

          {toolBIsManualLead ? (
            <button
              type="button"
              data-modal-target={toolBModalId}
              class="open-modal-btn mt-8 inline-flex w-full items-center justify-center rounded-xl bg-indigo-600 px-6 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
            >
              Request Intro &amp; Pricing
            </button>
          ) : (
            <a
              href={toolBAffiliateHref}
              class="js-affiliate-cta mt-8 inline-flex w-full items-center justify-center rounded-xl bg-indigo-600 px-6 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
              target="_blank"
              rel={toolBRel}
              data-track-vendor={comparison.tool_b_name}
              data-track-location="comparison_card"
            >
              Try {comparison.tool_b_name}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="ml-2 h-4 w-4" aria-hidden="true">
                <path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 0 1 .75-.75h8.5a.75.75 0 0 1 .75.75v5.75a.75.75 0 0 1-1.5 0V7.06l-7.47 7.47a.75.75 0 0 1-1.06-1.06L11.94 6H5.5a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd" />
              </svg>
            </a>
          )}
        </article>
      </section>

      <!-- Pricing Nuance: the fine print behind the headline rates above -->
      {(comparison.tool_a_pricing_nuance || comparison.tool_b_pricing_nuance) && (
        <section class="mb-12" aria-label="Pricing nuance and hidden fees">
          <h3 class="mb-2 text-xl font-bold text-slate-900">Pricing Nuance &amp; Hidden Fees</h3>
          <p class="mb-4 max-w-3xl text-sm text-slate-500">
            The headline prices above rarely survive contact with a real quote. Here is what each vendor bills on top.
          </p>
          <div class="rounded-2xl border border-amber-200 bg-amber-50/60 p-6">
            <ul class="space-y-5">
              {comparison.tool_a_pricing_nuance && (
                <li class="flex items-start gap-3">
                  <span aria-hidden="true" class="shrink-0 text-base leading-6">💡</span>
                  <p class="text-sm leading-relaxed text-slate-700">
                    <strong class="font-semibold text-slate-900">
                      Pricing Nuance — {comparison.tool_a_name}:
                    </strong>{' '}
                    {cleanCopy(comparison.tool_a_pricing_nuance)}
                  </p>
                </li>
              )}
              {comparison.tool_b_pricing_nuance && (
                <li class="flex items-start gap-3">
                  <span aria-hidden="true" class="shrink-0 text-base leading-6">💡</span>
                  <p class="text-sm leading-relaxed text-slate-700">
                    <strong class="font-semibold text-slate-900">
                      Pricing Nuance — {comparison.tool_b_name}:
                    </strong>{' '}
                    {cleanCopy(comparison.tool_b_pricing_nuance)}
                  </p>
                </li>
              )}
            </ul>
          </div>
        </section>
      )}

      <!-- Feature Matrix Table -->
      {featureMatrixRows.length > 0 && (
        <section class="mb-12" aria-label="Feature comparison matrix">
          <h3 class="mb-6 text-xl font-bold text-slate-900">Feature Comparison</h3>
          <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <div class="overflow-x-auto">
              <table class="w-full min-w-[480px] text-left text-sm">
                <thead>
                  <tr class="border-b border-slate-200 bg-slate-50">
                    <th scope="col" class="px-6 py-4 align-bottom font-semibold text-slate-700">Feature</th>
                    <th scope="col" class="px-6 py-4 align-bottom font-semibold text-slate-700">
                      {comparison.tool_a_badge && (
                        <span class="mb-1.5 inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700">
                          {comparison.tool_a_badge}
                        </span>
                      )}
                      <span class="block">{comparison.tool_a_name}</span>
                    </th>
                    <th scope="col" class="px-6 py-4 align-bottom font-semibold text-slate-700">
                      {comparison.tool_b_badge && (
                        <span class="mb-1.5 inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700">
                          {comparison.tool_b_badge}
                        </span>
                      )}
                      <span class="block">{comparison.tool_b_name}</span>
                    </th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
