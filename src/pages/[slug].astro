            <span class="font-semibold text-indigo-700">Bottom line:</span> {winnerName} is the stronger overall pick for {comparison.niche_audience_phrase.toLowerCase()}, with {runnerUpName} remaining a reasonable alternative depending on your priorities.
          </p>
          <div class="flex flex-wrap gap-3">
            {toolAIsManualLead ? (
              <button
                type="button"
                data-modal-target={toolAModalId}
                class="open-modal-btn inline-flex items-center justify-center rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 hover:shadow-md"
              >
                Request Intro &amp; Pricing for {comparison.tool_a_name}
              </button>
            ) : (
              <a
                href={toolAAffiliateHref}
                class="js-affiliate-cta inline-flex items-center justify-center rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 hover:shadow-md"
                target="_blank"
                rel={toolARel}
                data-track-vendor={comparison.tool_a_name}
                data-track-location="final_verdict"
              >
                Try {comparison.tool_a_name}
              </a>
            )}
            {toolBIsManualLead ? (
              <button
                type="button"
                data-modal-target={toolBModalId}
                class="open-modal-btn inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-indigo-300 hover:text-indigo-700 hover:shadow-md"
              >
                Request Intro &amp; Pricing for {comparison.tool_b_name}
              </button>
            ) : (
              <a
                href={toolBAffiliateHref}
                class="js-affiliate-cta inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-indigo-300 hover:text-indigo-700 hover:shadow-md"
                target="_blank"
                rel={toolBRel}
                data-track-vendor={comparison.tool_b_name}
                data-track-location="final_verdict"
              >
                Try {comparison.tool_b_name}
              </a>
            )}
          </div>
        </div>
      </section>

      <!-- FAQ Section -->
      <section class="mt-12" aria-label="Frequently asked questions">
        <h2 class="mb-6 text-2xl font-bold text-slate-900">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {faqItems.map((item) => (
            <details class="group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm open:shadow-md">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-semibold text-slate-900">
                {item.question}
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  class="h-5 w-5 shrink-0 text-indigo-600 transition group-open:rotate-180"
                  aria-hidden="true"
                >
                  <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.168l3.71-3.938a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" />
                </svg>
              </summary>
              <p class="mt-4 text-sm leading-relaxed text-slate-600">
                {item.answer}
              </p>
            </details>
          ))}
        </div>
      </section>

      <RelatedComparisons related={relatedComparisons} />
    </main>

    <script>
      // Client-only: Astro scripts never execute during SSR, and `track()`
      // itself no-ops outside the browser, so this is safe on the server.
      import { track } from '@vercel/analytics';

      if (typeof window !== 'undefined' && typeof document !== 'undefined') {
        document.querySelectorAll('.js-affiliate-cta[data-track-vendor]').forEach((link) => {
          link.addEventListener('click', () => {
            const vendor = link.getAttribute('data-track-vendor');
            const location = link.getAttribute('data-track-location') ?? 'unknown';
            const url = link.getAttribute('href');

            if (!vendor || !url) return;

            track('Outbound Click', { vendor, location, url });
          });
        });
      }
    </script>
</Layout>
