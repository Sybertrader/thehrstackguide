              </div>
              <div class="rounded-xl bg-slate-50 p-5">
                <h4 class="text-sm font-semibold uppercase tracking-wide text-indigo-700">{comparison.tool_b_name}</h4>
                <p class="mt-2 text-sm leading-relaxed text-slate-700">{toolBNarrative.textPricingTruth}</p>
              </div>
            </div>
          </article>
        </div>
      </section>

      <!-- SECTION 4: Decision Checklist -->
      <section class="mb-12" aria-label="Buyer decision checklist">
        <h2 class="mb-6 text-2xl font-bold text-slate-900">The Decision Checklist</h2>
        <div class="grid gap-6 lg:grid-cols-2">
          <div class="rounded-2xl border border-indigo-100 bg-indigo-50/60 p-6 sm:p-8">
            <h3 class="text-lg font-bold text-indigo-900">Choose {comparison.tool_a_name} If...</h3>
            <ul class="mt-4 space-y-3">
              {toolANarrative.chooseIf.map((reason) => (
                <li class="flex items-start gap-2.5 text-sm leading-relaxed text-slate-700">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 h-5 w-5 shrink-0 text-indigo-600" aria-hidden="true">
                    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                  </svg>
                  <span><span class="font-semibold text-slate-900">{reason}</span></span>
                </li>
              ))}
            </ul>
            <a
              href={comparison.tool_a_affiliate_url}
              class="js-affiliate-cta mt-6 inline-flex items-center justify-center rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 hover:shadow-md"
              target="_blank"
              rel="noopener noreferrer sponsored"
              data-track-vendor={comparison.tool_a_name}
              data-track-location="decision_checklist"
            >
              Try {comparison.tool_a_name}
            </a>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6 sm:p-8">
            <h3 class="text-lg font-bold text-slate-900">Choose {comparison.tool_b_name} If...</h3>
            <ul class="mt-4 space-y-3">
              {toolBNarrative.chooseIf.map((reason) => (
                <li class="flex items-start gap-2.5 text-sm leading-relaxed text-slate-700">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 h-5 w-5 shrink-0 text-slate-500" aria-hidden="true">
                    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                  </svg>
                  <span><span class="font-semibold text-slate-900">{reason}</span></span>
                </li>
              ))}
            </ul>
            <a
              href={comparison.tool_b_affiliate_url}
              class="js-affiliate-cta mt-6 inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-indigo-300 hover:text-indigo-700 hover:shadow-md"
              target="_blank"
              rel="noopener noreferrer sponsored"
              data-track-vendor={comparison.tool_b_name}
              data-track-location="decision_checklist"
            >
              Try {comparison.tool_b_name}
            </a>
          </div>
        </div>
      </section>

      <!-- SECTION 5: Final Verdict & Primary CTAs -->
      <section class="mb-12" aria-label="Final verdict">
        <h2 class="mb-6 text-2xl font-bold text-slate-900">
          Final Verdict for {comparison.niche_name}
        </h2>

        <!-- Winner Banner -->
        <div class="mb-6 overflow-hidden rounded-2xl border border-emerald-200 bg-gradient-to-r from-emerald-50 via-white to-slate-50 shadow-sm">
          <div class="flex flex-col gap-4 p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8">
            <div class="flex items-start gap-4">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-emerald-600 text-white shadow-md">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6" aria-hidden="true">
                  <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" clip-rule="evenodd" />
                </svg>
              </div>
              <div>
                <div class="flex flex-wrap items-center gap-2">
                  <span class="inline-flex items-center rounded-full bg-emerald-600 px-2.5 py-0.5 text-xs font-semibold text-white">
                    {isUseCaseVerdict ? `Best for ${comparison.winner_category}` : 'Recommended Choice'}
                  </span>
                </div>
                <h3 class="mt-2 text-xl font-bold text-slate-900 sm:text-2xl">
                  {isUseCaseVerdict ? comparison.winner_label : `${winnerName} is the winner`}
                </h3>
                <p class="mt-2 max-w-2xl text-base leading-relaxed text-slate-600">
                  {cleanCopy(comparison.winner_reason)}
                </p>
                {winnerBullets.length > 0 && (
                  <ul class="mt-3 max-w-2xl space-y-1.5">
                    {winnerBullets.map((bullet) => (
                      <li class="flex items-start gap-2 text-sm text-slate-600">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 h-4 w-4 shrink-0 text-emerald-600" aria-hidden="true">
                          <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                        </svg>
                        {bullet}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          </div>
        </div>

        <article class="space-y-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
          <div>
            <h3 class="text-lg font-semibold text-slate-900">The Winner's Edge</h3>
            <p class="mt-2 text-base leading-relaxed text-slate-700">
              {winnerEdgeParagraph}
            </p>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-slate-900">Where {runnerUpName} Fits</h3>
            <p class="mt-2 text-base leading-relaxed text-slate-700">
              {runnerUpFitParagraph}
            </p>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-slate-900">Final Recommendation</h3>
            <p class="mt-2 text-base leading-relaxed text-slate-700">
              {decisionFrameworkParagraph}
            </p>
          </div>
        </article>

        <!-- Final Primary CTAs -->
        <div class="mt-6 flex flex-col items-start gap-4 rounded-2xl border border-indigo-100 bg-indigo-50/60 p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8">
          <p class="text-sm leading-relaxed text-slate-700 sm:max-w-md">
            <span class="font-semibold text-indigo-700">Bottom line:</span> {winnerName} is the stronger overall pick for {comparison.niche_audience_phrase.toLowerCase()}, with {runnerUpName} remaining a reasonable alternative depending on your priorities.
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              href={comparison.tool_a_affiliate_url}
              class="js-affiliate-cta inline-flex items-center justify-center rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 hover:shadow-md"
              target="_blank"
              rel="noopener noreferrer sponsored"
              data-track-vendor={comparison.tool_a_name}
              data-track-location="final_verdict"
            >
              Try {comparison.tool_a_name}
            </a>
            <a
              href={comparison.tool_b_affiliate_url}
              class="js-affiliate-cta inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-indigo-300 hover:text-indigo-700 hover:shadow-md"
              target="_blank"
              rel="noopener noreferrer sponsored"
              data-track-vendor={comparison.tool_b_name}
              data-track-location="final_verdict"
            >
              Try {comparison.tool_b_name}
            </a>
          </div>
        </div>
      </section>

      <!-- FAQ Section -->
      <section class="mt-12" aria-label="Frequently asked questions">
        <h2 class="mb-6 text-2xl font-bold text-slate-900">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {faqItems.map((item) => (
            <details class="group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm open:shadow-md">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-semibold text-slate-900">
                {item.question}
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  class="h-5 w-5 shrink-0 text-indigo-600 transition group-open:rotate-180"
                  aria-hidden="true"
                >
                  <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.168l3.71-3.938a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" />
                </svg>
              </summary>
              <p class="mt-4 text-sm leading-relaxed text-slate-600">
                {item.answer}
              </p>
            </details>
          ))}
        </div>
      </section>

      <!-- Related Comparisons -->
      {related.length > 0 && (
        <section class="mt-16" aria-label={`Related comparisons for ${comparison.niche_name}`}>
          <h2 class="mb-6 text-2xl font-bold text-slate-900">
            Related Comparisons for {comparison.niche_name}
          </h2>
          <div class="grid gap-6 sm:grid-cols-3">
            {related.map((item) => (
              <a
                href={`/${item.slug}`}
                class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-indigo-200 hover:shadow-md"
              >
                <span class="text-xs font-semibold uppercase tracking-wide text-indigo-600">
                  {item.niche_name}
                </span>
                <h3 class="mt-2 text-lg font-semibold text-slate-900 transition group-hover:text-indigo-600">
                  {item.tool_a_name} vs {item.tool_b_name}
                </h3>
                <span class="mt-4 inline-flex items-center text-sm font-semibold text-indigo-600">
                  View comparison
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="ml-1 h-4 w-4" aria-hidden="true">
                    <path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 0 1 .75-.75h8.5a.75.75 0 0 1 .75.75v5.75a.75.75 0 0 1-1.5 0V7.06l-7.47 7.47a.75.75 0 0 1-1.06-1.06L11.94 6H5.5a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd" />
                  </svg>
                </span>
              </a>
            ))}
          </div>
        </section>
      )}
    </main>

    <script>
      // Client-only: Astro scripts never execute during SSR, and `track()`
      // itself no-ops outside the browser, so this is safe on the server.
      import { track } from '@vercel/analytics';

      if (typeof window !== 'undefined' && typeof document !== 'undefined') {
        document.querySelectorAll('.js-affiliate-cta[data-track-vendor]').forEach((link) => {
          link.addEventListener('click', () => {
            const vendor = link.getAttribute('data-track-vendor');
            const location = link.getAttribute('data-track-location') ?? 'unknown';
            const url = link.getAttribute('href');

            if (!vendor || !url) return;

            track('Outbound Click', { vendor, location, url });
          });
        });
      }
    </script>
</Layout>
