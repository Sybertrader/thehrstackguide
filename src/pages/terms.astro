---
import Layout from '../layouts/Layout.astro';

const lastUpdated = 'September 2026';
const pageTitle = 'Terms of Service — The HR Stack Guide';
const pageDescription =
  'Terms of Service for The HR Stack Guide, operated by Stack Guide Media. These terms cover informational use of comparison content, affiliate links, intellectual property, and limitation of liability.';
---

<Layout
  title={pageTitle}
  heading={pageTitle}
  description={pageDescription}
>
  <main class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <header class="mb-10">
      <nav aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 text-sm text-slate-500">
          <li><a href="/" class="transition hover:text-indigo-600">Home</a></li>
          <li aria-hidden="true" class="text-slate-300">&gt;</li>
          <li class="font-medium text-indigo-600" aria-current="page">Terms of Service</li>
        </ol>
      </nav>
      <h1 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        {pageTitle}
      </h1>
      <p class="mt-3 text-sm font-medium text-slate-500">Last updated: {lastUpdated}</p>
    </header>

    <article class="space-y-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
      <section>
        <p class="text-base leading-relaxed text-slate-700">
          These Terms of Service ("Terms") govern your access to and use of The HR Stack Guide (the "Site"),
          operated by Stack Guide Media ("Stack Guide Media," "we," "us," or "our"). By accessing or using the
          Site, you agree to be bound by these Terms.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-slate-900">1. Informational Purpose Only</h2>
        <p class="mt-2 text-base leading-relaxed text-slate-700">
          Content on the Site—including vendor comparisons, ratings, pricing breakdowns, and feature
          matrices—is provided for general informational purposes only. It does not constitute legal,
          financial, tax, or HR compliance advice. Vendor pricing, capabilities, and contract terms change
          frequently; always verify current details directly with the vendor before making purchasing
          decisions.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-slate-900">2. No Warranty</h2>
        <p class="mt-2 text-base leading-relaxed text-slate-700">
          While we strive for accuracy across all comparison routes, the Site is provided on an "as is" and
          "as available" basis without warranties of any kind, express or implied. We do not guarantee
          complete accuracy, completeness, or fitness for a particular business requirement.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-slate-900">3. Affiliate Disclosure &amp; Commercial Links</h2>
        <p class="mt-2 text-base leading-relaxed text-slate-700">
          The Site contains affiliate links to third-party software vendors. As detailed in our
          <a href="/affiliate-disclosure/" class="font-medium text-indigo-600 hover:underline">Affiliate Disclosure</a>,
          we may earn a referral commission when you purchase through these links at no extra cost to you.
          Commercial partnerships never dictate ratings, scores, or winner badges.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-slate-900">4. Third-Party Websites</h2>
        <p class="mt-2 text-base leading-relaxed text-slate-700">
          The Site links to external vendor websites not owned or controlled by Stack Guide Media. We are not
          responsible for third-party content, software availability, or privacy practices. Your use of
          external vendor sites is governed by their respective terms.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-slate-900">5. Limitation of Liability</h2>
        <p class="mt-2 text-base leading-relaxed text-slate-700">
          To the fullest extent permitted by law, Stack Guide Media shall not be liable for any direct,
          indirect, incidental, consequential, or punitive damages, or loss of profits arising from your
          reliance on information published on the Site or purchasing decisions made with third-party vendors.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-slate-900">6. Intellectual Property &amp; Nominative Fair Use</h2>
        <p class="mt-2 text-base leading-relaxed text-slate-700">
          Original text, layout design, and comparison frameworks on the Site belong to Stack Guide Media and
          may not be reproduced without written permission. All vendor names, logos, and registered trademarks
          belong to their respective owners and are used strictly for identification and comparative review
          purposes under nominative fair use.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-slate-900">7. Changes to Terms</h2>
        <p class="mt-2 text-base leading-relaxed text-slate-700">
          We reserve the right to update these Terms at any time. Continued use of the Site after changes are
          published constitutes acceptance of the updated Terms.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-slate-900">8. Contact Information</h2>
        <p class="mt-2 text-base leading-relaxed text-slate-700">
          Questions regarding these Terms should be sent to
          <a href="mailto:dave@thehrstackguide.com" class="font-medium text-indigo-600 hover:underline">dave@thehrstackguide.com</a>.
        </p>
      </section>
    </article>
  </main>
</Layout>
