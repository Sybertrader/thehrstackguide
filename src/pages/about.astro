---
import Layout from '../layouts/Layout.astro';
import { ORGANIZATION_SAME_AS } from '../lib/organization';

const pageTitle = 'About The HR Stack Guide | Independent HR Tech Research';
const pageHeading = 'Independent HR Technology Research';
const pageDescription =
  "Learn about The HR Stack Guide's mission, our founder Dave Storey, and our strict editorial independence policy.";

const founderName = 'Dave Storey';
const founderLinkedIn = 'https://www.linkedin.com/in/dave-storey-0053b111/';
const brandLinkedIn = 'https://www.linkedin.com/company/the-hr-stack-guide/';
const founderImagePath = '/Dave Storey.png';
const founderImageUrl = 'https://www.thehrstackguide.com/Dave%20Storey.png';

const siteUrl = new URL('/', Astro.site ?? Astro.url.origin).href;
const aboutUrl = new URL('/about/', siteUrl).href;
const daveId = `${aboutUrl}#dave-storey`;
const organizationId = 'https://www.thehrstackguide.com/#organization';

const aboutSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AboutPage',
      '@id': `${aboutUrl}#webpage`,
      name: pageTitle,
      description: pageDescription,
      url: aboutUrl,
      isPartOf: {
        '@type': 'WebSite',
        '@id': 'https://www.thehrstackguide.com/#website',
        name: 'The HR Stack Guide',
        url: siteUrl,
      },
      about: { '@id': organizationId },
      mainEntity: { '@id': daveId },
    },
    {
      '@type': 'Person',
      '@id': daveId,
      name: founderName,
      jobTitle: 'Founder & Principal Researcher',
      nationality: 'British',
      url: aboutUrl,
      image: founderImageUrl,
      worksFor: { '@id': organizationId },
      sameAs: [founderLinkedIn],
    },
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'The HR Stack Guide',
      alternateName: 'Stack Guide Media',
      legalName: 'Lonestar Assets LLC',
      url: siteUrl,
      logo: 'https://www.thehrstackguide.com/icon-512.png',
      description:
        'An independent software evaluation publication covering Employer of Record, global payroll, applicant tracking, and performance management.',
      founder: { '@id': daveId },
      email: 'contact@thehrstackguide.com',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '71-75 Shelton Street, Covent Garden',
        addressLocality: 'London',
        postalCode: 'WC2H 9JQ',
        addressCountry: 'GB',
      },
      sameAs: [...ORGANIZATION_SAME_AS],
    },
  ],
};
---

<Layout
  title={pageTitle}
  heading={pageHeading}
  description={pageDescription}
  includeOrganizationSchema={false}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(aboutSchema)} />

  <main class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
    <header class="mb-10 text-center">
      <p class="text-xs font-semibold uppercase tracking-wider text-indigo-600">About Our Publication</p>
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
        {pageHeading}
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-base text-slate-600 sm:text-lg">
        Helping People Operations leaders, CFOs, and founders build scalable, compliant, and cost-effective workforce infrastructure.
      </p>
    </header>

    <div class="max-w-none space-y-8 leading-relaxed text-slate-700">
      <section>
        <h2 class="text-2xl font-bold text-slate-900">Why We Built The HR Stack Guide</h2>
        <p class="mt-3">
          Most B2B software review directories rely on commercial models that distort buyer decisions. Aggregators frequently auction top rankings and category badges to the highest bidder in pay-per-click lead-generation auctions, while incentivizing unverified volume reviews with gift cards. These superficial product tours fail to evaluate contract lock-ins, hidden currency conversion spreads, or real-world onboarding friction.
        </p>
        <p class="mt-3">
          Selecting core HR infrastructure is fundamentally different from purchasing consumer productivity tools. Choosing the wrong Employer of Record (EOR) can expose an organization to permanent establishment risks, statutory compliance penalties, and intellectual property vulnerabilities. Deploying the wrong Applicant Tracking System (ATS) or performance management platform creates immediate operational bottlenecks across recruitment and engineering teams.
        </p>
        <p class="mt-3">
          The HR Stack Guide was created to provide transparent, unvarnished trade-offs. We analyze technical architecture, contract structures, entity ownership models, and total cost of ownership across competing workplace software providers.
        </p>
      </section>

      <section class="border-t border-slate-200 pt-8">
        <h2 class="text-2xl font-bold text-slate-900">What the Catalog Covers</h2>
        <p class="mt-3">
          The public site is 60 side-by-side comparison hubs, three category guides, and an Employer of Record cost calculator. Each comparison is a static page. The feature table, the cost model, and the buyer-profile verdict are written into the first HTML response for that specific pair. A note written for one matchup is not pasted onto another.
        </p>
        <ul class="mt-4 list-disc space-y-2 pl-6">
          <li>
            <a href="/global-payroll-eor/" class="font-medium text-indigo-600 hover:underline">Global Payroll and EOR</a> covers Deel, Remote, Rippling, Oyster HR, Gusto, Papaya Global, Multiplier, Payoneer Workforce Management, and Remote People.
          </li>
          <li>
            <a href="/applicant-tracking-systems/" class="font-medium text-indigo-600 hover:underline">Applicant Tracking Systems</a> covers Ashby, Lever, Workable, Breezy HR, JazzHR, Recruitee, and BambooHR.
          </li>
          <li>
            <a href="/performance-management/" class="font-medium text-indigo-600 hover:underline">Performance Management</a> covers PerformYard, Lattice, and Culture Amp.
          </li>
          <li>
            The <a href="/tools/eor-cost-calculator/" class="font-medium text-indigo-600 hover:underline">EOR cost calculator</a> prices a hiring scenario from published platform fees, foreign-exchange assumptions, and deposit rules. The calculation logic is open source, and the data shape is published as an OpenAPI schema.
          </li>
          <li>
            <a href="/how-to-build-an-hr-tech-stack/" class="font-medium text-indigo-600 hover:underline">How to Build an HR Tech Stack</a> walks a buyer from category choice to a shortlist before any demo is booked.
          </li>
        </ul>
      </section>

      <section class="border-t border-slate-200 pt-8">
        <h2 class="text-2xl font-bold text-slate-900">Editorial Leadership &amp; Research</h2>
        <div class="mt-4 rounded-xl border border-slate-200 bg-slate-50/60 p-6">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
            <img
              src={founderImagePath}
              alt="Dave Storey, Founder and Principal Researcher of The HR Stack Guide"
              class="h-20 w-20 shrink-0 rounded-full border border-slate-200 object-cover"
              width="80"
              height="80"
            />
            <div>
              <h3 id="dave-storey" class="text-lg font-semibold text-slate-900">Dave Storey — Founder &amp; Principal Researcher</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">
                Dave Storey has spent over 15 years evaluating, architecting, and scaling workplace technology and operational systems for high-growth businesses. Having guided talent acquisition, people operations, and workforce planning from early-stage venture backing through international scale-ups, Dave established The HR Stack Guide to address the lack of transparent, data-driven software evaluation in the mid-market.
              </p>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">
                His research focuses specifically on the unit economics of distributed hiring, cross-border compliance routing, and integration ergonomics between core HRIS platforms, modern ATS tools, and global payroll providers. Every comparison framework, cost model, and buyer profile evaluation published on The HR Stack Guide is developed under Dave’s editorial direction and verified against live platform documentation and contract terms.
              </p>
              <ul class="mt-3 flex flex-col gap-1 text-sm font-medium text-indigo-600">
                <li>
                  <a href={founderLinkedIn} target="_blank" rel="noopener noreferrer" class="hover:underline">Dave Storey on LinkedIn</a>
                </li>
                <li>
                  <a href={brandLinkedIn} target="_blank" rel="noopener noreferrer" class="hover:underline">The HR Stack Guide on LinkedIn</a>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <section class="border-t border-slate-200 pt-8">
        <h2 class="text-2xl font-bold text-slate-900">Our Editorial Independence Principles</h2>
        <p class="mt-3">
          Our editorial integrity is the foundation of our research. We adhere to three non-negotiable operational standards:
        </p>
        <ul class="mt-4 list-disc space-y-2 pl-6">
          <li>
            <strong>Zero Sponsored Rankings:</strong> Software vendors cannot purchase higher comparison ratings, favorable feature verdicts, or placement on our recommendation shortlists.
          </li>
          <li>
            <strong>Symmetrical 4-Pillar Evaluation:</strong> Every tool in a comparison is subjected to identical <a href="/methodology/" class="font-medium text-indigo-600 hover:underline">evaluation criteria</a> regardless of commercial relationships.
          </li>
          <li>
            <strong>Commercial Transparency:</strong> The HR Stack Guide is funded through affiliate referral agreements with select software providers. If you click an outbound link to schedule a vendor demo or request pricing, we may receive compensation. This commercial relationship never alters our quantitative scores, editorial verdicts, or documented platform limitations.
          </li>
        </ul>
      </section>

      <section class="border-t border-slate-200 pt-8">
        <h2 class="text-2xl font-bold text-slate-900">Research Audits &amp; Contact</h2>
        <p class="mt-3">
          We conduct quarterly verification audits across our entire comparison catalog. If you represent a software vendor covered on our site and have updated pricing tiers, revised feature sets, or compliance changes to report, contact our editorial team:
        </p>
        <div class="mt-4 grid grid-cols-1 gap-4 text-sm sm:grid-cols-2">
          <div class="rounded-lg border border-slate-200 bg-white p-4">
            <p class="font-semibold text-slate-900">Editorial &amp; Corrections</p>
            <p class="mt-1 text-slate-600">
              <a href="mailto:editorial@thehrstackguide.com" class="font-medium text-indigo-600 hover:underline">editorial@thehrstackguide.com</a>
            </p>
          </div>
          <div class="rounded-lg border border-slate-200 bg-white p-4">
            <p class="font-semibold text-slate-900">Business &amp; Operations</p>
            <p class="mt-1 text-slate-600">
              <a href="mailto:contact@thehrstackguide.com" class="font-medium text-indigo-600 hover:underline">contact@thehrstackguide.com</a>
            </p>
          </div>
        </div>
        <p class="mt-4 text-xs text-slate-500">
          Mailing Address: The HR Stack Guide, 71-75 Shelton Street, Covent Garden, London, WC2H 9JQ, United Kingdom.
        </p>
      </section>
    </div>
  </main>
</Layout>
