---
import Layout from '../layouts/Layout.astro';
import { ORGANIZATION_SAME_AS } from '../lib/organization';

const pageTitle = 'About - The HR Stack Guide | Independent HR Tech Analysis';
const pageHeading = 'About The HR Stack Guide';
const pageDescription =
  'Independent B2B HR technology analysis, pricing calculation engines, and software procurement benchmarking.';

const founderName = 'Dave Storey';
const founderLinkedIn = 'https://www.linkedin.com/in/dave-storey-0053b111/';
const brandLinkedIn = 'https://www.linkedin.com/company/the-hr-stack-guide/';

const siteUrl = new URL('/', Astro.site ?? Astro.url.origin).href;
const aboutUrl = new URL('/about/', siteUrl).href;
const daveId = `${aboutUrl}#dave-storey`;
const organizationId = 'https://www.thehrstackguide.com/#organization';

const aboutSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AboutPage',
      '@id': `${aboutUrl}#webpage`,
      name: pageTitle,
      description: pageDescription,
      url: aboutUrl,
      isPartOf: {
        '@type': 'WebSite',
        '@id': 'https://www.thehrstackguide.com/#website',
        name: 'The HR Stack Guide',
        url: siteUrl,
      },
      about: { '@id': organizationId },
      mainEntity: { '@id': daveId },
    },
    {
      '@type': 'Person',
      '@id': daveId,
      name: founderName,
      jobTitle: 'Founder',
      nationality: 'British',
      url: aboutUrl,
      worksFor: { '@id': organizationId },
      sameAs: [founderLinkedIn],
    },
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'The HR Stack Guide',
      alternateName: 'Stack Guide Media',
      legalName: 'Lonestar Assets LLC',
      url: siteUrl,
      logo: 'https://www.thehrstackguide.com/icon-512.png',
      description: 'An independent B2B HR technology comparison engine and global hiring pricing calculator.',
      founder: { '@id': daveId },
      sameAs: [...ORGANIZATION_SAME_AS],
    },
  ],
};
---

<Layout
  title={pageTitle}
  heading={pageHeading}
  description={pageDescription}
  includeOrganizationSchema={false}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(aboutSchema)} />

  <main class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="space-y-8 text-slate-800">
      <header class="border-b border-slate-200 pb-6">
        <h1 class="text-4xl font-extrabold tracking-tight text-slate-900">{pageHeading}</h1>
        <p class="mt-2 text-xl text-slate-600">{pageDescription}</p>
      </header>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-slate-900">What We Do</h2>
        <p class="text-lg leading-relaxed">
          <strong>The HR Stack Guide</strong> is an independent B2B HR technology evaluation platform. The HR Stack Guide provides live financial calculation tools for Global Payroll, Applicant Tracking Systems (ATS), and Employer of Record (EOR) software. The HR Stack Guide operates in the United Kingdom and serves an international audience of Chief Financial Officers, Chief People Officers, and HR Operations leaders.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-slate-900">About the Founder</h2>
        <p class="text-lg leading-relaxed">
          <strong>Dave Storey</strong> is a UK entrepreneur and technology strategist. Dave Storey founded The HR Stack Guide in 2026. Dave Storey specializes in B2B software evaluation, human resource management systems, and financial vendor modeling.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-slate-900">Methodology &amp; Data Integrity</h2>
        <p class="text-lg leading-relaxed">
          The HR Stack Guide collects verified software pricing data, fee schedules, and enterprise contract benchmarks directly from platform documentation and user disclosures. The HR Stack Guide does not accept financial compensation to alter scorecard verdicts or calculation outputs.
        </p>
      </section>

      <section class="space-y-4 border-t border-slate-200 pt-6">
        <h2 class="text-2xl font-bold text-slate-900">Verified Entity Links</h2>
        <ul class="list-disc space-y-2 pl-6 font-medium text-indigo-600">
          <li>
            <a href={founderLinkedIn} target="_blank" rel="noopener noreferrer" class="hover:underline">
              Dave Storey on LinkedIn (Founder)
            </a>
          </li>
          <li>
            <a href={brandLinkedIn} target="_blank" rel="noopener noreferrer" class="hover:underline">
              The HR Stack Guide on LinkedIn (Organization)
            </a>
          </li>
          <li>
            <a href="/methodology/" class="hover:underline">
              Data &amp; Scoring Methodology
            </a>
          </li>
        </ul>
      </section>
    </div>
  </main>
</Layout>
