---
import Layout from '../layouts/Layout.astro';
import { ORGANIZATION_SAME_AS } from '../lib/organization';

const lastUpdated = 'September 2026';
const pageTitle = 'About Us — The HR Stack Guide';
const pageDescription =
  'The HR Stack Guide is an independent buyer\'s guide for modern HR technology. We publish data-backed comparisons of Global Payroll & EOR, Applicant Tracking Systems (ATS), and Performance Management platforms so teams can choose software without relying on vendor sales pitches.';

const siteUrl = new URL('/', Astro.site ?? Astro.url.origin).href;
const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: pageTitle,
  description: pageDescription,
  url: new URL('/about/', siteUrl).href,
  isPartOf: {
    '@type': 'WebSite',
    name: 'The HR Stack Guide',
    url: siteUrl,
  },
  about: {
    '@type': 'Organization',
    name: 'Stack Guide Media',
    url: siteUrl,
    logo: 'https://www.thehrstackguide.com/icon-512.png',
    sameAs: [...ORGANIZATION_SAME_AS],
    description:
      'Stack Guide Media publishes The HR Stack Guide, an independent buyer\'s guide comparing Global Payroll & EOR, Applicant Tracking Systems (ATS), and Performance Management platforms.',
    email: 'dave@thehrstackguide.com',
  },
};

const evaluationItems = [
  {
    title: 'Primary Source Verification',
    description:
      'We pull specifications directly from vendor documentation, public changelogs, terms of service, and official pricing sheets.',
  },
  {
    title: 'Hands-On Testing',
    description:
      'Where available, we test platform workflows inside trial environments to verify onboarding, compliance settings, and feature limitations.',
  },
  {
    title: 'Standardized Scoring',
    description:
      'Tools are evaluated against a consistent rubric weighted by organization size (from seed-stage startups to international scaleups).',
  },
  {
    title: 'Scheduled Recalibration',
    description:
      'When vendor pricing or core capabilities change, we re-audit affected comparison matrices and update page verification dates.',
  },
];
---

<Layout
  title={pageTitle}
  heading={pageTitle}
  description={pageDescription}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(aboutSchema)} />

  <main class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <header class="mb-10">
      <nav aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 text-sm text-slate-500">
          <li><a href="/" class="transition hover:text-indigo-600">Home</a></li>
          <li aria-hidden="true" class="text-slate-300">&gt;</li>
          <li class="font-medium text-indigo-600" aria-current="page">About Us</li>
        </ol>
      </nav>
      <h1 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        {pageTitle}
      </h1>
      <p class="mt-3 text-sm font-medium text-slate-500">Last updated: {lastUpdated}</p>
    </header>

    <article class="space-y-10 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
      <section>
        <h2 class="text-lg font-semibold text-slate-900">Our Mission</h2>
        <p class="mt-2 text-base leading-relaxed text-slate-700">
          The HR Stack Guide is an independent buyer's guide for modern HR technology. We publish data-backed,
          side-by-side comparisons of Global Payroll &amp; EOR, Applicant Tracking Systems (ATS), and
          Performance Management platforms so founders, HR operations leads, and people leaders can choose
          software without relying on vendor sales pitches.
        </p>
        <p class="mt-3 text-base leading-relaxed text-slate-700">
          The site is published and operated by Stack Guide Media. We do not build, resell, or receive funding
          from any HR software vendor—our sole focus is delivering accurate, well-sourced comparison data.
        </p>
      </section>

      <section aria-label="How we evaluate software">
        <h2 class="text-lg font-semibold text-slate-900">How We Evaluate Software</h2>
        <p class="mt-2 text-base leading-relaxed text-slate-700">
          Every evaluation on this site follows a single, transparent editorial methodology rather than
          unverified user reviews:
        </p>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-base leading-relaxed text-slate-700">
          {evaluationItems.map((item) => (
            <li>
              <strong>{item.title}:</strong> {item.description}
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-slate-900">Editorial Independence &amp; Funding</h2>
        <p class="mt-2 text-base leading-relaxed text-slate-700">
          This site is free to use. We earn revenue through affiliate partnerships when readers sign up for a
          vendor through links on our pages, at no additional cost to them.
        </p>
        <p class="mt-3 text-base leading-relaxed text-slate-700">
          Affiliate relationships never dictate which vendors are evaluated, how platforms are scored, or who
          wins a comparison. Full details are available in our
          <a href="/affiliate-disclosure/" class="font-medium text-indigo-600 hover:underline">Affiliate Disclosure</a>.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-slate-900">Corrections &amp; Vendor Inquiries</h2>
        <p class="mt-2 text-base leading-relaxed text-slate-700">
          If you spot an outdated price point, an unverified feature claim, or a factual error, please let us
          know. We re-verify all correction requests against primary sources and update our data matrices
          promptly.
        </p>
        <p class="mt-3 text-base leading-relaxed text-slate-700">
          Contact:
          <a href="mailto:dave@thehrstackguide.com" class="font-medium text-indigo-600 hover:underline">dave@thehrstackguide.com</a>
        </p>
      </section>
    </article>
  </main>
</Layout>
