---
import VendorButton from '../../components/VendorButton.astro';
import { affiliateLinks } from '../../config/affiliates';
import { vendorOutboundOnclick } from '../../lib/outbound';
import { loadComparisons } from '../../lib/comparisons';
import { getToolProfile, isLiveVendorId } from '../../lib/tools';

export function getStaticPaths() {
  return Object.keys(affiliateLinks)
    .filter((slug) => isLiveVendorId(slug))
    .map((slug) => ({
      params: { slug },
      props: { targetUrl: affiliateLinks[slug] },
    }));
}

const { slug } = Astro.params;
const { targetUrl } = Astro.props;
const vendorId = slug ?? '';

const match = loadComparisons().find(
  (row) => row.tool_a_id === vendorId || row.tool_b_id === vendorId,
);
const vendorName =
  match?.tool_a_id === vendorId
    ? match.tool_a_name
    : match?.tool_b_id === vendorId
      ? match.tool_b_name
      : vendorId;
const profile = getToolProfile(vendorId);
const ctaLocation = 'go_redirect_fallback';
const canonicalURL = new URL(`/go/${vendorId}/`, Astro.site);

Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <!--
    These are thin meta-refresh redirectors to partner sites, not content.
    Keep them out of the index so they never compete with real comparison
    pages or absorb link equity. Also excluded from the sitemap in
    astro.config.mjs and disallowed in public/robots.txt.
  -->
  <meta name="robots" content="noindex, nofollow" />
  <link rel="canonical" href={canonicalURL.href} />
  <meta http-equiv="refresh" content={`0;url=${targetUrl}`} />
  <title>Redirecting...</title>
  <script is:inline define:vars={{ targetUrl }}>
    window.location.replace(targetUrl);
  </script>
</head>
<body class="bg-slate-50 text-slate-700 flex items-center justify-center min-h-screen font-sans">
  <main class="text-center p-6 max-w-lg">
    <h1 class="text-lg font-medium mb-2">Opening {vendorName} from /go/{vendorId}/</h1>
    <p class="text-sm text-slate-500 mb-3">
      This hop is the {vendorName} ({vendorId}) outbound fallback, not a comparison article.
      {match
        ? ` It belongs with the ${match.tool_a_name} vs ${match.tool_b_name} buyer page.`
        : ''}
    </p>
    {profile?.positioning && (
      <p class="text-sm text-slate-500 mb-3">{profile.positioning}</p>
    )}
    {profile?.skip_if && (
      <p class="text-sm text-slate-500 mb-3">{profile.skip_if}</p>
    )}
    <p class="text-sm text-slate-500">
      If you are not redirected automatically to {vendorName},
      <VendorButton
        href={targetUrl}
        vendorId={vendorId}
        vendorName={vendorName}
        location={ctaLocation}
        class="text-blue-600 underline hover:text-blue-800"
        onclick={vendorOutboundOnclick(vendorId, 'direct_outbound', { vendorName, ctaLocation })}
      >
        continue to {vendorName}
      </VendorButton>.
    </p>
  </main>
</body>
</html>
