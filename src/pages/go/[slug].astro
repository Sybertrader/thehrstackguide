---
import { affiliateLinks } from '../../config/affiliates';
import { VENDOR_OUTBOUND_REL, vendorOutboundOnclick } from '../../lib/outbound';

export function getStaticPaths() {
  return Object.keys(affiliateLinks).map((slug) => ({
    params: { slug },
    props: { targetUrl: affiliateLinks[slug] },
  }));
}

const { slug } = Astro.params;
const { targetUrl } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <!--
    These are thin meta-refresh redirectors to partner sites, not content.
    Keep them out of the index so they never compete with real comparison
    pages or absorb link equity. Also excluded from the sitemap in
    astro.config.mjs and disallowed in public/robots.txt.
  -->
  <meta name="robots" content="noindex, nofollow" />
  <meta http-equiv="refresh" content={`0;url=${targetUrl}`} />
  <title>Redirecting...</title>
  <script is:inline define:vars={{ targetUrl }}>
    window.location.replace(targetUrl);
  </script>
</head>
<body class="bg-slate-50 text-slate-700 flex items-center justify-center min-h-screen font-sans">
  <div class="text-center p-6">
    <p class="text-lg font-medium mb-2">Redirecting to partner site...</p>
    <p class="text-sm text-slate-500">
      If you are not redirected automatically, 
      <a href={targetUrl} rel={VENDOR_OUTBOUND_REL} target="_blank" onclick={vendorOutboundOnclick(slug ?? '')} class="text-blue-600 underline hover:text-blue-800">click here</a>.
    </p>
  </div>
</body>
</html>
