---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import Footer from '../components/Footer.astro';
import BaseHead from '../components/BaseHead.astro';
import { ORGANIZATION_SAME_AS } from '../lib/organization';

export interface Props {
  /** Document `<title>` / OG title. Must not match the page H1. */
  title: string;
  description?: string;
  /**
   * When true, emit `<meta name="robots" content="noindex, nofollow" />`.
   * Draft and utility pages only (`/thank-you/`, `/contact/`, 404).
   * Comparison hubs, child modifiers, category indexes, and the homepage
   * always emit `index, follow`.
   */
  noindex?: boolean;
  /**
   * Sitewide Organization JSON-LD. The homepage emits a WebSite +
   * Organization `@graph` instead, so it turns this off to avoid two
   * competing Organization nodes.
   */
  includeOrganizationSchema?: boolean;
  /** Optimized WebP hrefs for above-the-fold logos (`<link rel="preload">`). */
  lcpImages?: string[];
}

const {
  title,
  description,
  noindex = false,
  includeOrganizationSchema = true,
  lcpImages = [],
} = Astro.props;
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? '';

/** Full `<title>` keeps the brand suffix for Google; OG/Twitter titles do not. */
const BRAND_TITLE_SUFFIX = ' | The HR Stack Guide';
const socialTitle = title.endsWith(BRAND_TITLE_SUFFIX)
  ? title.slice(0, -BRAND_TITLE_SUFFIX.length)
  : title;

const ogImageUrl = 'https://www.thehrstackguide.com/og-banner.png';

/**
 * Self-referencing canonical on every page that uses this layout. Uses the
 * request URL (`Astro.url.href`) so the tag always matches the page being
 * served. `/go/*` affiliate redirects do not use this layout. `/thank-you/`
 * uses this layout with `noindex`.
 */
const canonicalURL = Astro.url.href;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'The HR Stack Guide',
  alternateName: 'Stack Guide Media',
  url: 'https://www.thehrstackguide.com',
  legalName: 'Lonestar Assets LLC',
  description: 'Data-driven B2B HR software comparison engine evaluating 400+ tools.',
  logo: 'https://www.thehrstackguide.com/icon-512.png',
  sameAs: [...ORGANIZATION_SAME_AS],
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <BaseHead gaMeasurementId={gaMeasurementId} lcpImages={lcpImages} />

    <!-- Google Preferred Sources: lets readers pin this domain in Search, AI Overviews, and AI Mode. -->
    <script async src="https://news.google.com/swg/js/v1/publisher.js" is:inline></script>

    <meta name="msvalidate.01" content="105CE4DC545640EE677BEC4BEF05F911" />
    <meta name="impact-site-verification" content="a50dccb2-0572-4388-b5b2-661cbde773d8" />
    <meta name="impact-site-verification" content="1aa2107c-f3e1-41fa-8768-64aa28e9c6af" />
    <meta name="impact-site-verification" content="be412a71-a7c9-4751-8de1-34f2e4701f89" />
    <!-- Prefer SVG / high-res PNG so Google and modern browsers do not stretch a low-res .ico -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="any" />
    <link rel="icon" type="image/png" sizes="48x48" href="/icon-48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" />
    <!-- Inter is self-hosted via @fontsource-variable/inter (`font-display: swap`). -->
    <!-- Document title only. On-page H1s are set by each page template and must not match this string. -->
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow" />
    )}
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:site_name" content="The HR Stack Guide" />
    <meta property="og:title" content={socialTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImageUrl} />
    {includeOrganizationSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    )}
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col bg-slate-50 font-sans text-slate-900 antialiased">
    <header class="border-b border-slate-200 bg-white/90 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
        <a href="/" class="flex shrink-0 items-center gap-2.5">
          <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-600 text-base font-bold text-white">
            SG
          </span>
          <span class="text-xl font-bold tracking-tight text-slate-900">The HR Stack Guide</span>
        </a>

        <nav aria-label="Primary" class="hidden items-center gap-5 text-sm font-medium text-slate-600 lg:flex lg:gap-6">
          <a href="/global-payroll-eor/" class="whitespace-nowrap transition hover:text-indigo-600">Payroll &amp; EOR</a>
          <a href="/applicant-tracking-systems/" class="whitespace-nowrap transition hover:text-indigo-600">ATS</a>
          <a href="/performance-management/" class="whitespace-nowrap transition hover:text-indigo-600">Performance Management</a>
          <a href="/about/" class="whitespace-nowrap transition hover:text-indigo-600">About</a>
        </nav>

        <button
          type="button"
          id="mobile-nav-toggle"
          class="inline-flex items-center justify-center rounded-lg border border-slate-200 p-2 text-slate-600 transition hover:border-indigo-300 hover:text-indigo-600 lg:hidden"
          aria-controls="mobile-nav"
          aria-expanded="false"
          aria-label="Open menu"
        >
          <svg id="mobile-nav-icon-open" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5" aria-hidden="true">
            <path fill-rule="evenodd" d="M2 4.75A.75.75 0 0 1 2.75 4h14.5a.75.75 0 0 1 0 1.5H2.75A.75.75 0 0 1 2 4.75Zm0 5A.75.75 0 0 1 2.75 9h14.5a.75.75 0 0 1 0 1.5H2.75A.75.75 0 0 1 2 9.75Zm0 5a.75.75 0 0 1 .75-.75h14.5a.75.75 0 0 1 0 1.5H2.75a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd" />
          </svg>
          <svg id="mobile-nav-icon-close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="hidden h-5 w-5" aria-hidden="true">
            <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" />
          </svg>
        </button>
      </div>

      <nav
        id="mobile-nav"
        aria-label="Mobile primary"
        class="hidden border-t border-slate-200 bg-white lg:hidden"
      >
        <div class="mx-auto flex max-w-6xl flex-col gap-1 px-4 py-3 sm:px-6">
          <a href="/global-payroll-eor/" class="rounded-lg px-3 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-indigo-50 hover:text-indigo-700">Payroll &amp; EOR</a>
          <a href="/applicant-tracking-systems/" class="rounded-lg px-3 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-indigo-50 hover:text-indigo-700">ATS</a>
          <a href="/performance-management/" class="rounded-lg px-3 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-indigo-50 hover:text-indigo-700">Performance Management</a>
          <a href="/about/" class="rounded-lg px-3 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-indigo-50 hover:text-indigo-700">About</a>
        </div>
      </nav>
    </header>

    <div class="flex-1">
      <slot />
    </div>

    <Footer />
    <Analytics />
    <SpeedInsights />

    <script>
      const toggle = document.getElementById('mobile-nav-toggle');
      const menu = document.getElementById('mobile-nav');
      const iconOpen = document.getElementById('mobile-nav-icon-open');
      const iconClose = document.getElementById('mobile-nav-icon-close');

      if (toggle && menu && iconOpen && iconClose) {
        toggle.addEventListener('click', () => {
          const isOpen = !menu.classList.contains('hidden');
          menu.classList.toggle('hidden', isOpen);
          iconOpen.classList.toggle('hidden', !isOpen);
          iconClose.classList.toggle('hidden', isOpen);
          toggle.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
          toggle.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
        });
      }
    </script>
    <script is:inline>
      document.body.addEventListener('click', function (e) {
        const target = e.target;
        if (!target || typeof target.closest !== 'function') return;
        const cta = target.closest('.js-affiliate-cta');
        if (!cta || typeof window.gtag !== 'function') return;

        window.gtag('event', 'vendor_cta_click', {
          vendor_id: cta.getAttribute('data-vendor-id') || '',
          vendor_name: cta.getAttribute('data-track-vendor') || '',
          cta_location: cta.getAttribute('data-track-location') || '',
          destination_type: cta.getAttribute('data-destination-type') || '',
          link_url: cta.getAttribute('href') || '',
          page_location: window.location.pathname,
        });
      });
    </script>
  </body>
</html>
