---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description?: string;
  /**
   * When true, emit `<meta name="robots" content="noindex, nofollow" />`.
   * Use on confirmation pages such as `/thank-you/`. Omit on indexable
   * pages (homepage, hubs, `/recommendation/`, comparison slugs).
   */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

/**
 * Self-referential canonical on every page that uses this layout (comparison
 * slugs, category hubs, legal pages, homepage, `/recommendation/`). Built from
 * the request path against the www origin so it stays absolute, query/hash-free,
 * and always trailing-slash — matching sitemap loc URLs and
 * `trailingSlash: 'always'`. `/go/*` affiliate redirects do not use this
 * layout and stay noindex. `/thank-you/` uses this layout with `noindex`.
 */
const SITE_ORIGIN = 'https://www.thehrstackguide.com';
const canonicalPath = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalURL = new URL(canonicalPath, SITE_ORIGIN).href;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'The HR Stack Guide',
  alternateName: 'Stack Guide Media',
  url: 'https://www.thehrstackguide.com',
  legalName: 'Lonestar Assets LLC',
  description: 'Data-driven B2B HR software comparison engine evaluating 400+ tools.',
  logo: 'https://www.thehrstackguide.com/icon-512.png',
  sameAs: [
    'https://www.linkedin.com/company/the-hr-stack-guide',
    'https://github.com/stackguidemedia',
    'https://peerlist.io/stackguidemedia',
    'https://peerlist.io/stackguidemedia/project/the-hr-stack-guide',
    'https://www.f6s.com/company/the-hr-stack-guide',
    'https://dealroom.co/companies/the-hr-stack-guide',
    'https://x.com/thehrstackguide',
    'https://www.facebook.com/profile.php?id=61592529246507',
    'https://www.indiehackers.com/Stack_Guide_Media',
    'https://www.crunchbase.com/organization/the-hr-stack-guide',
    'https://www.producthunt.com/products/the-hr-stack-guide',
    'https://alternativeto.net/user/stack_guide_media',
  ],
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-FK6Z3BFZ7Q" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());

      gtag('config', 'G-FK6Z3BFZ7Q');
    </script>

    <!--
      Affiliate click tracking for GA4. Delegated from `document` so it covers
      every `/go/` CTA on the site — including ones rendered by components and
      any added later — without each page wiring up its own handler. The
      parallel `.js-affiliate-cta` listener in src/pages/[...slug].astro reports
      to Vercel Analytics, so the two are separate destinations, not duplicates.

      Vendor and placement come from the `data-track-*` attributes that
      src/pages/[...slug].astro already sets, read via `closest()` so a wrapper
      element can carry them instead of the anchor. The fallbacks cover future
      CTAs added without those attributes: the slug in `/go/{slug}` matches the
      key in src/config/affiliates.ts, so vendor attribution survives either way.
    -->
    <script is:inline>
      document.addEventListener('click', function (e) {
        const link = e.target.closest('a[href^="/go/"]');
        if (link && typeof gtag === 'function') {
          const vendorSource = link.closest('[data-track-vendor]');
          const locationSource = link.closest('[data-track-location]');
          const vendor =
            (vendorSource && vendorSource.getAttribute('data-track-vendor')) ||
            link.getAttribute('href').replace('/go/', '');
          const location =
            (locationSource && locationSource.getAttribute('data-track-location')) || 'body_link';

          gtag('event', 'affiliate_click', {
            vendor_name: vendor,
            cta_location: location,
            link_url: link.getAttribute('href'),
          });
        }
      });
    </script>

    <!-- Google Preferred Sources: lets readers pin this domain in Search, AI Overviews, and AI Mode. -->
    <script async src="https://news.google.com/swg/js/v1/publisher.js" is:inline></script>

    <meta name="msvalidate.01" content="105CE4DC545640EE677BEC4BEF05F911" />
    <meta name="impact-site-verification" content="a50dccb2-0572-4388-b5b2-661cbde773d8" />
    <meta name="impact-site-verification" content="1aa2107c-f3e1-41fa-8768-64aa28e9c6af" />
    <meta name="impact-site-verification" content="be412a71-a7c9-4751-8de1-34f2e4701f89" />
    <!-- Prefer SVG / high-res PNG so Google and modern browsers do not stretch a low-res .ico -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="any" />
    <link rel="icon" type="image/png" sizes="48x48" href="/icon-48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Non-blocking Inter load; display=swap already in the stylesheet URL. -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      />
    </noscript>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content="https://thehrstackguide.com/sg-logo.png" />
    <meta property="og:image:type" content="image/png" />
    <meta name="twitter:image" content="https://thehrstackguide.com/sg-logo.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <slot name="head" />

    <!-- Microsoft Clarity: idle/deferred so it never competes with first interactions (INP). -->
    <script is:inline>
      (function () {
        function loadClarity() {
          if (window.__clarityLoaded) return;
          window.__clarityLoaded = true;
          (function (c, l, a, r, i, t, y) {
            c[a] =
              c[a] ||
              function () {
                (c[a].q = c[a].q || []).push(arguments);
              };
            t = l.createElement(r);
            t.async = 1;
            t.defer = true;
            t.src = 'https://www.clarity.ms/tag/' + i;
            y = l.getElementsByTagName(r)[0];
            y.parentNode.insertBefore(t, y);
          })(window, document, 'clarity', 'script', 'xx8emm4258');
        }
        function schedule() {
          if ('requestIdleCallback' in window) {
            requestIdleCallback(loadClarity, { timeout: 4000 });
          } else {
            setTimeout(loadClarity, 2000);
          }
        }
        if (document.readyState === 'complete') schedule();
        else window.addEventListener('load', schedule, { once: true });
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-slate-50 font-sans text-slate-900 antialiased">
    <header class="border-b border-slate-200 bg-white/90 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
        <a href="/" class="flex shrink-0 items-center gap-2.5">
          <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-600 text-base font-bold text-white">
            SG
          </span>
          <span class="text-xl font-bold tracking-tight text-slate-900">The HR Stack Guide</span>
        </a>

        <nav aria-label="Primary" class="hidden items-center gap-5 text-sm font-medium text-slate-600 lg:flex lg:gap-6">
          <a href="/global-payroll-eor/" class="whitespace-nowrap transition hover:text-indigo-600">Payroll &amp; EOR</a>
          <a href="/applicant-tracking-systems/" class="whitespace-nowrap transition hover:text-indigo-600">ATS</a>
          <a href="/performance-management/" class="whitespace-nowrap transition hover:text-indigo-600">Performance Management</a>
          <a href="/about/" class="whitespace-nowrap transition hover:text-indigo-600">About</a>
        </nav>

        <button
          type="button"
          id="mobile-nav-toggle"
          class="inline-flex items-center justify-center rounded-lg border border-slate-200 p-2 text-slate-600 transition hover:border-indigo-300 hover:text-indigo-600 lg:hidden"
          aria-controls="mobile-nav"
          aria-expanded="false"
          aria-label="Open menu"
        >
          <svg id="mobile-nav-icon-open" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5" aria-hidden="true">
            <path fill-rule="evenodd" d="M2 4.75A.75.75 0 0 1 2.75 4h14.5a.75.75 0 0 1 0 1.5H2.75A.75.75 0 0 1 2 4.75Zm0 5A.75.75 0 0 1 2.75 9h14.5a.75.75 0 0 1 0 1.5H2.75A.75.75 0 0 1 2 9.75Zm0 5a.75.75 0 0 1 .75-.75h14.5a.75.75 0 0 1 0 1.5H2.75a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd" />
          </svg>
          <svg id="mobile-nav-icon-close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="hidden h-5 w-5" aria-hidden="true">
            <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" />
          </svg>
        </button>
      </div>

      <nav
        id="mobile-nav"
        aria-label="Mobile primary"
        class="hidden border-t border-slate-200 bg-white lg:hidden"
      >
        <div class="mx-auto flex max-w-6xl flex-col gap-1 px-4 py-3 sm:px-6">
          <a href="/global-payroll-eor/" class="rounded-lg px-3 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-indigo-50 hover:text-indigo-700">Payroll &amp; EOR</a>
          <a href="/applicant-tracking-systems/" class="rounded-lg px-3 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-indigo-50 hover:text-indigo-700">ATS</a>
          <a href="/performance-management/" class="rounded-lg px-3 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-indigo-50 hover:text-indigo-700">Performance Management</a>
          <a href="/about/" class="rounded-lg px-3 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-indigo-50 hover:text-indigo-700">About</a>
        </div>
      </nav>
    </header>

    <div class="flex-1">
      <slot />
    </div>

    <Footer />
    <Analytics />
    <SpeedInsights />

    <script>
      const toggle = document.getElementById('mobile-nav-toggle');
      const menu = document.getElementById('mobile-nav');
      const iconOpen = document.getElementById('mobile-nav-icon-open');
      const iconClose = document.getElementById('mobile-nav-icon-close');

      if (toggle && menu && iconOpen && iconClose) {
        toggle.addEventListener('click', () => {
          const isOpen = !menu.classList.contains('hidden');
          menu.classList.toggle('hidden', isOpen);
          iconOpen.classList.toggle('hidden', !isOpen);
          iconClose.classList.toggle('hidden', isOpen);
          toggle.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
          toggle.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
        });
      }
    </script>
  </body>
</html>
