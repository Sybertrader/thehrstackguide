---
interface Props {
  headline?: string;
  description?: string;
  headingLevel?: 'h1' | 'h2';
  showEyebrow?: boolean;
  categoryPrefill?: string;
  class?: string;
}

const {
  headline = 'Unsure which HR software fits your team?',
  description = 'Skip hours of demo calls. Answer 5 quick questions and get an instant recommendation based on your category, headcount, budget, workforce location, and top priority.',
  headingLevel = 'h2',
  showEyebrow = true,
  categoryPrefill = '',
  class: className = '',
} = Astro.props;

const categories = [
  { value: 'payroll', label: 'Global Payroll & EOR' },
  { value: 'ats', label: 'Applicant Tracking Systems (ATS)' },
  { value: 'performance', label: 'Performance Management' },
];

const headcounts = [
  { value: 'startup', label: '1–20 employees (Startup)' },
  { value: 'scaleup', label: '50–250 employees (Scaleup)' },
  { value: 'enterprise', label: '250+ employees (Enterprise / Global)' },
];

const budgets = [
  { value: 'lean', label: 'Under $500 / month' },
  { value: 'mid', label: '$500–$2,000 / month' },
  { value: 'flexible', label: '$2,000+ / month or flexible' },
];

const locations = [
  { value: 'us_only', label: 'US Only' },
  { value: 'global_remote', label: 'Global / Remote' },
  { value: 'hybrid', label: 'Hybrid (US + International)' },
];

const priorities = [
  { value: 'performance', label: 'Performance Management & Reviews' },
  { value: 'global_eor', label: 'Global Hiring & EOR' },
  { value: 'payroll', label: 'Automated US Payroll' },
  { value: 'onboarding', label: 'Fast Onboarding & HRIS' },
];

const HeadingTag = headingLevel;
---

<section class:list={['recommendation-engine', className]} aria-label="Get our recommendation" data-recommendation-engine>
  {showEyebrow && (
    <span class="inline-flex items-center rounded-full border border-indigo-200 bg-indigo-50 px-3.5 py-1.5 text-sm font-semibold uppercase tracking-wide text-indigo-700">
      Free Guidance
    </span>
  )}
  <HeadingTag
    class:list={[
      'font-bold tracking-tight text-slate-900',
      showEyebrow ? 'mt-5' : '',
      headingLevel === 'h1' ? 'text-3xl sm:text-4xl' : 'text-2xl sm:text-3xl',
    ]}
  >
    {headline}
  </HeadingTag>
  <p class="mt-3 max-w-3xl text-base leading-relaxed text-slate-600 sm:text-lg">
    {description}
  </p>

  <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <form class="recommendation-form space-y-6" novalidate>
      <div>
        <label class="block text-sm font-semibold text-slate-900">
          1. Which category are you evaluating?
          <select
            name="category"
            required
            class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-normal text-slate-900 shadow-sm outline-none transition focus:border-indigo-400 focus:ring-4 focus:ring-indigo-100"
          >
            <option value="" disabled selected={!categoryPrefill}>Select a category</option>
            {categories.map((option) => (
              <option value={option.value} selected={categoryPrefill === option.value}>
                {option.label}
              </option>
            ))}
          </select>
        </label>
      </div>

      <div>
        <label class="block text-sm font-semibold text-slate-900">
          2. What's your team size?
          <select
            name="headcount"
            required
            class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-normal text-slate-900 shadow-sm outline-none transition focus:border-indigo-400 focus:ring-4 focus:ring-indigo-100"
          >
            <option value="" disabled selected>Select headcount</option>
            {headcounts.map((option) => (
              <option value={option.value}>{option.label}</option>
            ))}
          </select>
        </label>
      </div>

      <div>
        <label class="block text-sm font-semibold text-slate-900">
          3. What's your monthly software budget?
          <select
            name="budget"
            required
            class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-normal text-slate-900 shadow-sm outline-none transition focus:border-indigo-400 focus:ring-4 focus:ring-indigo-100"
          >
            <option value="" disabled selected>Select budget range</option>
            {budgets.map((option) => (
              <option value={option.value}>{option.label}</option>
            ))}
          </select>
        </label>
      </div>

      <div>
        <label class="block text-sm font-semibold text-slate-900" for="location-select">
          4. Where is your workforce located?
        </label>
        <select
          id="location-select"
          name="location"
          required
          class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-normal text-slate-900 shadow-sm outline-none transition focus:border-indigo-400 focus:ring-4 focus:ring-indigo-100"
        >
          <option value="" disabled selected>Select workforce location</option>
          {locations.map((option) => (
            <option value={option.value}>{option.label}</option>
          ))}
        </select>
      </div>

      <div>
        <label class="block text-sm font-semibold text-slate-900" for="priority-select">
          5. What is your primary priority?
        </label>
        <select
          id="priority-select"
          name="priority"
          required
          class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-normal text-slate-900 shadow-sm outline-none transition focus:border-indigo-400 focus:ring-4 focus:ring-indigo-100"
        >
          <option value="" disabled selected>Select your priority</option>
          {priorities.map((option) => (
            <option value={option.value}>{option.label}</option>
          ))}
        </select>
      </div>

      <button
        type="submit"
        class="inline-flex w-full items-center justify-center rounded-xl bg-indigo-600 px-5 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 sm:w-auto"
      >
        Get Our Recommendation
      </button>
    </form>
  </div>
</section>

<script>
  /**
   * `trailingSlash: 'always'` is enforced site-wide (astro.config.mjs), so
   * every path needs its slash or the host will redirect on the way out.
   */
  const ROUTES = {
    performance: '/performance-management/',
    global: '/global-payroll-eor/',
    usSmbPayroll: '/rippling-vs-gusto-for-tech-startups/',
    enterpriseHris: '/performance-management/',
    fallback: '/global-payroll-eor/',
  };

  /**
   * Question 2 offers startup/scaleup/enterprise; the raw employee bands are
   * accepted too so these rules survive a future rewording of that question.
   * Between them the two lists cover every option, so no headcount can fall
   * through to the generic fallback.
   */
  const SMALL_TEAM_SIZES = ['1-10', '11-50', 'startup'];
  const MID_ENTERPRISE_TEAM_SIZES = ['51-200', '201-500', '500+', 'scaleup', 'enterprise'];

  function resolveTargetUrl(
    teamSize: string,
    location: string,
    priority: string,
  ): string {
    // Rule 1 — performance override.
    if (priority === 'performance') {
      return ROUTES.performance;
    }

    // Rule 2 — global override.
    if (location === 'global_remote' || location === 'hybrid' || priority === 'global_eor') {
      return ROUTES.global;
    }

    // Rules 3 and 4 — US-only visitors split on headcount: small teams get the
    // SMB payroll comparison, everyone larger gets the HRIS route.
    if (location === 'us_only') {
      if (SMALL_TEAM_SIZES.indexOf(teamSize) !== -1) {
        return ROUTES.usSmbPayroll;
      }
      if (MID_ENTERPRISE_TEAM_SIZES.indexOf(teamSize) !== -1) {
        return ROUTES.enterpriseHris;
      }
    }

    return ROUTES.fallback;
  }

  const INVALID_CLASSES = ['border-red-500', 'ring-2', 'ring-red-100'];

  function markValidity(select: HTMLSelectElement, isValid: boolean) {
    // Swap the resting border out entirely — leaving both colours on the
    // element would make the highlight depend on Tailwind's rule order.
    select.classList.toggle('border-slate-300', isValid);
    INVALID_CLASSES.forEach((className) => select.classList.toggle(className, !isValid));
  }

  function initRecommendationEngine(root: Element) {
    const form = root.querySelector('.recommendation-form') as HTMLFormElement | null;
    if (!form) return;

    const selects = Array.from(form.querySelectorAll('select')) as HTMLSelectElement[];

    // Clear the highlight as soon as the visitor answers the question.
    selects.forEach((select) => {
      select.addEventListener('change', () => {
        if (select.value) markValidity(select, true);
      });
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();

      let firstInvalid: HTMLSelectElement | null = null;
      selects.forEach((select) => {
        const isValid = Boolean(select.value);
        markValidity(select, isValid);
        if (!isValid && !firstInvalid) firstInvalid = select;
      });

      if (firstInvalid) {
        // The form is novalidate, so ask for the native bubble explicitly.
        form.reportValidity();
        (firstInvalid as HTMLSelectElement).focus();
        return;
      }

      // Read through FormData rather than the ids, so a page rendering two
      // instances of this component still reads the submitted form's answers.
      const data = new FormData(form);
      const teamSize = String(data.get('headcount') || '').trim();
      const location = String(data.get('location') || '').trim();
      const priority = String(data.get('priority') || '').trim();

      window.location.href = resolveTargetUrl(teamSize, location, priority);
    });
  }

  function initAll() {
    document.querySelectorAll('[data-recommendation-engine]').forEach((root) => {
      if ((root as HTMLElement).dataset.initialized === 'true') return;
      (root as HTMLElement).dataset.initialized = 'true';
      initRecommendationEngine(root);
    });
  }

  if (typeof document !== 'undefined') {
    initAll();
  }
</script>
