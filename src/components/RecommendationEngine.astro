---
import {
  BUDGET_OPTIONS,
  CATEGORY_OPTIONS,
  COMPANY_TYPE_OPTIONS,
  LEGACY_CATEGORY_VALUES,
  LOCATION_OPTIONS,
  RECOMMENDATION_VENDOR_IDS,
} from '../lib/recommendation-routing';
import { outboundRel, resolveVendorOutboundHref, vendorCtaDestinationType } from '../lib/outbound';

interface Props {
  headline?: string;
  description?: string;
  headingLevel?: 'h1' | 'h2';
  showEyebrow?: boolean;
  categoryPrefill?: string;
  class?: string;
}

const {
  headline = 'Unsure which HR software fits your team?',
  description = 'Answer 4 quick questions and see an instant recommendation tailored to your team.',
  headingLevel = 'h2',
  showEyebrow = true,
  categoryPrefill = '',
  class: className = '',
} = Astro.props;

// Hub CTAs still send ?category=payroll; that older value maps to global_eor.
const resolvedPrefill = LEGACY_CATEGORY_VALUES[categoryPrefill] ?? categoryPrefill;

// Outbound hrefs are resolved here rather than in the client script because
// resolveVendorOutboundHref reads tools.json through node:fs. Routing every
// vendor through it also keeps lead-only brands (Workable, Lever, JazzHR,
// Culture Amp, PerformYard) off `/go/{id}/`, which only builds for registered
// affiliates and would otherwise 404.
const vendorLinks = Object.fromEntries(
  RECOMMENDATION_VENDOR_IDS.map((id) => {
    const href = resolveVendorOutboundHref(id);
    return [id, { href, rel: outboundRel(href) ?? '', type: vendorCtaDestinationType(href) }];
  }),
);

const SELECT_CLASSES =
  'mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-normal text-slate-900 shadow-sm outline-none transition focus:border-indigo-400 focus:ring-4 focus:ring-indigo-100 disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-500';
const LABEL_CLASSES = 'block text-sm font-semibold text-slate-900';
const PRIMARY_CTA_CLASSES =
  'inline-flex w-full items-center justify-center rounded-xl bg-indigo-600 px-5 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 sm:w-auto';
const SECONDARY_CTA_CLASSES =
  'inline-flex w-full items-center justify-center rounded-xl border border-indigo-200 bg-white px-5 py-3.5 text-sm font-semibold text-indigo-700 shadow-sm transition hover:border-indigo-300 hover:bg-indigo-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 sm:w-auto';

const HeadingTag = headingLevel;
---

<section
  class:list={['recommendation-engine', className]}
  aria-label="Get our recommendation"
  data-recommendation-engine
  data-vendor-links={JSON.stringify(vendorLinks)}
>
  {showEyebrow && (
    <span class="inline-flex items-center rounded-full border border-indigo-200 bg-indigo-50 px-3.5 py-1.5 text-sm font-semibold uppercase tracking-wide text-indigo-700">
      Free Guidance
    </span>
  )}
  <HeadingTag
    class:list={[
      'font-bold tracking-tight text-slate-900',
      showEyebrow ? 'mt-5' : '',
      headingLevel === 'h1' ? 'text-3xl sm:text-4xl' : 'text-2xl sm:text-3xl',
    ]}
  >
    {headline}
  </HeadingTag>
  <p class="mt-3 max-w-3xl text-base leading-relaxed text-slate-600 sm:text-lg">
    {description}
  </p>

  <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <form id="wizard-form" class="recommendation-form space-y-6" novalidate>
      <div>
        <label class={LABEL_CLASSES} for="category-select">
          1. Which category are you evaluating?
        </label>
        <select id="category-select" name="category" required class={SELECT_CLASSES}>
          <option value="" disabled selected={!resolvedPrefill}>Select a category</option>
          {CATEGORY_OPTIONS.map((option) => (
            <option value={option.value} selected={resolvedPrefill === option.value}>
              {option.label}
            </option>
          ))}
        </select>
      </div>

      <div>
        <label class={LABEL_CLASSES} for="company-type-select">
          2. What best describes your company?
        </label>
        <select id="company-type-select" name="companyType" required class={SELECT_CLASSES}>
          <option value="" disabled selected>Select company type</option>
          {COMPANY_TYPE_OPTIONS.map((option) => (
            <option value={option.value}>{option.label}</option>
          ))}
        </select>
      </div>

      <div>
        <label class={LABEL_CLASSES} for="budget-select">
          3. What's your monthly software budget?
        </label>
        <select id="budget-select" name="budget" required class={SELECT_CLASSES}>
          <option value="" disabled selected>Select budget range</option>
          {BUDGET_OPTIONS.map((option) => (
            <option value={option.value}>{option.label}</option>
          ))}
        </select>
      </div>

      <div>
        <label class={LABEL_CLASSES} for="location-select">
          4. Where is your workforce located?
        </label>
        <select id="location-select" name="location" required class={SELECT_CLASSES}>
          <option value="" disabled selected>Select workforce location</option>
          {LOCATION_OPTIONS.map((option) => (
            <option value={option.value}>{option.label}</option>
          ))}
        </select>
      </div>

      <button type="submit" class={PRIMARY_CTA_CLASSES}>
        Get Our Recommendation
      </button>
    </form>

    <div id="wizard-result" class="recommendation-result hidden" hidden>
      <span class="inline-flex items-center rounded-full border border-indigo-200 bg-indigo-50 px-3.5 py-1.5 text-sm font-semibold uppercase tracking-wide text-indigo-700">
        Your match
      </span>
      <h3 data-result-pair-label class="mt-5 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl"></h3>
      <p data-result-rationale class="mt-3 max-w-3xl text-base leading-relaxed text-slate-600 sm:text-lg"></p>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a data-result-pair-href href="/" class={PRIMARY_CTA_CLASSES}>Read the comparison</a>
        <a data-result-vendor-a data-vendor-cta href="/" target="_blank" class={SECONDARY_CTA_CLASSES}></a>
        <a data-result-vendor-b data-vendor-cta href="/" target="_blank" class={SECONDARY_CTA_CLASSES}></a>
      </div>
      <button
        type="button"
        data-result-reset
        class="mt-4 text-sm font-semibold text-indigo-600 transition hover:text-indigo-800"
      >
        Edit answers
      </button>
    </div>
  </div>
</section>

<script>
  import {
    LEGACY_CATEGORY_VALUES,
    resolveRecommendation,
    type RecommendationVendor,
  } from '../lib/recommendation-routing';

  interface VendorLink {
    href: string;
    rel: string;
    type: string;
  }

  const INVALID_CLASSES = ['border-red-500', 'ring-2', 'ring-red-100'];

  function markValidity(select: HTMLSelectElement, isValid: boolean) {
    // Swap the resting border out entirely - leaving both colours on the
    // element would make the highlight depend on Tailwind's rule order.
    select.classList.toggle('border-slate-300', isValid);
    INVALID_CLASSES.forEach((className) => select.classList.toggle(className, !isValid));
  }

  function applyCategoryPrefill(form: HTMLFormElement) {
    const select = form.querySelector('select[name="category"]') as HTMLSelectElement | null;
    if (!select) return;

    const requested = new URLSearchParams(window.location.search).get('category');
    if (!requested) return;

    const value = LEGACY_CATEGORY_VALUES[requested] || requested;
    const isKnown = Array.from(select.options).some((option) => option.value === value);
    if (isKnown) select.value = value;
  }

  function parseJsonData<T>(root: HTMLElement, key: string, fallback: T): T {
    try {
      const raw = root.dataset[key];
      return raw ? (JSON.parse(raw) as T) : fallback;
    } catch {
      return fallback;
    }
  }

  function applyVendorCta(
    link: HTMLAnchorElement | null,
    vendor: RecommendationVendor,
    vendorLinks: Record<string, VendorLink>,
  ) {
    if (!link) return;

    const destination = vendorLinks[vendor.id];
    if (!destination) {
      link.hidden = true;
      return;
    }

    link.hidden = false;
    link.href = destination.href;
    link.textContent = `Try ${vendor.name} ↗`;
    link.dataset.vendorId = vendor.id;
    link.dataset.vendorName = vendor.name;
    link.dataset.destinationType = destination.type;
    if (destination.rel) {
      link.rel = destination.rel;
    } else {
      link.removeAttribute('rel');
    }
  }

  function trackVendorClick(link: HTMLAnchorElement) {
    const gtag = (window as any).gtag;
    if (typeof gtag !== 'function') return;
    gtag('event', 'vendor_cta_click', {
      vendor_id: link.dataset.vendorId ?? '',
      vendor_name: link.dataset.vendorName ?? '',
      cta_location: 'recommendation_engine',
      destination_type: link.dataset.destinationType ?? 'direct_outbound',
      page_location: window.location.pathname,
    });
  }

  function initRecommendationEngine(root: Element) {
    const form = root.querySelector('.recommendation-form') as HTMLFormElement | null;
    const result = root.querySelector('.recommendation-result') as HTMLElement | null;
    if (!form) return;

    const vendorLinks = parseJsonData<Record<string, VendorLink>>(
      root as HTMLElement,
      'vendorLinks',
      {},
    );

    applyCategoryPrefill(form);

    const selects = Array.from(form.querySelectorAll('select')) as HTMLSelectElement[];

    // Clear the highlight as soon as the visitor answers the question.
    selects.forEach((select) => {
      select.addEventListener('change', () => {
        if (select.value) markValidity(select, true);
      });
    });

    result?.querySelectorAll('[data-vendor-cta]').forEach((link) => {
      link.addEventListener('click', () => trackVendorClick(link as HTMLAnchorElement));
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();

      let firstInvalid: HTMLSelectElement | null = null;
      selects.forEach((select) => {
        const isValid = Boolean(select.value);
        markValidity(select, isValid);
        if (!isValid && !firstInvalid) firstInvalid = select;
      });

      if (firstInvalid) {
        // The form is novalidate, so ask for the native bubble explicitly.
        form.reportValidity();
        (firstInvalid as HTMLSelectElement).focus();
        return;
      }

      // Read through FormData rather than the ids, so a page rendering two
      // instances of this component still reads the submitted form's answers.
      const data = new FormData(form);
      const category = String(data.get('category') || '').trim();
      const companyType = String(data.get('companyType') || '').trim();
      const budget = String(data.get('budget') || '').trim();
      const location = String(data.get('location') || '').trim();

      const match = resolveRecommendation(category, companyType, budget, location);

      if (result) {
        const pairLabel = result.querySelector('[data-result-pair-label]');
        const rationale = result.querySelector('[data-result-rationale]');
        const pairLink = result.querySelector('[data-result-pair-href]') as HTMLAnchorElement | null;
        if (pairLabel) pairLabel.textContent = match.pairLabel;
        if (rationale) rationale.textContent = match.rationale;
        if (pairLink) {
          pairLink.href = match.pairHref;
          pairLink.textContent = `Read ${match.pairLabel}`;
        }
        applyVendorCta(
          result.querySelector('[data-result-vendor-a]'),
          match.vendorA,
          vendorLinks,
        );
        applyVendorCta(
          result.querySelector('[data-result-vendor-b]'),
          match.vendorB,
          vendorLinks,
        );
        form.classList.add('hidden');
        result.classList.remove('hidden');
        result.removeAttribute('hidden');
        result.querySelector('[data-result-reset]')?.addEventListener(
          'click',
          () => {
            result.classList.add('hidden');
            result.setAttribute('hidden', '');
            form.classList.remove('hidden');
          },
          { once: true },
        );
      } else {
        window.location.href = match.pairHref;
      }
    });
  }

  function initAll() {
    document.querySelectorAll('[data-recommendation-engine]').forEach((root) => {
      if ((root as HTMLElement).dataset.initialized === 'true') return;
      (root as HTMLElement).dataset.initialized = 'true';
      initRecommendationEngine(root);
    });
  }

  if (typeof document !== 'undefined') {
    // Module scripts normally run before DOMContentLoaded, but guard anyway so
    // the prefill can never miss the form.
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }
  }
</script>
