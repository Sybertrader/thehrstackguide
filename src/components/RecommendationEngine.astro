---
interface Props {
  headline?: string;
  description?: string;
  headingLevel?: 'h1' | 'h2';
  showEyebrow?: boolean;
  categoryPrefill?: string;
  class?: string;
}

const {
  headline = 'Unsure which HR software fits your team?',
  description = 'Answer 4 quick questions and see an instant recommendation tailored to your team.',
  headingLevel = 'h2',
  showEyebrow = true,
  categoryPrefill = '',
  class: className = '',
} = Astro.props;

const categories = [
  { value: 'performance', label: 'Performance Management' },
  { value: 'global_eor', label: 'Global Payroll & EOR' },
  { value: 'ats', label: 'Applicant Tracking Systems (ATS)' },
];

// The Global Payroll & EOR hub links to /recommendation/?category=payroll, so
// keep that older value pointing at the category it was always meant to select.
const LEGACY_CATEGORY_VALUES: Record<string, string> = { payroll: 'global_eor' };
const resolvedPrefill = LEGACY_CATEGORY_VALUES[categoryPrefill] ?? categoryPrefill;

// Labels for every persona token the wizard can emit. Question 2 only
// shows the subset that the selected category actually publishes.
const companyTypeCatalog: Record<string, string> = {
  startups: 'Tech Startup',
  scaleups: 'Scaleup (50-250 employees)',
  enterprise: 'Enterprise',
  agencies: 'Agency / Professional Services',
  'remote-teams': 'Remote / Distributed Team',
  'us-latam': 'US & LATAM / Nearshore Team',
  'people-ops': 'People Ops Leader',
  'web3-crypto': 'Web3 & Crypto',
};

const personasByCategory: Record<string, string[]> = {
  ats: ['startups', 'scaleups', 'enterprise', 'agencies', 'remote-teams'],
  global_eor: ['startups', 'scaleups', 'agencies', 'us-latam', 'web3-crypto'],
  performance: ['startups', 'scaleups', 'enterprise', 'people-ops', 'remote-teams'],
};

function companyTypeOptionsFor(category: string): { value: string; label: string }[] {
  return (personasByCategory[category] ?? []).map((value) => ({
    value,
    label: companyTypeCatalog[value] ?? value,
  }));
}

const initialCompanyTypes = companyTypeOptionsFor(resolvedPrefill);

const budgets = [
  { value: 'lean', label: 'Under $500 / month' },
  { value: 'mid', label: '$500–$2,000 / month' },
  { value: 'flexible', label: '$2,000+ / month or flexible' },
];

const locations = [
  { value: 'us_only', label: 'US Only' },
  { value: 'global_remote', label: 'Global / Remote' },
  { value: 'hybrid', label: 'Hybrid (US + International)' },
];

const SELECT_CLASSES =
  'mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-normal text-slate-900 shadow-sm outline-none transition focus:border-indigo-400 focus:ring-4 focus:ring-indigo-100 disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-500';
const LABEL_CLASSES = 'block text-sm font-semibold text-slate-900';

const HeadingTag = headingLevel;
---

<section
  class:list={['recommendation-engine', className]}
  aria-label="Get our recommendation"
  data-recommendation-engine
  data-company-type-catalog={JSON.stringify(companyTypeCatalog)}
  data-personas-by-category={JSON.stringify(personasByCategory)}
>
  {showEyebrow && (
    <span class="inline-flex items-center rounded-full border border-indigo-200 bg-indigo-50 px-3.5 py-1.5 text-sm font-semibold uppercase tracking-wide text-indigo-700">
      Free Guidance
    </span>
  )}
  <HeadingTag
    class:list={[
      'font-bold tracking-tight text-slate-900',
      showEyebrow ? 'mt-5' : '',
      headingLevel === 'h1' ? 'text-3xl sm:text-4xl' : 'text-2xl sm:text-3xl',
    ]}
  >
    {headline}
  </HeadingTag>
  <p class="mt-3 max-w-3xl text-base leading-relaxed text-slate-600 sm:text-lg">
    {description}
  </p>

  <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <form id="wizard-form" class="recommendation-form space-y-6" novalidate>
      <div>
        <label class={LABEL_CLASSES} for="category-select">
          1. Which category are you evaluating?
        </label>
        <select id="category-select" name="category" required class={SELECT_CLASSES}>
          <option value="" disabled selected={!resolvedPrefill}>Select a category</option>
          {categories.map((option) => (
            <option value={option.value} selected={resolvedPrefill === option.value}>
              {option.label}
            </option>
          ))}
        </select>
      </div>

      <div>
        <label class={LABEL_CLASSES} for="company-type-select">
          2. What best describes your company?
        </label>
        <select
          id="company-type-select"
          name="companyType"
          required
          disabled={!resolvedPrefill}
          class={SELECT_CLASSES}
        >
          <option value="" disabled selected>Select company type</option>
          {initialCompanyTypes.map((option) => (
            <option value={option.value}>{option.label}</option>
          ))}
        </select>
      </div>

      <div>
        <label class={LABEL_CLASSES} for="budget-select">
          3. What's your monthly software budget?
        </label>
        <select id="budget-select" name="budget" required class={SELECT_CLASSES}>
          <option value="" disabled selected>Select budget range</option>
          {budgets.map((option) => (
            <option value={option.value}>{option.label}</option>
          ))}
        </select>
      </div>

      <div>
        <label class={LABEL_CLASSES} for="location-select">
          4. Where is your workforce located?
        </label>
        <select id="location-select" name="location" required class={SELECT_CLASSES}>
          <option value="" disabled selected>Select workforce location</option>
          {locations.map((option) => (
            <option value={option.value}>{option.label}</option>
          ))}
        </select>
      </div>

      <button
        type="submit"
        class="inline-flex w-full items-center justify-center rounded-xl bg-indigo-600 px-5 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 sm:w-auto"
      >
        Get Our Recommendation
      </button>
    </form>
  </div>
</section>

<script>
  /**
   * Destinations are assembled from the persona values in Question 2 to match
   * the comparison slugs, so every persona list below is limited to the
   * personas that pair actually has a page for. Anything unpublished falls back
   * to the category hub rather than a mismatched persona's page.
   * `trailingSlash: 'always'` is enforced site-wide, hence the closing slashes.
   */
  const HUBS = {
    performance: '/performance-management/',
    ats: '/applicant-tracking-systems/',
    globalEor: '/global-payroll-eor/',
  };

  const PERFORMANCE_PERSONAS = ['startups', 'scaleups', 'enterprise', 'remote-teams', 'people-ops'];
  const ATS_PERSONAS = ['startups', 'scaleups', 'enterprise', 'remote-teams', 'agencies'];

  // Payroll startup pages still use the legacy `tech-startups` token in this
  // wizard; live child URLs for that persona canonicalize to `-for-startups`.
  // `us-latam` is the public modifier (`-for-us-latam`) and must stay as-is.
  const EOR_PERSONA_SLUGS: Record<string, string> = {
    startups: 'tech-startups',
    scaleups: 'scaleups',
    agencies: 'agencies',
    'us-latam': 'us-latam',
    'web3-crypto': 'web3-crypto',
  };

  function resolveTargetUrl(category: string, companyType: string, location: string): string {
    if (category === 'performance') {
      return PERFORMANCE_PERSONAS.includes(companyType)
        ? `/15five-vs-performyard-for-${companyType}/`
        : HUBS.performance;
    }

    if (category === 'ats') {
      return ATS_PERSONAS.includes(companyType)
        ? `/ashby-vs-greenhouse-for-${companyType}/`
        : HUBS.ats;
    }

    // `payroll` is the legacy value still used by inbound ?category= links.
    if (category === 'global_eor' || category === 'payroll') {
      const persona = EOR_PERSONA_SLUGS[companyType];
      if (!persona) return HUBS.globalEor;

      // Nearshore US + LATAM teams need an EOR pair with LATAM entity
      // coverage (Deel / Oyster), not the US-payroll Gusto comparison.
      if (persona === 'us-latam') {
        return '/deel-vs-oyster-for-us-latam/';
      }

      // US-only startups get the domestic payroll pair instead of an EOR one.
      if (location === 'us_only' && persona === 'tech-startups') {
        return '/rippling-vs-gusto-for-tech-startups/';
      }
      return `/deel-vs-gusto-for-${persona}/`;
    }

    return HUBS.globalEor;
  }

  const INVALID_CLASSES = ['border-red-500', 'ring-2', 'ring-red-100'];

  function markValidity(select: HTMLSelectElement, isValid: boolean) {
    // Swap the resting border out entirely — leaving both colours on the
    // element would make the highlight depend on Tailwind's rule order.
    select.classList.toggle('border-slate-300', isValid);
    INVALID_CLASSES.forEach((className) => select.classList.toggle(className, !isValid));
  }

  // Mirrors the server-side map in the frontmatter. The server path only runs
  // under SSR, so on this static build the prefill happens here.
  const LEGACY_CATEGORY_VALUES: Record<string, string> = { payroll: 'global_eor' };

  function applyCategoryPrefill(form: HTMLFormElement) {
    const select = form.querySelector('select[name="category"]') as HTMLSelectElement | null;
    if (!select) return;

    const requested = new URLSearchParams(window.location.search).get('category');
    if (!requested) return;

    const value = LEGACY_CATEGORY_VALUES[requested] || requested;
    const isKnown = Array.from(select.options).some((option) => option.value === value);
    if (isKnown) select.value = value;
  }

  function parseJsonData<T>(root: HTMLElement, key: string, fallback: T): T {
    try {
      const raw = root.dataset[key];
      return raw ? (JSON.parse(raw) as T) : fallback;
    } catch {
      return fallback;
    }
  }

  function personasForCategory(
    category: string,
    byCategory: Record<string, string[]>,
  ): string[] | null {
    const key = LEGACY_CATEGORY_VALUES[category] ?? category;
    const allowed = byCategory[key];
    return allowed?.length ? allowed : null;
  }

  function syncCompanyTypeOptions(
    root: HTMLElement,
    categorySelect: HTMLSelectElement,
    companyTypeSelect: HTMLSelectElement,
  ) {
    const catalog = parseJsonData<Record<string, string>>(root, 'companyTypeCatalog', {});
    const byCategory = parseJsonData<Record<string, string[]>>(root, 'personasByCategory', {});
    const allowed = personasForCategory(categorySelect.value, byCategory);
    const previous = companyTypeSelect.value;

    const placeholder = document.createElement('option');
    placeholder.value = '';
    placeholder.disabled = true;
    placeholder.textContent = 'Select company type';
    companyTypeSelect.replaceChildren(placeholder);

    if (!allowed) {
      companyTypeSelect.disabled = true;
      companyTypeSelect.selectedIndex = 0;
      markValidity(companyTypeSelect, true);
      return;
    }

    companyTypeSelect.disabled = false;
    for (const value of allowed) {
      const option = document.createElement('option');
      option.value = value;
      option.textContent = catalog[value] ?? value;
      companyTypeSelect.append(option);
    }

    if (previous && allowed.includes(previous)) {
      companyTypeSelect.value = previous;
    } else {
      companyTypeSelect.selectedIndex = 0;
    }

    // A category switch that empties Q2 is a reset, not a failed submit.
    markValidity(companyTypeSelect, true);
  }

  function initRecommendationEngine(root: Element) {
    const form = root.querySelector('.recommendation-form') as HTMLFormElement | null;
    if (!form) return;

    const categorySelect = form.querySelector('select[name="category"]') as HTMLSelectElement | null;
    const companyTypeSelect = form.querySelector(
      'select[name="companyType"]',
    ) as HTMLSelectElement | null;
    if (!categorySelect || !companyTypeSelect) return;

    applyCategoryPrefill(form);
    syncCompanyTypeOptions(root as HTMLElement, categorySelect, companyTypeSelect);

    const selects = Array.from(form.querySelectorAll('select')) as HTMLSelectElement[];

    // Clear the highlight as soon as the visitor answers the question.
    selects.forEach((select) => {
      select.addEventListener('change', () => {
        if (select === categorySelect) {
          syncCompanyTypeOptions(root as HTMLElement, categorySelect, companyTypeSelect);
        }
        if (select.value) markValidity(select, true);
      });
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();

      let firstInvalid: HTMLSelectElement | null = null;
      selects.forEach((select) => {
        const isValid = Boolean(select.value);
        markValidity(select, isValid);
        if (!isValid && !firstInvalid) firstInvalid = select;
      });

      if (firstInvalid) {
        // The form is novalidate, so ask for the native bubble explicitly.
        form.reportValidity();
        (firstInvalid as HTMLSelectElement).focus();
        return;
      }

      // Read through FormData rather than the ids, so a page rendering two
      // instances of this component still reads the submitted form's answers.
      const data = new FormData(form);
      const category = String(data.get('category') || '').trim();
      const companyType = String(data.get('companyType') || '').trim();
      const location = String(data.get('location') || '').trim();

      const targetUrl = resolveTargetUrl(category, companyType, location);
      console.log('Wizard routing submission to:', targetUrl);
      window.location.href = targetUrl;
    });
  }

  function initAll() {
    document.querySelectorAll('[data-recommendation-engine]').forEach((root) => {
      if ((root as HTMLElement).dataset.initialized === 'true') return;
      (root as HTMLElement).dataset.initialized = 'true';
      initRecommendationEngine(root);
    });
  }

  if (typeof document !== 'undefined') {
    // Module scripts normally run before DOMContentLoaded, but guard anyway so
    // the prefill can never miss the form.
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }
  }
</script>
