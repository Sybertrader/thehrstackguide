---
interface VendorPill {
  id: string;
  name: string;
  href: string;
}

interface Props {
  vendors: VendorPill[];
}

const { vendors } = Astro.props;
---

{
  vendors.length > 0 && (
    <section class="mt-10" aria-labelledby="browse-by-vendor-heading">
      <h2 id="browse-by-vendor-heading" class="text-2xl font-bold text-slate-900 sm:text-left text-center">
        Browse by Vendor
      </h2>
      <p class="mt-2 text-center text-base text-slate-600 sm:text-left">
        Select a platform to view all head-to-head comparison guides:
      </p>
      <div class="mt-5 flex flex-wrap justify-center gap-2 sm:justify-start">
        {vendors.map((vendor) => (
          <a
            href={vendor.href}
            class="inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm transition hover:-translate-y-px hover:border-indigo-300 hover:text-indigo-700 hover:shadow-md"
          >
            {vendor.name}
          </a>
        ))}
      </div>
    </section>
  )
}
