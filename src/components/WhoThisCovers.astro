---
import type { ComparisonFamily, ComparisonVariantLink } from '../lib/persona-evaluation';

interface CoverageCard {
  nicheId: string | null;
  title: string;
  body: string;
}

interface Props {
  toolAName: string;
  toolBName: string;
  family?: ComparisonFamily | null;
  variants?: ComparisonVariantLink[];
}

const { toolAName, toolBName, family = null, variants = [] } = Astro.props;

const GENERAL: CoverageCard = {
  nicheId: null,
  title: 'General Tech Buyers',
  body: 'Product, People, and Finance leads comparing the pairing on pricing, coverage, and implementation weight.',
};

const CARD_BY_NICHE: Record<string, CoverageCard> = {
  startups: {
    nicheId: 'startups',
    title: 'Startups',
    body: 'Teams that need a first system of record without an enterprise implementation project.',
  },
  scaleups: {
    nicheId: 'scaleups',
    title: 'Scaleups',
    body: 'Operators consolidating multi-team processes and reporting onto one vendor.',
  },
  enterprise: {
    nicheId: 'enterprise',
    title: 'Enterprise',
    body: 'Procurement-led buyers who need SSO, audit evidence, and a named implementation SLA.',
  },
  agencies: {
    nicheId: 'agencies',
    title: 'Agencies',
    body: 'Studios and staffing firms paying or hiring across client accounts, not a single in-house headcount plan.',
  },
  'remote-teams': {
    nicheId: 'remote-teams',
    title: 'Remote Teams',
    body: 'Distributed operators who cannot assume one office, one calendar, or overlapping working hours.',
  },
  'us-latam': {
    nicheId: 'us-latam',
    title: 'US & LATAM',
    body: 'US companies employing or paying contractors in Brazil, Mexico, Argentina, and the wider LATAM corridor.',
  },
  'web3-crypto': {
    nicheId: 'web3-crypto',
    title: 'Web3 & Crypto',
    body: 'DAO and token-comp teams that need stablecoin rails, contributor agreements, and vesting on the worker file.',
  },
  'people-ops': {
    nicheId: 'people-ops',
    title: 'People Ops',
    body: 'HRBPs who need calibration, engagement, and reviews in one console—not a CSV export every cycle.',
  },
};

const VERTICAL_PERSONAS: Record<ComparisonFamily, string[]> = {
  ats: ['startups', 'scaleups', 'enterprise', 'agencies', 'remote-teams'],
  payroll: ['startups', 'scaleups', 'agencies', 'us-latam', 'web3-crypto'],
  pm: ['startups', 'scaleups', 'enterprise', 'people-ops', 'remote-teams'],
};

const activeNicheIds = new Set(
  variants.map((variant) => (variant.nicheId === 'tech-startups' ? 'startups' : variant.nicheId))
);

const verticalOrder = (family && VERTICAL_PERSONAS[family]) || ['startups', 'scaleups'];
const personaCards = verticalOrder
  .filter((nicheId) => activeNicheIds.has(nicheId) || variants.length === 0)
  .map((nicheId) => CARD_BY_NICHE[nicheId])
  .filter(Boolean);

const cards = [GENERAL, ...personaCards];
---

<section class="mb-10 mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8" aria-label="Who this evaluation covers">
  <h2 class="text-xl font-bold text-slate-900">Who This Evaluation Covers</h2>
  <p class="mt-3 max-w-3xl text-sm leading-relaxed text-slate-600">
    This hub is the baseline {toolAName} vs {toolBName} comparison for general technology buyers. It is written for startups standing up an HR stack for the first time and for scaleups replacing spreadsheets or a first-generation vendor—not for a single niche workflow.
  </p>
  <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {cards.map((card) => (
      <li class="rounded-xl border border-slate-100 bg-slate-50 px-4 py-3">
        <p class="text-sm font-semibold text-slate-900">{card.title}</p>
        <p class="mt-1 text-xs leading-relaxed text-slate-600">{card.body}</p>
      </li>
    ))}
  </ul>
</section>
