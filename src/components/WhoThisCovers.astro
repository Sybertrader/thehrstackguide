---
interface Props {
  toolAName: string;
  toolBName: string;
}

const { toolAName, toolBName } = Astro.props;
---

<section class="mb-10 mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8" aria-label="Who this evaluation covers">
  <h2 class="text-xl font-bold text-slate-900">Who This Evaluation Covers</h2>
  <p class="mt-3 max-w-3xl text-sm leading-relaxed text-slate-600">
    This hub is the baseline {toolAName} vs {toolBName} comparison for general technology buyers. It is written for startups standing up an HR stack for the first time and for scaleups replacing spreadsheets or a first-generation vendor—not for a single niche workflow.
  </p>
  <ul class="mt-5 grid gap-3 sm:grid-cols-3">
    <li class="rounded-xl border border-slate-100 bg-slate-50 px-4 py-3">
      <p class="text-sm font-semibold text-slate-900">General tech buyers</p>
      <p class="mt-1 text-xs leading-relaxed text-slate-600">Product, People, and Finance leads comparing the pairing on pricing, coverage, and implementation weight.</p>
    </li>
    <li class="rounded-xl border border-slate-100 bg-slate-50 px-4 py-3">
      <p class="text-sm font-semibold text-slate-900">Startups</p>
      <p class="mt-1 text-xs leading-relaxed text-slate-600">Teams that need a first system of record without an enterprise implementation project.</p>
    </li>
    <li class="rounded-xl border border-slate-100 bg-slate-50 px-4 py-3">
      <p class="text-sm font-semibold text-slate-900">Scaleups</p>
      <p class="mt-1 text-xs leading-relaxed text-slate-600">Operators consolidating multi-team processes and reporting onto one vendor.</p>
    </li>
  </ul>
</section>
