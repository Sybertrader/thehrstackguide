---
interface Props {
  take: string;
}

const { take } = Astro.props;
---

<blockquote class="my-6 rounded-r-lg border-l-4 border-indigo-600 bg-slate-50 p-4 font-medium text-slate-800">
  <p class="text-xs font-bold uppercase tracking-wide text-indigo-700">The HR Stack Guide Take</p>
  <p class="mt-2 text-base leading-relaxed">{take}</p>
</blockquote>
