---
interface Props {
  vendorAName: string;
  vendorBName: string;
  pickA: string;
  pickB: string;
  tradeoff: string;
}

const { vendorAName, vendorBName, pickA, pickB, tradeoff } = Astro.props;
---

<section class="my-8 rounded-2xl border border-indigo-200 bg-indigo-50/60 p-5 sm:p-6" aria-label={`${vendorAName} vs ${vendorBName} decision framework`}>
  <h2 class="text-xs font-bold uppercase tracking-wide text-indigo-700">How to choose: {vendorAName} vs {vendorBName}</h2>
  <p class="mt-3 text-base leading-relaxed text-slate-800">{pickA} {pickB}</p>
  <p class="mt-3 text-base leading-relaxed text-slate-800">{tradeoff}</p>
</section>
