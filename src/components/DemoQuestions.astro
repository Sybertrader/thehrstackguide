---
/**
 * Deal-breaker questions for comparison pages. Vendor names are
 * interpolated so the checklist is about this pair, not generic HR software.
 */
interface Props {
  toolA: string;
  toolB: string;
  family?: 'payroll' | 'ats' | 'pm' | null;
}

const { toolA, toolB, family = 'payroll' } = Astro.props;

const questionTwo =
  family === 'ats'
    ? {
        label: 'Recruiter seats vs the sticker',
        question: `Is sourcing CRM, nurture, and unlimited reviewer seats inside the ${toolA} and ${toolB} base plan, or billed per recruiter?`,
      }
    : family === 'pm'
      ? {
          label: 'Modules they will not mention first',
          question: `Are 1:1s, manager prompts, and engagement surveys inside the ${toolA} and ${toolB} per-user fee, or sold after you are in procurement?`,
        }
      : {
          label: 'The FX line they bury',
          question: `What exact percentage does ${toolA} or ${toolB} add on foreign-currency payouts? I want the spread, not the headline seat.`,
        };

const questions = [
  {
    label: 'Auto-renewal and your data',
    question: `How many days' written notice stop auto-renewal at ${toolA} and ${toolB}, and do we keep historical records if we leave?`,
  },
  questionTwo,
  {
    label: 'Seat minimums after a layoff',
    question: `If we cut headcount mid-contract, does the ${toolA} or ${toolB} bill actually drop, or are we stuck on a minimum?`,
  },
  {
    label: 'Setup fees not on the website',
    question: `What onboarding or dedicated-manager surcharge does ${toolA} or ${toolB} charge that is missing from the public pricing page?`,
  },
];
---

<section class="mb-12" aria-label={`Demo questions for ${toolA} and ${toolB}`}>
  <h2 class="text-2xl font-bold text-slate-900">Questions to Ask on Your Demo Call</h2>
  <p class="mt-2 max-w-3xl text-base leading-relaxed text-slate-700">
    Take these four questions to <span class="font-semibold text-slate-900">{toolA}</span> and <span class="font-semibold text-slate-900">{toolB}</span>. If they dodge them, walk.
  </p>

  <ol class="mt-6 grid gap-4 sm:grid-cols-2">
    {questions.map((item, index) => (
      <li class="rounded-r-2xl rounded-l-md border border-slate-200 border-l-4 border-l-indigo-600 bg-indigo-50/40 p-5">
        <p class="text-xs font-semibold uppercase tracking-wider text-indigo-700">
          Question {index + 1}
        </p>
        <h3 class="mt-1.5 text-lg font-bold text-slate-900">{item.label}</h3>
        <p class="mt-1 text-sm text-slate-600">
          Ask both {toolA} and {toolB}:
        </p>
        <blockquote class="mt-3 text-base font-medium leading-relaxed text-slate-700">
          &ldquo;{item.question}&rdquo;
        </blockquote>
      </li>
    ))}
  </ol>
</section>
