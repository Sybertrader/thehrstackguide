---
/**
 * Short demo prompt for a comparison hub. The long shared question script
 * is not repeated on every pair. Booking still goes to each vendor.
 */
import VendorButton from './VendorButton.astro';

interface Props {
  toolA: string;
  toolB: string;
  family?: 'payroll' | 'ats' | 'pm' | null;
  toolAId: string;
  toolBId: string;
  toolAAffiliateHref: string;
  toolBAffiliateHref: string;
  toolAIsManualLead?: boolean;
  toolBIsManualLead?: boolean;
  toolAModalId?: string;
  toolBModalId?: string;
  toolAIsWinner?: boolean;
  toolBIsWinner?: boolean;
}

const {
  toolA,
  toolB,
  toolAId,
  toolBId,
  toolAAffiliateHref,
  toolBAffiliateHref,
  toolAIsManualLead = false,
  toolBIsManualLead = false,
  toolAModalId = '',
  toolBModalId = '',
  toolAIsWinner = false,
  toolBIsWinner = false,
} = Astro.props;

const demoCtaClass = (isWinner: boolean) =>
  isWinner
    ? 'inline-flex w-full items-center justify-center rounded-xl bg-indigo-600 px-6 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2'
    : 'inline-flex w-full items-center justify-center rounded-xl border-2 border-indigo-600 bg-white px-6 py-3.5 text-sm font-semibold text-indigo-700 shadow-sm transition hover:bg-indigo-50 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2';
---

<section
  class="mb-12"
  aria-label={`Demo questions for ${toolA} and ${toolB}`}
  data-demo-questions
  data-demo-pair={`${toolA} vs ${toolB}`}
>
  <h2 class="text-2xl font-bold text-slate-900">Questions for the {toolA} and {toolB} demo</h2>
  <p class="mt-2 max-w-3xl text-base leading-relaxed text-slate-700">
    Ask what stops auto-renewal, whether the bill drops if headcount falls, and which fee is missing from the public {toolA} and {toolB} price.
  </p>

  <div class="mt-6 grid w-full gap-4 sm:grid-cols-2">
    <VendorButton
      href={toolAAffiliateHref}
      modalId={toolAIsManualLead ? toolAModalId : undefined}
      vendorId={toolAId}
      vendorName={toolA}
      location="demo_questions"
      leadMagnet
      leadMagnetBadge={false}
      class={demoCtaClass(toolAIsWinner || !toolBIsWinner)}
    >
      Book {toolA} Demo →
    </VendorButton>
    <VendorButton
      href={toolBAffiliateHref}
      modalId={toolBIsManualLead ? toolBModalId : undefined}
      vendorId={toolBId}
      vendorName={toolB}
      location="demo_questions"
      leadMagnet
      leadMagnetBadge={false}
      class={demoCtaClass(toolBIsWinner)}
    >
      Book {toolB} Demo →
    </VendorButton>
  </div>
</section>
