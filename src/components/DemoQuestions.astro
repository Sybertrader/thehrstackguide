---
/**
 * Deal-breaker questions for comparison pages. Vendor names are
 * interpolated so the checklist is about this pair, not generic HR software.
 */
import VendorButton from './VendorButton.astro';

interface Props {
  toolA: string;
  toolB: string;
  family?: 'payroll' | 'ats' | 'pm' | null;
  toolAId: string;
  toolBId: string;
  toolAAffiliateHref: string;
  toolBAffiliateHref: string;
  toolAIsManualLead?: boolean;
  toolBIsManualLead?: boolean;
  toolAModalId?: string;
  toolBModalId?: string;
  toolAIsWinner?: boolean;
  toolBIsWinner?: boolean;
}

const {
  toolA,
  toolB,
  family = 'payroll',
  toolAId,
  toolBId,
  toolAAffiliateHref,
  toolBAffiliateHref,
  toolAIsManualLead = false,
  toolBIsManualLead = false,
  toolAModalId = '',
  toolBModalId = '',
  toolAIsWinner = false,
  toolBIsWinner = false,
} = Astro.props;

const demoCtaClass = (isWinner: boolean) =>
  isWinner
    ? 'inline-flex w-full items-center justify-center rounded-xl bg-indigo-600 px-6 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2'
    : 'inline-flex w-full items-center justify-center rounded-xl border-2 border-indigo-600 bg-white px-6 py-3.5 text-sm font-semibold text-indigo-700 shadow-sm transition hover:bg-indigo-50 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2';

const questionTwo =
  family === 'ats'
    ? {
        label: 'Recruiter seats vs the sticker',
        question: `Is sourcing CRM, nurture, and unlimited reviewer seats inside the ${toolA} and ${toolB} base plan, or billed per recruiter?`,
      }
    : family === 'pm'
      ? {
          label: 'Modules they will not mention first',
          question: `Are 1:1s, manager prompts, and engagement surveys inside the ${toolA} and ${toolB} per-user fee, or sold after you are in procurement?`,
        }
      : {
          label: 'The FX line they bury',
          question: `What exact percentage does ${toolA} or ${toolB} add on foreign-currency payouts? I want the spread, not the headline seat.`,
        };

const questions = [
  {
    label: 'Auto-renewal and your data',
    question: `How many days' written notice stop auto-renewal at ${toolA} and ${toolB}, and do we keep historical records if we leave?`,
  },
  questionTwo,
  {
    label: 'Seat minimums after a layoff',
    question: `If we cut headcount mid-contract, does the ${toolA} or ${toolB} bill actually drop, or are we stuck on a minimum?`,
  },
  {
    label: 'Setup fees not on the website',
    question: `What onboarding or dedicated-manager surcharge does ${toolA} or ${toolB} charge that is missing from the public pricing page?`,
  },
];
---

<section
  class="mb-12"
  aria-label={`Demo questions for ${toolA} and ${toolB}`}
  data-demo-questions
  data-demo-pair={`${toolA} vs ${toolB}`}
>
  <h2 class="text-2xl font-bold text-slate-900">Critical Questions to Ask on Your Demo Call</h2>
  <p class="mt-2 max-w-3xl text-base leading-relaxed text-slate-700">
    Take these four questions to <span class="font-semibold text-slate-900">{toolA}</span> and <span class="font-semibold text-slate-900">{toolB}</span>. If they dodge them, walk.
  </p>

  <ol class="mt-6 grid gap-4 sm:grid-cols-2">
    {questions.map((item, index) => (
      <li
        class="rounded-r-2xl rounded-l-md border border-slate-200 border-l-4 border-l-indigo-600 bg-indigo-50/40 p-5"
        data-demo-question-label={item.label}
        data-demo-question-text={item.question}
      >
        <p class="text-xs font-semibold uppercase tracking-wider text-indigo-700">
          Question {index + 1}
        </p>
        <h3 class="mt-1.5 text-lg font-bold text-slate-900">{item.label}</h3>
        <p class="mt-1 text-sm text-slate-600">
          Ask both {toolA} and {toolB}:
        </p>
        <blockquote class="mt-3 text-base font-medium leading-relaxed text-slate-700">
          &ldquo;{item.question}&rdquo;
        </blockquote>
        <button
          type="button"
          class="js-copy-demo-question mt-3 text-xs font-medium text-slate-500 underline-offset-2 transition hover:text-indigo-700 hover:underline"
          data-copy-question={item.question}
        >
          Copy question to notes
        </button>
      </li>
    ))}
  </ol>

  <div class="mt-6 flex justify-center">
    <button
      type="button"
      class="js-copy-all-demo-questions inline-flex w-full max-w-xl items-center justify-center gap-2 rounded-xl border-2 border-indigo-600 bg-white px-5 py-3 text-sm font-semibold text-indigo-700 shadow-sm transition hover:bg-indigo-50 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 active:bg-indigo-100"
    >
      📋 Copy All Demo Questions to Clipboard
    </button>
  </div>

  <div class="mt-8 flex flex-col items-center text-center">
    <p class="max-w-3xl text-base leading-relaxed text-slate-700 italic">
      Or book a demo call directly with {toolA} or {toolB} and get the complete Vendor Evaluation Scorecard (.docx) with the full list of 20+ questions and evaluation grid:
    </p>
    <p class="mt-4">
      <span class="inline-flex max-w-full items-center justify-center rounded-full bg-amber-100 px-2.5 py-1 text-[11px] font-semibold leading-snug text-amber-950 ring-1 ring-inset ring-amber-300">
        🎁 Includes Free Vendor Evaluation Scorecard (.docx)
      </span>
    </p>
    <div class="mt-3 grid w-full max-w-3xl gap-4 sm:grid-cols-2">
      <VendorButton
        href={toolAAffiliateHref}
        modalId={toolAIsManualLead ? toolAModalId : undefined}
        vendorId={toolAId}
        vendorName={toolA}
        location="demo_questions"
        leadMagnet
        leadMagnetBadge={false}
        class={demoCtaClass(toolAIsWinner || !toolBIsWinner)}
      >
        Book {toolA} Demo →
      </VendorButton>
      <VendorButton
        href={toolBAffiliateHref}
        modalId={toolBIsManualLead ? toolBModalId : undefined}
        vendorId={toolBId}
        vendorName={toolB}
        location="demo_questions"
        leadMagnet
        leadMagnetBadge={false}
        class={demoCtaClass(toolBIsWinner)}
      >
        Book {toolB} Demo →
      </VendorButton>
    </div>
  </div>
</section>

<script>
  const COPY_ALL_IDLE = '📋 Copy All Demo Questions to Clipboard';
  const COPY_ALL_DONE = '✓ All Questions Copied to Clipboard!';
  const COPY_ALL_FAIL = 'Copy failed';
  const COPY_ALL_IDLE_CLASS =
    'border-indigo-600 bg-white text-indigo-700 hover:bg-indigo-50 active:bg-indigo-100';
  const COPY_ALL_DONE_CLASS =
    'border-emerald-600 bg-emerald-50 text-emerald-800 hover:bg-emerald-50 active:bg-emerald-50';

  function copyQuestionText(text: string) {
    const area = document.createElement('textarea');
    area.value = text;
    area.setAttribute('readonly', '');
    area.style.position = 'fixed';
    area.style.left = '-9999px';
    document.body.appendChild(area);
    area.select();
    const ok = document.execCommand('copy');
    document.body.removeChild(area);
    if (!ok) throw new Error('copy failed');
  }

  async function writeClipboard(text: string) {
    if (navigator.clipboard?.writeText) {
      await navigator.clipboard.writeText(text);
      return;
    }
    copyQuestionText(text);
  }

  function formatAllQuestions(root: HTMLElement): string {
    const pair = root.getAttribute('data-demo-pair') ?? '';
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-demo-question-text]'));
    const lines = cards.map((card, index) => {
      const title = (card.getAttribute('data-demo-question-label') ?? '').trim();
      const question = (card.getAttribute('data-demo-question-text') ?? '').trim();
      return `${index + 1}. ${title}: "${question}"`;
    });
    return `Demo Questions for ${pair}:\n\n${lines.join('\n')}`;
  }

  document.querySelectorAll('.js-copy-demo-question').forEach((node) => {
    const button = node as HTMLButtonElement;
    const original = button.textContent ?? 'Copy question to notes';
    button.addEventListener('click', async () => {
      const text = button.getAttribute('data-copy-question') ?? '';
      if (!text) return;
      try {
        await writeClipboard(text);
        button.textContent = 'Copied to notes';
      } catch {
        try {
          copyQuestionText(text);
          button.textContent = 'Copied to notes';
        } catch {
          button.textContent = 'Copy failed';
        }
      }
      window.setTimeout(() => {
        button.textContent = original;
      }, 1600);
    });
  });

  document.querySelectorAll('.js-copy-all-demo-questions').forEach((node) => {
    const button = node as HTMLButtonElement;
    button.addEventListener('click', async () => {
      const root = button.closest<HTMLElement>('[data-demo-questions]');
      if (!root) return;
      const formatted = formatAllQuestions(root);
      if (!formatted.trim()) return;

      const succeed = () => {
        button.textContent = COPY_ALL_DONE;
        button.classList.remove(...COPY_ALL_IDLE_CLASS.split(' '));
        button.classList.add(...COPY_ALL_DONE_CLASS.split(' '));
      };
      const fail = () => {
        button.textContent = COPY_ALL_FAIL;
      };
      const restore = () => {
        button.textContent = COPY_ALL_IDLE;
        button.classList.remove(...COPY_ALL_DONE_CLASS.split(' '));
        button.classList.add(...COPY_ALL_IDLE_CLASS.split(' '));
      };

      try {
        await writeClipboard(formatted);
        succeed();
      } catch {
        try {
          copyQuestionText(formatted);
          succeed();
        } catch {
          fail();
        }
      }
      window.setTimeout(restore, 2000);
    });
  });
</script>
