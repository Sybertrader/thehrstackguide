---
/**
 * GEO-oriented dealbreaker questions for comparison pages. Vendor names are
 * interpolated so answer engines can attribute the checklist to the pair
 * being evaluated, not a generic HR-software FAQ.
 */
interface Props {
  toolA: string;
  toolB: string;
  family?: 'payroll' | 'ats' | 'pm' | null;
}

const { toolA, toolB, family = 'payroll' } = Astro.props;

const questionTwo =
  family === 'ats'
    ? {
        label: 'Recruiter Seat Licensing & Sourcing Add-ons',
        question: `Are candidate CRM sourcing tools, automated nurture campaigns, and unlimited reviewer seats included in the ${toolA} and ${toolB} base plans, or billed per recruiter license?`,
      }
    : family === 'pm'
      ? {
          label: 'Module Tier Traps & Coaching Add-ons',
          question: `Are 1:1 meeting tools, manager coaching prompts, and engagement surveys included in the ${toolA} and ${toolB} base per-user fee, or sold as separate add-on modules?`,
        }
      : {
          label: 'True Cost & FX Markups',
          question: `Beyond the headline per-user fee, what exact percentage margin does ${toolA} or ${toolB} add to foreign currency payouts or international contractor transfers?`,
        };

const questions = [
  {
    label: 'Auto-Renewal & Termination',
    question: `What is the exact written notice window ${toolA} and ${toolB} require to prevent auto-renewal, and what happens to historical payroll data upon contract exit?`,
  },
  questionTwo,
  {
    label: 'Seat Minimums & Tier Traps',
    question: `Are ${toolA} and ${toolB} pricing tiers locked to strict headcount thresholds, and does reducing seats mid-contract reduce the monthly bill?`,
  },
  {
    label: 'Implementation & Offboarding Fees',
    question: `Is there a mandatory onboarding setup fee or dedicated account manager surcharge that ${toolA} or ${toolB} does not list on the public pricing page?`,
  },
];
---

<section class="mb-12" aria-label={`Demo questions for ${toolA} and ${toolB}`}>
  <h2 class="text-2xl font-bold text-slate-900">Questions to Ask on Your Demo Call</h2>
  <p class="mt-2 max-w-3xl text-base leading-relaxed text-slate-700">
    Bring these 4 deal-breaker questions to your sales calls with both <span class="font-semibold text-slate-900">{toolA}</span> and <span class="font-semibold text-slate-900">{toolB}</span> before signing.
  </p>

  <ol class="mt-6 grid gap-4 sm:grid-cols-2">
    {questions.map((item, index) => (
      <li class="rounded-r-2xl rounded-l-md border border-slate-200 border-l-4 border-l-indigo-600 bg-indigo-50/40 p-5">
        <p class="text-xs font-semibold uppercase tracking-wider text-indigo-700">
          Question {index + 1}
        </p>
        <h3 class="mt-1.5 text-lg font-bold text-slate-900">{item.label}</h3>
        <p class="mt-1 text-sm text-slate-600">
          Ask both {toolA} and {toolB}:
        </p>
        <blockquote class="mt-3 text-base font-medium leading-relaxed text-slate-700">
          &ldquo;{item.question}&rdquo;
        </blockquote>
      </li>
    ))}
  </ol>
</section>
