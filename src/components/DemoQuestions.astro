---
/**
 * Demo kit. Vendor buttons are the primary action: each one opens that
 * vendor's affiliate route and downloads the scorecard. The bare file link
 * stays secondary so it does not outrank the demo click.
 */
import { SCORECARD_FILENAME, SCORECARD_HREF } from '../lib/lead-magnet';
import { isAffiliateRedirect, outboundRel } from '../lib/links';
import { isManualLeadBrand } from '../lib/outbound';

interface Props {
  toolA: string;
  toolB: string;
  toolASlug?: string;
  toolBSlug?: string;
  family?: 'payroll' | 'ats' | 'pm' | null;
  toolAId: string;
  toolBId: string;
  toolAAffiliateHref: string;
  toolBAffiliateHref: string;
  toolAIsManualLead?: boolean;
  toolBIsManualLead?: boolean;
  toolAModalId?: string;
  toolBModalId?: string;
  toolAIsWinner?: boolean;
  toolBIsWinner?: boolean;
}

const {
  toolA,
  toolB,
  toolASlug,
  toolBSlug,
  toolAId,
  toolBId,
  toolAAffiliateHref,
  toolBAffiliateHref,
  toolAIsManualLead = false,
  toolBIsManualLead = false,
  toolAModalId = '',
  toolBModalId = '',
} = Astro.props;

function vendorSlug(explicit: string | undefined, id: string, name: string): string {
  return (explicit || id || name).trim().toLowerCase().replace(/\s+/g, '-');
}

/**
 * Registered affiliates already resolve to `/go/{id}/`. Use that path.
 * A missing `/go/` route must not be invented for lead-capture brands.
 */
function demoHref(explicitSlug: string | undefined, id: string, name: string, resolved: string): string {
  if (isAffiliateRedirect(resolved)) return resolved.endsWith('/') ? resolved : `${resolved}/`;
  if (resolved) return resolved;
  return `/go/${vendorSlug(explicitSlug, id, name)}/`;
}

const vendorASlug = vendorSlug(toolASlug, toolAId, toolA);
const vendorBSlug = vendorSlug(toolBSlug, toolBId, toolB);
const vendorAHref = demoHref(toolASlug, toolAId, toolA, toolAAffiliateHref);
const vendorBHref = demoHref(toolBSlug, toolBId, toolB, toolBAffiliateHref);
const vendorAManual = toolAIsManualLead || isManualLeadBrand(toolAId);
const vendorBManual = toolBIsManualLead || isManualLeadBrand(toolBId);

const primaryAClass =
  'js-affiliate-cta inline-flex w-full items-center justify-between rounded-xl bg-slate-900 px-5 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-900 focus:ring-offset-2';
const primaryBClass =
  'js-affiliate-cta inline-flex w-full items-center justify-between rounded-xl bg-indigo-600 px-5 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2';
---

<section
  class="my-12 overflow-hidden rounded-2xl border border-indigo-100 bg-gradient-to-br from-indigo-50/60 via-white to-slate-50 p-6 shadow-sm sm:p-8"
  aria-label={`Demo preparation kit for ${toolA} and ${toolB}`}
  data-demo-questions
  data-demo-pair={`${toolA} vs ${toolB}`}
>
  <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
    <div class="max-w-xl">
      <div class="inline-flex items-center gap-1.5 rounded-md bg-indigo-100 px-2.5 py-1 text-xs font-semibold text-indigo-800">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
        Demo Preparation Kit
      </div>

      <h2 class="mt-3 text-2xl font-bold tracking-tight text-slate-900">
        Evaluate {toolA} vs {toolB} Like a Procurement Pro
      </h2>

      <p class="mt-2 text-sm leading-relaxed text-slate-600 sm:text-base">
        Book a demo below to automatically receive our editable Word scorecard. Grade both sales teams side-by-side on hidden fees, entity compliance, and contract terms.
      </p>

      <ul class="mt-4 grid grid-cols-1 gap-2 text-xs font-medium text-slate-700 sm:grid-cols-2">
        <li class="flex items-center gap-2">
          <svg class="h-4 w-4 shrink-0 text-emerald-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          20 red-flag demo questions
        </li>
        <li class="flex items-center gap-2">
          <svg class="h-4 w-4 shrink-0 text-emerald-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          1–5 rating scale across 4 key pillars
        </li>
        <li class="flex items-center gap-2">
          <svg class="h-4 w-4 shrink-0 text-emerald-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          Executive comparison sheet
        </li>
        <li class="flex items-center gap-2">
          <svg class="h-4 w-4 shrink-0 text-emerald-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          Editable Word format (.docx)
        </li>
      </ul>
    </div>

    <div class="flex shrink-0 flex-col gap-3 sm:min-w-[280px]">
      {vendorAManual ? (
        <button
          type="button"
          data-modal-target={toolAModalId || undefined}
          data-download-scorecard
          class={primaryAClass}
          data-vendor-id={toolAId || vendorASlug}
          data-vendor-name={toolA}
          data-cta-location="scorecard_kit"
          data-destination-type="lead_modal"
        >
          <span>Book {toolA} Demo</span>
          <span class="text-xs font-normal text-slate-300">+ Scorecard →</span>
        </button>
      ) : (
        <a
          href={vendorAHref}
          target="_blank"
          rel={outboundRel(vendorAHref) ?? 'noopener sponsored'}
          data-download-scorecard
          class={primaryAClass}
          data-vendor-id={toolAId || vendorASlug}
          data-vendor-name={toolA}
          data-cta-location="scorecard_kit"
          data-destination-type={isAffiliateRedirect(vendorAHref) ? 'go_redirect' : 'direct_outbound'}
        >
          <span>Book {toolA} Demo</span>
          <span class="text-xs font-normal text-slate-300">+ Scorecard →</span>
        </a>
      )}

      {vendorBManual ? (
        <button
          type="button"
          data-modal-target={toolBModalId || undefined}
          data-download-scorecard
          class={primaryBClass}
          data-vendor-id={toolBId || vendorBSlug}
          data-vendor-name={toolB}
          data-cta-location="scorecard_kit"
          data-destination-type="lead_modal"
        >
          <span>Book {toolB} Demo</span>
          <span class="text-xs font-normal text-indigo-200">+ Scorecard →</span>
        </button>
      ) : (
        <a
          href={vendorBHref}
          target="_blank"
          rel={outboundRel(vendorBHref) ?? 'noopener sponsored'}
          data-download-scorecard
          class={primaryBClass}
          data-vendor-id={toolBId || vendorBSlug}
          data-vendor-name={toolB}
          data-cta-location="scorecard_kit"
          data-destination-type={isAffiliateRedirect(vendorBHref) ? 'go_redirect' : 'direct_outbound'}
        >
          <span>Book {toolB} Demo</span>
          <span class="text-xs font-normal text-indigo-200">+ Scorecard →</span>
        </a>
      )}

      <a
        href={SCORECARD_HREF}
        download={SCORECARD_FILENAME}
        class="mt-1 text-center text-xs font-medium text-slate-500 underline decoration-slate-300 underline-offset-4 transition hover:text-slate-800"
      >
        Download blank scorecard only (.docx)
      </a>
    </div>
  </div>
</section>

<script>
  import { initScorecardDownload } from '../scripts/scorecard';

  initScorecardDownload();
</script>
