---
interface Props {
  categoryName: string;
  /** Accent theme aligned to each category hub. */
  theme?: 'indigo' | 'teal' | 'sky';
  ctaHref?: string;
}

const { categoryName, theme = 'indigo', ctaHref = '/contact/' } = Astro.props;

const themes = {
  indigo: {
    shell: 'border-indigo-200 bg-indigo-50/70',
    accentBar: 'from-indigo-500 to-violet-600',
    button: 'bg-indigo-600 hover:bg-indigo-700 focus:ring-indigo-500',
    eyebrow: 'bg-indigo-100 text-indigo-700',
  },
  teal: {
    shell: 'border-teal-200 bg-teal-50/70',
    accentBar: 'from-emerald-500 to-teal-600',
    button: 'bg-teal-600 hover:bg-teal-700 focus:ring-teal-500',
    eyebrow: 'bg-teal-100 text-teal-800',
  },
  sky: {
    shell: 'border-sky-200 bg-sky-50/70',
    accentBar: 'from-sky-500 to-cyan-600',
    button: 'bg-sky-600 hover:bg-sky-700 focus:ring-sky-500',
    eyebrow: 'bg-sky-100 text-sky-800',
  },
} as const;

const styles = themes[theme];
---

<section class="mt-12" aria-label="Get a stack recommendation">
  <div class:list={['relative overflow-hidden rounded-2xl border p-6 shadow-sm sm:p-8', styles.shell]}>
    <div class:list={['absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r', styles.accentBar]} aria-hidden="true"></div>
    <span class:list={['inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wide', styles.eyebrow]}>
      Free concierge
    </span>
    <h2 class="mt-4 text-2xl font-bold tracking-tight text-slate-900">
      Unsure which {categoryName} platform fits your team?
    </h2>
    <p class="mt-3 max-w-2xl text-base leading-relaxed text-slate-600">
      Skip hours of demo calls. Answer 3 quick questions and get our unbiased recommendation based on your headcount and budget.
    </p>
    <a
      href={ctaHref}
      class:list={[
        'mt-6 inline-flex items-center justify-center rounded-xl px-5 py-3 text-sm font-semibold text-white shadow-sm transition focus:outline-none focus:ring-2 focus:ring-offset-2',
        styles.button,
      ]}
    >
      Get Stack Recommendation
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="ml-1.5 h-4 w-4" aria-hidden="true">
        <path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 0 1 .75-.75h8.5a.75.75 0 0 1 .75.75v5.75a.75.75 0 0 1-1.5 0V7.06l-7.47 7.47a.75.75 0 0 1-1.06-1.06L11.94 6H5.5a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd" />
      </svg>
    </a>
  </div>
</section>
