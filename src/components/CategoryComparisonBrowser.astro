---
import type { Comparison } from '../types/comparison';
import { buildCategoryBrowser, childHref } from '../lib/category-browser';

interface Props {
  comparisons: Comparison[];
  theme: 'emerald' | 'indigo' | 'sky';
  idPrefix: string;
}

const { comparisons, theme, idPrefix } = Astro.props;
const { pills, pairings } = buildCategoryBrowser(comparisons);
const defaultPill = pills[0] ?? null;

const themeClasses = {
  emerald: {
    active: 'border-emerald-600 bg-emerald-600 text-white shadow-sm',
    inactive: 'border-slate-200 bg-white text-slate-600 hover:border-emerald-300 hover:text-emerald-700',
    cardHover: 'hover:border-emerald-300',
    titleHover: 'group-hover:text-emerald-600',
    iconHover: 'group-hover:text-emerald-600',
  },
  indigo: {
    active: 'border-indigo-600 bg-indigo-600 text-white shadow-sm',
    inactive: 'border-slate-200 bg-white text-slate-600 hover:border-indigo-300 hover:text-indigo-700',
    cardHover: 'hover:border-indigo-300',
    titleHover: 'group-hover:text-indigo-600',
    iconHover: 'group-hover:text-indigo-600',
  },
  sky: {
    active: 'border-sky-600 bg-sky-600 text-white shadow-sm',
    inactive: 'border-slate-200 bg-white text-slate-600 hover:border-sky-300 hover:text-sky-700',
    cardHover: 'hover:border-sky-300',
    titleHover: 'group-hover:text-sky-600',
    iconHover: 'group-hover:text-sky-600',
  },
} as const;

const palette = themeClasses[theme];
---

{
  pills.length > 0 && pairings.length > 0 && defaultPill && (
    <div data-comparison-browser data-theme={theme}>
      <p class="mb-6 max-w-3xl text-sm text-slate-500">
        {pairings.length} head-to-head pairings across {pills.length} audience-specific use cases. Filter by team type to open the child comparison built for that workflow.
      </p>

      <p
        data-vendor-filter-banner
        class="mb-6 hidden rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-600"
      >
        Showing head-to-head guides that include <span data-vendor-filter-name class="font-semibold text-slate-900"></span>
        <a data-vendor-clear href="./" class="font-semibold text-indigo-600 hover:text-indigo-700">
          View all comparisons
        </a>
      </p>

      <div class="mb-8 flex flex-wrap gap-2" role="tablist" aria-label="Filter comparisons by use case">
        {pills.map((pill, index) => (
          <button
            type="button"
            role="tab"
            id={`${idPrefix}-tab-${pill.slug}`}
            data-persona-pill={pill.slug}
            data-persona-label={pill.label}
            aria-selected={index === 0 ? 'true' : 'false'}
            class:list={[
              'inline-flex items-center rounded-full border px-4 py-2 text-sm font-semibold transition',
              index === 0 ? palette.active : palette.inactive,
            ]}
          >
            {pill.label}
          </button>
        ))}
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" id={`${idPrefix}-comparison-grid`}>
        {pairings.map((pairing) => {
          const hasDefault = pairing.modifiers.includes(defaultPill.slug);
          return (
            <a
              href={childHref(pairing.baseSlug, defaultPill.slug)}
              data-base-slug={pairing.baseSlug}
              data-modifiers={pairing.modifiers.join(',')}
              data-tool-a-id={pairing.toolAId}
              data-tool-b-id={pairing.toolBId}
              data-tool-a-name={pairing.toolAName}
              data-tool-b-name={pairing.toolBName}
              class:list={[
                'comparison-card group flex flex-col gap-2 rounded-xl border border-slate-200 bg-white px-4 py-3.5 text-sm shadow-sm transition duration-150 hover:-translate-y-0.5 hover:shadow-md',
                palette.cardHover,
                hasDefault ? '' : 'hidden opacity-0',
              ]}
            >
              <span
                data-persona-badge
                class="inline-flex w-fit items-center rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-slate-500"
              >
                {defaultPill.label}
              </span>
              <span class="flex items-center justify-between gap-3">
                <span class:list={['font-semibold text-slate-800 transition', palette.titleHover]}>
                  {pairing.toolAName} vs {pairing.toolBName}
                </span>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class:list={['h-4 w-4 shrink-0 text-slate-400 transition', palette.iconHover]} aria-hidden="true">
                  <path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 0 1 .75-.75h8.5a.75.75 0 0 1 .75.75v5.75a.75.75 0 0 1-1.5 0V7.06l-7.47 7.47a.75.75 0 0 1-1.06-1.06L11.94 6H5.5a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd" />
                </svg>
              </span>
            </a>
          );
        })}
      </div>

      <p data-comparison-empty-state class="hidden mt-10 text-center text-sm text-slate-500">
        No comparisons found for this use case yet.
      </p>
    </div>
  )
}

<script>
  const THEME_CLASSES = {
    emerald: {
      active: ['border-emerald-600', 'bg-emerald-600', 'text-white', 'shadow-sm'],
      inactive: ['border-slate-200', 'bg-white', 'text-slate-600', 'hover:border-emerald-300', 'hover:text-emerald-700'],
    },
    indigo: {
      active: ['border-indigo-600', 'bg-indigo-600', 'text-white', 'shadow-sm'],
      inactive: ['border-slate-200', 'bg-white', 'text-slate-600', 'hover:border-indigo-300', 'hover:text-indigo-700'],
    },
    sky: {
      active: ['border-sky-600', 'bg-sky-600', 'text-white', 'shadow-sm'],
      inactive: ['border-slate-200', 'bg-white', 'text-slate-600', 'hover:border-sky-300', 'hover:text-sky-700'],
    },
  } as const;

  function initComparisonBrowsers() {
    const roots = Array.from(document.querySelectorAll<HTMLElement>('[data-comparison-browser]'));

    for (const root of roots) {
      const theme = (root.dataset.theme ?? 'emerald') as keyof typeof THEME_CLASSES;
      const palette = THEME_CLASSES[theme] ?? THEME_CLASSES.emerald;
      const tabButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-persona-pill]'));
      const cards = Array.from(root.querySelectorAll<HTMLAnchorElement>('.comparison-card'));
      const emptyState = root.querySelector<HTMLElement>('[data-comparison-empty-state]');
      const vendorBanner = root.querySelector<HTMLElement>('[data-vendor-filter-banner]');
      const vendorNameEl = root.querySelector<HTMLElement>('[data-vendor-filter-name]');
      const vendorClear = root.querySelector<HTMLAnchorElement>('[data-vendor-clear]');
      if (!tabButtons.length || !cards.length) continue;

      const vendor = (new URLSearchParams(window.location.search).get('vendor') ?? '').trim().toLowerCase();

      function cardMatchesVendor(card: HTMLAnchorElement): boolean {
        if (!vendor) return true;
        return card.dataset.toolAId === vendor || card.dataset.toolBId === vendor;
      }

      function vendorDisplayName(): string {
        for (const card of cards) {
          if (card.dataset.toolAId === vendor) return card.dataset.toolAName || vendor;
          if (card.dataset.toolBId === vendor) return card.dataset.toolBName || vendor;
        }
        return vendor;
      }

      if (vendor && vendorBanner && vendorNameEl) {
        vendorNameEl.textContent = `${vendorDisplayName().trim()}.`;
        vendorBanner.classList.remove('hidden');
        if (vendorClear) vendorClear.href = window.location.pathname;
      }

      function applyPersona(personaSlug: string, label: string) {
        let visibleCount = 0;
        for (const card of cards) {
          const baseSlug = card.dataset.baseSlug;
          const modifiers = (card.dataset.modifiers ?? '').split(',').filter(Boolean);
          const matches =
            Boolean(baseSlug) && modifiers.includes(personaSlug) && cardMatchesVendor(card);
          if (matches && baseSlug) {
            visibleCount += 1;
            card.href = `/${baseSlug}-for-${personaSlug}/`;
            card.classList.remove('hidden', 'opacity-0');
            const badge = card.querySelector('[data-persona-badge]');
            if (badge) badge.textContent = label;
          } else {
            card.classList.add('hidden', 'opacity-0');
          }
        }
        emptyState?.classList.toggle('hidden', visibleCount > 0);
      }

      function setActiveTab(button: HTMLButtonElement) {
        for (const btn of tabButtons) {
          const isActive = btn === button;
          btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
          btn.classList.remove(...palette.active, ...palette.inactive);
          btn.classList.add(...(isActive ? palette.active : palette.inactive));
        }
      }

      function personaHasVendorMatches(personaSlug: string): boolean {
        return cards.some((card) => {
          const modifiers = (card.dataset.modifiers ?? '').split(',').filter(Boolean);
          return modifiers.includes(personaSlug) && cardMatchesVendor(card);
        });
      }

      if (vendor) {
        const current = tabButtons.find((button) => button.getAttribute('aria-selected') === 'true');
        const fallback =
          (current && personaHasVendorMatches(current.dataset.personaPill ?? '')
            ? current
            : tabButtons.find((button) => personaHasVendorMatches(button.dataset.personaPill ?? ''))) ??
          current ??
          tabButtons[0];
        if (fallback) {
          setActiveTab(fallback);
          applyPersona(fallback.dataset.personaPill ?? '', fallback.dataset.personaLabel ?? '');
        }
      }

      for (const button of tabButtons) {
        button.addEventListener('click', () => {
          const personaSlug = button.dataset.personaPill;
          const label = button.dataset.personaLabel ?? personaSlug ?? '';
          if (!personaSlug) return;

          setActiveTab(button);
          requestAnimationFrame(() => applyPersona(personaSlug, label));
        });
      }
    }
  }

  if (typeof window !== 'undefined' && typeof document !== 'undefined') {
    initComparisonBrowsers();
  }
</script>
