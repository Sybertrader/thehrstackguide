---
import type { Comparison } from '../types/comparison';
import { buildCategoryBrowser } from '../lib/category-browser';

interface Props {
  comparisons: Comparison[];
  theme: 'emerald' | 'indigo' | 'sky';
  idPrefix: string;
  gridTitle: string;
}

const { comparisons, theme, idPrefix, gridTitle } = Astro.props;
const { vendors, pairings, canonicalByPair } = buildCategoryBrowser(comparisons);
const canonicalMapJson = JSON.stringify(canonicalByPair);

const themeClasses = {
  emerald: {
    cardHover: 'hover:border-emerald-300',
    titleHover: 'group-hover:text-emerald-600',
    iconHover: 'group-hover:text-emerald-600',
    button: 'bg-emerald-600 hover:bg-emerald-700 focus:ring-emerald-500',
    vs: 'bg-emerald-600',
    ring: 'focus:border-emerald-500 focus:ring-emerald-500',
  },
  indigo: {
    cardHover: 'hover:border-indigo-300',
    titleHover: 'group-hover:text-indigo-600',
    iconHover: 'group-hover:text-indigo-600',
    button: 'bg-indigo-600 hover:bg-indigo-700 focus:ring-indigo-500',
    vs: 'bg-indigo-600',
    ring: 'focus:border-indigo-500 focus:ring-indigo-500',
  },
  sky: {
    cardHover: 'hover:border-sky-300',
    titleHover: 'group-hover:text-sky-600',
    iconHover: 'group-hover:text-sky-600',
    button: 'bg-sky-600 hover:bg-sky-700 focus:ring-sky-500',
    vs: 'bg-sky-600',
    ring: 'focus:border-sky-500 focus:ring-sky-500',
  },
} as const;

const palette = themeClasses[theme];
const vendorAId = `${idPrefix}-vendor-a`;
const vendorBId = `${idPrefix}-vendor-b`;
---

{
  vendors.length > 1 && pairings.length > 0 && (
    <div class="mb-16" data-matchup-selector data-canonical-map={canonicalMapJson}>
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Build Your Comparison</h2>
        <p class="mt-2 max-w-2xl text-base leading-relaxed text-slate-600">
          Select two vendors below to generate an instant head-to-head analysis.
        </p>

        <form data-matchup-form class="mt-6" novalidate>
          <div class="flex flex-col items-stretch gap-4 sm:flex-row sm:items-end">
            <div class="min-w-0 flex-1">
              <label for={vendorAId} class="mb-1.5 block text-sm font-semibold text-slate-700">
                Vendor A
              </label>
              <select
                id={vendorAId}
                name="vendorA"
                data-vendor-a
                required
                class:list={[
                  'w-full rounded-xl border border-slate-300 bg-white px-3.5 py-3 text-sm font-medium text-slate-900 shadow-sm transition',
                  'focus:outline-none focus:ring-2',
                  palette.ring,
                ]}
              >
                <option value="">Select a platform</option>
                {vendors.map((vendor) => (
                  <option value={vendor.id}>{vendor.name}</option>
                ))}
              </select>
            </div>

            <div class="flex shrink-0 items-center justify-center sm:pb-1">
              <span
                class:list={[
                  'inline-flex h-10 w-10 items-center justify-center rounded-full text-xs font-bold tracking-wider text-white',
                  palette.vs,
                ]}
              >
                VS
              </span>
            </div>

            <div class="min-w-0 flex-1">
              <label for={vendorBId} class="mb-1.5 block text-sm font-semibold text-slate-700">
                Vendor B
              </label>
              <select
                id={vendorBId}
                name="vendorB"
                data-vendor-b
                required
                class:list={[
                  'w-full rounded-xl border border-slate-300 bg-white px-3.5 py-3 text-sm font-medium text-slate-900 shadow-sm transition',
                  'focus:outline-none focus:ring-2',
                  palette.ring,
                ]}
              >
                <option value="">Select a platform</option>
                {vendors.map((vendor) => (
                  <option value={vendor.id}>{vendor.name}</option>
                ))}
              </select>
            </div>

            <button
              type="submit"
              data-compare-cta
              disabled
              class:list={[
                'inline-flex w-full items-center justify-center rounded-xl px-5 py-3 text-sm font-semibold text-white shadow-sm transition sm:w-auto sm:whitespace-nowrap',
                'focus:outline-none focus:ring-2 focus:ring-offset-2',
                'disabled:cursor-not-allowed disabled:bg-slate-300 disabled:shadow-none',
                palette.button,
              ]}
            >
              Compare Now
              <span aria-hidden="true" class="ml-1.5">→</span>
            </button>
          </div>

          <p data-matchup-error class="mt-3 hidden text-sm font-medium text-red-600" role="alert"></p>
        </form>
      </div>

      <div class="mt-10">
        <h3 class="mb-4 text-lg font-bold text-slate-900">{gridTitle}</h3>
        <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {pairings.map((pairing) => (
            <li>
              <a
                href={pairing.href}
                class:list={[
                  'group flex items-center justify-between gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3.5 text-sm shadow-sm transition duration-150 hover:-translate-y-0.5 hover:shadow-md',
                  palette.cardHover,
                ]}
              >
                <span class:list={['font-semibold text-slate-800 transition', palette.titleHover]}>
                  {pairing.toolAName} vs {pairing.toolBName}
                </span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  class:list={['h-4 w-4 shrink-0 text-slate-400 transition', palette.iconHover]}
                  aria-hidden="true"
                >
                  <path
                    fill-rule="evenodd"
                    d="M4.25 5.5a.75.75 0 0 1 .75-.75h8.5a.75.75 0 0 1 .75.75v5.75a.75.75 0 0 1-1.5 0V7.06l-7.47 7.47a.75.75 0 0 1-1.06-1.06L11.94 6H5.5a.75.75 0 0 1-.75-.75Z"
                    clip-rule="evenodd"
                  />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  )
}

<script>
  function canonicalHref(
    map: Record<string, string>,
    vendorA: string,
    vendorB: string,
  ): string | null {
    return map[`${vendorA}|${vendorB}`] ?? map[`${vendorB}|${vendorA}`] ?? `/${vendorA}-vs-${vendorB}/`;
  }

  function syncDisabledOptions(selectA: HTMLSelectElement, selectB: HTMLSelectElement) {
    const a = selectA.value;
    const b = selectB.value;
    for (const option of Array.from(selectA.options)) {
      if (!option.value) continue;
      option.disabled = option.value === b;
    }
    for (const option of Array.from(selectB.options)) {
      if (!option.value) continue;
      option.disabled = option.value === a;
    }
  }

  function initMatchupSelectors() {
    const roots = Array.from(document.querySelectorAll<HTMLElement>('[data-matchup-selector]'));

    for (const root of roots) {
      const form = root.querySelector<HTMLFormElement>('[data-matchup-form]');
      const selectA = root.querySelector<HTMLSelectElement>('[data-vendor-a]');
      const selectB = root.querySelector<HTMLSelectElement>('[data-vendor-b]');
      const cta = root.querySelector<HTMLButtonElement>('[data-compare-cta]');
      const error = root.querySelector<HTMLElement>('[data-matchup-error]');
      if (!form || !selectA || !selectB || !cta) continue;

      let canonicalMap: Record<string, string> = {};
      try {
        canonicalMap = JSON.parse(root.dataset.canonicalMap || '{}') as Record<string, string>;
      } catch {
        canonicalMap = {};
      }

      function updateCta() {
        const ready = Boolean(selectA!.value && selectB!.value && selectA!.value !== selectB!.value);
        cta!.disabled = !ready;
        if (error) {
          error.classList.add('hidden');
          error.textContent = '';
        }
      }

      function onChange() {
        if (selectA!.value && selectA!.value === selectB!.value) {
          selectB!.value = '';
        }
        syncDisabledOptions(selectA!, selectB!);
        updateCta();
      }

      selectA.addEventListener('change', onChange);
      selectB.addEventListener('change', onChange);

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const vendorA = selectA.value;
        const vendorB = selectB.value;
        if (!vendorA || !vendorB || vendorA === vendorB) {
          if (error) {
            error.textContent = 'Select two different platforms to compare.';
            error.classList.remove('hidden');
          }
          return;
        }
        window.location.href = canonicalHref(canonicalMap, vendorA, vendorB);
      });

      syncDisabledOptions(selectA, selectB);
      updateCta();
    }
  }

  if (typeof window !== 'undefined' && typeof document !== 'undefined') {
    initMatchupSelectors();
  }
</script>
