---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src?: string | null;
  alt: string;
  name: string;
  badgeColor: string;
  /** Display size in CSS pixels. Matches the reserved layout box. */
  size?: 36 | 40;
  loading?: 'lazy' | 'eager';
}

const { src = '', alt, name, badgeColor, size = 40, loading = 'lazy' } = Astro.props;

const logos = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/logos/*.{jpeg,jpg,png,gif,webp}',
  { eager: true },
);

function globKeyFromSrc(value: string): string | null {
  const trimmed = value.trim();
  if (!trimmed.startsWith('/') || trimmed.startsWith('//')) return null;
  const file = decodeURIComponent(trimmed.replace(/^\//, '').split(/[?#]/)[0] ?? '');
  if (!file || file.includes('..') || file.includes('/')) return null;
  return `/src/assets/logos/${file}`;
}

const trimmedSrc = src.trim();
const key = trimmedSrc ? globKeyFromSrc(trimmedSrc) : null;
const local = key ? logos[key]?.default : undefined;
const remote = /^https?:\/\//i.test(trimmedSrc) ? trimmedSrc : undefined;
const imageSrc: ImageMetadata | string | undefined = local ?? remote;
const boxClass = size === 36 ? 'h-9 w-9' : 'h-10 w-10';
const letterClass = size === 36 ? 'text-xs' : 'text-sm';
---

<div class:list={['relative inline-flex shrink-0', boxClass]}>
  {
    imageSrc && (
      <Image
        src={imageSrc}
        alt={alt}
        width={size}
        height={size}
        format="webp"
        densities={[1, 2]}
        loading={loading}
        decoding="async"
        class:list={[boxClass, 'rounded-lg bg-slate-100 object-contain aspect-square']}
        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
      />
    )
  }
  <div
    class:list={[
      imageSrc ? 'hidden' : 'flex',
      boxClass,
      letterClass,
      'items-center justify-center rounded-lg font-bold uppercase text-white',
      badgeColor,
    ]}
    aria-hidden="true"
  >
    {name.charAt(0)}
  </div>
</div>
