---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { vendorLogoAsset } from '../lib/vendor-logo';

interface Props {
  src?: string | null;
  alt: string;
  name: string;
  badgeColor: string;
  /** Display size in CSS pixels. Matches the reserved layout box. */
  size?: 36 | 40;
  loading?: 'lazy' | 'eager';
  /** Above-the-fold LCP logos: `fetchpriority="high"` + `loading="eager"`. */
  priority?: boolean;
}

const {
  src = '',
  alt,
  name,
  badgeColor,
  size = 40,
  loading = 'lazy',
  priority = false,
} = Astro.props;

const local = vendorLogoAsset(src);
const remote = /^https?:\/\//i.test(src.trim()) ? src.trim() : undefined;
const imageSrc: ImageMetadata | string | undefined = local ?? remote;
const boxClass = size === 36 ? 'h-9 w-9' : 'h-10 w-10';
const letterClass = size === 36 ? 'text-xs' : 'text-sm';
const isLcp = priority || loading === 'eager';
---

<div class:list={['relative inline-flex shrink-0', boxClass]}>
  {
    imageSrc && (
      <Image
        src={imageSrc}
        alt={alt}
        width={size}
        height={size}
        format="webp"
        densities={[1, 2]}
        loading={isLcp ? 'eager' : loading}
        fetchpriority={isLcp ? 'high' : undefined}
        decoding={isLcp ? 'sync' : 'async'}
        priority={isLcp}
        class:list={[boxClass, 'rounded-lg bg-slate-100 object-contain aspect-square']}
        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
      />
    )
  }
  <div
    class:list={[
      imageSrc ? 'hidden' : 'flex',
      boxClass,
      letterClass,
      'items-center justify-center rounded-lg font-bold uppercase text-white',
      badgeColor,
    ]}
    aria-hidden="true"
  >
    {name.charAt(0)}
  </div>
</div>
