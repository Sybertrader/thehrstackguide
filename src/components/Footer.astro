---
import PreferredSourceButton from './PreferredSourceButton.astro';

const currentMonthYear = new Date().toLocaleDateString('en-US', {
  month: 'long',
  year: 'numeric',
}); // Produces "September 2026"
const currentYear = new Date().getFullYear();

const eorLinks = [
  { href: '/deel-vs-remote-for-tech-startups/', label: 'Deel vs Remote' },
  { href: '/rippling-vs-gusto-for-scaleups/', label: 'Rippling vs Gusto' },
  { href: '/deel-vs-oyster-for-tech-startups/', label: 'Deel vs Oyster HR' },
  { href: '/gusto-vs-multiplier-for-web3-crypto/', label: 'Gusto vs Multiplier' },
  { href: '/remote-vs-papaya-for-us-latam/', label: 'Remote vs Papaya Global' },
];

const atsLinks = [
  { href: '/ashby-vs-greenhouse-for-startups/', label: 'Ashby vs Greenhouse' },
  { href: '/workable-vs-jazzhr-for-startups/', label: 'Workable vs JazzHR' },
  { href: '/greenhouse-vs-lever-for-enterprise/', label: 'Greenhouse vs Lever' },
  { href: '/workable-vs-breezy-hr-for-startups/', label: 'Breezy HR vs Workable' },
  { href: '/ashby-vs-lever-for-startups/', label: 'Ashby vs Lever' },
];

const pmLinks = [
  { href: '/15five-vs-lattice-for-scaleups/', label: '15Five vs Lattice' },
  { href: '/leapsome-vs-culture-amp-for-people-ops/', label: 'Leapsome vs Culture Amp' },
  { href: '/leapsome-vs-lattice-for-enterprise/', label: 'Leapsome vs Lattice' },
  { href: '/15five-vs-performyard-for-startups/', label: '15Five vs PerformYard' },
  { href: '/lattice-vs-culture-amp-for-people-ops/', label: 'Lattice vs Culture Amp' },
];

const legalLinks = [
  { href: '/about/', label: 'About Us' },
  { href: '/privacy-policy/', label: 'Privacy Policy' },
  { href: '/terms/', label: 'Terms of Service' },
  { href: '/affiliate-disclosure/', label: 'Affiliate Disclosure' },
  { href: '/methodology/', label: 'Methodology' },
];
---

<footer class="shrink-0 overflow-visible border-t border-slate-200 bg-white">
  <div class="mx-auto max-w-6xl overflow-visible px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-10 overflow-visible sm:grid-cols-2 lg:grid-cols-[minmax(17.5rem,1.35fr)_repeat(4,minmax(0,1fr))]">
      <!-- Col 1: Brand & Trust -->
      <div class="h-auto overflow-visible pb-3">
        <a href="/" class="flex items-center gap-2.5">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-indigo-600 text-sm font-bold text-white">
            SG
          </span>
          <span class="text-lg font-bold tracking-tight text-slate-900">The HR Stack Guide</span>
        </a>
        <p class="mt-3 text-sm leading-relaxed text-slate-500">
          Independent B2B HR Tech Analysis
        </p>
        <span class="mt-4 inline-flex w-fit items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5" aria-hidden="true">
            <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
          </svg>
          Verified B2B Software Operations Analysts ({currentMonthYear} Edition)
        </span>
        <PreferredSourceButton theme="light" align="left" />
      </div>

      <!-- Col 2: Global Payroll & EOR -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-900">
          <a href="/global-payroll-eor/" class="transition hover:text-indigo-600">Global Payroll &amp; EOR</a>
        </h3>
        <ul class="mt-4 space-y-2.5">
          {eorLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-slate-500 transition hover:text-indigo-600">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Applicant Tracking Systems -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-900">
          <a href="/applicant-tracking-systems/" class="transition hover:text-indigo-600">Applicant Tracking Systems</a>
        </h3>
        <ul class="mt-4 space-y-2.5">
          {atsLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-slate-500 transition hover:text-indigo-600">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Performance Management -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-900">
          <a href="/performance-management/" class="transition hover:text-indigo-600">Performance Management</a>
        </h3>
        <ul class="mt-4 space-y-2.5">
          {pmLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-slate-500 transition hover:text-indigo-600">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 5: Legal & Methodology -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-900">Legal &amp; Methodology</h3>
        <ul class="mt-4 space-y-2.5">
          {legalLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-slate-500 transition hover:text-indigo-600">{link.label}</a>
            </li>
          ))}
        </ul>
        <p class="mt-6 text-xs text-slate-400">
          &copy; {currentYear} The HR Stack Guide Media. All rights reserved.
        </p>
      </div>
    </div>

    <div class="mt-10 border-t border-slate-100 pt-6">
      <p class="max-w-3xl text-xs leading-relaxed text-slate-500">
        <span class="font-semibold text-slate-600">Disclosure:</span> The HR Stack Guide is an independent evaluation hub. We may earn a commission if you sign up through our links at no extra cost to you.
      </p>
    </div>
  </div>
</footer>
