---
/**
 * Interactive EOR + contractor platform-fee estimator for payroll comparisons.
 */
import VendorButton from './VendorButton.astro';
import {
  annualPlatformCost,
  monthlyFixedPlatformFees,
  resolveEorPlatformRates,
  vendorPublishesContractorRate,
  vendorPublishesEorRate,
  type EorCalculatorVendor,
  type EorPlatformRates,
} from '../data/vendors/eor-platform-rates';
import { CUSTOM_QUOTE_LABEL, CUSTOM_QUOTE_SUBTEXT } from '../lib/tco-projection';

export interface CostCalculatorVendor {
  id: string;
  name: string;
  eorMonthlyRate?: number;
  eorAnnualRate?: number;
  contractorMonthlyRate?: number;
  contractorAnnualRate?: number;
  affiliateUrl: string;
}

interface Props {
  vendorA: CostCalculatorVendor;
  vendorB: CostCalculatorVendor;
  toolAIsManualLead?: boolean;
  toolBIsManualLead?: boolean;
  toolAModalId?: string;
  toolBModalId?: string;
  toolAIsWinner?: boolean;
  toolBIsWinner?: boolean;
  /** Hub page: vendor dropdowns and client-side pair switching. */
  selectable?: boolean;
  vendors?: EorCalculatorVendor[];
  showIntro?: boolean;
  instanceId?: string;
}

const {
  vendorA,
  vendorB,
  toolAIsManualLead = false,
  toolBIsManualLead = false,
  toolAModalId = '',
  toolBModalId = '',
  toolAIsWinner = false,
  toolBIsWinner = false,
  selectable = false,
  vendors = [],
  showIntro = true,
  instanceId = 'cost-calc',
} = Astro.props;

const DEFAULT_EOR = 5;
const DEFAULT_CONTRACTORS = 10;
const MAX_EOR = 250;
const MAX_CONTRACTORS = 500;
const DEFAULT_CYCLE = 'annual' as const;

function ratesFor(vendor: CostCalculatorVendor): EorPlatformRates {
  return resolveEorPlatformRates(vendor.id, {
    eorMonthlyRate: vendor.eorMonthlyRate,
    eorAnnualRate: vendor.eorAnnualRate,
    contractorMonthlyRate: vendor.contractorMonthlyRate,
    contractorAnnualRate: vendor.contractorAnnualRate,
  });
}

const aRates = ratesFor(vendorA);
const bRates = ratesFor(vendorB);

function cycleRates(rates: EorPlatformRates, cycle: 'annual' | 'monthly') {
  return cycle === 'annual'
    ? { eor: rates.eorAnnualRate, contractor: rates.contractorAnnualRate }
    : { eor: rates.eorMonthlyRate, contractor: rates.contractorMonthlyRate };
}

const initialA = cycleRates(aRates, DEFAULT_CYCLE);
const initialB = cycleRates(bRates, DEFAULT_CYCLE);
const aEorPublished = vendorPublishesEorRate(vendorA.id);
const bEorPublished = vendorPublishesEorRate(vendorB.id);
const aContractorPublished = vendorPublishesContractorRate(vendorA.id);
const bContractorPublished = vendorPublishesContractorRate(vendorB.id);
const quoteRequired = (eorPublished: boolean, contractorPublished: boolean) =>
  (DEFAULT_EOR > 0 && !eorPublished) || (DEFAULT_CONTRACTORS > 0 && !contractorPublished);
const aQuote = quoteRequired(aEorPublished, aContractorPublished);
const bQuote = quoteRequired(bEorPublished, bContractorPublished);
function annualWithFixed(countEor: number, countContractors: number, rates: EorPlatformRates, seat: { eor: number; contractor: number }) {
  return annualPlatformCost(countEor, countContractors, seat.eor, seat.contractor) + monthlyFixedPlatformFees(countEor, countContractors, rates) * 12;
}
const initialAAnnual = aQuote ? null : annualWithFixed(DEFAULT_EOR, DEFAULT_CONTRACTORS, aRates, initialA);
const initialBAnnual = bQuote ? null : annualWithFixed(DEFAULT_EOR, DEFAULT_CONTRACTORS, bRates, initialB);
const initialAFixed = monthlyFixedPlatformFees(DEFAULT_EOR, DEFAULT_CONTRACTORS, aRates);
const initialBFixed = monthlyFixedPlatformFees(DEFAULT_EOR, DEFAULT_CONTRACTORS, bRates);
const initialDelta =
  initialAAnnual != null && initialBAnnual != null ? Math.abs(initialAAnnual - initialBAnnual) : 0;
const initialAWins = initialAAnnual != null && initialBAnnual != null && initialAAnnual < initialBAnnual;
const initialBWins = initialAAnnual != null && initialBAnnual != null && initialBAnnual < initialAAnnual;
const initialWinnerName = initialAWins ? vendorA.name : initialBWins ? vendorB.name : '';

function money(value: number): string {
  return new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
    maximumFractionDigits: 0,
  }).format(value);
}

const catalogJson = selectable ? JSON.stringify(vendors) : '';
const eorSliderId = `${instanceId}-eor`;
const eorCountId = `${instanceId}-eor-count`;
const contractorSliderId = `${instanceId}-contractors`;
const contractorCountId = `${instanceId}-contractors-count`;
const vendorASelectId = `${instanceId}-vendor-a`;
const vendorBSelectId = `${instanceId}-vendor-b`;

const ctaClass = (isWinner: boolean) =>
  isWinner
    ? 'inline-flex w-full items-center justify-center rounded-xl bg-indigo-600 px-6 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2'
    : 'inline-flex w-full items-center justify-center rounded-xl border-2 border-indigo-600 bg-white px-6 py-3.5 text-sm font-semibold text-indigo-700 shadow-sm transition hover:bg-indigo-50 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2';
---

<section
  class="mb-12 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8"
  aria-label={`Interactive EOR and global hiring cost calculator for ${vendorA.name} vs ${vendorB.name}`}
  data-cost-calculator
  data-selectable={selectable ? 'true' : undefined}
  data-a-id={vendorA.id}
  data-b-id={vendorB.id}
  data-a-name={vendorA.name}
  data-b-name={vendorB.name}
  data-a-eor-monthly={aRates.eorMonthlyRate}
  data-a-eor-annual={aRates.eorAnnualRate}
  data-a-contractor-monthly={aRates.contractorMonthlyRate}
  data-a-contractor-annual={aRates.contractorAnnualRate}
  data-b-eor-monthly={bRates.eorMonthlyRate}
  data-b-eor-annual={bRates.eorAnnualRate}
  data-b-contractor-monthly={bRates.contractorMonthlyRate}
  data-b-contractor-annual={bRates.contractorAnnualRate}
  data-a-eor-published={aEorPublished ? 'true' : 'false'}
  data-a-contractor-published={aContractorPublished ? 'true' : 'false'}
  data-b-eor-published={bEorPublished ? 'true' : 'false'}
  data-b-contractor-published={bContractorPublished ? 'true' : 'false'}
  data-quote-label={CUSTOM_QUOTE_LABEL}
  data-quote-subtext={CUSTOM_QUOTE_SUBTEXT}
>
  {selectable && catalogJson && (
    <script type="application/json" data-cost-calculator-catalog set:html={catalogJson} />
  )}
  {showIntro && (
  <header class="mb-6">
    <h2 class="text-2xl font-bold text-slate-900">Interactive EOR &amp; Global Hiring Cost Calculator</h2>
    <p class="mt-2 max-w-3xl text-base leading-relaxed text-slate-600" data-pair-copy>
      Estimate your total annual software &amp; platform fees for {vendorA.name} vs {vendorB.name} based on your exact team roadmap.
    </p>
  </header>
  )}

  <div class="grid gap-5 rounded-xl border border-slate-100 bg-slate-50/80 p-4 sm:p-5">
    {selectable && vendors.length > 0 && (
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for={vendorASelectId} class="mb-2 block text-sm font-semibold text-slate-800">Vendor A</label>
          <select
            id={vendorASelectId}
            data-vendor-select="a"
            class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-800 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          >
            {vendors.map((vendor) => (
              <option value={vendor.id} selected={vendor.id === vendorA.id ? true : undefined}>
                {vendor.name}
              </option>
            ))}
          </select>
        </div>
        <div>
          <label for={vendorBSelectId} class="mb-2 block text-sm font-semibold text-slate-800">Vendor B</label>
          <select
            id={vendorBSelectId}
            data-vendor-select="b"
            class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-medium text-slate-800 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          >
            {vendors.map((vendor) => (
              <option value={vendor.id} selected={vendor.id === vendorB.id ? true : undefined}>
                {vendor.name}
              </option>
            ))}
          </select>
        </div>
      </div>
    )}
    <div>
      <div class="mb-2 flex items-center justify-between gap-3">
        <label for={eorCountId} class="text-sm font-semibold text-slate-800">Full-Time EOR Employees</label>
        <input
          id={eorCountId}
          type="number"
          inputmode="numeric"
          min="0"
          max={MAX_EOR}
          step="1"
          value={DEFAULT_EOR}
          data-eor-count
          aria-label="Full-time EOR employee headcount"
          class="w-20 rounded-full border border-indigo-200 bg-indigo-50 px-2 py-0.5 text-center text-sm font-bold tabular-nums text-indigo-700 outline-none [appearance:textfield] focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
        />
      </div>
      <input
        id={eorSliderId}
        type="range"
        min="0"
        max={MAX_EOR}
        step="1"
        value={DEFAULT_EOR}
        data-eor-slider
        aria-controls={eorCountId}
        class="h-2 w-full cursor-pointer appearance-none rounded-full bg-slate-200 accent-indigo-600"
      />
      <div class="mt-1 flex justify-between text-[11px] text-slate-400">
        <span>0</span>
        <span>{MAX_EOR}</span>
      </div>
    </div>

    <div>
      <div class="mb-2 flex items-center justify-between gap-3">
        <label for={contractorCountId} class="text-sm font-semibold text-slate-800">Global Contractors</label>
        <input
          id={contractorCountId}
          type="number"
          inputmode="numeric"
          min="0"
          max={MAX_CONTRACTORS}
          step="1"
          value={DEFAULT_CONTRACTORS}
          data-contractor-count
          aria-label="Global contractor headcount"
          class="w-20 rounded-full border border-indigo-200 bg-indigo-50 px-2 py-0.5 text-center text-sm font-bold tabular-nums text-indigo-700 outline-none [appearance:textfield] focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
        />
      </div>
      <input
        id={contractorSliderId}
        type="range"
        min="0"
        max={MAX_CONTRACTORS}
        step="1"
        value={DEFAULT_CONTRACTORS}
        data-contractor-slider
        aria-controls={contractorCountId}
        class="h-2 w-full cursor-pointer appearance-none rounded-full bg-slate-200 accent-indigo-600"
      />
      <div class="mt-1 flex justify-between text-[11px] text-slate-400">
        <span>0</span>
        <span>{MAX_CONTRACTORS}</span>
      </div>
    </div>

    <div>
      <p class="mb-2 text-sm font-semibold text-slate-800" id={`${instanceId}-billing-label`}>Billing Cycle</p>
      <div class="inline-flex flex-wrap items-center gap-2 rounded-full border border-slate-200 bg-white p-1" role="group" aria-labelledby={`${instanceId}-billing-label`}>
        <button
          type="button"
          data-billing="monthly"
          aria-pressed="false"
          class="rounded-full px-3.5 py-1.5 text-sm font-semibold text-slate-600 hover:bg-slate-50 aria-pressed:bg-indigo-600 aria-pressed:text-white aria-pressed:shadow-sm aria-pressed:hover:bg-indigo-600"
        >
          Monthly Billing
        </button>
        <button
          type="button"
          data-billing="annual"
          aria-pressed="true"
          class="inline-flex items-center gap-2 rounded-full px-3.5 py-1.5 text-sm font-semibold text-slate-600 aria-pressed:bg-indigo-600 aria-pressed:text-white aria-pressed:shadow-sm"
        >
          Annual commitment
        </button>
      </div>
    </div>
  </div>

  <p class:list={['mt-6 text-center', initialDelta === 0 && 'hidden']} data-savings-badge>
    <span class="inline-flex max-w-full items-center rounded-full bg-emerald-600 px-3 py-1.5 text-sm font-semibold text-white shadow-sm">
      🏆 <span data-savings-text>{initialWinnerName} saves you {money(initialDelta)}/yr for this team size</span>
    </span>
  </p>

  <div class="mt-6 grid gap-4 lg:grid-cols-2" aria-live="polite">
    <article
      class:list={[
        'rounded-2xl border bg-white p-5 shadow-sm',
        initialAWins ? 'border-emerald-300 ring-2 ring-emerald-100' : 'border-slate-200',
      ]}
      data-vendor-card="a"
    >
      <h3 class="flex items-center gap-2.5 text-lg font-bold text-slate-900" data-vendor-heading>
        <img data-vendor-logo src={vendors.find((vendor) => vendor.id === vendorA.id)?.logo || ''} alt={`${vendorA.name} logo`} width="28" height="28" class:list={['h-7 w-7 rounded-md bg-slate-100 object-contain', !vendors.find((vendor) => vendor.id === vendorA.id)?.logo && 'hidden']} />
        <span data-vendor-name>{vendorA.name}</span>
      </h3>
      <p class="mt-3 text-3xl font-bold tracking-tight text-slate-900">
        <span data-annual-total>{aQuote ? CUSTOM_QUOTE_LABEL : money(initialAAnnual ?? 0)}</span>
        <span data-annual-suffix class:list={['text-lg font-semibold text-slate-500', aQuote && 'hidden']}>/yr</span>
      </p>
      <p class:list={['mt-1 text-sm font-medium text-slate-500', aQuote && 'hidden']} data-monthly-wrap>
        <span data-monthly-total>{money((initialAAnnual ?? 0) / 12)}</span>/mo
      </p>
      <p class:list={['mt-2 text-sm leading-relaxed text-slate-600', !aQuote && 'hidden']} data-quote-note>
        {CUSTOM_QUOTE_SUBTEXT}
      </p>
      <ul class:list={['mt-4 space-y-1.5 text-sm text-slate-600', aQuote && 'hidden']} data-rate-lines>
        <li data-eor-line>EOR Fees ({DEFAULT_EOR} × {money(initialA.eor)}/mo)</li>
        <li data-contractor-line>Contractor Fees ({DEFAULT_CONTRACTORS} × {money(initialA.contractor)}/mo)</li>
        <li data-fixed-line class:list={[initialAFixed <= 0 && 'hidden']}>Base fees ({money(initialAFixed)}/mo)</li>
        <li data-deposit-line class:list={[(aRates.depositMonths ?? 0) <= 0 && 'hidden']}>Upfront deposit: {aRates.depositMonths ?? 0} month of gross salary per EOR employee</li>
        <li data-fx-line class:list={[(aRates.fxMarkupPercent ?? 0) <= 0 && 'hidden']}>FX markup about {aRates.fxMarkupPercent ?? 0}% of cross-border payroll</li>
      </ul>
    </article>
    <article
      class:list={[
        'rounded-2xl border bg-white p-5 shadow-sm',
        initialBWins ? 'border-emerald-300 ring-2 ring-emerald-100' : 'border-slate-200',
      ]}
      data-vendor-card="b"
    >
      <h3 class="flex items-center gap-2.5 text-lg font-bold text-slate-900" data-vendor-heading>
        <img data-vendor-logo src={vendors.find((vendor) => vendor.id === vendorB.id)?.logo || ''} alt={`${vendorB.name} logo`} width="28" height="28" class:list={['h-7 w-7 rounded-md bg-slate-100 object-contain', !vendors.find((vendor) => vendor.id === vendorB.id)?.logo && 'hidden']} />
        <span data-vendor-name>{vendorB.name}</span>
      </h3>
      <p class="mt-3 text-3xl font-bold tracking-tight text-slate-900">
        <span data-annual-total>{bQuote ? CUSTOM_QUOTE_LABEL : money(initialBAnnual ?? 0)}</span>
        <span data-annual-suffix class:list={['text-lg font-semibold text-slate-500', bQuote && 'hidden']}>/yr</span>
      </p>
      <p class:list={['mt-1 text-sm font-medium text-slate-500', bQuote && 'hidden']} data-monthly-wrap>
        <span data-monthly-total>{money((initialBAnnual ?? 0) / 12)}</span>/mo
      </p>
      <p class:list={['mt-2 text-sm leading-relaxed text-slate-600', !bQuote && 'hidden']} data-quote-note>
        {CUSTOM_QUOTE_SUBTEXT}
      </p>
      <ul class:list={['mt-4 space-y-1.5 text-sm text-slate-600', bQuote && 'hidden']} data-rate-lines>
        <li data-eor-line>EOR Fees ({DEFAULT_EOR} × {money(initialB.eor)}/mo)</li>
        <li data-contractor-line>Contractor Fees ({DEFAULT_CONTRACTORS} × {money(initialB.contractor)}/mo)</li>
        <li data-fixed-line class:list={[initialBFixed <= 0 && 'hidden']}>Base fees ({money(initialBFixed)}/mo)</li>
        <li data-deposit-line class:list={[(bRates.depositMonths ?? 0) <= 0 && 'hidden']}>Upfront deposit: {bRates.depositMonths ?? 0} month of gross salary per EOR employee</li>
        <li data-fx-line class:list={[(bRates.fxMarkupPercent ?? 0) <= 0 && 'hidden']}>FX markup about {bRates.fxMarkupPercent ?? 0}% of cross-border payroll</li>
      </ul>
    </article>
  </div>

  <p class="mt-4 hidden text-center" data-enterprise-callout>
    <span class="inline-flex max-w-3xl items-center justify-center rounded-xl border border-amber-200 bg-amber-50 px-3.5 py-2.5 text-sm font-medium leading-relaxed text-amber-950">
      💼 Teams with 50+ EOR employees qualify for custom volume rates. Book a demo to lock in negotiated enterprise quotes.
    </span>
  </p>

  <p class="mt-6 text-sm leading-relaxed text-slate-600 italic">
    ℹ️ Baseline Estimate Note: Calculations reflect latest standard published platform rates. Final binding quotes, enterprise volume discounts, and local statutory employment costs depend on your team's specific country mix. Click below to request custom pricing directly on your vendor demo call.
  </p>

  <div class="mt-6 flex flex-col items-center text-center">
    <div class="mt-0 grid w-full gap-4 sm:grid-cols-2">
      <div data-calc-cta="a">
      <VendorButton
        href={vendorA.affiliateUrl}
        modalId={toolAIsManualLead ? toolAModalId : undefined}
        vendorId={vendorA.id}
        vendorName={vendorA.name}
        location="cost_calculator"
        leadMagnet
        leadMagnetBadge={false}
        class={ctaClass(toolAIsWinner || !toolBIsWinner)}
      >
        Book {vendorA.name} Demo to Lock in Custom Quote →
      </VendorButton>
      </div>
      <div data-calc-cta="b">
      <VendorButton
        href={vendorB.affiliateUrl}
        modalId={toolBIsManualLead ? toolBModalId : undefined}
        vendorId={vendorB.id}
        vendorName={vendorB.name}
        location="cost_calculator"
        leadMagnet
        leadMagnetBadge={false}
        class={ctaClass(toolBIsWinner)}
      >
        Book {vendorB.name} Demo to Lock in Custom Quote →
      </VendorButton>
      </div>
    </div>
  </div>
</section>

<script>
  import { initCostCalculators } from '../scripts/cost-calculator';

  initCostCalculators();
</script>
