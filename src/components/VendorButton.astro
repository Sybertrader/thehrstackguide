---
import { outboundRel, vendorLeadModalOnclick, vendorOutboundOnclick } from '../lib/outbound';

interface Props {
  vendorName: string;
  /** Stable tool id used as GA4 `vendor_id` (e.g. `lever`, `culture-amp`). */
  vendorId?: string;
  location?: string;
  class?: string;
  /** Outbound affiliate / UTM href. Ignored when `modalId` is set. */
  href?: string;
  /** When set, the CTA opens the lead-capture modal instead of leaving the site. */
  modalId?: string;
}

const { href = '', vendorName, vendorId = '', location = 'body_link', class: className = '', modalId = '' } = Astro.props;
const opensModal = Boolean(modalId);
const resolvedVendorId = vendorId || vendorName.toLowerCase().replace(/\s+/g, '-');
const linkRel = outboundRel(href);
const isOutbound = Boolean(linkRel);
---

{
  opensModal ? (
    <button
      type="button"
      data-modal-target={modalId}
      class:list={['open-modal-btn', className]}
      data-vendor-id={resolvedVendorId}
      data-track-vendor={vendorName}
      data-track-location={location}
      onclick={vendorLeadModalOnclick(resolvedVendorId)}
    >
      <slot>Try {vendorName}</slot>
    </button>
  ) : (
    <a
      href={href}
      target={isOutbound ? '_blank' : undefined}
      rel={linkRel}
      class:list={['js-affiliate-cta', className]}
      data-vendor-id={resolvedVendorId}
      data-track-vendor={vendorName}
      data-track-location={location}
      data-vendor-outbound
      onclick={vendorOutboundOnclick(resolvedVendorId)}
    >
      <slot>Try {vendorName}</slot>
    </a>
  )
}
