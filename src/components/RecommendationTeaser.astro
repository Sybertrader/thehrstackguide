---
interface Props {
  ctaHref?: string;
  class?: string;
}

const { ctaHref = '/recommendation/', class: className = '' } = Astro.props;
---

<section class:list={['mt-16', className]} aria-label="Get our recommendation">
  <div class="relative overflow-hidden rounded-2xl border border-indigo-200 bg-indigo-50/70 p-6 shadow-sm sm:p-8">
    <div class="absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r from-indigo-500 to-violet-600" aria-hidden="true"></div>
    <span class="inline-flex items-center rounded-full bg-indigo-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-indigo-700">
      Free Guidance
    </span>
    <h2 class="mt-4 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
      Unsure which HR software fits your team?
    </h2>
    <p class="mt-3 max-w-2xl text-base leading-relaxed text-slate-600">
      Skip hours of demo calls. Answer 3 quick questions and get our unbiased recommendation based on your headcount and budget.
    </p>
    <a
      href={ctaHref}
      class="mt-6 inline-flex items-center justify-center rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
    >
      Get Our Recommendation ↗
    </a>
  </div>
</section>
