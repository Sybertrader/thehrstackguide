---
import type { ComparisonVariantLink } from '../lib/persona-evaluation';

interface Props {
  variants: ComparisonVariantLink[];
}

const { variants } = Astro.props;

const visibleVariants = variants.filter(
  (variant) =>
    !variant.slug.endsWith('-for-tech-startups') &&
    variant.titleSuffix !== 'Tech Startups' &&
    variant.nicheId !== 'tech-startups'
);
---

{visibleVariants.length > 0 && (
  <section class="mb-12" aria-label="Specialized use-case evaluations">
    <h2 class="mb-2 text-xl font-bold text-slate-900">Specialized Use-Case Evaluations</h2>
    <p class="mb-5 max-w-3xl text-sm text-slate-500">
      Jump to the modifier page that matches your workflow. Each child URL has its own capability matrix, evaluation, and schema.
    </p>
    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {visibleVariants.map((variant) => (
        <li>
          <a
            href={variant.href}
            class="flex h-full flex-col rounded-xl border border-indigo-100 bg-indigo-50/40 px-4 py-3 transition hover:border-indigo-300 hover:bg-indigo-50"
          >
            <span class="text-sm font-semibold text-indigo-800">
              {variant.titleSuffix === 'Remote-First Teams' ? 'Remote Teams' : variant.titleSuffix}
            </span>
            {variant.nicheName !== variant.titleSuffix &&
              variant.nicheName !== 'Tech Startups' &&
              variant.nicheName !== 'Remote-First Teams' && (
              <span class="mt-1 text-xs text-slate-500">{variant.nicheName}</span>
            )}
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
