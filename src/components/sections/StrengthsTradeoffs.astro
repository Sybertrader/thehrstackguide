---
import VendorLogo from '../VendorLogo.astro';

interface VendorCard {
  name: string;
  logo?: string | null;
  badgeColor: string;
  bestFor: string;
  strengths: string[];
  tradeoffs: string[];
}

interface Props {
  vendorA: VendorCard;
  vendorB: VendorCard;
}

const { vendorA, vendorB } = Astro.props;
const cards = [vendorA, vendorB];
---

<section class="mb-12" aria-label="Platform strengths and trade-offs">
  <h2 class="mb-6 text-2xl font-bold text-slate-900">Platform Strengths &amp; Trade-offs</h2>
  <div class="grid gap-6 lg:grid-cols-2">
    {
      cards.map((vendor) => (
        <article class="rounded-xl border border-slate-200 bg-white p-6">
          <header class="flex items-center gap-3">
            <VendorLogo src={vendor.logo} alt={`${vendor.name} logo`} name={vendor.name} badgeColor={vendor.badgeColor} size={36} />
            <div class="min-w-0">
              <h3 class="text-lg font-semibold text-slate-900">{vendor.name}</h3>
              {
                vendor.bestFor && (
                  <p class="mt-0.5 text-sm text-slate-500">
                    Best for: {vendor.bestFor}
                  </p>
                )
              }
            </div>
          </header>

          {
            vendor.strengths.length > 0 && (
              <div class="mt-5">
                <h4 class="inline-flex rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-emerald-800">
                  Strengths
                </h4>
                <ul class="mt-3 space-y-3">
                  {vendor.strengths.map((item) => (
                    <li class="flex items-start gap-2.5 text-sm leading-relaxed text-slate-700">
                      <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-3 w-3" aria-hidden="true">
                          <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                        </svg>
                      </span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          {
            vendor.tradeoffs.length > 0 && (
              <div class="mt-5">
                <h4 class="inline-flex rounded-full bg-amber-50 px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-amber-900">
                  Trade-offs
                </h4>
                <ul class="mt-3 space-y-3">
                  {vendor.tradeoffs.map((item) => (
                    <li class="flex items-start gap-2.5 text-sm leading-relaxed text-slate-700">
                      <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-amber-100 text-amber-700">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-3 w-3" aria-hidden="true">
                          <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495ZM10 6a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 10 6Zm0 8a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" />
                        </svg>
                      </span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </article>
      ))
    }
  </div>
</section>
