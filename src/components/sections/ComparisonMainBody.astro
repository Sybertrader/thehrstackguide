---
/**
 * Core comparison sections: scoring cards, verdict, feature grid, pricing,
 * and platform strengths and trade-offs. TCO charts and synthetic editorial are not rendered.
 */
import AtAGlance from '../AtAGlance.astro';
import PricingNuance from '../PricingNuance.astro';
import VerdictCallout from '../VerdictCallout.astro';
import SegmentTabEngine from '../SegmentTabEngine.astro';
import PreferredSourceButton from '../PreferredSourceButton.astro';
import DemoQuestions from '../DemoQuestions.astro';
import CostCalculator from '../CostCalculator.astro';
import FeatureParityGrid from './FeatureParityGrid.astro';
import StrengthsTradeoffs from './StrengthsTradeoffs.astro';
import type { Comparison, FeatureMatrixEntry } from '../../lib/comparisons';
import type { VendorContrast } from '../../lib/vendor-contrast';
import type { CategoryHubFamily } from '../../lib/comparison-routes';
import type { MasterSegmentPanel } from '../../lib/persona-evaluation';
import type { MatchupVerdict } from '../../lib/matchup-verdict';

interface RatingDisplay {
  rating: string;
  reviewCountLabel: string | null;
  ratingSource: string | null;
}

interface Props {
  comparison: Comparison;
  mainSectionOrder: string[];
  isHub: boolean;
  hubFamily: CategoryHubFamily | null;
  toolAFeatures: string[];
  toolBFeatures: string[];
  toolANarrative: RatingDisplay;
  toolBNarrative: RatingDisplay;
  toolAIsWinner: boolean;
  toolBIsWinner: boolean;
  winnerBadgeText: string;
  toolABadgeColor: string;
  toolBBadgeColor: string;
  toolAIsManualLead: boolean;
  toolBIsManualLead: boolean;
  toolAModalId: string;
  toolBModalId: string;
  toolAAffiliateHref: string;
  toolBAffiliateHref: string;
  vendorAContrast: VendorContrast;
  vendorBContrast: VendorContrast;
  toolAContrastNuance: string;
  toolBContrastNuance: string;
  showFeatureTable: boolean;
  featureMatrixRows: [string, FeatureMatrixEntry][];
  toolAIntegrations: string[];
  toolBIntegrations: string[];
  segmentPanels: MasterSegmentPanel[];
  matchupVerdict: MatchupVerdict | null;
}

const {
  comparison,
  mainSectionOrder,
  isHub,
  hubFamily,
  toolAFeatures,
  toolBFeatures,
  toolANarrative,
  toolBNarrative,
  toolAIsWinner,
  toolBIsWinner,
  winnerBadgeText,
  toolABadgeColor,
  toolBBadgeColor,
  toolAIsManualLead,
  toolBIsManualLead,
  toolAModalId,
  toolBModalId,
  toolAAffiliateHref,
  toolBAffiliateHref,
  vendorAContrast,
  vendorBContrast,
  toolAContrastNuance,
  toolBContrastNuance,
  showFeatureTable,
  featureMatrixRows,
  toolAIntegrations,
  toolBIntegrations,
  segmentPanels,
  matchupVerdict,
} = Astro.props;
---

{mainSectionOrder.map((sectionId) => (
  <>
    {sectionId === 'glance' && (
      <AtAGlance
        comparison={comparison}
        toolAFeatures={toolAFeatures}
        toolBFeatures={toolBFeatures}
        toolANarrative={toolANarrative}
        toolBNarrative={toolBNarrative}
        toolAIsWinner={toolAIsWinner}
        toolBIsWinner={toolBIsWinner}
        winnerBadgeText={winnerBadgeText}
        toolABadgeColor={toolABadgeColor}
        toolBBadgeColor={toolBBadgeColor}
        toolAIsManualLead={toolAIsManualLead}
        toolBIsManualLead={toolBIsManualLead}
        toolAModalId={toolAModalId}
        toolBModalId={toolBModalId}
        toolAAffiliateHref={toolAAffiliateHref}
        toolBAffiliateHref={toolBAffiliateHref}
        toolAContrastBullets={toolAFeatures.slice(0, 2)}
        toolBContrastBullets={toolBFeatures.slice(0, 2)}
      />
    )}

    {sectionId === 'pricing' && isHub && (
      <PricingNuance
        toolAName={comparison.tool_a_name}
        toolBName={comparison.tool_b_name}
        toolAId={comparison.tool_a_id}
        toolBId={comparison.tool_b_id}
        toolALogo={comparison.tool_a_logo_url}
        toolBLogo={comparison.tool_b_logo_url}
        toolABadgeColor={toolABadgeColor}
        toolBBadgeColor={toolBBadgeColor}
        toolANuance={toolAContrastNuance}
        toolBNuance={toolBContrastNuance}
        toolAAffiliateHref={toolAAffiliateHref}
        toolBAffiliateHref={toolBAffiliateHref}
        toolAIsManualLead={toolAIsManualLead}
        toolBIsManualLead={toolBIsManualLead}
        toolAModalId={toolAModalId}
        toolBModalId={toolBModalId}
      />
    )}

    {sectionId === 'calculator' && hubFamily === 'payroll' && (
      <CostCalculator
        vendorA={{
          id: comparison.tool_a_id,
          name: comparison.tool_a_name,
          affiliateUrl: toolAAffiliateHref,
        }}
        vendorB={{
          id: comparison.tool_b_id,
          name: comparison.tool_b_name,
          affiliateUrl: toolBAffiliateHref,
        }}
        toolAIsManualLead={toolAIsManualLead}
        toolBIsManualLead={toolBIsManualLead}
        toolAModalId={toolAModalId}
        toolBModalId={toolBModalId}
        toolAIsWinner={toolAIsWinner}
        toolBIsWinner={toolBIsWinner}
      />
    )}

    {sectionId === 'verdict' && isHub && matchupVerdict && (
      <VerdictCallout
        vendorAName={comparison.tool_a_name}
        vendorBName={comparison.tool_b_name}
        pickA={matchupVerdict.pickA}
        pickB={matchupVerdict.pickB}
        tradeoff={matchupVerdict.tradeoff}
      />
    )}

    {sectionId === 'tabs' && isHub && (
      <SegmentTabEngine
        panels={segmentPanels}
        toolAName={comparison.tool_a_name}
        toolBName={comparison.tool_b_name}
      />
    )}

    {sectionId === 'preferred' && isHub && (
      <aside class="mb-12" aria-label="Add as a Google preferred source">
        <p class="text-sm font-medium text-slate-700">Save this comparison in Google Preferred Sources.</p>
        <PreferredSourceButton theme="light" align="left" />
      </aside>
    )}

    {sectionId === 'features' && showFeatureTable && (
      <FeatureParityGrid
        toolAName={comparison.tool_a_name}
        toolBName={comparison.tool_b_name}
        toolAId={comparison.tool_a_id}
        toolBId={comparison.tool_b_id}
        toolALogo={comparison.tool_a_logo_url}
        toolBLogo={comparison.tool_b_logo_url}
        toolABadgeColor={toolABadgeColor}
        toolBBadgeColor={toolBBadgeColor}
        toolAAffiliateHref={toolAAffiliateHref}
        toolBAffiliateHref={toolBAffiliateHref}
        toolAIsManualLead={toolAIsManualLead}
        toolBIsManualLead={toolBIsManualLead}
        toolAModalId={toolAModalId}
        toolBModalId={toolBModalId}
        toolAIsWinner={toolAIsWinner}
        toolBIsWinner={toolBIsWinner}
        featureMatrixRows={featureMatrixRows}
        toolAIntegrations={toolAIntegrations}
        toolBIntegrations={toolBIntegrations}
      />
    )}

    {sectionId === 'pros' && isHub && (
      <StrengthsTradeoffs
        vendorA={{
          name: comparison.tool_a_name,
          logo: comparison.tool_a_logo_url,
          badgeColor: toolABadgeColor,
          bestFor: vendorAContrast.bestFor,
          strengths: vendorAContrast.strengths,
          tradeoffs: vendorAContrast.tradeoffs,
        }}
        vendorB={{
          name: comparison.tool_b_name,
          logo: comparison.tool_b_logo_url,
          badgeColor: toolBBadgeColor,
          bestFor: vendorBContrast.bestFor,
          strengths: vendorBContrast.strengths,
          tradeoffs: vendorBContrast.tradeoffs,
        }}
      />
    )}

    {sectionId === 'demo' && isHub && (
      <DemoQuestions
        toolA={comparison.tool_a_name}
        toolB={comparison.tool_b_name}
        family={hubFamily}
        toolAId={comparison.tool_a_id}
        toolBId={comparison.tool_b_id}
        toolAAffiliateHref={toolAAffiliateHref}
        toolBAffiliateHref={toolBAffiliateHref}
        toolAIsManualLead={toolAIsManualLead}
        toolBIsManualLead={toolBIsManualLead}
        toolAModalId={toolAModalId}
        toolBModalId={toolBModalId}
        toolAIsWinner={toolAIsWinner}
        toolBIsWinner={toolBIsWinner}
      />
    )}
  </>
))}
