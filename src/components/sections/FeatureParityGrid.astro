---
import VendorButton from '../VendorButton.astro';
import VendorLogo from '../VendorLogo.astro';
import { vendorQuoteCtaLabel } from '../../lib/outbound';
import type { FeatureMatrixEntry } from '../../lib/comparisons';

interface Props {
  toolAName: string;
  toolBName: string;
  toolAId: string;
  toolBId: string;
  toolALogo: string;
  toolBLogo: string;
  toolABadgeColor: string;
  toolBBadgeColor: string;
  toolAAffiliateHref: string;
  toolBAffiliateHref: string;
  toolAIsManualLead: boolean;
  toolBIsManualLead: boolean;
  toolAModalId: string;
  toolBModalId: string;
  toolAIsWinner: boolean;
  toolBIsWinner: boolean;
  featureMatrixRows: [string, FeatureMatrixEntry][];
  toolAIntegrations: string[];
  toolBIntegrations: string[];
  contrastNote?: string;
}

const {
  toolAName,
  toolBName,
  toolAId,
  toolBId,
  toolALogo,
  toolBLogo,
  toolABadgeColor,
  toolBBadgeColor,
  toolAAffiliateHref,
  toolBAffiliateHref,
  toolAIsManualLead,
  toolBIsManualLead,
  toolAModalId,
  toolBModalId,
  toolAIsWinner,
  toolBIsWinner,
  featureMatrixRows,
  toolAIntegrations,
  toolBIntegrations,
  contrastNote = '',
} = Astro.props;

const stickyFeatureCol =
  'sticky left-0 z-20 min-w-[10rem] max-w-[12rem] border-r border-slate-200 shadow-[4px_0_12px_-6px_rgba(15,23,42,0.18)]';
---

<section class="mb-12" aria-label={`Feature parity grid for ${toolAName} versus ${toolBName}`}>
  <h2 class="mb-6 text-2xl font-bold text-slate-900">Feature &amp; Integration Comparison</h2>
  {contrastNote && <p class="mb-3 text-sm text-slate-600">{contrastNote}</p>}
  <p class="mb-3 text-xs font-medium text-slate-500 md:hidden">Swipe sideways to compare. The Feature column stays put.</p>
  <div class="feature-compare-scroll isolate overflow-x-auto overscroll-x-contain rounded-2xl border border-slate-200 bg-white shadow-sm">
    <table class="w-full min-w-[36rem] border-separate border-spacing-0 text-left text-sm">
      <thead>
        <tr class="bg-slate-50">
          <th scope="col" class:list={[stickyFeatureCol, 'border-b border-slate-200 bg-slate-50 px-6 py-4 align-bottom font-semibold text-slate-700']}>Feature</th>
          <th scope="col" class="min-w-[10rem] border-b border-slate-200 px-6 py-4 align-bottom font-semibold text-slate-700">
            <span class="flex items-center gap-2.5">
              <VendorLogo src={toolALogo} alt="" name={toolAName} badgeColor={toolABadgeColor} size={36} />
              <span>Key Capabilities: {toolAName}</span>
            </span>
          </th>
          <th scope="col" class="min-w-[10rem] border-b border-slate-200 px-6 py-4 align-bottom font-semibold text-slate-700">
            <span class="flex items-center gap-2.5">
              <VendorLogo src={toolBLogo} alt="" name={toolBName} badgeColor={toolBBadgeColor} size={36} />
              <span>Key Capabilities: {toolBName}</span>
            </span>
          </th>
        </tr>
      </thead>
      <tbody>
        {featureMatrixRows.map(([feature, value]) => {
          const differs = value.a !== value.b;
          return (
          <tr class:list={['group transition', differs ? 'bg-amber-50/50 dark:bg-amber-950/20' : 'hover:bg-slate-50/80']}>
            <th
              scope="row"
              class:list={[
                stickyFeatureCol,
                'border-b border-slate-100 px-6 py-4 font-medium text-slate-900',
                differs
                  ? 'border-l-2 border-amber-500 bg-amber-50/50 dark:bg-amber-950/20'
                  : 'bg-white group-hover:bg-slate-50',
              ]}
            >
              <span class="flex flex-wrap items-center gap-2">
                {feature}
                {differs && (
                  <span class="text-xs font-medium text-amber-700 bg-amber-100 rounded px-1.5 py-0.5">Key Difference</span>
                )}
              </span>
            </th>
            <td class:list={['border-b border-slate-100 px-6 py-4', differs && 'bg-amber-50/50 dark:bg-amber-950/20']}>
              {value.a ? (
                <span class="inline-flex items-center rounded-full bg-emerald-50 p-0.5 text-emerald-600" aria-label={`${toolAName} includes ${feature}`}>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5" aria-hidden="true">
                    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                  </svg>
                </span>
              ) : (
                <span class="inline-flex items-center rounded-full bg-red-50 p-0.5 text-red-500" aria-label={`${toolAName} lacks ${feature}`}>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5" aria-hidden="true">
                    <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" />
                  </svg>
                </span>
              )}
            </td>
            <td class:list={['border-b border-slate-100 px-6 py-4', differs && 'bg-amber-50/50 dark:bg-amber-950/20']}>
              {value.b ? (
                <span class="inline-flex items-center rounded-full bg-emerald-50 p-0.5 text-emerald-600" aria-label={`${toolBName} includes ${feature}`}>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5" aria-hidden="true">
                    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                  </svg>
                </span>
              ) : (
                <span class="inline-flex items-center rounded-full bg-red-50 p-0.5 text-red-500" aria-label={`${toolBName} lacks ${feature}`}>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5" aria-hidden="true">
                    <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" />
                  </svg>
                </span>
              )}
            </td>
          </tr>
          );
        })}
        {(toolAIntegrations.length > 0 || toolBIntegrations.length > 0) && (
          <tr class="group align-top transition hover:bg-slate-50/80">
            <th scope="row" class:list={[stickyFeatureCol, 'border-b border-slate-100 bg-white px-6 py-4 font-medium text-slate-900 group-hover:bg-slate-50']}>Native integrations</th>
            <td class="border-b border-slate-100 px-6 py-4 text-slate-700">
              {toolAIntegrations.length > 0 ? (
                <ul class="flex flex-wrap gap-1.5">
                  {toolAIntegrations.map((item) => (
                    <li class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700">
                      {item}
                    </li>
                  ))}
                </ul>
              ) : (
                <span class="text-sm text-slate-500">Not published</span>
              )}
            </td>
            <td class="border-b border-slate-100 px-6 py-4 text-slate-700">
              {toolBIntegrations.length > 0 ? (
                <ul class="flex flex-wrap gap-1.5">
                  {toolBIntegrations.map((item) => (
                    <li class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700">
                      {item}
                    </li>
                  ))}
                </ul>
              ) : (
                <span class="text-sm text-slate-500">Not published</span>
              )}
            </td>
          </tr>
        )}
      </tbody>
      <tfoot>
        <tr class="bg-slate-50">
          <td class:list={[stickyFeatureCol, 'border-t border-slate-200 bg-slate-50 px-6 py-4 text-sm font-medium text-slate-500']}>Get a quote</td>
          <td class="border-t border-slate-200 px-6 py-4 align-top">
            <VendorButton
              href={toolAAffiliateHref}
              modalId={toolAIsManualLead ? toolAModalId : undefined}
              vendorId={toolAId}
              vendorName={toolAName}
              location="feature_table"
              leadMagnet
              leadMagnetBadge={false}
              class={
                toolAIsWinner || !toolBIsWinner
                  ? 'inline-flex w-full items-center justify-center rounded-lg bg-indigo-600 px-3.5 py-2 text-xs font-semibold text-white shadow-sm transition hover:bg-indigo-700'
                  : 'inline-flex w-full items-center justify-center rounded-lg border border-indigo-600 bg-white px-3.5 py-2 text-xs font-semibold text-indigo-700 transition hover:bg-indigo-50'
              }
            >
              {vendorQuoteCtaLabel(toolAName)}
            </VendorButton>
          </td>
          <td class="border-t border-slate-200 px-6 py-4 align-top">
            <VendorButton
              href={toolBAffiliateHref}
              modalId={toolBIsManualLead ? toolBModalId : undefined}
              vendorId={toolBId}
              vendorName={toolBName}
              location="feature_table"
              leadMagnet
              leadMagnetBadge={false}
              class={
                toolBIsWinner
                  ? 'inline-flex w-full items-center justify-center rounded-lg bg-indigo-600 px-3.5 py-2 text-xs font-semibold text-white shadow-sm transition hover:bg-indigo-700'
                  : 'inline-flex w-full items-center justify-center rounded-lg border border-indigo-600 bg-white px-3.5 py-2 text-xs font-semibold text-indigo-700 transition hover:bg-indigo-50'
              }
            >
              {vendorQuoteCtaLabel(toolBName)}
            </VendorButton>
          </td>
        </tr>
      </tfoot>
    </table>
  </div>
</section>
