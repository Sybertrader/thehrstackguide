---
interface Props {
  brandName: string;
  modalId?: string;
  formActionUrl?: string;
}

const { 
  brandName, 
  modalId = `lead-modal-${brandName.toLowerCase().replace(/[^a-z0-9]/g, '')}`,
  formActionUrl = "https://formspree.io/f/YOUR_FORM_ID"
} = Astro.props;
---

<div
  id={modalId}
  class="modal-backdrop fixed inset-0 z-[9999] hidden bg-slate-900/70 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto"
  aria-hidden="true"
>
  <div class="relative w-full max-w-lg bg-white rounded-2xl shadow-2xl overflow-hidden border border-slate-100 text-left my-auto z-[10000]">
    
    <!-- Header -->
    <div class="bg-slate-900 px-6 py-5 text-white flex justify-between items-center">
      <div>
        <h3 class="text-xl font-bold tracking-tight">Connect with {brandName}</h3>
        <p class="text-xs text-slate-300 mt-1">Get custom pricing & priority onboarding support</p>
      </div>
      <button
        type="button"
        class="close-modal-btn text-slate-400 hover:text-white text-2xl font-bold leading-none p-1 rounded-lg focus:outline-none cursor-pointer"
        aria-label="Close modal"
      >
        &times;
      </button>
    </div>

    <!-- Form Container -->
    <div class="p-6">
      <form id={`form-${modalId}`} action={formActionUrl} method="POST" class="space-y-4">
        <input type="hidden" name="target_software" value={brandName} />
        <input type="hidden" name="_subject" value={`New Referral Inquiry: ${brandName} via The HR Stack Guide`} />

        <!-- First & Last Name -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for={`fname-${modalId}`} class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">First Name *</label>
            <input
              type="text"
              id={`fname-${modalId}`}
              name="first_name"
              required
              class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-sm outline-none transition"
              placeholder="Sarah"
            />
          </div>
          <div>
            <label for={`lname-${modalId}`} class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Last Name *</label>
            <input
              type="text"
              id={`lname-${modalId}`}
              name="last_name"
              required
              class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-sm outline-none transition"
              placeholder="Jenkins"
            />
          </div>
        </div>

        <!-- Work Email -->
        <div>
          <label for={`email-${modalId}`} class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Work Email *</label>
          <input
            type="email"
            id={`email-${modalId}`}
            name="work_email"
            required
            class="work-email-input w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-sm outline-none transition"
            placeholder="sarah@company.com"
          />
          <p class="email-error text-xs text-red-600 mt-1 hidden">Please enter a valid work email address (no personal webmail).</p>
        </div>

        <!-- Company Name & Job Title -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for={`company-${modalId}`} class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Company Name *</label>
            <input
              type="text"
              id={`company-${modalId}`}
              name="company_name"
              required
              class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-sm outline-none transition"
              placeholder="Acme Corp"
            />
          </div>
          <div>
            <label for={`role-${modalId}`} class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Job Title *</label>
            <input
              type="text"
              id={`role-${modalId}`}
              name="job_title"
              required
              class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-sm outline-none transition"
              placeholder="HR Director"
            />
          </div>
        </div>

        <!-- Company Size & Phone -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for={`size-${modalId}`} class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Employee Count *</label>
            <select
              id={`size-${modalId}`}
              name="company_size"
              required
              class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-sm outline-none bg-white transition"
            >
              <option value="">Select size...</option>
              <option value="1-10">1 - 10 employees</option>
              <option value="11-50">11 - 50 employees</option>
              <option value="51-200">51 - 200 employees</option>
              <option value="201-500">201 - 500 employees</option>
              <option value="500+">500+ employees</option>
            </select>
          </div>
          <div>
            <label for={`phone-${modalId}`} class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Phone Number</label>
            <input
              type="tel"
              id={`phone-${modalId}`}
              name="phone"
              class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-sm outline-none transition"
              placeholder="+1 (555) 000-0000"
            />
          </div>
        </div>

        <!-- Requirements Notes -->
        <div>
          <label for={`notes-${modalId}`} class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Primary Requirements / Timeline</label>
          <textarea
            id={`notes-${modalId}`}
            name="notes"
            rows="2"
            class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-sm outline-none transition resize-none"
            placeholder="Looking to switch within 30 days..."
          ></textarea>
        </div>

        <button
          type="submit"
          class="submit-btn w-full mt-2 py-3 px-4 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg shadow-md transition-all duration-200 flex items-center justify-center cursor-pointer"
        >
          <span class="btn-text">Submit Intro Request</span>
          <svg class="spinner hidden animate-spin ml-2 h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </button>

        <p class="text-[11px] text-slate-400 text-center mt-3 leading-relaxed">
          By submitting, you agree to allow <em>The HR Stack Guide</em> to connect your business directly with an authorized representative at {brandName}.
        </p>
      </form>

      <div class="success-message hidden py-8 text-center space-y-3">
        <div class="w-12 h-12 bg-green-100 text-green-600 rounded-full flex items-center justify-center mx-auto text-2xl font-bold">
          ✓
        </div>
        <h4 class="text-xl font-bold text-slate-900">Request Received!</h4>
        <p class="text-sm text-slate-600 max-w-xs mx-auto">
          Thank you. Our team is coordinating with {brandName} and will introduce your rep shortly.
        </p>
        <button
          type="button"
          class="close-modal-btn mt-4 px-5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium rounded-lg text-sm transition cursor-pointer"
        >
          Close Window
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function initModalHandlers() {
    if (window.__leadModalScriptInitialized) return;
    window.__leadModalScriptInitialized = true;

    var blockedDomains = ['gmail.com', 'yahoo.com', 'hotmail.com', 'outlook.com', 'aol.com', 'icloud.com'];

    document.addEventListener('click', function(e) {
      var target = e.target;
      var openBtn = target.closest('[data-modal-target]') || target.closest('.open-modal-btn');
      var closeBtn = target.closest('.close-modal-btn');

      if (openBtn) {
        var modalId = openBtn.getAttribute('data-modal-target');
        if (!modalId) {
          var text = openBtn.innerText || '';
          if (text.indexOf('Rippling') !== -1) modalId = 'lead-modal-rippling';
          else if (text.indexOf('Plane') !== -1) modalId = 'lead-modal-plane';
          else if (text.indexOf('Lever') !== -1) modalId = 'lead-modal-lever';
          else if (text.indexOf('JazzHR') !== -1) modalId = 'lead-modal-jazzhr';
        }

        if (modalId) {
          var modal = document.getElementById(modalId);
          if (modal) {
            e.preventDefault();
            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
          }
        }
      }

      if (closeBtn) {
        var activeModal = closeBtn.closest('.modal-backdrop');
        if (activeModal) {
          activeModal.classList.add('hidden');
          document.body.style.overflow = '';
        }
      }

      if (target.classList.contains('modal-backdrop')) {
        target.classList.add('hidden');
        document.body.style.overflow = '';
      }
    });

    document.addEventListener('submit', async function(e) {
      var form = e.target;
      if (!form || !form.id || form.id.indexOf('form-lead-modal-') !== 0) return;

      e.preventDefault();

      var emailInput = form.querySelector('.work-email-input');
      var emailError = form.querySelector('.email-error');
      var submitBtn = form.querySelector('.submit-btn');
      var btnText = form.querySelector('.btn-text');
      var spinner = form.querySelector('.spinner');
      var successMessage = form.closest('.p-6') ? form.closest('.p-6').querySelector('.success-message') : null;

      if (emailInput) {
        var emailValue = emailInput.value.toLowerCase().trim();
        var domain = emailValue.split('@')[1];

        if (blockedDomains.indexOf(domain) !== -1) {
          if (emailError) emailError.classList.remove('hidden');
          emailInput.classList.add('border-red-500');
          return;
        } else {
          if (emailError) emailError.classList.add('hidden');
          emailInput.classList.remove('border-red-500');
        }
      }

      if (submitBtn) submitBtn.disabled = true;
      if (btnText) btnText.classList.add('hidden');
      if (spinner) spinner.classList.remove('hidden');

      try {
        var formData = new FormData(form);
        var response = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: { 'Accept': 'application/json' }
        });

        if (response.ok) {
          form.classList.add('hidden');
          if (successMessage) successMessage.classList.remove('hidden');
        } else {
          alert('There was a problem submitting your request. Please try again.');
        }
      } catch (err) {
        alert('Submission error. Please check your connection and try again.');
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        if (btnText) btnText.classList.remove('hidden');
        if (spinner) spinner.classList.add('hidden');
      }
    });
  })();
</script>
