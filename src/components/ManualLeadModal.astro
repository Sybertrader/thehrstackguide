---
import { LEAD_MODAL_ID, nonAffiliateVendorHomeUrl, vendorLeadModalHeading } from '../lib/outbound';
import { loadToolProfiles } from '../lib/tools';

interface Props {
  brandName?: string;
  vendorId?: string;
  modalId?: string;
  partnerLandingUrl?: string;
  /** @deprecated Prefer posting through /api/leads which records email server-side. */
  formActionUrl?: string;
}

const {
  brandName = '',
  vendorId = '',
  // Every CTA targets this singleton. Vendor identity is copied from the button on open.
  modalId = LEAD_MODAL_ID,
  partnerLandingUrl = '',
  formActionUrl = '/api/leads',
} = Astro.props;

const resolvedVendorId = vendorId || (brandName ? brandName.toLowerCase().replace(/\s+/g, '-') : '');
const headingText = brandName ? vendorLeadModalHeading(brandName) : 'Get Custom Pricing';
const vendorHomeUrl = resolvedVendorId ? nonAffiliateVendorHomeUrl(resolvedVendorId) : '';
const partnerUrls: Record<string, string> = {};
for (const [id, profile] of Object.entries(loadToolProfiles())) {
  if (profile.partner_landing_url) partnerUrls[id] = profile.partner_landing_url;
}

// Needs the PUBLIC_ prefix to survive into the browser bundle. Falls back to the
// same key api/leads.js uses so a deploy without the env var still collects
// leads. Web3Forms access keys are meant for browser-side posting, so this is
// readable in page source either way.
const WEB3FORMS_KEY =
  import.meta.env.PUBLIC_WEB3FORMS_KEY || '9e3cce58-b062-4436-9834-24ba34373412';
---

<div
  id={modalId}
  class="modal-backdrop fixed inset-0 z-[9999] hidden bg-slate-900/70 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto"
  aria-hidden="true"
  data-vendor-id={resolvedVendorId || undefined}
  data-brand-name={brandName || undefined}
  data-partner-landing-url={partnerLandingUrl || undefined}
  data-partner-urls={JSON.stringify(partnerUrls)}
  data-vendor-url={vendorHomeUrl || undefined}
>
  <div class="relative w-full max-w-lg bg-white rounded-2xl shadow-2xl overflow-hidden border border-slate-100 text-left my-auto z-[10000]">
    
    <!-- Header -->
    <div class="bg-slate-900 px-6 py-5 text-white flex justify-between items-center">
      <div>
        <h3 class="lead-modal-heading text-xl font-bold tracking-tight">{headingText}</h3>
        <p class="text-xs text-slate-300 mt-1">Skip the general sales queue for custom pricing &amp; direct team access.</p>
      </div>
      <button
        type="button"
        class="close-modal-btn text-slate-400 hover:text-white text-2xl font-bold leading-none p-1 rounded-lg focus:outline-none cursor-pointer"
        aria-label="Close modal"
      >
        &times;
      </button>
    </div>

    <!-- Form Container -->
    <div class="p-6">
      <form
        id={`form-${modalId}`}
        action={formActionUrl}
        method="POST"
        class="space-y-4"
        data-lead-form
        data-access-key={WEB3FORMS_KEY}
      >
        <input type="hidden" name="vendorId" value={resolvedVendorId} />
        <input type="hidden" name="brandName" value={brandName} />
        <input type="hidden" name="target_software" value={brandName} />
        <input type="hidden" name="partnerLandingUrl" value={partnerLandingUrl} />

        <!-- Full Name -->
        <div>
          <label for={`fullname-${modalId}`} class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Full Name *</label>
          <input
            type="text"
            id={`fullname-${modalId}`}
            name="fullName"
            required
            autocomplete="name"
            minlength="2"
            class="full-name-input w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-sm outline-none transition"
            placeholder="Sarah Jenkins"
          />
          <p class="fullname-error text-xs text-red-600 mt-1 hidden">Please enter your full name.</p>
        </div>

        <!-- Work Email -->
        <div>
          <label for={`email-${modalId}`} class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Work Email *</label>
          <input
            type="email"
            id={`email-${modalId}`}
            name="email"
            required
            autocomplete="email"
            class="work-email-input w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-sm outline-none transition"
            placeholder="sarah@company.com"
          />
          <p class="mt-1 text-[11px] leading-relaxed text-slate-500">Used strictly to send your custom pricing breakdown. Zero newsletter spam.</p>
          <p class="email-error text-xs text-red-600 mt-1 hidden">Please enter a valid work email address (no personal webmail).</p>
        </div>

        <!-- Company Name & Job Title -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for={`company-${modalId}`} class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Company Name *</label>
            <input
              type="text"
              id={`company-${modalId}`}
              name="company"
              required
              class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-sm outline-none transition"
              placeholder="Acme Corp"
            />
          </div>
          <div>
            <label for={`role-${modalId}`} class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Job Title *</label>
            <input
              type="text"
              id={`role-${modalId}`}
              name="jobTitle"
              required
              class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-sm outline-none transition"
              placeholder="HR Director"
            />
          </div>
        </div>

        <!-- Company Size & Region -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for={`size-${modalId}`} class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Employee Count *</label>
            <select
              id={`size-${modalId}`}
              name="employeeCount"
              required
              class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-sm outline-none bg-white transition"
            >
              <option value="">Select size...</option>
              <option value="1-10">1 - 10 employees</option>
              <option value="11-50">11 - 50 employees</option>
              <option value="51-200">51 - 200 employees</option>
              <option value="201-500">201 - 500 employees</option>
              <option value="500+">500+ employees</option>
            </select>
          </div>
          <div>
            <label for={`region-${modalId}`} class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Region *</label>
            <select
              id={`region-${modalId}`}
              name="region"
              required
              class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-sm outline-none bg-white transition"
            >
              <option value="">Select region...</option>
              <option value="North America">North America</option>
              <option value="Europe">Europe</option>
              <option value="APAC">APAC</option>
              <option value="LATAM">LATAM</option>
              <option value="Middle East / Africa">Middle East / Africa</option>
              <option value="Global / Multi-region">Global / Multi-region</option>
            </select>
          </div>
        </div>

        <!-- Phone -->
        <div>
          <label for={`phone-${modalId}`} class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Phone Number (Optional)</label>
          <input
            type="tel"
            id={`phone-${modalId}`}
            name="phone"
            autocomplete="tel"
            class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-sm outline-none transition"
            placeholder="+1 (555) 000-0000"
          />
          <p class="mt-1 text-[11px] leading-relaxed text-slate-500">Optional. Only used if you request a callback. No automated sales harassment.</p>
        </div>

        <!-- Timeline -->
        <div>
          <label for={`notes-${modalId}`} class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Primary Requirements / Timeline *</label>
          <select
            id={`notes-${modalId}`}
            name="requirements"
            required
            class="timeline-select w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-sm outline-none bg-white transition"
          >
            <option value="">Select timeline...</option>
            <option value="Evaluating (0–30 days)">Evaluating (0–30 days)</option>
            <option value="Exploring (1–3 months)">Exploring (1–3 months)</option>
            <option value="Just Researching / Comparing">Just Researching / Comparing</option>
          </select>
          <p class="timeline-error text-xs text-red-600 mt-1 hidden">Please select your evaluation timeline.</p>
        </div>

        <button
          type="submit"
          class="submit-btn w-full mt-2 py-3 px-4 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg shadow-md transition-all duration-200 flex items-center justify-center cursor-pointer"
        >
          <span class="btn-text">Get Custom Pricing &amp; Intro →</span>
          <svg class="spinner hidden animate-spin ml-2 h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </button>

        <p class="text-xs text-gray-400 mt-3 text-center">
          We respect your <a href="/privacy/" target="_blank" rel="noopener noreferrer" class="underline hover:text-blue-500">privacy</a>. Your information is encrypted and shared exclusively with an authorized <span class="lead-modal-brand">{brandName || 'vendor'}</span> representative to prepare your quote.
        </p>
      </form>

      <div class="success-message hidden py-8 text-center space-y-3">
        <div class="w-12 h-12 bg-green-100 text-green-600 rounded-full flex items-center justify-center mx-auto text-2xl font-bold">
          ✓
        </div>
        <h4 class="text-xl font-bold text-slate-900">Thank you!</h4>
        <p class="text-sm text-slate-600 max-w-xs mx-auto">
          Your request has been received. A representative will reach out to you shortly.
        </p>
        <button
          type="button"
          class="close-modal-btn mt-4 px-5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium rounded-lg text-sm transition cursor-pointer"
        >
          Close
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { initLeadModal } from '../scripts/lead-modal';

  initLeadModal();
</script>
