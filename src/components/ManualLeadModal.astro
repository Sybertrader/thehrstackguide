---
interface Props {
  brandName: string;
  vendorId?: string;
  modalId?: string;
  partnerLandingUrl?: string;
  /** @deprecated Prefer posting through /api/leads which records email server-side. */
  formActionUrl?: string;
}

const {
  brandName,
  vendorId = '',
  // Must match [slug].astro / [...slug].astro manualLeadModalId() — spaces become hyphens.
  modalId = `lead-modal-${brandName.toLowerCase().replace(/\s+/g, '-')}`,
  partnerLandingUrl = '',
  formActionUrl = '/api/leads',
} = Astro.props;

const resolvedVendorId = vendorId || brandName.toLowerCase().replace(/\s+/g, '-');

// Needs the PUBLIC_ prefix to survive into the browser bundle. Falls back to the
// same key api/leads.js uses so a deploy without the env var still collects
// leads. Web3Forms access keys are meant for browser-side posting, so this is
// readable in page source either way.
const WEB3FORMS_KEY =
  import.meta.env.PUBLIC_WEB3FORMS_KEY || '9e3cce58-b062-4436-9834-24ba34373412';
---

<div
  id={modalId}
  class="modal-backdrop fixed inset-0 z-[9999] hidden bg-slate-900/70 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto"
  aria-hidden="true"
  data-vendor-id={resolvedVendorId}
  data-brand-name={brandName}
  data-partner-landing-url={partnerLandingUrl}
>
  <div class="relative w-full max-w-lg bg-white rounded-2xl shadow-2xl overflow-hidden border border-slate-100 text-left my-auto z-[10000]">
    
    <!-- Header -->
    <div class="bg-slate-900 px-6 py-5 text-white flex justify-between items-center">
      <div>
        <h3 class="text-xl font-bold tracking-tight">Connect with {brandName}</h3>
        <p class="text-xs text-slate-300 mt-1">Get custom pricing & priority onboarding support</p>
      </div>
      <button
        type="button"
        class="close-modal-btn text-slate-400 hover:text-white text-2xl font-bold leading-none p-1 rounded-lg focus:outline-none cursor-pointer"
        aria-label="Close modal"
      >
        &times;
      </button>
    </div>

    <!-- Form Container -->
    <div class="p-6">
      <form
        id={`form-${modalId}`}
        action={formActionUrl}
        method="POST"
        class="space-y-4"
        data-access-key={WEB3FORMS_KEY}
      >
        <input type="hidden" name="vendorId" value={resolvedVendorId} />
        <input type="hidden" name="brandName" value={brandName} />
        <input type="hidden" name="target_software" value={brandName} />
        <input type="hidden" name="partnerLandingUrl" value={partnerLandingUrl} />

        <!-- First & Last Name -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for={`fname-${modalId}`} class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">First Name *</label>
            <input
              type="text"
              id={`fname-${modalId}`}
              name="first_name"
              required
              class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-sm outline-none transition"
              placeholder="Sarah"
            />
          </div>
          <div>
            <label for={`lname-${modalId}`} class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Last Name *</label>
            <input
              type="text"
              id={`lname-${modalId}`}
              name="last_name"
              required
              class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-sm outline-none transition"
              placeholder="Jenkins"
            />
          </div>
        </div>

        <!-- Work Email -->
        <div>
          <label for={`email-${modalId}`} class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Work Email *</label>
          <input
            type="email"
            id={`email-${modalId}`}
            name="work_email"
            required
            class="work-email-input w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-sm outline-none transition"
            placeholder="sarah@company.com"
          />
          <p class="email-error text-xs text-red-600 mt-1 hidden">Please enter a valid work email address (no personal webmail).</p>
        </div>

        <!-- Company Name & Job Title -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for={`company-${modalId}`} class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Company Name *</label>
            <input
              type="text"
              id={`company-${modalId}`}
              name="company_name"
              required
              class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-sm outline-none transition"
              placeholder="Acme Corp"
            />
          </div>
          <div>
            <label for={`role-${modalId}`} class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Job Title *</label>
            <input
              type="text"
              id={`role-${modalId}`}
              name="job_title"
              required
              class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-sm outline-none transition"
              placeholder="HR Director"
            />
          </div>
        </div>

        <!-- Company Size & Region -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for={`size-${modalId}`} class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Employee Count *</label>
            <select
              id={`size-${modalId}`}
              name="company_size"
              required
              class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-sm outline-none bg-white transition"
            >
              <option value="">Select size...</option>
              <option value="1-10">1 - 10 employees</option>
              <option value="11-50">11 - 50 employees</option>
              <option value="51-200">51 - 200 employees</option>
              <option value="201-500">201 - 500 employees</option>
              <option value="500+">500+ employees</option>
            </select>
          </div>
          <div>
            <label for={`region-${modalId}`} class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Region *</label>
            <select
              id={`region-${modalId}`}
              name="region"
              required
              class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-sm outline-none bg-white transition"
            >
              <option value="">Select region...</option>
              <option value="North America">North America</option>
              <option value="Europe">Europe</option>
              <option value="APAC">APAC</option>
              <option value="LATAM">LATAM</option>
              <option value="Middle East / Africa">Middle East / Africa</option>
              <option value="Global / Multi-region">Global / Multi-region</option>
            </select>
          </div>
        </div>

        <!-- Phone -->
        <div>
          <label for={`phone-${modalId}`} class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Phone Number</label>
          <input
            type="tel"
            id={`phone-${modalId}`}
            name="phone"
            class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-sm outline-none transition"
            placeholder="+1 (555) 000-0000"
          />
        </div>

        <!-- Requirements Notes -->
        <div>
          <label for={`notes-${modalId}`} class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Primary Requirements / Timeline</label>
          <textarea
            id={`notes-${modalId}`}
            name="notes"
            rows="2"
            class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-sm outline-none transition resize-none"
            placeholder="Looking to switch within 30 days..."
          ></textarea>
        </div>

        <button
          type="submit"
          class="submit-btn w-full mt-2 py-3 px-4 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg shadow-md transition-all duration-200 flex items-center justify-center cursor-pointer"
        >
          <span class="btn-text">Submit Intro Request</span>
          <svg class="spinner hidden animate-spin ml-2 h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </button>

        <p class="text-[11px] text-slate-400 text-center mt-3 leading-relaxed">
          By submitting, you agree to allow <em>The HR Stack Guide</em> to connect your business directly with an authorized representative at {brandName}.
        </p>
      </form>

      <div class="success-message hidden py-8 text-center space-y-3">
        <div class="w-12 h-12 bg-green-100 text-green-600 rounded-full flex items-center justify-center mx-auto text-2xl font-bold">
          ✓
        </div>
        <h4 class="text-xl font-bold text-slate-900">Thank you!</h4>
        <p class="text-sm text-slate-600 max-w-xs mx-auto">
          Your request has been received. A representative will reach out to you shortly.
        </p>
        <button
          type="button"
          class="close-modal-btn mt-4 px-5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium rounded-lg text-sm transition cursor-pointer"
        >
          Close
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function initModalHandlers() {
    if (window.__leadModalScriptInitialized) return;
    window.__leadModalScriptInitialized = true;

    var blockedDomains = ['gmail.com', 'yahoo.com', 'hotmail.com', 'outlook.com', 'aol.com', 'icloud.com'];

    var PERFORMYARD_ZAPIER_WEBHOOK = 'https://hooks.zapier.com/hooks/catch/17923801/46vtmid/';
    var PERFORMYARD_REDIRECT_URL = 'https://www.performyard.com/';

    // The only vendors whose modal submissions this script handles. Anything
    // else keeps the original /api/leads behaviour.
    var EMAIL_SEND_VENDORS = ['lever', 'jazzhr', 'culture-amp', 'performyard'];
    var WEB3FORMS_ENDPOINT = 'https://api.web3forms.com/submit';

    function trackGenerateLead(vendorId) {
      if (typeof window.gtag === 'function' && vendorId) {
        window.gtag('event', 'generate_lead', {
          vendor_id: vendorId,
          page_location: window.location.pathname,
        });
      }
    }

    /**
     * Web3Forms supports browser-side posting, so this is a normal CORS fetch
     * the caller can await. Pass keepalive when a redirect follows immediately,
     * otherwise the navigation cancels the request.
     */
    function sendWeb3FormsEmail(payload, keepalive) {
      return fetch(WEB3FORMS_ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload),
        keepalive: Boolean(keepalive),
      });
    }

    /**
     * Fire-and-forget POST that must never block the redirect or surface an
     * error to the visitor. sendBeacon keeps the request alive across the
     * navigation; the fetch fallback uses no-cors + keepalive for the same
     * reason. Neither path can be inspected for success, so callers must not
     * treat a return value as delivery confirmation.
     */
    function dispatchInBackground(url, payload) {
      var body = JSON.stringify(payload);

      try {
        if (navigator.sendBeacon) {
          var blob = new Blob([body], { type: 'application/json' });
          if (navigator.sendBeacon(url, blob)) return;
        }
      } catch (_) {
        // Fall through to fetch below.
      }

      try {
        fetch(url, {
          method: 'POST',
          mode: 'no-cors',
          keepalive: true,
          body: body,
        }).catch(function () {});
      } catch (_) {
        // Nothing left to try — never interrupt the handoff.
      }
    }

    document.addEventListener('click', function(e) {
      var target = e.target;
      if (!target || !target.closest) return;

      var openBtn = target.closest('[data-modal-target]') || target.closest('.open-modal-btn');
      var closeBtn = target.closest('.close-modal-btn');

      if (openBtn) {
        // Prefer explicit data attribute — avoid innerText (forces layout / hurts INP).
        var modalId = openBtn.getAttribute('data-modal-target');
        if (!modalId) {
          var label = (openBtn.getAttribute('aria-label') || openBtn.textContent || '').toLowerCase();
          if (label.indexOf('lever') !== -1) modalId = 'lead-modal-lever';
          else if (label.indexOf('jazzhr') !== -1) modalId = 'lead-modal-jazzhr';
          else if (label.indexOf('culture amp') !== -1) modalId = 'lead-modal-culture-amp';
          else if (label.indexOf('performyard') !== -1) modalId = 'lead-modal-performyard';
        }

        if (modalId) {
          var modal = document.getElementById(modalId);
          if (modal) {
            e.preventDefault();
            // Teleport to body so fixed positioning is never trapped by
            // ancestor overflow/transform stacking contexts.
            if (modal.parentElement !== document.body) {
              document.body.appendChild(modal);
            }
            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
          }
        }
        return;
      }

      if (closeBtn) {
        var activeModal = closeBtn.closest('.modal-backdrop');
        if (activeModal) {
          activeModal.classList.add('hidden');
          document.body.style.overflow = '';
        }
        return;
      }

      if (target.classList && target.classList.contains('modal-backdrop')) {
        target.classList.add('hidden');
        document.body.style.overflow = '';
      }
    }, { passive: false });

    document.addEventListener('submit', async function(e) {
      var form = e.target;
      if (!form || !form.id || form.id.indexOf('form-lead-modal-') !== 0) return;

      e.preventDefault();

      var emailInput = form.querySelector('.work-email-input');
      var emailError = form.querySelector('.email-error');
      var submitBtn = form.querySelector('.submit-btn');
      var btnText = form.querySelector('.btn-text');
      var spinner = form.querySelector('.spinner');
      var successMessage = form.closest('.p-6') ? form.closest('.p-6').querySelector('.success-message') : null;
      var backdrop = form.closest('.modal-backdrop');

      if (emailInput) {
        var emailValue = emailInput.value.toLowerCase().trim();
        var domain = emailValue.split('@')[1];

        if (blockedDomains.indexOf(domain) !== -1) {
          if (emailError) emailError.classList.remove('hidden');
          emailInput.classList.add('border-red-500');
          return;
        } else {
          if (emailError) emailError.classList.add('hidden');
          emailInput.classList.remove('border-red-500');
        }
      }

      if (submitBtn) submitBtn.disabled = true;
      if (btnText) btnText.classList.add('hidden');
      if (spinner) spinner.classList.remove('hidden');

      // Read through FormData scoped to the submitted form: comparison pages
      // render two modal instances, so a document-wide id lookup could pick up
      // the other vendor's fields.
      var formData = new FormData(form);
      var firstName = String(formData.get('first_name') || '').trim();
      var lastName = String(formData.get('last_name') || '').trim();
      var vendorId = String(formData.get('vendorId') || (backdrop && backdrop.getAttribute('data-vendor-id')) || '').trim();
      var vendor = vendorId.toLowerCase();

      if (EMAIL_SEND_VENDORS.indexOf(vendor) !== -1) {
        var accessKey = form.dataset.accessKey || '';
        if (!accessKey) {
          console.error('Web3Forms access key missing — set PUBLIC_WEB3FORMS_KEY. Lead will not be emailed.');
        }

        var company = String(formData.get('company_name') || '').trim();
        var emailPayload = {
          access_key: accessKey,
          subject: 'New Lead: ' + vendor.toUpperCase() + ' - ' + company,
          from_name: 'The HR Stack Guide',
          firstName: firstName,
          lastName: lastName,
          email: String(formData.get('work_email') || '').trim(),
          company: company,
          jobTitle: String(formData.get('job_title') || '').trim(),
          employeeCount: String(formData.get('company_size') || '').trim(),
          region: String(formData.get('region') || '').trim(),
          phone: String(formData.get('phone') || '').trim(),
          requirements: String(formData.get('notes') || '').trim(),
          vendor: vendor,
        };

        // PerformYard leads go straight from the browser to Shane's Zapier catch
        // hook, then hand the visitor off to PerformYard.
        if (vendor === 'performyard') {
          dispatchInBackground(PERFORMYARD_ZAPIER_WEBHOOK, {
            firstName: firstName,
            lastName: lastName,
            email: String(formData.get('work_email') || '').trim(),
            company: String(formData.get('company_name') || '').trim(),
            jobTitle: String(formData.get('job_title') || '').trim(),
            employeeCount: String(formData.get('company_size') || '').trim(),
            region: String(formData.get('region') || '').trim(),
            phone: String(formData.get('phone') || '').trim(),
            requirements: String(formData.get('notes') || '').trim(),
            source: 'thehrstackguide.com',
            timestamp: new Date().toISOString(),
          });

          sendWeb3FormsEmail(emailPayload, true).catch(function (err) {
            console.error('Web3Forms notification failed', err);
          });

          trackGenerateLead(vendor);
          window.location.href = PERFORMYARD_REDIRECT_URL;
          return;
        }

        // lever / jazzhr / culture-amp: email only, no webhook and no redirect.
        try {
          var emailResponse = await sendWeb3FormsEmail(emailPayload, false);
          if (!emailResponse.ok) {
            console.error('Web3Forms notification rejected', emailResponse.status);
          }
        } catch (err) {
          // Deliberately swallowed: a delivery problem must not block the
          // visitor. Failures surface in the console and in Web3Forms.
          console.error('Web3Forms notification failed', err);
        }

        trackGenerateLead(vendor);
        form.classList.add('hidden');
        if (successMessage) successMessage.classList.remove('hidden');
        if (submitBtn) submitBtn.disabled = false;
        if (btnText) btnText.classList.remove('hidden');
        if (spinner) spinner.classList.add('hidden');
        return;
      }

      try {
        var payload = {
          vendorId: vendorId,
          brandName: String(formData.get('brandName') || (backdrop && backdrop.getAttribute('data-brand-name')) || '').trim(),
          firstName: firstName,
          lastName: lastName,
          fullName: (firstName + ' ' + lastName).trim(),
          workEmail: String(formData.get('work_email') || '').trim(),
          companyName: String(formData.get('company_name') || '').trim(),
          jobTitle: String(formData.get('job_title') || '').trim(),
          headcount: String(formData.get('company_size') || '').trim(),
          region: String(formData.get('region') || '').trim(),
          phone: String(formData.get('phone') || '').trim(),
          needs: String(formData.get('notes') || '').trim(),
          partnerLandingUrl:
            String(formData.get('partnerLandingUrl') || (backdrop && backdrop.getAttribute('data-partner-landing-url')) || '').trim() ||
            null,
          source: 'The HR Stack Guide',
        };

        var response = await fetch(form.action || '/api/leads', {
          method: 'POST',
          headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        var result = null;
        try {
          result = await response.json();
        } catch (_) {
          result = null;
        }

        if (response.ok) {
          trackGenerateLead(vendorId);
          var redirectUrl = result && result.redirectUrl ? String(result.redirectUrl) : '';
          if (redirectUrl) {
            window.location.href = redirectUrl;
            return;
          }
          form.classList.add('hidden');
          if (successMessage) successMessage.classList.remove('hidden');
        } else {
          console.error('Lead submission rejected', response.status);
        }
      } catch (err) {
        console.error('Lead submission failed', err);
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        if (btnText) btnText.classList.remove('hidden');
        if (spinner) spinner.classList.add('hidden');
      }
    });
  })();
</script>
