---
/**
 * Compact EEAT / GEO trust chip for comparison pages. Pass `quarter` from
 * the page's existing date helper (e.g. `currentQuarter`); defaults to the
 * current editorial window so the badge never renders blank.
 */
interface Props {
  quarter?: string;
}

const { quarter = 'Q3 2026' } = Astro.props;
---

<p class="my-2 inline-flex max-w-full items-center gap-1.5 rounded-full border border-emerald-200 bg-emerald-50/50 px-3 py-1 text-xs font-medium text-slate-700">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5 shrink-0 text-emerald-600" aria-hidden="true">
    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
  </svg>
  <span>Primary Terms &amp; Pricing Audited {quarter} | Unbiased Data</span>
</p>
