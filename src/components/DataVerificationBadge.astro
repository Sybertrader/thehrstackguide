---
/**
 * Compact EEAT / GEO trust chip for comparison pages. Month/year is computed
 * at build time so the badge stays current without hardcoded quarters.
 */
interface Props {
  updatedLabel?: string;
}

const currentMonthYear = new Date().toLocaleDateString('en-US', {
  month: 'long',
  year: 'numeric',
});
const { updatedLabel = currentMonthYear } = Astro.props;
---

<div class="my-2 inline-flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-xs font-medium text-emerald-900">
  <svg class="h-4 w-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
  </svg>
  <span>Human-Verified Pricing &amp; Terms (Updated {updatedLabel})</span>
  <span class="text-emerald-300" aria-hidden="true">|</span>
  <span>Independent Operational Data</span>
</div>
