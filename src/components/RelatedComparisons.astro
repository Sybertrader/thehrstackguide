---
import VendorLogo from './VendorLogo.astro';

interface RelatedLink {
  href: string;
  tool_a_name: string;
  tool_b_name: string;
  tool_a_logo_url?: string | null;
  tool_b_logo_url?: string | null;
}

interface Props {
  links: RelatedLink[];
  categoryHref: string;
  categoryLabel: string;
}

const { links, categoryHref, categoryLabel } = Astro.props;

function logoBadgeColor(name: string): string {
  const colors = ['bg-indigo-600', 'bg-violet-600', 'bg-sky-600', 'bg-emerald-600', 'bg-rose-600', 'bg-amber-600', 'bg-cyan-600', 'bg-fuchsia-600'];
  let hash = 0;
  for (let i = 0; i < name.length; i += 1) {
    hash = name.charCodeAt(i) + ((hash << 5) - hash);
  }
  return colors[Math.abs(hash) % colors.length];
}
---

{links.length > 0 && (
  <section class="mt-16" aria-label="Related comparisons">
    <h2 class="mb-2 text-2xl font-bold text-slate-900">Related Comparisons</h2>
    <p class="mb-6 text-sm text-slate-600">
      Same category. Different pair. Read these next, or go back to the
      {' '}
      <a href={categoryHref} class="font-semibold text-indigo-700 underline underline-offset-2 hover:text-indigo-900">
        {categoryLabel}
      </a>
      {' '}
      category hub.
    </p>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {links.map((item) => (
        <a
          href={item.href}
          class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-indigo-200 hover:shadow-md"
        >
          <div class="mb-3 flex items-center gap-2">
            <VendorLogo
              src={item.tool_a_logo_url}
              alt={`${item.tool_a_name} logo`}
              name={item.tool_a_name}
              badgeColor={logoBadgeColor(item.tool_a_name)}
              size={24}
            />
            <span class="text-xs font-semibold text-gray-400">VS</span>
            <VendorLogo
              src={item.tool_b_logo_url}
              alt={`${item.tool_b_name} logo`}
              name={item.tool_b_name}
              badgeColor={logoBadgeColor(item.tool_b_name)}
              size={24}
            />
          </div>
          <h3 class="text-base font-bold text-gray-900 transition group-hover:text-indigo-600">
            {item.tool_a_name} vs {item.tool_b_name}
          </h3>
          <span class="mt-4 inline-flex items-center text-sm font-semibold text-indigo-600">
            View comparison
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="ml-1 h-4 w-4" aria-hidden="true">
              <path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 0 1 .75-.75h8.5a.75.75 0 0 1 .75.75v5.75a.75.75 0 0 1-1.5 0V7.06l-7.47 7.47a.75.75 0 0 1-1.06-1.06L11.94 6H5.5a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd" />
            </svg>
          </span>
        </a>
      ))}
    </div>
  </section>
)}
