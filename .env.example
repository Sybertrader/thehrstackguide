# Google Analytics 4. PUBLIC_ so it is available in the browser bundle at
# build time. Leave unset to skip gtag.js entirely (local / preview).
PUBLIC_GA_MEASUREMENT_ID=G-FK6Z3BFZ7Q

# Lead intake / partner integrations (set in Vercel project settings)

# Read in the browser by src/components/ManualLeadModal.astro, so it MUST keep
# the PUBLIC_ prefix and must be present at build time — without it the lead
# modal posts an empty access_key and Web3Forms rejects every submission.
PUBLIC_WEB3FORMS_KEY=9e3cce58-b062-4436-9834-24ba34373412

# Server-side only (api/leads.js).
WEB3FORMS_ACCESS_KEY=
PERFORMYARD_ZAPIER_WEBHOOK_URL=
PERFORMYARD_PARTNER_LANDING_URL=https://www.performyard.com
